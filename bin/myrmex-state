    reconcile.add_argument("run_id")
    reconcile.set_defaults(func=cmd_reconcile)

    delivery = sub.add_parser("delivery", help="derive delivery artifacts from confirmed typed identities")
    delivery.add_argument("run_id")
    delivery.add_argument("delivery_action", choices=["pr-body"])
    delivery.add_argument(
        "--tracking-operation-id", "--tracking-issue-operation-id",
        dest="tracking_operation_id", required=True,
