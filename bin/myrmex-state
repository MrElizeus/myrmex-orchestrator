def utcnow() -> str:
    return dt.datetime.now(dt.timezone.utc).isoformat(timespec="seconds")


def state_home() -> Path:
    explicit = os.environ.get("MYRMEX_STATE_HOME")
    if explicit:
        return Path(explicit).expanduser().resolve()
    xdg = os.environ.get("XDG_STATE_HOME")
    base = Path(xdg).expanduser() if xdg else Path.home() / ".local" / "state"
    return (base / "opencode" / "myrmex-orchestrator").resolve()


def runs_dir() -> Path:
    return state_home() / "runs"


def run_dir(run_id: str) -> Path:
    validate_run_id(run_id)
    return runs_dir() / run_id


def validate_run_id(value: str) -> None:
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{2,127}", value):
        raise SystemExit(f"invalid run id: {value!r}")


def slug(value: str, limit: int = 36) -> str:
    text = re.sub(r"[^a-z0-9]+", "-", value.lower()).strip("-")
    return (text or "objective")[:limit].rstrip("-")


def atomic_write(path: Path, data: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    mode = (path.stat().st_mode & 0o777) if path.exists() else 0o600
    fd, tmp = tempfile.mkstemp(prefix=path.name + ".", suffix=".tmp", dir=path.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump(data, handle, indent=2, ensure_ascii=False, sort_keys=True)
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    finally:
        try:
            os.unlink(tmp)
        except FileNotFoundError:
            pass


def read_state(run_id: str) -> dict[str, Any]:
    path = run_dir(run_id) / "state.json"
    if not path.is_file():
        raise SystemExit(f"run not found: {run_id}")
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except Exception as exc:
        raise SystemExit(f"invalid state for {run_id}: {exc}") from exc
    pair = (data.get("schema"), data.get("schema_version"))
    if pair not in SUPPORTED_SCHEMAS:
        raise SystemExit(
            f"unsupported state schema/version for {run_id}: "
            f"{data.get('schema')!r}/{data.get('schema_version')!r}"
        )
    return data


def state_is_v2(data: dict[str, Any]) -> bool:
    return data.get("schema") == SCHEMA_V2 and data.get("schema_version") == 2


def require_v2(data: dict[str, Any], command: str) -> None:
    """Keep schema upgrades explicit instead of changing a run during a write."""
    if not state_is_v2(data):
        raise SystemExit(
            f"{command} requires {SCHEMA_V2}; run `myrmex-state migrate {data.get('run_id')}` first"
        )


def sanitize_evidence(value: Any) -> Any:
    """Keep evidence useful without storing credentials or browser contents."""
    sensitive = re.compile(
        r"(?:api[_-]?key|client[_-]?secret|access[_-]?token|token|secret|password|"
        r"authorization|cookie|auth(?:entication)?[_-]?headers?|session(?:[_-]?token)?|"
        r"storage[_-]?state|raw[_-]?(?:profile|response)|profile(?:[_-]?(?:content|contents))?|"
        r"credential|private[_-]?key|headers?)",
        re.I,
    )
    token = re.compile(r"\b(?:gh[opsu]_[A-Za-z0-9_]+|sk-[A-Za-z0-9_-]{12,}|Bearer\s+\S+)", re.I)
    if isinstance(value, dict):
        return {str(key): "[REDACTED]" if sensitive.fullmatch(str(key)) else sanitize_evidence(item)
                for key, item in value.items()}
    if isinstance(value, list):
        return [sanitize_evidence(item) for item in value]
    if isinstance(value, str):
        return token.sub("[REDACTED]", value)
    return value


def normalize_legacy_state(data: dict[str, Any]) -> list[str]:
    """Apply lossless normalizations needed by older v1 state files."""
    changes: list[str] = []
    if data.get("phase") == "dormant" and data.get("status") == "active":
        data["status"] = "dormant"
        data["blocker"] = None
        changes.append("normalized phase=dormant,status=active")
    if "delegation_batches" not in data:
        data["delegation_batches"] = []
        changes.append("initialized delegation_batches")
    if "no_progress_cycles" not in data:
        data["no_progress_cycles"] = 0
        changes.append("initialized no_progress_cycles")
    if "defect_history" not in data:
        data["defect_history"] = []
        changes.append("initialized defect_history")
    if "delegation_ledger" not in data:
        data["delegation_ledger"] = []
        changes.append("initialized delegation_ledger")
    elif isinstance(data["delegation_ledger"], dict):
        data["delegation_ledger"] = [data["delegation_ledger"]]
        changes.append("wrapped legacy delegation_ledger object")
    if "execution" not in data:
        data["execution"] = {
            "requested_policy": "auto",
            "effective_route": "auto",
            "authority": "system",
            "request_id": None,
            "source_digest": None,
            "set_at": data.get("created_at") or utcnow(),
            "resolved_at": data.get("created_at") or utcnow(),
            "locked": False,
        }
        changes.append("initialized execution policy")
    if "pending_operations" not in data:
        data["pending_operations"] = []
        changes.append("initialized pending operation ledger")
    return changes


def ensure_v2_defaults(data: dict[str, Any]) -> None:
    """Hydrate additive v2 fields on the next explicit state write.

    The operation ledger was added after v2 shipped.  Treat a missing field as
    an older v2 shape while reading, but make the first typed write durable so
    new recovery logic never has to infer an empty ledger from an omission.
    """
    if state_is_v2(data) and "pending_operations" not in data:
        data["pending_operations"] = []
    if state_is_v2(data) and "authorizations" not in data:
        data["authorizations"] = []
    if state_is_v2(data) and "commit_policy_authorization" not in data:
        data["commit_policy_authorization"] = None
    if state_is_v2(data) and "parent_gate" not in data:
        data["parent_gate"] = None
    if state_is_v2(data) and "parent_gate_history" not in data:
        data["parent_gate_history"] = []
    if state_is_v2(data) and "next_work_unit" not in data:
        data["next_work_unit"] = None
    if state_is_v2(data) and "clarification" not in data:
        data["clarification"] = None
    if state_is_v2(data) and "pause" not in data:
        data["pause"] = None
    if state_is_v2(data) and "cancellation" not in data:
        data["cancellation"] = None
    if state_is_v2(data) and "recovery" not in data:
        data["recovery"] = None
    if state_is_v2(data) and isinstance(data.get("execution"), dict):
        execution = data["execution"]
        execution.setdefault("source_digest", None)
        execution.setdefault(
            "resolved_at",
            None if execution.get("requested_policy") == "unresolved" else execution.get("set_at"),
        )


def parse_authorization_expiry(value: Any) -> dt.datetime | None:
    if value is None:
        return None
    if not isinstance(value, str) or not value:
        raise SystemExit("authorization expires_at must be an ISO-8601 timestamp or null")
    try:
        parsed = dt.datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError as exc:
        raise SystemExit("authorization expires_at must be an ISO-8601 timestamp") from exc
    if parsed.tzinfo is None:
        raise SystemExit("authorization expires_at must include a timezone")
    return parsed


def normalize_repository_path(value: str, option: str = "repository root") -> str:
    if not isinstance(value, str) or not value.strip():
        raise SystemExit(f"{option} must be a non-empty path")
    return str(Path(value).expanduser().resolve())


def git_artifact_boundaries(repository_root: str) -> list[Path]:
    """Return the repository, common Git directory, and every worktree path."""
    boundaries = [Path(repository_root).expanduser().resolve()]

    def git_output(*arguments: str) -> str | None:
        try:
            result = subprocess.run(
                ["git", "-C", repository_root, *arguments],
                capture_output=True,
                text=True,
                stdin=subprocess.DEVNULL,
                timeout=10,
            )
        except (OSError, subprocess.TimeoutExpired):
            return None
        return result.stdout.strip() if result.returncode == 0 else None

    common = git_output("rev-parse", "--git-common-dir")
    if common:
        common_path = Path(common)
        if not common_path.is_absolute():
            common_path = boundaries[0] / common_path
        boundaries.append(common_path.resolve())

    worktrees = git_output("worktree", "list", "--porcelain")
    if worktrees:
        for line in worktrees.splitlines():
            if line.startswith("worktree "):
                boundaries.append(Path(line.removeprefix("worktree ")).resolve())
    return list(dict.fromkeys(boundaries))


def normalize_artifact_root(
    value: str,
    repository_root: str,
    *,
    option: str = "artifact root",
    create: bool = False,
) -> str:
    """Resolve and enforce an external, symlink-safe transport artifact root."""
    if not isinstance(value, str) or not value.strip():
        raise SystemExit(f"{option} must be a non-empty absolute path")
    candidate = Path(value).expanduser()
    if not candidate.is_absolute():
        raise SystemExit(f"{option} must be an absolute path")
    try:
        resolved = candidate.resolve(strict=False)
    except OSError as exc:
        raise SystemExit(f"{option} cannot be resolved: {exc}") from exc
    for boundary in git_artifact_boundaries(repository_root):
        try:
            resolved.relative_to(boundary)
        except ValueError:
            continue
        raise SystemExit(f"{option} must be outside protected repository path: {boundary}")
    if resolved.exists() and not resolved.is_dir():
        raise SystemExit(f"{option} must be a directory: {resolved}")
    if create:
        try:
            resolved.mkdir(parents=True, exist_ok=True)
            reread = resolved.resolve(strict=True)
        except OSError as exc:
            raise SystemExit(f"{option} cannot be created: {exc}") from exc
        if reread != resolved:
            for boundary in git_artifact_boundaries(repository_root):
                try:
                    reread.relative_to(boundary)
                except ValueError:
                    continue
                raise SystemExit(f"{option} symlink escapes into protected repository path: {boundary}")
            resolved = reread
    return str(resolved)


def artifact_root_for_run(run_id: str, repository_root: str, requested: str | None = None) -> str:
    if requested is None:
        for variable in ("MYRMEX_FRONTIER_ARTIFACT_ROOT", "MYRMEX_ARTIFACT_ROOT"):
            if variable in os.environ:
                requested = os.environ[variable]
                break
    if requested is None:
        # State may itself be configured inside a checked-out workspace during
        # tests or recovery. Do not derive transport files beneath that state
        # directory; use the stable user state namespace instead.
        requested = str(
            Path.home() / ".local" / "state" / "opencode" / "myrmex-orchestrator"
            / "frontier-artifacts" / run_id
        )
    return normalize_artifact_root(requested, repository_root)


def artifact_root_for_state(data: dict[str, Any]) -> str:
    stored = data.get("artifact_root")
    if stored is not None:
        return normalize_artifact_root(str(stored), str(data["repository_root"]))
    # v1/v2 historical runs predate this field. Keep them readable while making
    # their next transport operation use the same deterministic external path.
    return artifact_root_for_run(str(data["run_id"]), str(data["repository_root"]))


def validate_frontier_artifact_roots(data: dict[str, Any]) -> None:
    """Validate persisted root metadata without requiring old runs to migrate."""
    if data.get("artifact_root") is not None:
        normalize_artifact_root(str(data["artifact_root"]), str(data["repository_root"]))
    for operation in data.get("pending_operations", []):
        if not isinstance(operation, dict) or operation.get("kind") != "frontier_exchange":
            continue
        intent = operation.get("intent")
        if isinstance(intent, dict) and intent.get("artifact_root") is not None:
            normalize_artifact_root(str(intent["artifact_root"]), str(data["repository_root"]))


def normalize_allowed_paths(values: list[str] | None) -> list[str]:
    if not values:
        raise SystemExit("local_commit authorization requires at least one allowed path")
    normalized: list[str] = []
    for value in values:
        if not isinstance(value, str) or not value or "\\" in value:
            raise SystemExit("allowed paths must be non-empty POSIX-relative paths")
        path = Path(value)
        if path.is_absolute() or value.endswith("/") or any(part in {"", ".", ".."} for part in path.parts):
            raise SystemExit(f"invalid allowed path: {value!r}")
        candidate = path.as_posix()
        if candidate != value:
            raise SystemExit(f"allowed path is not normalized: {value!r}")
        if candidate == ".git" or candidate.startswith(".git/"):
            raise SystemExit("allowed paths cannot enter .git")
        name = path.name
        if name == ".env" or (name.startswith(".env.") and name != ".env.example"):
            raise SystemExit("allowed paths cannot include environment files")
        normalized.append(candidate)
    if len(set(normalized)) != len(normalized):
        raise SystemExit("allowed paths must be unique")
    return sorted(normalized)


def authorization_scope_digest(
    repository_root: str, branch: str, expected_head: str, allowed_paths: list[str], message: str,
    *, parent_run_id: str | None = None, work_unit_id: str | None = None,
    candidate_diff_sha: str | None = None,
) -> str:
    payload = {
        "repository_root": repository_root,
        "branch": branch,
        "expected_head": expected_head,
        "allowed_paths": allowed_paths,
        "commit_message": message,
    }
    if parent_run_id is not None:
        payload["parent_run_id"] = parent_run_id
    if work_unit_id is not None:
        payload["work_unit_id"] = work_unit_id
    if candidate_diff_sha is not None:
        payload["candidate_diff_sha"] = candidate_diff_sha
    encoded = json.dumps(payload, ensure_ascii=False, sort_keys=True, separators=(",", ":")).encode()
    return hashlib.sha256(encoded).hexdigest()


def authorization_id(authority: str, request_id: str, scope_digest: str) -> str:
    return "auth-" + hashlib.sha256((authority + "\0" + request_id + "\0" + scope_digest).encode()).hexdigest()[:24]


def validate_authorizations(data: dict[str, Any], *, required: bool) -> None:
    authorizations = data.get("authorizations")
    if authorizations is None and not required:
        return
    if not isinstance(authorizations, list):
        raise SystemExit("authorizations must be an array")
    seen: set[str] = set()
    requests: set[tuple[str, str]] = set()
    for authorization in authorizations:
        if not isinstance(authorization, dict):
            raise SystemExit("authorization must be an object")
        authorization_id_value = authorization.get("authorization_id")
        if not isinstance(authorization_id_value, str) or not AUTHORIZATION_ID_RE.fullmatch(authorization_id_value):
            raise SystemExit("authorization has an invalid authorization_id")
        if authorization_id_value in seen:
            raise SystemExit("authorization IDs must be unique")
        seen.add(authorization_id_value)
        if authorization.get("kind") != "local_commit":
            raise SystemExit("authorization kind must be local_commit")
        if authorization.get("authority") not in AUTHORIZATION_AUTHORITIES:
            raise SystemExit("invalid authorization authority")
        request_id = authorization.get("request_id")
        if not isinstance(request_id, str) or not request_id:
            raise SystemExit("authorization request_id is required")
        request_identity = (authorization["kind"], request_id)
        if request_identity in requests:
            raise SystemExit("authorization kind/request_id must be unique")
        requests.add(request_identity)
        repository_root = authorization.get("repository_root")
        if not isinstance(repository_root, str) or not Path(repository_root).is_absolute():
            raise SystemExit("authorization repository_root must be absolute")
        if repository_root != str(Path(repository_root).resolve()):
            raise SystemExit("authorization repository_root must be normalized")
        if not isinstance(authorization.get("branch"), str) or not authorization["branch"]:
            raise SystemExit("authorization branch is required")
        if not isinstance(authorization.get("expected_head"), str) or not GIT_SHA_RE.fullmatch(authorization["expected_head"]):
            raise SystemExit("authorization expected_head is invalid")
        allowed_paths = authorization.get("allowed_paths")
        if not isinstance(allowed_paths, list) or not allowed_paths:
            raise SystemExit("authorization allowed_paths must be a non-empty array")
        if allowed_paths != sorted(allowed_paths) or len(set(allowed_paths)) != len(allowed_paths):
            raise SystemExit("authorization allowed_paths must be sorted and unique")
        normalize_allowed_paths(allowed_paths)
        message = authorization.get("commit_message")
        if not isinstance(message, str) or not message:
            raise SystemExit("authorization commit_message is required")
        message_digest = authorization.get("commit_message_digest")
        if not isinstance(message_digest, str) or not SHA256_RE.fullmatch(message_digest):
            raise SystemExit("authorization commit_message_digest is invalid")
        if message_digest != hashlib.sha256(message.encode()).hexdigest():
            raise SystemExit("authorization commit_message_digest does not match commit_message")
        scope_digest = authorization.get("scope_digest")
        if not isinstance(scope_digest, str) or not SHA256_RE.fullmatch(scope_digest):
            raise SystemExit("authorization scope_digest is invalid")
        governed = authorization.get("grant_kind") == "governed" or "work_unit_id" in authorization
        parent_run_id = authorization.get("parent_run_id")
        work_unit_id = authorization.get("work_unit_id")
        candidate_diff_sha = authorization.get("candidate_diff_sha")
        if governed:
            if parent_run_id != data.get("run_id"):
                raise SystemExit("governed authorization parent_run_id must match the parent run")
            require_work_unit_id(work_unit_id)
            if not isinstance(candidate_diff_sha, str) or not SHA256_RE.fullmatch(candidate_diff_sha):
                raise SystemExit("governed authorization candidate_diff_sha is invalid")
            for key in ("source_operation_id", "source_request_id"):
                if not isinstance(authorization.get(key), str) or not authorization[key]:
                    raise SystemExit(f"governed authorization {key} is required")
            accepted_wu = authorization.get("accepted_work_unit")
            if not isinstance(accepted_wu, dict) or accepted_wu.get("work_unit_id") != work_unit_id:
                raise SystemExit("governed authorization accepted_work_unit is invalid")
            for key in ("repository_root", "branch"):
                if not isinstance(accepted_wu.get(key), str) or not accepted_wu[key]:
                    raise SystemExit(f"governed authorization accepted_work_unit {key} is required")
            if accepted_wu["repository_root"] != repository_root or accepted_wu["branch"] != authorization["branch"]:
                raise SystemExit("governed authorization target identity does not match accepted work unit")
            source_scope = authorization.get("source_scope")
            expected_source_scope = {
                "repository_root": repository_root,
                "branch": authorization["branch"],
                "expected_head": authorization["expected_head"],
                "candidate_diff_sha": candidate_diff_sha,
                "allowed_paths": allowed_paths,
                "commit_message": message,
            }
            if source_scope != expected_source_scope:
                raise SystemExit("governed authorization source_scope does not match grant identity")
        expected_scope = authorization_scope_digest(
            repository_root, authorization["branch"], authorization["expected_head"], allowed_paths, message,
            parent_run_id=parent_run_id if governed else None,
            work_unit_id=work_unit_id if governed else None,
            candidate_diff_sha=candidate_diff_sha if governed else None,
        )
        if scope_digest != expected_scope:
            raise SystemExit("authorization scope_digest does not match authorization scope")
        for key in ("max_uses", "consumed_uses"):
            if not isinstance(authorization.get(key), int) or authorization[key] < 0:
                raise SystemExit(f"authorization {key} must be non-negative")
        if authorization["max_uses"] != 1 or authorization["consumed_uses"] > authorization["max_uses"]:
            raise SystemExit("authorization use counts are invalid")
        if authorization.get("status") not in AUTHORIZATION_STATUSES:
            raise SystemExit("authorization has an invalid status")
        if authorization["status"] == "open" and authorization["consumed_uses"] >= authorization["max_uses"]:
            raise SystemExit("open authorization has no remaining use")
        if authorization["status"] == "consumed" and authorization["consumed_uses"] != authorization["max_uses"]:
            raise SystemExit("consumed authorization must have exhausted its uses")
        parse_authorization_expiry(authorization.get("expires_at"))
        for key in ("authorized_at",):
            if not isinstance(authorization.get(key), str) or not authorization[key]:
                raise SystemExit(f"authorization {key} is required")
            parse_authorization_expiry(authorization[key])
        consumed_at = authorization.get("consumed_at")
        if consumed_at is not None:
            parse_authorization_expiry(consumed_at)
        if authorization["status"] == "open" and consumed_at is not None:
            raise SystemExit("open authorization cannot have consumed_at")
        if authorization["status"] in {"consumed", "expired", "revoked"} and consumed_at is None:
            raise SystemExit("closed authorization requires consumed_at")


def validate_commit_policy_authorization(data: dict[str, Any], *, required: bool) -> None:
    standing = data.get("commit_policy_authorization")
    if standing is None:
        if required:
            raise SystemExit("governed commit policy requires a standing authorization")
        return
    if not isinstance(standing, dict):
        raise SystemExit("commit_policy_authorization must be an object or null")
    authorization_id_value = standing.get("authorization_id")
    if not isinstance(authorization_id_value, str) or not STANDING_AUTHORIZATION_ID_RE.fullmatch(authorization_id_value):
        raise SystemExit("standing commit policy authorization has an invalid authorization_id")
    if standing.get("authority") != STANDING_AUTHORITY:
        raise SystemExit("standing commit policy authorization requires human authority")
    for key in ("source_request_id", "authorized_at"):
        if not isinstance(standing.get(key), str) or not standing[key]:
            raise SystemExit(f"standing commit policy authorization {key} is required")
    parse_authorization_expiry(standing["authorized_at"])
    if standing.get("status") not in {"active", "revoked"}:
        raise SystemExit("standing commit policy authorization has an invalid status")
    scope = standing.get("scope")
    if not isinstance(scope, dict):
        raise SystemExit("standing commit policy authorization scope is required")
    expected_scope = {
        "parent_run_id": data.get("run_id"),
        "repository_root": data.get("repository_root"),
        "branch": data.get("branch"),
    }
    if any(scope.get(key) != value for key, value in expected_scope.items()):
        raise SystemExit("standing commit policy authorization scope does not match the parent")
    if not isinstance(scope.get("parent_objective"), str) or not scope["parent_objective"]:
        raise SystemExit("standing commit policy authorization parent objective is required")
    source = standing.get("source")
    if not isinstance(source, dict):
        raise SystemExit("standing commit policy authorization source is required")
    for key in ("operation_id", "request_id", "message_id", "work_unit_id", "response_type", "frontier_decision"):
        if not isinstance(source.get(key), str) or not source[key]:
            raise SystemExit(f"standing commit policy authorization source {key} is required")
    if source.get("request_id") != standing["source_request_id"]:
        raise SystemExit("standing commit policy authorization source request mismatch")
    if source.get("response_type") != "sub_objective_complete" or source.get("frontier_decision") != "ACCEPT":
        raise SystemExit("standing commit policy authorization requires SUB_OBJECTIVE_COMPLETE/ACCEPT evidence")
    accepted_wu = standing.get("accepted_work_unit")
    if not isinstance(accepted_wu, dict) or accepted_wu.get("work_unit_id") != source["work_unit_id"]:
        raise SystemExit("standing commit policy authorization accepted work unit is invalid")
    for key in ("repository_root", "branch"):
        if not isinstance(accepted_wu.get(key), str) or not accepted_wu[key]:
            raise SystemExit(f"standing commit policy authorization accepted work unit {key} is required")
    audit_history = standing.get("audit_history")
    if not isinstance(audit_history, list) or not audit_history:
        raise SystemExit("standing commit policy authorization audit_history is required")
    if not all(isinstance(entry, dict) for entry in audit_history):
        raise SystemExit("standing commit policy authorization audit_history entries must be objects")
    if data.get("commit_policy") == "governed" and standing.get("status") != "active" and data.get("status") not in TERMINAL_RUN_STATUSES:
        raise SystemExit("active governed commit policy requires an active standing authorization")


def write_state(data: dict[str, Any], expected_revision: int | None = None) -> dict[str, Any]:
    """Atomically write only v2 state.

    A v1 state is intentionally never upgraded as a side effect of an ordinary
    domain command.  `migrate` performs that conversion after creating a backup.
    """
    require_v2(data, "state write")
    ensure_v2_defaults(data)
    run_id = str(data["run_id"])
    path = run_dir(run_id) / "state.json"
    current_revision = -1
    if path.exists():
        current = json.loads(path.read_text(encoding="utf-8"))
        current_revision = int(current.get("revision", 0))
        if expected_revision is not None and current_revision != expected_revision:
            raise SystemExit(
                f"revision conflict for {run_id}: expected {expected_revision}, observed {current_revision}"
            )
    data["revision"] = current_revision + 1
    data["updated_at"] = utcnow()
    validate_state(data)
    atomic_write(path, data)
    latest = state_home() / "latest"
    latest.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix="latest.", suffix=".tmp", dir=latest.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write(run_id + "\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(tmp, 0o600)
        os.replace(tmp, latest)
    finally:
        try:
            os.unlink(tmp)
        except FileNotFoundError:
            pass
    return data


def validate_execution(data: dict[str, Any], *, required: bool) -> None:
    execution = data.get("execution")
    if execution is None and not required:
        return
    if not isinstance(execution, dict):
        raise SystemExit("execution must be an object")
    policy = execution.get("requested_policy")
    if policy not in EXECUTION_POLICIES:
        raise SystemExit("invalid requested execution policy")
    expected_route = EXECUTION_ROUTE[policy]
    if execution.get("effective_route") != expected_route or execution.get("effective_route") not in EFFECTIVE_ROUTES:
        raise SystemExit("invalid effective execution route")
    if not isinstance(execution.get("authority"), str) or not execution["authority"]:
        raise SystemExit("execution authority must be a non-empty string")
    if execution.get("request_id") is not None and not isinstance(execution["request_id"], str):
        raise SystemExit("execution request_id must be a string or null")
    source_digest = execution.get("source_digest")
    if source_digest is not None and (not isinstance(source_digest, str) or not SHA256_RE.fullmatch(source_digest)):
        raise SystemExit("execution source_digest must be a lowercase SHA-256 digest or null")
    if not isinstance(execution.get("set_at"), str) or not execution["set_at"]:
        raise SystemExit("execution set_at must be a timestamp string")
    resolved_at = execution.get("resolved_at")
    if policy == "unresolved":
        if execution.get("effective_route") != "unresolved":
            raise SystemExit("unresolved execution policy must use unresolved route")
        if resolved_at is not None:
            raise SystemExit("unresolved execution policy cannot have resolved_at")
        if execution.get("locked") is not False:
            raise SystemExit("unresolved execution policy cannot be locked")
    elif resolved_at is not None and (not isinstance(resolved_at, str) or not resolved_at):
        raise SystemExit("execution resolved_at must be a timestamp string or null")
    if not isinstance(execution.get("locked"), bool):
        raise SystemExit("execution locked must be boolean")


def normalize_frontier_transport_status(value: Any) -> str:
    if not isinstance(value, str) or not value.strip():
        raise SystemExit("Frontier transport_status must be a non-empty string")
    normalized = value.strip().lower().replace(" ", "_")
    normalized = FRONTIER_TRANSPORT_ALIASES.get(normalized, normalized)
    if normalized not in FRONTIER_TRANSPORT_STATUSES:
        raise SystemExit(f"invalid Frontier transport_status: {value!r}")
    return normalized


def normalize_effect_stage(value: Any) -> str:
    if not isinstance(value, str) or not value.strip():
        raise SystemExit("effect_stage must be none, transport_started, request_sent, or response_observed")
    normalized = value.strip().lower().replace("-", "_").replace(" ", "_")
    if normalized not in EFFECT_STAGES:
        raise SystemExit(f"invalid effect_stage: {value!r}")
    return normalized


def normalize_frontier_decision(value: Any, *, allow_none: bool = False) -> str | None:
    if value is None and allow_none:
        return None
    if not isinstance(value, str) or not value.strip():
        raise SystemExit("Frontier frontier_decision must be ACCEPT, REMEDIATE, or BLOCKED")
    normalized = value.strip().upper().replace("-", "_")
    if normalized not in FRONTIER_DECISIONS:
        raise SystemExit(f"invalid Frontier frontier_decision: {value!r}")
    return normalized


def normalize_frontier_response_type(value: Any, *, allow_none: bool = False) -> str | None:
    if value is None and allow_none:
        return None
    if not isinstance(value, str) or not value.strip():
        raise SystemExit("Frontier response_type is required")
    normalized = value.strip().lower().replace("-", "_").replace(" ", "_")
    if normalized not in FRONTIER_RESPONSE_TYPES:
        raise SystemExit(f"invalid Frontier response_type: {value!r}")
    return normalized


def frontier_message_id(source: Any) -> str | None:
    if not isinstance(source, dict):
        return None
    values = [source.get(key) for key in ("message_id", "response_message_id", "response_id") if source.get(key) is not None]
    if not values:
        return None
    if not all(isinstance(value, str) and value for value in values):
        return "<invalid>"
    if len(set(values)) != 1:
        return "<conflict>"
    return values[0]


def frontier_operation_identity(operation: dict[str, Any]) -> dict[str, str | None]:
    """Extract immutable Frontier identity without changing historical records."""
    sources = [operation.get("intent"), operation.get("effect"), operation.get("receipt")]
    request_id: str | None = None
    message_id: str | None = None
    task_id: str | None = None
    scope: str | None = None
    for source in sources:
        if not isinstance(source, dict):
            continue
        if request_id is None and isinstance(source.get("request_id"), str) and source["request_id"]:
            request_id = source["request_id"]
        source_message = frontier_message_id(source)
        if message_id is None and source_message not in {None, "<invalid>", "<conflict>"}:
            message_id = source_message
        if task_id is None and isinstance(source.get("task_id"), str) and source["task_id"]:
            task_id = source["task_id"]
        if scope is None and isinstance(source.get("scope"), str) and source["scope"]:
            scope = source["scope"]
    return {"request_id": request_id, "message_id": message_id, "task_id": task_id, "scope": scope}


def validate_frontier_typed_fields(operation: dict[str, Any]) -> None:
    """Validate additive Frontier transport/decision and recovery evidence."""
    if operation.get("kind") != "frontier_exchange":
        return
    effect_stage = operation.get("effect_stage")
    effective_effect_stage = operation.get("effective_effect_stage")
    if effect_stage is not None:
        normalize_effect_stage(effect_stage)
    if effective_effect_stage is not None:
        normalize_effect_stage(effective_effect_stage)
    if (
        effect_stage is not None
        and effective_effect_stage is not None
        and EFFECT_STAGE_ORDER[effective_effect_stage] < EFFECT_STAGE_ORDER[effect_stage]
    ):
        raise SystemExit("Frontier effective effect_stage cannot precede the original stage")
    if operation.get("pre_effect_absence_proven") is not None and not isinstance(
        operation["pre_effect_absence_proven"], bool
    ):
        raise SystemExit("Frontier pre_effect_absence_proven must be boolean")
    if operation.get("pre_effect_absence_proven") is True and effect_stage not in {None, "none"}:
        raise SystemExit("Frontier pre-effect absence proof requires effect_stage=none")
    if operation.get("pre_effect_absence_proven") is True:
        for source_name in ("effect", "receipt"):
            source = operation.get(source_name)
            if isinstance(source, dict) and frontier_message_id(source) is not None:
                raise SystemExit("Frontier pre-effect absence proof conflicts with message identity")
        if not frontier_resolution_evidence_complete(operation):
            raise SystemExit("Frontier pre-effect absence proof requires complete structured evidence")
    for field in ("transport_status", "effective_transport_status"):
        if field in operation and operation[field] is not None:
            normalize_frontier_transport_status(operation[field])
    for field in ("frontier_decision", "effective_frontier_decision"):
        if field in operation and operation[field] is not None:
            normalize_frontier_decision(operation[field])
    for field in ("response_type", "effective_response_type"):
        if field in operation and operation[field] is not None:
            normalize_frontier_response_type(operation[field])
    if operation.get("proposed_plan") is not None and not isinstance(operation.get("proposed_plan"), dict):
        raise SystemExit("Frontier proposed_plan must be an object")
    effective_status = operation.get("effective_status")
    if effective_status is not None and effective_status not in TERMINAL_OPERATION_STATUSES:
        raise SystemExit("Frontier effective_status must be a terminal operation status")
    history = operation.get("recovery_history", [])
    if not isinstance(history, list):
        raise SystemExit("Frontier recovery_history must be an array")
    recovery_ids: set[str] = set()
    for recovery in history:
        if not isinstance(recovery, dict):
            raise SystemExit("Frontier recovery entry must be an object")
        recovery_id = recovery.get("recovery_id")
        if not isinstance(recovery_id, str) or not re.fullmatch(r"recovery-[0-9a-f]{24}", recovery_id):
            raise SystemExit("Frontier recovery entry has an invalid recovery_id")
        if recovery_id in recovery_ids:
            raise SystemExit("Frontier recovery IDs must be unique")
        recovery_ids.add(recovery_id)
        normalize_frontier_transport_status(recovery.get("transport_status"))
        normalize_frontier_decision(recovery.get("frontier_decision"))
        if recovery.get("effective_status") not in TERMINAL_OPERATION_STATUSES:
            raise SystemExit("Frontier recovery effective_status must be terminal")
        for field in ("request_id", "message_id", "recorded_at"):
            if not isinstance(recovery.get(field), str) or not recovery[field]:
                raise SystemExit(f"Frontier recovery {field} is required")
        for field in ("effect", "receipt"):
            if not isinstance(recovery.get(field), dict):
                raise SystemExit(f"Frontier recovery {field} must be an object")
    if history and operation.get("effective_status") != history[-1].get("effective_status"):
        raise SystemExit("Frontier effective_status must match the latest recovery")
    effective_outcome = operation.get("effective_outcome")
    if effective_outcome is not None:
        if not isinstance(effective_outcome, dict):
            raise SystemExit("Frontier effective_outcome must be an object")
        for field in ("transport_status", "frontier_decision", "request_id", "message_id", "effect", "receipt"):
            if field not in effective_outcome:
                raise SystemExit(f"Frontier effective_outcome missing {field}")
        if effective_outcome.get("effect_stage") is not None:
            normalize_effect_stage(effective_outcome["effect_stage"])
        normalize_frontier_transport_status(effective_outcome["transport_status"])
        normalize_frontier_decision(effective_outcome["frontier_decision"])
        if not isinstance(effective_outcome["request_id"], str) or not isinstance(effective_outcome["message_id"], str):
            raise SystemExit("Frontier effective_outcome identity must be strings")
        if not isinstance(effective_outcome["effect"], dict) or not isinstance(effective_outcome["receipt"], dict):
            raise SystemExit("Frontier effective_outcome evidence must be objects")


def validate_pending_operations(data: dict[str, Any], *, required: bool) -> None:
    """Validate the durable side-effect ledger without interpreting effects.

    `required=False` accepts the first v2 shape that predates this additive
    ledger.  A mutating command hydrates it through ``ensure_v2_defaults``;
    reconciliation then treats legacy external identifiers conservatively.
    """
    operations = data.get("pending_operations")
    if operations is None and not required:
        return
    if not isinstance(operations, list):
        raise SystemExit("pending_operations must be an array")
    operation_ids: set[str] = set()
    idempotency: set[tuple[str, str]] = set()
    for operation in operations:
        if not isinstance(operation, dict):
            raise SystemExit("pending operation must be an object")
        operation_id = operation.get("operation_id")
        if not isinstance(operation_id, str) or not OPERATION_ID_RE.fullmatch(operation_id):
            raise SystemExit("pending operation has an invalid operation_id")
        if operation_id in operation_ids:
            raise SystemExit("pending operation IDs must be unique")
        operation_ids.add(operation_id)
        kind = operation.get("kind")
        if kind not in OPERATION_KINDS:
            raise SystemExit("pending operation has an invalid kind")
        key = operation.get("idempotency_key")
        if not isinstance(key, str) or not key:
            raise SystemExit("pending operation requires an idempotency_key")
        identity = (kind, key)
        if identity in idempotency:
            raise SystemExit("pending operation kind/idempotency_key must be unique")
        idempotency.add(identity)
        if operation.get("status") not in OPERATION_STATUSES:
            raise SystemExit("pending operation has an invalid status")
        if not isinstance(operation.get("intent"), dict):
            raise SystemExit("pending operation intent must be an object")
        for timestamp in ("created_at", "updated_at"):
            if not isinstance(operation.get(timestamp), str) or not operation[timestamp]:
                raise SystemExit(f"pending operation {timestamp} must be a timestamp string")
        effect = operation.get("effect")
        receipt = operation.get("receipt")
        if effect is not None and not isinstance(effect, dict):
            raise SystemExit("pending operation effect must be an object or null")
        if receipt is not None and not isinstance(receipt, dict):
            raise SystemExit("pending operation receipt must be an object or null")
        if operation["status"] == "intent" and (effect is not None or receipt is not None):
            raise SystemExit("intent operation cannot already have effect or receipt")
        if operation["status"] == "effect-observed" and effect is None:
            raise SystemExit("effect-observed operation requires effect")
        if operation["status"] == "receipt-recorded" and (effect is None or receipt is None):
            raise SystemExit("receipt-recorded operation requires effect and receipt")
        if operation["status"] == "confirmed" and (effect is None or receipt is None):
            raise SystemExit("confirmed operation requires observed effect and receipt")
        if operation["status"] in TERMINAL_OPERATION_STATUSES:
            if not isinstance(operation.get("confirmed_at"), str) or not operation["confirmed_at"]:
                raise SystemExit("terminal operation requires confirmed_at")
        elif operation.get("confirmed_at") is not None:
            raise SystemExit("non-terminal operation cannot have confirmed_at")
        reason = operation.get("terminal_reason")
        if reason is not None and not isinstance(reason, str):
            raise SystemExit("pending operation terminal_reason must be a string or null")
        effect_stage = operation.get("effect_stage")
        if effect_stage is not None:
            normalize_effect_stage(effect_stage)
        for link in ("predecessor_operation_id", "successor_operation_id"):
            link_value = operation.get(link)
            if link_value is not None and (
                not isinstance(link_value, str) or not OPERATION_ID_RE.fullmatch(link_value)
            ):
                raise SystemExit(f"pending operation {link} must be a valid operation ID or null")
        predecessor_ids = operation.get("predecessor_operation_ids")
        if predecessor_ids is not None and (
            not isinstance(predecessor_ids, list)
            or len(set(predecessor_ids)) != len(predecessor_ids)
            or not all(isinstance(item, str) and OPERATION_ID_RE.fullmatch(item) for item in predecessor_ids)
        ):
            raise SystemExit("pending operation predecessor_operation_ids must be unique operation IDs")
        attempt_group_id = operation.get("attempt_group_id")
        if attempt_group_id is not None and (
            not isinstance(attempt_group_id, str) or not ATTEMPT_GROUP_RE.fullmatch(attempt_group_id)
        ):
            raise SystemExit("pending operation attempt_group_id must be an attempt ID or null")
        terminal_disposition = operation.get("terminal_disposition")
        if terminal_disposition is not None and terminal_disposition not in {
            "completed_effect", "failed_attempt", "superseded", "abandoned", "ambiguous_effect",
        }:
            raise SystemExit("pending operation terminal_disposition is invalid")
        resolution_evidence = operation.get("resolution_evidence")
        if resolution_evidence is not None and not isinstance(resolution_evidence, dict):
            raise SystemExit("pending operation resolution_evidence must be an object or null")
        resolution_digest = operation.get("resolution_evidence_digest")
        if resolution_digest is not None and (not isinstance(resolution_digest, str) or not SHA256_RE.fullmatch(resolution_digest)):
            raise SystemExit("pending operation resolution_evidence_digest must be a lowercase SHA-256 digest")
        purpose_digest = operation.get("purpose_digest")
        if purpose_digest is not None:
            if not isinstance(purpose_digest, str) or not SHA256_RE.fullmatch(purpose_digest):
                raise SystemExit("pending operation purpose_digest must be a lowercase SHA-256 digest")
            if kind != "frontier_exchange":
                raise SystemExit("purpose_digest is restricted to frontier_exchange operations")
        validate_frontier_typed_fields(operation)


def validate_continuity_state(data: dict[str, Any]) -> None:
    """Validate additive continuous-parent evidence without rewriting old v2 runs."""
    gate = data.get("parent_gate")
    if gate is not None:
        if not isinstance(gate, dict):
            raise SystemExit("parent_gate must be an object or null")
        if gate.get("status") not in {"required", "requested", "confirmed", "blocked"}:
            raise SystemExit("parent_gate has an invalid status")
        completed = gate.get("completed_work_unit_id")
        if completed is not None:
            require_work_unit_id(completed)
        response_type = gate.get("response_type")
        if response_type is not None:
            normalize_frontier_response_type(response_type)
        for key in ("operation_id", "request_id", "message_id"):
            if gate.get(key) is not None and (not isinstance(gate[key], str) or not gate[key]):
                raise SystemExit(f"parent_gate {key} must be a non-empty string or null")
        for key in ("effect", "receipt"):
            if gate.get(key) is not None and not isinstance(gate[key], dict):
                raise SystemExit(f"parent_gate {key} must be an object or null")
        if gate.get("status") == "confirmed" and response_type is None:
            raise SystemExit("confirmed parent_gate requires an explicit response_type")
        if gate.get("status") == "required" and response_type is not None:
            raise SystemExit("required parent_gate cannot have a response_type")

    history = data.get("parent_gate_history", [])
    if not isinstance(history, list):
        raise SystemExit("parent_gate_history must be an array")
    for historic_gate in history:
        if not isinstance(historic_gate, dict):
            raise SystemExit("parent_gate_history entries must be objects")

    next_work_unit = data.get("next_work_unit")
    if next_work_unit is not None:
        if not isinstance(next_work_unit, dict):
            raise SystemExit("next_work_unit must be an object or null")
        work_unit_id = next_work_unit.get("work_unit_id")
        require_work_unit_id(work_unit_id)
        if next_work_unit.get("status") not in {"approved", "active", "complete"}:
            raise SystemExit("next_work_unit has an invalid status")
        if not isinstance(next_work_unit.get("intent"), dict):
            raise SystemExit("next_work_unit intent must be an object")
        provenance = next_work_unit.get("provenance")
        if not isinstance(provenance, dict):
            raise SystemExit("next_work_unit requires Frontier provenance")
        for key in ("operation_id", "request_id", "message_id"):
            if not isinstance(provenance.get(key), str) or not provenance[key]:
                raise SystemExit(f"next_work_unit provenance requires {key}")
        if next_work_unit.get("status") in {"approved", "active"}:
            if not isinstance(gate, dict) or gate.get("status") != "confirmed" or gate.get("response_type") != "plan":
                raise SystemExit("approved next_work_unit requires a confirmed Frontier plan gate")

    clarification = data.get("clarification")
    if clarification is not None:
        if not isinstance(clarification, dict):
            raise SystemExit("clarification must be an object or null")
        if clarification.get("status") not in {"blocked", "resumed"}:
            raise SystemExit("clarification has an invalid status")
        if not isinstance(clarification.get("resume_phase"), str) or clarification["resume_phase"] not in PHASES:
            raise SystemExit("clarification requires a valid resume_phase")
        if not isinstance(clarification.get("action"), dict):
            raise SystemExit("clarification requires a preserved action")

    pause = data.get("pause")
    if pause is not None:
        if not isinstance(pause, dict) or pause.get("status") not in {"paused", "resumed"}:
            raise SystemExit("pause must be a paused or resumed object")
        if not isinstance(pause.get("resume_phase"), str) or pause["resume_phase"] not in PHASES:
            raise SystemExit("pause requires a valid resume_phase")
        if not isinstance(pause.get("action"), dict):
            raise SystemExit("pause requires a preserved action")

    cancellation = data.get("cancellation")
    if cancellation is not None:
        if not isinstance(cancellation, dict):
            raise SystemExit("cancellation must be an object or null")
        if cancellation.get("type") not in {PARENT_CANCELLATION_TYPE, RUN_CANCELLATION_TYPE}:
            raise SystemExit("cancellation has an invalid type")

    if data.get("scope") == "continuous" and data.get("parent_objective"):
        live_units = [
            work_unit_id for work_unit_id, work_unit in data.get("work_units", {}).items()
            if isinstance(work_unit, dict) and work_unit.get("status") in {"active", "remediating"}
        ]
        if len(live_units) > 1:
            raise SystemExit("continuous parent may have at most one active work unit")
        if live_units and data.get("active_work_unit_id") != live_units[0]:
            raise SystemExit("active_work_unit_id must identify the only active continuous work unit")


def validate_common_state(data: dict[str, Any]) -> None:
    required = [
        "schema", "schema_version", "run_id", "objective_id", "objective", "scope",
        "mode", "phase", "status", "repository_root", "protected_dirty_paths",
        "commit_policy", "push_policy", "revision", "created_at", "updated_at",
    ]
    missing = [key for key in required if key not in data]
    if missing:
        raise SystemExit(f"state missing fields: {', '.join(missing)}")
    if (data["schema"], data["schema_version"]) not in SUPPORTED_SCHEMAS:
        raise SystemExit("unsupported state schema/version")
    validate_run_id(str(data["run_id"]))
    if data["scope"] not in {"narrow", "continuous"}:
        raise SystemExit("invalid scope")
    if data["mode"] not in {"interactive", "autonomous"}:
        raise SystemExit("invalid mode")
    if data["phase"] not in PHASES:
        raise SystemExit(f"invalid phase: {data['phase']}")
    if data["status"] not in STATUSES:
        raise SystemExit(f"invalid status: {data['status']}")
    expected_status = PHASE_STATUS[data["phase"]]
    if data["status"] != expected_status:
        raise SystemExit(
            f"invalid phase/status combination: {data['phase']}/{data['status']}; "
            f"expected {data['phase']}/{expected_status}"
        )
    if data["phase"] == "dormant" and data.get("blocker") is not None:
        raise SystemExit("dormant runs must clear blocker")
    if data["commit_policy"] not in POLICIES or data["push_policy"] not in POLICIES:
        raise SystemExit("invalid commit/push policy")
    if data.get("push_status") not in PUSH_STATUSES:
        raise SystemExit("invalid push_status")
    if data.get("memory_status") is not None and data["memory_status"] not in MEMORY_STATUSES:
        raise SystemExit("invalid memory_status")
    if not isinstance(data["protected_dirty_paths"], list) or not all(isinstance(x, str) for x in data["protected_dirty_paths"]):
        raise SystemExit("protected_dirty_paths must be an array of strings")
    if not isinstance(data.get("receipts"), dict):
        raise SystemExit("receipts must be an object")
    if not isinstance(data.get("delegation_ledger"), list):
        raise SystemExit("delegation_ledger must be an array")
    batches = data.get("delegation_batches", [])
    if not isinstance(batches, list):
        raise SystemExit("delegation_batches must be an array")
    for batch in batches:
        if not isinstance(batch, dict):
            raise SystemExit("delegation batch must be an object")
        if not isinstance(batch.get("batch_id"), str) or not batch["batch_id"]:
            raise SystemExit("delegation batch missing batch_id")
        task_ids = batch.get("task_ids")
        if not isinstance(task_ids, list) or not task_ids or not all(isinstance(item, str) and item for item in task_ids):
            raise SystemExit("delegation batch task_ids must be a non-empty array of strings")
        if len(set(task_ids)) != len(task_ids):
            raise SystemExit("delegation batch task_ids must be unique")
    if not isinstance(data.get("attempts"), dict):
        raise SystemExit("attempts must be an object")
    for key in ["scouts", "writers", "verifiers", "corrections"]:
        if not isinstance(data["attempts"].get(key), int) or data["attempts"][key] < 0:
            raise SystemExit(f"invalid attempt counter: {key}")
    if not isinstance(data.get("defect_history"), list):
        raise SystemExit("defect_history must be an array")
    if not isinstance(data.get("no_progress_cycles"), int) or data["no_progress_cycles"] < 0:
        raise SystemExit("no_progress_cycles must be a non-negative integer")
    if not isinstance(data.get("revision"), int) or data["revision"] < 0:
        raise SystemExit("revision must be a non-negative integer")


def validate_recovery_context(data: dict[str, Any]) -> None:
    recovery = data.get("recovery")
    if recovery is None:
        return
    if not isinstance(recovery, dict):
        raise SystemExit("recovery must be an object or null")
    code = recovery.get("code")
    if not isinstance(code, str) or not code:
        raise SystemExit("recovery code must be a non-empty string")
    status = recovery.get("status")
    if status not in {"blocked", "resolved"}:
        raise SystemExit("recovery status must be blocked or resolved")
    operation_ids = recovery.get("operation_ids", [])
    if not isinstance(operation_ids, list) or not all(
        isinstance(item, str) and OPERATION_ID_RE.fullmatch(item) for item in operation_ids
    ):
        raise SystemExit("recovery operation_ids must be operation IDs")
    resume_phase = recovery.get("resume_phase")
    if resume_phase is not None and (resume_phase not in PHASES or PHASE_STATUS[resume_phase] != "active"):
        raise SystemExit("recovery resume_phase must be an active phase or null")
    blocked_revision = recovery.get("blocked_at_revision")
    if blocked_revision is not None and (not isinstance(blocked_revision, int) or blocked_revision < 0):
        raise SystemExit("recovery blocked_at_revision must be a non-negative integer or null")
    evidence_digest = recovery.get("evidence_digest")
    if evidence_digest is not None and (not isinstance(evidence_digest, str) or not SHA256_RE.fullmatch(evidence_digest)):
        raise SystemExit("recovery evidence_digest must be a lowercase SHA-256 digest or null")
    remaining = recovery.get("remaining_operation_ids", [])
    if not isinstance(remaining, list) or len(set(remaining)) != len(remaining) or not all(
        isinstance(item, str) and OPERATION_ID_RE.fullmatch(item) for item in remaining
    ):
        raise SystemExit("recovery remaining_operation_ids must be unique operation IDs")
    for field in ("resolved_operation_id", "successor_operation_id"):
        value = recovery.get(field)
        if value is not None and (not isinstance(value, str) or not OPERATION_ID_RE.fullmatch(value)):
            raise SystemExit(f"recovery {field} must be an operation ID or null")
    recorded_at = recovery.get("recorded_at")
    if recorded_at is not None and (not isinstance(recorded_at, str) or not recorded_at):
        raise SystemExit("recovery recorded_at must be a timestamp string or null")
    resolved_at = recovery.get("resolved_at")
    if status == "resolved" and (not isinstance(resolved_at, str) or not resolved_at):
        raise SystemExit("resolved recovery requires resolved_at")
    if status == "blocked" and resolved_at is not None:
        raise SystemExit("blocked recovery cannot have resolved_at")


def validate_state(data: dict[str, Any]) -> None:
    validate_common_state(data)
    is_v2 = state_is_v2(data)
    validate_execution(data, required=is_v2)
    validate_recovery_context(data)
    validate_pending_operations(data, required=False)
    validate_frontier_artifact_roots(data)
    validate_authorizations(data, required=False)
    validate_commit_policy_authorization(data, required=data.get("commit_policy") == "governed")
    if not isinstance(data.get("budgets"), dict):
        raise SystemExit("budgets must be an object")
    validate_continuity_state(data)

    if not is_v2:
        for key in ["max_wait_seconds", "max_plan_iterations", "max_worker_corrections", "max_failover_chats"]:
            if not isinstance(data["budgets"].get(key), int) or data["budgets"][key] < 0:
                raise SystemExit(f"invalid budget: {key}")
        if data["budgets"]["max_wait_seconds"] < 30 or data["budgets"]["max_plan_iterations"] < 1:
            raise SystemExit("invalid frontier budgets")
        if data["attempts"]["corrections"] > data["budgets"]["max_worker_corrections"]:
            raise SystemExit("BLOCKED_CORRECTION_BUDGET")
        return

    for key in ["max_wait_seconds", "max_plan_iterations", "max_corrections_per_work_unit", "max_failover_chats"]:
        if not isinstance(data["budgets"].get(key), int) or data["budgets"][key] < 0:
            raise SystemExit(f"invalid budget: {key}")
    if data["budgets"]["max_wait_seconds"] < 30 or data["budgets"]["max_plan_iterations"] < 1:
        raise SystemExit("invalid frontier budgets")
    max_total = data["budgets"].get("max_total_corrections")
    if max_total is not None and (not isinstance(max_total, int) or max_total < 0):
        raise SystemExit("invalid budget: max_total_corrections")

    work_units = data.get("work_units")
    if not isinstance(work_units, dict):
        raise SystemExit("work_units must be an object")
    normal_total = 0
    legacy_total = 0
    for work_unit_id, work_unit in work_units.items():
        if not isinstance(work_unit_id, str) or not isinstance(work_unit, dict):
            raise SystemExit("work_units must map IDs to objects")
        status = work_unit.get("status")
        if work_unit_id == "__legacy__":
            if status != "legacy-ambiguous":
                raise SystemExit("__legacy__ work unit must be legacy-ambiguous")
            legacy_total = work_unit.get("corrections_used", -1)
        else:
            if not WORK_UNIT_ID_RE.fullmatch(work_unit_id):
                raise SystemExit(f"invalid work unit id: {work_unit_id!r}")
            if work_unit.get("work_unit_id") != work_unit_id:
                raise SystemExit("work unit key/id mismatch")
            if status not in WORK_UNIT_STATUSES - {"legacy-ambiguous"}:
                raise SystemExit("invalid work unit status")
            normal_total += work_unit.get("corrections_used", -1)
        for key in ["base_correction_limit", "corrections_used", "no_progress_cycles"]:
            if not isinstance(work_unit.get(key), int) or work_unit[key] < 0:
                raise SystemExit(f"invalid work unit {key}")

    active_work_unit_id = data.get("active_work_unit_id")
    if active_work_unit_id is not None and active_work_unit_id not in work_units:
        raise SystemExit("active_work_unit_id must reference a work unit")
    if active_work_unit_id == "__legacy__":
        raise SystemExit("__legacy__ cannot be active")

    remediation = data.get("remediation")
    if not isinstance(remediation, dict):
        raise SystemExit("remediation must be an object")
    total = remediation.get("total_corrections_used")
    if not isinstance(total, int) or total < 0:
        raise SystemExit("invalid remediation total_corrections_used")
    if remediation.get("max_total_corrections") != max_total:
        raise SystemExit("remediation max_total_corrections must match budgets")
    if total != normal_total + legacy_total or data["attempts"]["corrections"] != total:
        raise SystemExit("correction totals are inconsistent")
    if max_total is not None and total > max_total:
        raise SystemExit("BLOCKED_TOTAL_CORRECTION_BUDGET")
    grants = remediation.get("grants")
    if not isinstance(grants, list):
        raise SystemExit("remediation grants must be an array")
    grant_ids: set[str] = set()
    consumed_by_work_unit: dict[str, int] = {}
    for grant in grants:
        if not isinstance(grant, dict):
            raise SystemExit("remediation grant must be an object")
        grant_id = grant.get("grant_id")
        if not isinstance(grant_id, str) or not grant_id or grant_id in grant_ids:
            raise SystemExit("remediation grant_id must be unique")
        grant_ids.add(grant_id)
        if grant.get("authority") not in CORRECTION_AUTHORITIES:
            raise SystemExit("invalid remediation grant authority")
        work_unit_id = grant.get("work_unit_id")
        if work_unit_id not in work_units or work_unit_id == "__legacy__":
            raise SystemExit("remediation grant references unknown work unit")
        if not isinstance(grant.get("request_id"), str) or not grant["request_id"]:
            raise SystemExit("remediation grant request_id is required")
        if not isinstance(grant.get("verification_request_id"), str) or not grant["verification_request_id"]:
            raise SystemExit("remediation grant verification_request_id is required")
        if not isinstance(grant.get("defect_revision"), int) or grant["defect_revision"] < 0:
            raise SystemExit("remediation grant defect_revision must be a non-negative integer")
        if not isinstance(grant.get("scope_digest"), str) or not SHA256_RE.fullmatch(grant["scope_digest"]):
            raise SystemExit("remediation grant scope_digest must be lowercase SHA-256")
        if not isinstance(grant.get("source_candidate_sha"), str) or not GIT_SHA_RE.fullmatch(grant["source_candidate_sha"]):
            raise SystemExit("remediation grant source_candidate_sha is invalid")
        expected_grant_id = correction_grant_id(
            grant["authority"], grant["request_id"], work_unit_id, grant["scope_digest"],
            grant["source_candidate_sha"], grant["verification_request_id"], grant["defect_revision"],
        )
        if grant["grant_id"] != expected_grant_id:
            raise SystemExit("remediation grant_id does not match its immutable identity")
        for key in ["granted_attempts", "consumed_attempts"]:
            if not isinstance(grant.get(key), int) or grant[key] < 0:
                raise SystemExit(f"invalid remediation grant {key}")
        if grant["consumed_attempts"] > grant["granted_attempts"]:
            raise SystemExit("remediation grant over-consumed")
        if grant.get("status") not in {"open", "consumed", "expired", "revoked"}:
            raise SystemExit("invalid remediation grant status")
        if grant["status"] == "open" and grant["consumed_attempts"] >= grant["granted_attempts"]:
            raise SystemExit("open remediation grant has no remaining use")
        if grant["status"] == "consumed" and grant["consumed_attempts"] != grant["granted_attempts"]:
            raise SystemExit("consumed remediation grant must have exhausted its uses")
        consumed_by_work_unit[work_unit_id] = consumed_by_work_unit.get(work_unit_id, 0) + grant["consumed_attempts"]
    for work_unit_id, work_unit in work_units.items():
        if work_unit_id == "__legacy__":
            continue
        if work_unit["corrections_used"] > work_unit["base_correction_limit"] + consumed_by_work_unit.get(work_unit_id, 0):
            raise SystemExit("work unit correction count exceeds authorized capacity")

    blocked = remediation.get("blocked")
    if blocked is not None:
        if not isinstance(blocked, dict):
            raise SystemExit("remediation blocked must be an object or null")
        scope = blocked.get("scope")
        if scope not in {"work_unit", "run", "legacy-ambiguous"}:
            raise SystemExit("invalid remediation blocker scope")
        if data["phase"] != "blocked" or data["status"] != "blocked":
            raise SystemExit("remediation blocker requires blocked run")
        if scope == "work_unit":
            if data.get("blocker") != "BLOCKED_CORRECTION_BUDGET" or blocked.get("work_unit_id") not in work_units:
                raise SystemExit("invalid work-unit correction blocker")
            if not isinstance(blocked.get("source_request_id"), str) or not blocked["source_request_id"]:
                raise SystemExit("work-unit correction blocker requires source_request_id")
            if blocked.get("verification_request_id") != blocked["source_request_id"]:
                raise SystemExit("work-unit correction blocker verification request identity mismatch")
            if not isinstance(blocked.get("defect_revision"), int) or blocked["defect_revision"] < 0:
                raise SystemExit("work-unit correction blocker requires defect_revision")
            if not isinstance(blocked.get("scope_digest"), str) or not SHA256_RE.fullmatch(blocked["scope_digest"]):
                raise SystemExit("work-unit correction blocker requires scope_digest")
            if not isinstance(blocked.get("source_candidate_sha"), str) or not GIT_SHA_RE.fullmatch(blocked["source_candidate_sha"]):
                raise SystemExit("work-unit correction blocker requires source_candidate_sha")
        elif scope == "run":
            if data.get("blocker") != "BLOCKED_TOTAL_CORRECTION_BUDGET" or blocked.get("work_unit_id") is not None:
                raise SystemExit("invalid run correction blocker")
        elif blocked.get("work_unit_id") is not None:
            raise SystemExit("legacy correction blocker cannot identify a work unit")
    elif data.get("blocker") in {"BLOCKED_CORRECTION_BUDGET", "BLOCKED_TOTAL_CORRECTION_BUDGET"}:
        raise SystemExit("correction blocker requires remediation context")

def latest_run() -> str:
    marker = state_home() / "latest"
    if marker.is_file():
        value = marker.read_text(encoding="utf-8").strip()
        if value and (runs_dir() / value / "state.json").is_file():
            return value
    candidates = sorted(
        (p for p in runs_dir().glob("*/state.json") if p.is_file()),
        key=lambda p: p.stat().st_mtime,
        reverse=True,
    ) if runs_dir().is_dir() else []
    if not candidates:
        raise SystemExit("no Myrmex runs found")
    return candidates[0].parent.name


def parse_scalar(value: str) -> Any:
    try:
        return json.loads(value)
    except json.JSONDecodeError:
        return value


def set_dotted(target: dict[str, Any], key: str, value: Any) -> None:
    if not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_.-]*", key):
        raise SystemExit(f"invalid patch key: {key}")
    parts = key.split(".")
    current: dict[str, Any] = target
    for part in parts[:-1]:
        existing = current.get(part)
        if existing is None:
            existing = {}
            current[part] = existing
        if not isinstance(existing, dict):
            raise SystemExit(f"cannot descend into non-object patch key: {key}")
        current = existing
    current[parts[-1]] = value


def ensure_patch_key_is_allowed(key: str) -> None:
    """Reject generic writes to state-machine-owned fields.

    This check intentionally runs before `set_dotted`: allowing a parent or a
    child path would otherwise make the protected list trivially bypassable.
    """
    root = key.split(".", 1)[0]
    if root in PROTECTED_PATCH_PATHS:
        raise SystemExit(
            f"patch cannot modify protected state path: {key}; use a typed domain command"
        )


def append_event(run_id: str, event_type: str, message: str | None, data: Any) -> dict[str, Any]:
    directory = run_dir(run_id)
    if not (directory / "state.json").is_file():
        raise SystemExit(f"run not found: {run_id}")
    event = {
        "timestamp": utcnow(),
        "run_id": run_id,
        "type": event_type,
        "message": message,
        "data": data,
    }
    path = directory / "events.jsonl"
    path.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(path, os.O_APPEND | os.O_CREAT | os.O_WRONLY, 0o600)
    try:
        os.write(fd, (json.dumps(event, ensure_ascii=False, sort_keys=True) + "\n").encode())
        os.fsync(fd)
    finally:
        os.close(fd)
    return event


def cmd_doctor(args: argparse.Namespace) -> int:
    root = state_home()
    errors: list[str] = []
    warnings: list[str] = []
    try:
        root.mkdir(parents=True, exist_ok=True)
        test = root / ".write-test"
        test.write_text("ok\n", encoding="utf-8")
        test.unlink()
    except Exception as exc:
        errors.append(f"state directory is not writable: {exc}")
    invalid_runs: list[str] = []
    if runs_dir().is_dir():
        for path in runs_dir().glob("*/state.json"):
            try:
                data = json.loads(path.read_text(encoding="utf-8"))
                changes: list[str] = []
                if not state_is_v2(data):
                    # Normalize only the in-memory diagnostic copy.  A read or
                    # doctor run never upgrades the on-disk v1 state.
                    changes = normalize_legacy_state(data)
                validate_state(data)
                if not state_is_v2(data):
                    detail = f"; normalizations available: {', '.join(changes)}" if changes else ""
                    warnings.append(f"{path.parent.name}: v1 state requires explicit `myrmex-state migrate {path.parent.name}`{detail}")
            except BaseException as exc:  # validate_state raises SystemExit
                invalid_runs.append(f"{path.parent.name}: {exc}")
    if invalid_runs:
        warnings.extend(invalid_runs)
    result = {
        "ok": not errors,
        "schema": SCHEMA,
        "state_home": str(root),
        "runs": len(list(runs_dir().glob("*/state.json"))) if runs_dir().is_dir() else 0,
        "warnings": warnings,
        "errors": errors,
    }
    print(json.dumps(result, indent=2))
    return 0 if not errors else 1


def cmd_init(args: argparse.Namespace) -> int:
    if args.commit_policy == "governed":
        raise SystemExit("commit_policy=governed requires commit-policy authorize")
    if bool(args.objective) == bool(args.objective_file):
        raise SystemExit("provide exactly one of --objective or --objective-file")
    objective = args.objective
    if args.objective_file:
        objective = Path(args.objective_file).expanduser().read_text(encoding="utf-8").strip()
    assert objective is not None
    if not objective.strip():
        raise SystemExit("objective cannot be empty")
    if args.execution_source_digest is not None and not SHA256_RE.fullmatch(args.execution_source_digest):
        raise SystemExit("--execution-source-digest must be a lowercase SHA-256 digest")
    if args.execution_policy == "direct-only" and args.execution_authority not in {None, "user"}:
        raise SystemExit("direct-only execution policy requires user authority")
    repo = str(Path(args.repository_root).expanduser().resolve())
    now = utcnow()
    run_id = args.run_id or (
        "myrmex-" + dt.datetime.now(dt.timezone.utc).strftime("%Y%m%dT%H%M%SZ") + "-" + slug(objective) + "-" + secrets.token_hex(3)
    )
    validate_run_id(run_id)
    artifact_root = artifact_root_for_run(run_id, repo, args.artifact_root)
    directory = run_dir(run_id)
    if directory.exists():
        raise SystemExit(f"run already exists: {run_id}")
    objective_id = hashlib.sha256((repo + "\0" + objective.strip()).encode()).hexdigest()[:20]
    data: dict[str, Any] = {
        "schema": SCHEMA_V2,
        "schema_version": 2,
        "run_id": run_id,
        "objective_id": objective_id,
        "objective": objective.strip(),
        "parent_objective": args.parent_objective,
        "scope": args.scope,
        "mode": args.mode,
        "phase": "initializing",
        "status": "active",
        "repository_root": repo,
        "artifact_root": artifact_root,
        "branch": args.branch,
        "base_sha": args.base_sha,
        "protected_dirty_paths": args.protected_dirty_path or [],
        "commit_policy": args.commit_policy,
        "push_policy": args.push_policy,
        "frontier_chat_url": args.chat_url,
        "frontier_task_id": None,
        "last_request_id": None,
        "last_outbound_digest": None,
        "last_response_digest": None,
        "plan_revision": 0,
        "worker_task_id": None,
        "verification_revision": 0,
        "commit_sha": None,
        "push_status": "not_requested" if args.push_policy == "deny" else "unauthorized",
        "execution": {
            "requested_policy": args.execution_policy,
            "effective_route": EXECUTION_ROUTE[args.execution_policy],
            "authority": (args.execution_authority or ("system" if args.execution_policy == "unresolved" else "prompt")),
            "request_id": args.execution_request_id,
            "source_digest": args.execution_source_digest,
            "set_at": now,
            "resolved_at": None if args.execution_policy == "unresolved" else now,
            "locked": args.execution_policy == "direct-only",
        },
        "blocker": None,
        "budgets": {
            "max_wait_seconds": args.max_wait_seconds,
            "max_plan_iterations": args.max_plan_iterations,
            "max_corrections_per_work_unit": (
                args.legacy_max_worker_corrections
                if args.legacy_max_worker_corrections is not None
                else args.max_corrections_per_work_unit
            ),
            "max_total_corrections": args.max_total_corrections,
            "max_failover_chats": args.max_failover_chats,
        },
        "receipts": {},
        "pending_operations": [],
        "authorizations": [],
        "commit_policy_authorization": None,
        "delegation_ledger": [],
        "delegation_batches": [],
        "attempts": {"scouts": 0, "writers": 0, "verifiers": 0, "corrections": 0},
        "defect_history": [],
        "no_progress_cycles": 0,
        "active_work_unit_id": None,
        "work_units": {},
        "remediation": {
            "total_corrections_used": 0,
            "max_total_corrections": args.max_total_corrections,
            "grants": [],
            "blocked": None,
        },
        "parent_gate": None,
        "parent_gate_history": [],
        "next_work_unit": None,
        "clarification": None,
        "pause": None,
        "cancellation": None,
        "recovery": None,
        "revision": -1,
        "created_at": now,
        "updated_at": now,
    }
    directory.mkdir(parents=True, exist_ok=False)
    (directory / "artifacts").mkdir()
    write_state(data)
    append_event(run_id, "run.initialized", "Myrmex run initialized", {"mode": args.mode, "scope": args.scope})
    print(run_id)
    return 0


def cmd_show(args: argparse.Namespace) -> int:
    run_id = args.run_id or latest_run()
    print(json.dumps(read_state(run_id), indent=2, ensure_ascii=False, sort_keys=True))
    return 0


def cmd_list(args: argparse.Namespace) -> int:
    rows: list[dict[str, Any]] = []
    if runs_dir().is_dir():
        for path in runs_dir().glob("*/state.json"):
            try:
                data = json.loads(path.read_text(encoding="utf-8"))
                if args.status and data.get("status") != args.status:
                    continue
                rows.append({key: data.get(key) for key in ["run_id", "status", "phase", "mode", "scope", "objective", "updated_at"]})
            except Exception:
                continue
    rows.sort(key=lambda row: str(row.get("updated_at") or ""), reverse=True)
    if args.limit:
        rows = rows[: args.limit]
    print(json.dumps(rows, indent=2, ensure_ascii=False))
    return 0


def cmd_patch(args: argparse.Namespace) -> int:
    data = read_state(args.run_id)
    require_v2(data, "patch")
    require_active_run(data, "patch")
    if args.json_patch:
        patch = json.loads(args.json_patch)
        if not isinstance(patch, dict):
            raise SystemExit("--json-patch must be an object")
        for key, value in patch.items():
            ensure_patch_key_is_allowed(key)
            set_dotted(data, key, value)
    for item in args.set or []:
        if "=" not in item:
            raise SystemExit(f"--set requires key=value: {item}")
        key, value = item.split("=", 1)
        ensure_patch_key_is_allowed(key)
        set_dotted(data, key, parse_scalar(value))
    saved = write_state(data, args.expect_revision)
    append_event(args.run_id, "state.patched", None, {"revision": saved["revision"], "keys": args.set or []})
    print(json.dumps(saved, indent=2, ensure_ascii=False, sort_keys=True))
    return 0


def cmd_transition(args: argparse.Namespace) -> int:
    """Move an active run through one explicit state-machine transition.

    Completion and cancellation keep their dedicated commands because they
    have additional ordering and audit semantics. A blocked run also cannot be
    reopened here: a future domain-specific recovery command must prove the
    authority and scope for that operation.
    """
    data = read_state(args.run_id)
    require_v2(data, "transition")
    if data["revision"] != args.expect_revision:
        raise SystemExit(
            f"revision conflict for {args.run_id}: expected {args.expect_revision}, observed {data['revision']}"
        )
    if data["status"] != "active":
        raise SystemExit("transition requires an active run; use the applicable recovery or terminal command")
    target_phase = args.to_phase
    target_status = PHASE_STATUS[target_phase]
    if target_status not in {"active", "blocked"}:
        raise SystemExit("transition only supports active phases or an explicit blocked state")
    if target_status == "blocked" and not args.blocker:
        raise SystemExit("--blocker is required when transitioning to blocked")
    if target_status == "active" and args.blocker:
        raise SystemExit("--blocker is valid only when transitioning to blocked")

    if data["phase"] == target_phase and data.get("blocker") == args.blocker:
        print(json.dumps(data, indent=2, ensure_ascii=False, sort_keys=True))
        return 0
    if target_status == "active" and target_phase not in ALLOWED_ACTIVE_TRANSITIONS[data["phase"]]:
        raise SystemExit(f"invalid state transition: {data['phase']} -> {target_phase}")

    previous_phase = data["phase"]
    data["phase"] = target_phase
    data["status"] = target_status
    data["blocker"] = args.blocker if target_status == "blocked" else None
    if target_status == "blocked":
        operation_ids = args.recovery_operation_id or []
        if args.recovery_code is not None:
            if args.recovery_resume_phase is not None and args.recovery_resume_phase != previous_phase:
                raise SystemExit("--recovery-resume-phase must match the phase being blocked")
            if args.recovery_evidence_digest is not None and not SHA256_RE.fullmatch(args.recovery_evidence_digest):
                raise SystemExit("--recovery-evidence-digest must be a lowercase SHA-256 digest")
            data["recovery"] = {
                "code": args.recovery_code,
                "status": "blocked",
                "operation_ids": operation_ids,
                "blocked_at_revision": data["revision"] + 1,
                "resume_phase": previous_phase,
                "evidence_digest": args.recovery_evidence_digest,
                "recorded_at": utcnow(),
            }
        else:
            data["recovery"] = None
    else:
        data["recovery"] = None
    saved = write_state(data, args.expect_revision)
    append_event(args.run_id, "state.transitioned", args.reason, {
        "from_phase": previous_phase,
        "to_phase": target_phase,
        "to_status": target_status,
        "blocker": data["blocker"],
        "recovery": data.get("recovery"),
        "reason": args.reason,
        "revision": saved["revision"],
    })
    print(json.dumps(saved, indent=2, ensure_ascii=False, sort_keys=True))
    return 0


TERMINAL_RUN_STATUSES = {"dormant", "failed", "cancelled", "superseded"}


def require_active_run(data: dict[str, Any], command: str) -> None:
    """Reject new domain work after a run has stopped being active."""
    if data.get("status") != "active":
        raise SystemExit(f"{command} requires an active run")


def require_nonterminal_run(data: dict[str, Any], command: str) -> None:
    """Permit typed recovery of an existing blocker, never terminal revival."""
    if data.get("status") in TERMINAL_RUN_STATUSES:
        raise SystemExit(f"{command} cannot modify a terminal run")


def require_batch_collect_allowed(data: dict[str, Any], batch: dict[str, Any]) -> None:
    """Allow collection only for active work or its own missing-result recovery.

    A delayed child result must not clear an unrelated human, policy, or safety
    blocker just because it completes a batch.  The one existing blocked-run
    exception is the batch's own missing-result state, whose purpose is to
    accept the late terminal result it explicitly awaited.
    """
    require_nonterminal_run(data, "delegation-batch collect")
    if data.get("status") == "active":
        return
    if (
        data.get("status") == "blocked"
        and data.get("phase") == "blocked"
        and data.get("blocker") == "BLOCKED_MISSING_DELEGATION_RESULT"
        and batch.get("status") == "blocked"
    ):
        return
    raise SystemExit("delegation-batch collect cannot clear an unrelated blocker")


def active_task_ids(data: dict[str, Any]) -> list[str]:
    """Return task IDs whose last persisted delegation record is non-terminal."""
    latest: dict[str, str] = {}
    for entry in data.get("delegation_ledger", []):
        if not isinstance(entry, dict):
            continue
        task_id = entry.get("task_id")
        status = entry.get("status")
        if isinstance(task_id, str) and task_id and isinstance(status, str):
            latest[task_id] = status
    return sorted(task_id for task_id, status in latest.items() if status == "started")


def route_change_blockers(data: dict[str, Any]) -> list[str]:
    """Identify persisted work that must be reconciled before switching to direct."""
    blockers: list[str] = []
    tasks = active_task_ids(data)
    if tasks:
        blockers.append("active delegation tasks: " + ", ".join(tasks))
    # Older state files may contain a started record from before task IDs were
    # mandatory.  It is still live work even though we cannot name it, so it
    # must block a direct-only route change rather than being silently ignored.
    anonymous_started = sum(
        1 for entry in data.get("delegation_ledger", [])
        if isinstance(entry, dict)
        and entry.get("status") == "started"
        and not (isinstance(entry.get("task_id"), str) and entry["task_id"])
    )
    if anonymous_started:
        blockers.append(f"anonymous active delegation records: {anonymous_started}")
    incomplete_batches = [
        str(batch.get("batch_id")) for batch in data.get("delegation_batches", [])
        if isinstance(batch, dict) and batch.get("status") not in {"proceeded", "blocked"}
    ]
    if incomplete_batches:
        blockers.append("incomplete delegation batches: " + ", ".join(incomplete_batches))
    pending_operations = data.get("pending_operations")
    frontier_operations = [
        operation for operation in pending_operations or []
        if isinstance(operation, dict) and operation.get("kind") == "frontier_exchange"
    ] if isinstance(pending_operations, list) else []
    frontier_identity = bool(data.get("frontier_task_id") or data.get("last_request_id"))
    if (
        data.get("phase") == "waiting-for-frontier"
        or any(operation.get("status") not in TERMINAL_OPERATION_STATUSES for operation in frontier_operations)
        # An external identity without any matching operation is incomplete
        # whether it predates the ledger or was partially written by a crash.
        or (frontier_identity and not frontier_operations)
    ):
        blockers.append("frontier exchange is pending")
    if isinstance(pending_operations, list) and any(
        isinstance(operation, dict)
        and operation.get("kind") != "frontier_exchange"
        and operation.get("status") not in TERMINAL_OPERATION_STATUSES
        for operation in pending_operations
    ):
        blockers.append("external operation is pending")
    return blockers


def has_confirmed_frontier_plan(data: dict[str, Any]) -> bool:
    return any(
        isinstance(operation, dict)
        and operation.get("kind") == "frontier_exchange"
        and operation_is_effectively_confirmed(operation)
        and (operation.get("frontier_decision") or operation.get("effective_frontier_decision")) == "ACCEPT"
        and (operation.get("response_type") == "plan" or operation.get("effective_response_type") == "plan")
        for operation in data.get("pending_operations", [])
    )


def ensure_route_allows(data: dict[str, Any], action: str) -> None:
    """Enforce the persisted execution policy at stateful effect boundaries."""
    policy = data["execution"]["requested_policy"]
    if policy == "unresolved":
        raise SystemExit("BLOCKED_EXECUTION_POLICY_UNRESOLVED")
    if policy == "direct-only":
        if action in {"delegation", "frontier"}:
            raise SystemExit("BLOCKED_DELEGATION_FORBIDDEN_BY_EXECUTION_POLICY")
        raise SystemExit(f"unsupported execution-policy action: {action}")
    if policy == "frontier-gated" and action == "delegation" and not has_confirmed_frontier_plan(data):
        raise SystemExit("BLOCKED_FRONTIER_PLAN_REQUIRED_BY_EXECUTION_POLICY")


def resolve_route_positionals(args: argparse.Namespace) -> tuple[str, str]:
    """Accept both documented `route set RUN_ID` and legacy `route RUN_ID set`.

    The command is used in persisted runbooks, so accepting the legacy order
    avoids a compatibility break while making the canonical typed-command form
    match the rest of the state CLI.
    """
    actions = {"set", "assert"}
    first = args.first
    second = args.second
    if first in actions and second not in actions:
        return second, first
    if second in actions and first not in actions:
        return first, second
    raise SystemExit("route syntax is `myrmex-state route set RUN_ID` (legacy `route RUN_ID set` is also accepted)")


def cmd_route(args: argparse.Namespace) -> int:
    run_id, route_action = resolve_route_positionals(args)
    data = read_state(run_id)
    require_v2(data, "route")
    if route_action == "assert":
        if data["revision"] != args.expect_revision:
            raise SystemExit(
                f"revision conflict for {run_id}: expected {args.expect_revision}, observed {data['revision']}"
            )
        if args.action is None:
            raise SystemExit("--action is required for route assert")
        ensure_route_allows(data, args.action)
        print(json.dumps(data["execution"], indent=2, ensure_ascii=False, sort_keys=True))
        return 0

    if args.policy is None or args.authority is None or args.request_id is None:
        raise SystemExit("route set requires --policy, --authority, and --request-id")
    current = data["execution"]
    policy = args.policy
    if policy == "unresolved":
        raise SystemExit("route set cannot persist unresolved; choose an execution policy")
    if args.source_digest is not None and not SHA256_RE.fullmatch(args.source_digest):
        raise SystemExit("--source-digest must be a lowercase SHA-256 digest")
    target_identity = {
        "requested_policy": policy,
        "effective_route": EXECUTION_ROUTE[policy],
        "authority": args.authority,
        "request_id": args.request_id,
        "source_digest": args.source_digest if args.source_digest is not None else current.get("source_digest"),
        "locked": policy == "direct-only",
    }
    # A retry of the exact request is harmless and must remain idempotent even
    # if the caller only retained the revision from its original attempt.
    if all(current.get(key) == value for key, value in target_identity.items()):
        print(json.dumps(data, indent=2, ensure_ascii=False, sort_keys=True))
        return 0
    if data["revision"] != args.expect_revision:
        raise SystemExit(
            f"revision conflict for {run_id}: expected {args.expect_revision}, observed {data['revision']}"
        )
    if data["status"] != "active":
        raise SystemExit("route changes require an active run")
    if policy == "direct-only" and args.authority != "user":
        raise SystemExit("direct-only execution policy requires --authority user")
    # `direct-only` is a user lock, not merely a policy value.  In particular,
    # do not let a later actor rewrite its provenance by re-setting the same
    # policy without an explicit user override.
    if current["locked"] and not args.override_locked:
        raise SystemExit("BLOCKED_EXECUTION_POLICY_LOCKED")
    if current["locked"] and args.authority != "user":
        raise SystemExit("only user authority may override a locked execution policy")
    if policy == "direct-only":
        blockers = route_change_blockers(data)
        if blockers:
            raise SystemExit("BLOCKED_ROUTE_CHANGE_PENDING_WORK: " + "; ".join(blockers))

    resolved_at = utcnow()
    target = {
        **target_identity,
        "set_at": resolved_at,
        "resolved_at": resolved_at,
    }
    previous = dict(current)
    data["execution"] = target
    saved = write_state(data, args.expect_revision)
    append_event(run_id, "execution.route_set", None, {
        "previous": previous,
        "current": target,
        "revision": saved["revision"],
    })
    print(json.dumps(saved, indent=2, ensure_ascii=False, sort_keys=True))
    return 0


def parse_object_json(value: str | None, option: str, *, default: dict[str, Any] | None = None) -> dict[str, Any]:
    if value is None:
        return dict(default or {})
    try:
        parsed = json.loads(value)
    except json.JSONDecodeError as exc:
        raise SystemExit(f"invalid {option}: {exc}") from exc
    if not isinstance(parsed, dict):
        raise SystemExit(f"{option} must be an object")
    return sanitize_evidence(parsed)


FRONTIER_METADATA_KEYS = {
    "artifact_root", "blocker", "chat_url", "clarification", "frontier_decision",
    "message_id", "poll_count", "proposed_plan", "recovery_actions", "request_id",
    "response_digest", "response_id", "response_message_id", "response_type", "scope",
    "stable", "status", "task_id", "transport_status", "type", "work_unit_id",
    "repository_root", "branch", "expected_head", "candidate_diff_sha",
    "allowed_paths", "commit_message", "effect_stage", "pre_effect_absence_proven",
    "browser_tab_opened", "outbound_request_observed", "request_sent",
}


def sanitize_frontier_payload(source: dict[str, Any]) -> dict[str, Any]:
    """Persist transport metadata only; never retain raw browser response data."""
    return sanitize_evidence({key: source[key] for key in FRONTIER_METADATA_KEYS if key in source})


def response_type_from_sources(*sources: Any) -> str | None:
    values: list[str] = []
    for source in sources:
        if isinstance(source, str):
            values.append(normalize_frontier_response_type(source))
            continue
        if not isinstance(source, dict):
            continue
        candidate = source.get("response_type")
        if candidate is None and isinstance(source.get("type"), str):
            candidate = source["type"]
        if candidate is None and isinstance(source.get("status"), str):
            status_candidate = source["status"].strip().lower().replace("-", "_").replace(" ", "_")
            if status_candidate in FRONTIER_RESPONSE_TYPES or status_candidate.upper() in {
                value.upper() for value in FRONTIER_RESPONSE_TYPES
            }:
                candidate = status_candidate
        if candidate is None and isinstance(source.get("proposed_plan") or source.get("plan"), dict):
            candidate = "plan"
        if candidate is not None:
            values.append(normalize_frontier_response_type(candidate))  # type: ignore[arg-type]
    if not values:
        return None
    if len(set(values)) != 1:
        raise SystemExit("Frontier response_type mismatch")
    return values[0]


PRE_EFFECT_EVIDENCE_KEYS = ("browser_tab_opened", "outbound_request_observed", "request_sent")


def pre_effect_absence_evidence_complete(effect: Any, receipt: Any) -> bool:
    """Require complete, consistent no-effect evidence from every source.

    Absence is never inferred.  Every available effect and receipt source must
    explicitly record ``browser_tab_opened=false``,
    ``outbound_request_observed=false`` and ``request_sent=false``; the sources
    must agree; and no message identity may exist.  Missing fields, any
    ``true``, a contradiction, or a message_id keep the exchange ambiguous.
    """
    for source in (effect, receipt):
        if not isinstance(source, dict):
            return False
        for key in PRE_EFFECT_EVIDENCE_KEYS:
            value = source.get(key)
            if value is not True and value is not False:
                return False
            if value is True:
                return False
    for key in PRE_EFFECT_EVIDENCE_KEYS:
        if effect.get(key) != receipt.get(key):
            return False
    if frontier_message_id(effect) is not None or frontier_message_id(receipt) is not None:
        return False
    return True


def pre_effect_absence_proven(
    args: argparse.Namespace, effect: dict[str, Any], receipt: dict[str, Any],
) -> bool:
    """Authority assertion plus complete structured evidence; never inferred.

    ``--pre-effect-absence-proven`` asserts the operator's authority; it never
    manufactures evidence.  The flag is validated against the supplied effect
    and receipt, which must carry the full no-effect marker set.
    """
    if not bool(getattr(args, "pre_effect_absence_proven", False)):
        return False
    return pre_effect_absence_evidence_complete(effect, receipt)


def requested_effect_stage(
    args: argparse.Namespace, *, status: str, message_id: str | None,
    effect: dict[str, Any], receipt: dict[str, Any],
) -> str:
    explicit = getattr(args, "effect_stage", None)
    if explicit is not None:
        return normalize_effect_stage(explicit)
    if status == "success":
        return "response_observed"
    if message_id is None and pre_effect_absence_proven(args, effect, receipt):
        return "none"
    # A failed exchange with an identity is at least request-sent.  A failure
    # without one is still conservatively transport-started until the caller
    # supplies an explicit absence proof.
    return "request_sent" if message_id else "transport_started"


def proposed_plan_from_sources(*sources: Any) -> dict[str, Any] | None:
    plans: list[dict[str, Any]] = []
    for source in sources:
        if not isinstance(source, dict):
            continue
        candidate = source.get("proposed_plan")
        if candidate is None:
            candidate = source.get("plan")
        if candidate is not None:
            if not isinstance(candidate, dict):
                raise SystemExit("Frontier proposed_plan must be an object")
            plans.append(sanitize_evidence(candidate))
    if not plans:
        return None
    if any(plan != plans[0] for plan in plans[1:]):
        raise SystemExit("Frontier proposed_plan mismatch")
    return plans[0]


def operation_id(kind: str, idempotency_key: str) -> str:
    return "op-" + hashlib.sha256((kind + "\0" + idempotency_key).encode()).hexdigest()[:24]


def require_nonempty_string(value: Any, label: str) -> str:
    if not isinstance(value, str) or not value.strip():
        raise SystemExit(f"{label} must be a non-empty string")
    return value


def require_delivery_repo(value: Any, label: str = "delivery repo") -> str:
    repo = require_nonempty_string(value, label)
    if not GITHUB_REPO_RE.fullmatch(repo):
        raise SystemExit(f"{label} must be an owner/name GitHub repository")
    return repo


def require_delivery_sha(value: Any, label: str) -> str:
    if not isinstance(value, str) or not SHA256_RE.fullmatch(value):
        raise SystemExit(f"{label} must be a lowercase SHA-256 digest")
    return value


def tracking_issue_identity_marker(objective_id: str, scope_digest: str) -> str:
    return f"<!-- myrmex:tracking objective_id={objective_id} scope_digest={scope_digest} -->"


def canonical_delivery_url(repo: str, resource: str, number: Any) -> str:
    if not isinstance(number, int) or isinstance(number, bool) or number < 1:
        raise SystemExit(f"delivery {resource} number must be a positive integer")
    expected = f"https://github.com/{repo}/{resource}/{number}"
    pattern = GITHUB_ISSUE_URL_RE if resource == "issues" else GITHUB_PR_URL_RE
    return expected if pattern.fullmatch(expected) else ""


def validate_delivery_url(value: Any, repo: str, resource: str, number: Any, label: str) -> str:
    url = require_nonempty_string(value, label)
    expected = canonical_delivery_url(repo, resource, number)
    if url != expected:
        raise SystemExit(f"{label} does not match the persisted {resource[:-1]} identity")
    return url


def delivery_operation_issue_identity(
    operation: dict[str, Any], *, require_confirmed: bool = True,
) -> tuple[str, int, str, str]:
    """Return the exact approved issue identity from a confirmed operation."""
    valid_statuses = {"confirmed"} if require_confirmed else {"receipt-recorded", "confirmed"}
    if operation.get("kind") != "tracking_issue" or operation.get("status") not in valid_statuses:
        raise SystemExit("PULL_REQUEST_TRACKING_ISSUE_NOT_CONFIRMED")
    intent = operation.get("intent")
    if not isinstance(intent, dict):
        raise SystemExit("TRACKING_ISSUE_INTENT_INVALID")
    repo = require_delivery_repo(intent.get("repo"), "tracking issue intent repo")
    objective_id = require_nonempty_string(intent.get("objective_id"), "tracking issue objective_id")
    scope_digest = require_delivery_sha(intent.get("scope_digest"), "tracking issue scope_digest")
    identity = tracking_issue_identity_marker(objective_id, scope_digest)
    if intent.get("identity_marker", identity) != identity:
        raise SystemExit("TRACKING_ISSUE_IDENTITY_MARKER_MISMATCH")
    receipt = operation.get("receipt")
    effect = operation.get("effect")
    if not isinstance(receipt, dict) or not isinstance(effect, dict):
        raise SystemExit("PULL_REQUEST_TRACKING_ISSUE_NOT_CONFIRMED")
    status = receipt_status(receipt)
    if status not in TRACKING_ISSUE_APPROVED_STATUSES:
        raise SystemExit("PULL_REQUEST_TRACKING_ISSUE_NOT_APPROVED")
    if receipt.get("approved") is not True:
        raise SystemExit("PULL_REQUEST_TRACKING_ISSUE_NOT_APPROVED")
    if receipt.get("approval_marker") != intent.get("approval_marker"):
        raise SystemExit("TRACKING_ISSUE_APPROVAL_MARKER_MISMATCH")
    number = receipt.get("number")
    if number is None:
        number = effect.get("number")
    url = receipt.get("url")
    if url is None:
        url = effect.get("url")
    url = validate_delivery_url(url, repo, "issues", number, "tracking issue URL")
    if receipt.get("number") is not None and receipt.get("number") != number:
        raise SystemExit("TRACKING_ISSUE_RECEIPT_IDENTITY_MISMATCH")
    if effect.get("number") is not None and effect.get("number") != number:
        raise SystemExit("TRACKING_ISSUE_EFFECT_IDENTITY_MISMATCH")
    if receipt.get("url") is not None and receipt.get("url") != url:
        raise SystemExit("TRACKING_ISSUE_RECEIPT_IDENTITY_MISMATCH")
    if effect.get("url") is not None and effect.get("url") != url:
        raise SystemExit("TRACKING_ISSUE_EFFECT_IDENTITY_MISMATCH")
    return repo, int(number), url, identity


def delivery_policy_digest(policy: dict[str, Any]) -> str:
    payload = {key: value for key, value in policy.items() if key != "policy_digest"}
    return hashlib.sha256(json.dumps(
        payload, ensure_ascii=False, sort_keys=True, separators=(",", ":"),
    ).encode()).hexdigest()


def recompute_delivery_policy(data: dict[str, Any], policy: dict[str, Any]) -> dict[str, Any]:
    inputs = policy.get("inputs")
    if not isinstance(inputs, dict) or set(inputs) != {"run_authorization", "repository_config", "installation_profile"}:
        raise SystemExit("TRACKING_ISSUE_POLICY_INPUTS_INVALID")
    command = [
        sys.executable,
        str(Path(__file__).resolve().parents[1] / "scripts" / "resolve-delivery-policy.py"),
        "--repository-root", str(data["repository_root"]),
        "--mode", str(policy.get("mode")),
    ]
    for key, option in (
        ("run_authorization", "--run-authorization-file"),
        ("repository_config", "--repository-config"),
        ("installation_profile", "--installation-profile"),
    ):
        value = inputs.get(key)
        if value is None:
            continue
        if not isinstance(value, str) or not value or not Path(value).is_absolute() or str(Path(value).resolve()) != value:
            raise SystemExit("TRACKING_ISSUE_POLICY_INPUT_PATH_INVALID")
        command.extend([option, value])
    try:
        result = subprocess.run(
            command, capture_output=True, text=True, stdin=subprocess.DEVNULL, timeout=20,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise SystemExit("TRACKING_ISSUE_POLICY_RECOMPUTE_FAILED") from exc
    if result.returncode != 0:
        raise SystemExit("TRACKING_ISSUE_POLICY_RECOMPUTE_FAILED")
    try:
        recomputed = json.loads(result.stdout)
    except json.JSONDecodeError as exc:
        raise SystemExit("TRACKING_ISSUE_POLICY_RECOMPUTE_MALFORMED") from exc
    if not isinstance(recomputed, dict):
        raise SystemExit("TRACKING_ISSUE_POLICY_RECOMPUTE_MALFORMED")
    if recomputed != policy:
        raise SystemExit("TRACKING_ISSUE_POLICY_RESOLUTION_MISMATCH")
    return recomputed


def validate_resolved_delivery_policy(data: dict[str, Any], intent: dict[str, Any]) -> dict[str, Any]:
    policy = intent.get("policy")
    if not isinstance(policy, dict) or policy.get("schema") != DELIVERY_POLICY_SCHEMA:
        raise SystemExit("tracking_issue intent requires a resolved delivery policy")
    expected_policy_keys = {
        "schema", "repository_root", "mode", "delivery", "decision", "policy_digest", "provenance", "inputs",
    }
    if set(policy) != expected_policy_keys:
        raise SystemExit("TRACKING_ISSUE_POLICY_FIELDS_INVALID")
    if policy.get("repository_root") != data.get("repository_root"):
        raise SystemExit("TRACKING_ISSUE_POLICY_REPOSITORY_MISMATCH")
    if policy.get("mode") != data.get("mode"):
        raise SystemExit("TRACKING_ISSUE_POLICY_MODE_MISMATCH")
    policy_digest = require_delivery_sha(intent.get("policy_digest"), "tracking issue policy_digest")
    if policy.get("policy_digest") != policy_digest or delivery_policy_digest(policy) != policy_digest:
        raise SystemExit("TRACKING_ISSUE_POLICY_DIGEST_MISMATCH")
    recompute_delivery_policy(data, policy)
    delivery = policy.get("delivery")
    effective = delivery.get("tracking_issue") if isinstance(delivery, dict) else None
    if not isinstance(effective, dict) or set(TRACKING_POLICY_KEYS) - set(effective):
        raise SystemExit("TRACKING_ISSUE_POLICY_FIELDS_MISSING")
    if set(effective) != set(TRACKING_POLICY_KEYS):
        raise SystemExit("TRACKING_ISSUE_POLICY_FIELDS_UNEXPECTED")
    for key in TRACKING_POLICY_KEYS:
        if key == "approval_marker":
            marker = require_nonempty_string(effective.get(key), f"resolved policy {key}")
            if marker != marker.strip() or len(marker) > 128 or any(char in marker for char in "\r\n\0"):
                raise SystemExit("TRACKING_ISSUE_POLICY_MARKER_INVALID")
        elif type(effective.get(key)) is not bool:
            raise SystemExit(f"resolved policy {key} must be boolean")
    decision = policy.get("decision")
    if not isinstance(decision, dict):
        raise SystemExit("TRACKING_ISSUE_POLICY_DECISION_MISSING")
    if set(decision) != {"on_missing_tracking_issue", "on_ambiguous_match", "creation_policy"}:
        raise SystemExit("TRACKING_ISSUE_POLICY_DECISION_FIELDS_INVALID")
    mode = policy["mode"]
    expected_missing = "not-required" if not effective["required"] else (
        "create" if mode == "autonomous" and effective["create_when_missing"] else "ask"
    )
    expected_creation = "deny" if not effective["required"] else (
        "authorized" if expected_missing == "create" else "ask"
    )
    expected_decision = {
        "on_missing_tracking_issue": expected_missing,
        "on_ambiguous_match": "ask" if effective["ask_on_ambiguous_match"] else "block",
        "creation_policy": expected_creation,
    }
    if decision != expected_decision:
        raise SystemExit("TRACKING_ISSUE_POLICY_DECISION_MISMATCH")
    intent_fields = {
        "required": effective["required"],
        "reuse_matching_approved": effective["reuse_matching_approved"],
        "create_when_missing": effective["create_when_missing"],
        "approval_marker": effective["approval_marker"],
        "ask_on_ambiguous_match": effective["ask_on_ambiguous_match"],
        "creation_policy": decision["creation_policy"],
    }
    if any(intent.get(key) != value for key, value in intent_fields.items()):
        raise SystemExit("TRACKING_ISSUE_POLICY_INTENT_MISMATCH")
    if intent.get("ensure_approval") is not effective["required"]:
        raise SystemExit("TRACKING_ISSUE_POLICY_APPROVAL_MISMATCH")
    return policy


def validate_tracking_issue_intent(data: dict[str, Any], intent: dict[str, Any]) -> dict[str, Any]:
    normalized = dict(intent)
    if type(normalized.get("required")) is not bool:
        raise SystemExit("tracking_issue intent requires boolean required")
    repo = require_delivery_repo(normalized.get("repo"), "tracking issue intent repo")
    title = require_nonempty_string(normalized.get("title"), "tracking issue intent title")
    body_file = require_nonempty_string(normalized.get("body_file"), "tracking issue intent body_file")
    receipt_file = require_nonempty_string(normalized.get("receipt_file"), "tracking issue intent receipt_file")
    objective_id = require_nonempty_string(normalized.get("objective_id"), "tracking issue intent objective_id")
    if not WORK_UNIT_ID_RE.fullmatch(objective_id):
        raise SystemExit("tracking issue intent objective_id contains unsafe marker characters")
    scope_digest = require_delivery_sha(normalized.get("scope_digest"), "tracking issue intent scope_digest")
    approval_marker = require_nonempty_string(normalized.get("approval_marker"), "tracking issue intent approval_marker")
    if any(char in approval_marker for char in "\r\n\0") or approval_marker != approval_marker.strip() or len(approval_marker) > 128:
        raise SystemExit("tracking issue intent approval_marker is invalid")
    creation_policy = normalized.get("creation_policy")
    if creation_policy not in POLICIES:
        raise SystemExit("tracking issue intent creation_policy must be deny, ask, or authorized")
    if type(normalized.get("ensure_approval")) is not bool:
        raise SystemExit("tracking_issue intent requires boolean ensure_approval")
    identity = tracking_issue_identity_marker(objective_id, scope_digest)
    if normalized.get("identity_marker", identity) != identity:
        raise SystemExit("tracking_issue intent identity_marker does not match objective scope")
    normalized.update({
        "repo": repo,
        "title": title,
        "body_file": body_file,
        "receipt_file": receipt_file,
        "objective_id": objective_id,
        "scope_digest": scope_digest,
        "approval_marker": approval_marker,
        "identity_marker": identity,
    })
    policy = validate_resolved_delivery_policy(data, normalized)
    normalized["policy"] = policy
    return normalized


def exact_issue_url_token(body: str, issue_url: str) -> bool:
    pattern = re.compile(r"(?<![A-Za-z0-9._-])" + re.escape(issue_url) + r"(?![A-Za-z0-9._/?#-])")
    return pattern.search(body) is not None


def validate_pull_request_intent(data: dict[str, Any], intent: dict[str, Any]) -> dict[str, Any]:
    normalized = dict(intent)
    if type(normalized.get("required")) is not bool:
        raise SystemExit("pull_request intent requires boolean required")
    repo = require_delivery_repo(normalized.get("repo"), "pull request intent repo")
    head = require_nonempty_string(normalized.get("head"), "pull request intent head")
    base = require_nonempty_string(normalized.get("base"), "pull request intent base")
    title = require_nonempty_string(normalized.get("title"), "pull request intent title")
    body_file = require_nonempty_string(normalized.get("body_file"), "pull request intent body_file")
    receipt_file = require_nonempty_string(normalized.get("receipt_file"), "pull request intent receipt_file")
    tracking_operation_id = normalized.get("tracking_issue_operation_id")
    if not isinstance(tracking_operation_id, str) or not OPERATION_ID_RE.fullmatch(tracking_operation_id):
        raise SystemExit("pull_request intent requires tracking_issue_operation_id")
    tracking_operation = find_operation(data, tracking_operation_id)
    tracking_repo, issue_number, issue_url, identity = delivery_operation_issue_identity(tracking_operation)
    if tracking_repo != repo:
        raise SystemExit("PULL_REQUEST_TRACKING_REPOSITORY_MISMATCH")
    if "tracking_issue_number" in normalized and normalized["tracking_issue_number"] != issue_number:
        raise SystemExit("PULL_REQUEST_TRACKING_ISSUE_IDENTITY_MISMATCH")
    if "tracking_issue_url" in normalized and normalized["tracking_issue_url"] != issue_url:
        raise SystemExit("PULL_REQUEST_TRACKING_ISSUE_IDENTITY_MISMATCH")
    if "tracking_issue_identity_marker" in normalized and normalized["tracking_issue_identity_marker"] != identity:
        raise SystemExit("PULL_REQUEST_TRACKING_ISSUE_IDENTITY_MISMATCH")
    try:
        body = Path(body_file).expanduser().resolve().read_text(encoding="utf-8")
    except OSError as exc:
        raise SystemExit(f"pull request body_file cannot be read: {body_file}") from exc
    markers = TRACKING_BODY_LINK_RE.findall(body)
    if markers and any(marker != issue_url for marker in markers):
        raise SystemExit("PULL_REQUEST_BODY_TRACKING_ISSUE_MISMATCH")
    if not exact_issue_url_token(body, issue_url):
        raise SystemExit("PULL_REQUEST_BODY_MISSING_TRACKING_ISSUE")
    body_digest = normalized.get("body_digest")
    if body_digest is None:
        raise SystemExit("pull_request intent requires body_digest")
    require_delivery_sha(body_digest, "pull request intent body_digest")
    if body_digest != hashlib.sha256(body.encode()).hexdigest():
        raise SystemExit("PULL_REQUEST_BODY_DIGEST_MISMATCH")
    label = normalized.get("label")
    if label is not None:
        require_nonempty_string(label, "pull request intent label")
    normalized.update({
        "repo": repo,
        "head": head,
        "base": base,
        "title": title,
        "body_file": body_file,
        "receipt_file": receipt_file,
        "tracking_issue_number": issue_number,
        "tracking_issue_url": issue_url,
        "tracking_issue_identity_marker": identity,
    })
    return normalized


def validate_pull_request_body(intent: dict[str, Any], label: str) -> str:
    body_file = require_nonempty_string(intent.get("body_file"), "pull request intent body_file")
    body_digest = require_delivery_sha(intent.get("body_digest"), "pull request intent body_digest")
    issue_url = require_nonempty_string(intent.get("tracking_issue_url"), "pull request tracking issue URL")
    try:
        body = Path(body_file).expanduser().resolve().read_text(encoding="utf-8")
    except OSError as exc:
        raise SystemExit(f"pull request body_file cannot be read during {label}: {body_file}") from exc
    if hashlib.sha256(body.encode()).hexdigest() != body_digest:
        raise SystemExit(f"PULL_REQUEST_BODY_DIGEST_MISMATCH_DURING_{label.upper()}")
    markers = TRACKING_BODY_LINK_RE.findall(body)
    if any(marker != issue_url for marker in markers) or not exact_issue_url_token(body, issue_url):
        raise SystemExit(f"PULL_REQUEST_BODY_TRACKING_ISSUE_MISMATCH_DURING_{label.upper()}")
    return body


def pull_request_identity(operation: dict[str, Any], payload: dict[str, Any], label: str) -> tuple[int, str]:
    intent = operation.get("intent")
    if not isinstance(intent, dict):
        raise SystemExit("pull_request operation intent is invalid")
    number = payload.get("number")
    url = validate_delivery_url(payload.get("url"), intent["repo"], "pull", number, f"pull request {label} URL")
    return int(number), url


def validate_pull_request_effect_receipt_identity(operation: dict[str, Any], payload: dict[str, Any]) -> None:
    effect = operation.get("effect")
    if not isinstance(effect, dict):
        return
    effect_identity = pull_request_identity(operation, effect, "effect")
    payload_identity = pull_request_identity(operation, payload, "receipt")
    if effect_identity != payload_identity:
        raise SystemExit("PULL_REQUEST_EFFECT_RECEIPT_IDENTITY_MISMATCH")


def validate_delivery_payload(operation: dict[str, Any], payload: dict[str, Any], label: str) -> None:
    """Bind helper artifacts to the typed operation intent and issue identity."""
    kind = operation.get("kind")
    intent = operation.get("intent")
    if not isinstance(intent, dict):
        raise SystemExit(f"{kind} operation intent is invalid")
    if kind == "tracking_issue":
        marker = intent.get("identity_marker")
        if payload.get("identity_marker") != marker:
            raise SystemExit(f"tracking issue {label} identity marker mismatch")
        if payload.get("repo") != intent.get("repo"):
            raise SystemExit(f"tracking issue {label} repository mismatch")
        if payload.get("approval_marker") != intent.get("approval_marker"):
            raise SystemExit(f"tracking issue {label} approval marker mismatch")
        number = payload.get("number")
        if number is not None:
            validate_delivery_url(payload.get("url"), intent["repo"], "issues", number, f"tracking issue {label} URL")
    elif kind == "pull_request":
        validate_pull_request_body(intent, label)
        if payload.get("repo") != intent.get("repo"):
            raise SystemExit(f"pull request {label} repository mismatch")
        if payload.get("head") != intent.get("head") or payload.get("base") != intent.get("base"):
            raise SystemExit(f"pull request {label} branch identity mismatch")
        pull_request_identity(operation, payload, label)


def validate_delivery_confirmation(operation: dict[str, Any], terminal_status: str) -> None:
    if terminal_status != "confirmed":
        return
    kind = operation.get("kind")
    if kind == "tracking_issue":
        delivery_operation_issue_identity(operation, require_confirmed=False)
    elif kind == "pull_request":
        intent = operation.get("intent")
        effect = operation.get("effect")
        receipt = operation.get("receipt")
        if not isinstance(intent, dict) or not isinstance(effect, dict) or not isinstance(receipt, dict):
            raise SystemExit("PULL_REQUEST_CONFIRMATION_REQUIRES_TYPED_RECEIPT")
        if receipt_status(receipt) not in PULL_REQUEST_SUCCESS_STATUSES:
            raise SystemExit("PULL_REQUEST_RECEIPT_NOT_SUCCESSFUL")
        if receipt.get("repo") != intent.get("repo") or receipt.get("head") != intent.get("head") or receipt.get("base") != intent.get("base"):
            raise SystemExit("PULL_REQUEST_RECEIPT_IDENTITY_MISMATCH")
        number = receipt.get("number") if receipt.get("number") is not None else effect.get("number")
        url = receipt.get("url") if receipt.get("url") is not None else effect.get("url")
        validate_delivery_url(url, intent["repo"], "pull", number, "pull request URL")
        validate_delivery_payload(operation, effect, "effect")
        validate_delivery_payload(operation, receipt, "receipt")
        validate_pull_request_effect_receipt_identity(operation, receipt)


def find_operation(data: dict[str, Any], operation_id_value: str) -> dict[str, Any]:
    if not isinstance(operation_id_value, str) or not OPERATION_ID_RE.fullmatch(operation_id_value):
        raise SystemExit("--operation-id must be a valid operation ID")
    for operation in data.get("pending_operations", []):
        if isinstance(operation, dict) and operation.get("operation_id") == operation_id_value:
            return operation
    raise SystemExit(f"operation not found: {operation_id_value}")


def find_operation_by_identity(data: dict[str, Any], kind: str, idempotency_key: str) -> dict[str, Any] | None:
    for operation in data.get("pending_operations", []):
        if (
            isinstance(operation, dict)
            and operation.get("kind") == kind
            and operation.get("idempotency_key") == idempotency_key
        ):
            return operation
    return None


def existing_frontier_identity(
    data: dict[str, Any], *, request_id: str, task_id: str, message_id: str | None,
    scope: str | None, chat_url: str | None, intent: dict[str, Any],
) -> dict[str, Any] | None:
    """Return an exact prior Frontier identity, or reject an attempted reuse."""
    incoming = dict(intent)
    for operation in data.get("pending_operations", []):
        if not isinstance(operation, dict) or operation.get("kind") != "frontier_exchange":
            continue
        identity = frontier_operation_identity(operation)
        if identity["request_id"] != request_id:
            continue
        if identity["task_id"] is not None and identity["task_id"] != task_id:
            raise SystemExit("FRONTIER_REQUEST_IDENTITY_CONFLICT")
        if identity["message_id"] is not None and message_id is not None and identity["message_id"] != message_id:
            raise SystemExit("FRONTIER_REQUEST_IDENTITY_CONFLICT")
        if identity["scope"] is not None and scope is not None and identity["scope"] != scope:
            raise SystemExit("FRONTIER_REQUEST_IDENTITY_CONFLICT")
        existing_intent = operation.get("intent")
        if not isinstance(existing_intent, dict):
            raise SystemExit("FRONTIER_REQUEST_IDENTITY_CONFLICT")
        # A caller may learn the response message after the original send. It
        # must still reuse that exchange rather than creating a second send.
        if message_id is None:
            incoming.pop("message_id", None)
            existing_compare = dict(existing_intent)
            existing_compare.pop("message_id", None)
        else:
            existing_compare = existing_intent
        if chat_url is None:
            incoming.pop("chat_url", None)
            existing_compare = dict(existing_compare)
            existing_compare.pop("chat_url", None)
        if "artifact_root" not in existing_compare:
            legacy_compare = dict(existing_compare)
            legacy_compare.pop("artifact_root", None)
            incoming_compare = dict(incoming)
            incoming_compare.pop("artifact_root", None)
        else:
            legacy_compare = existing_compare
            incoming_compare = incoming
        if legacy_compare != incoming_compare:
            raise SystemExit("FRONTIER_REQUEST_IDENTITY_CONFLICT")
        return operation
    return None


def nonterminal_operations(data: dict[str, Any], kind: str | None = None) -> list[dict[str, Any]]:
    return [
        operation for operation in data.get("pending_operations", [])
        if isinstance(operation, dict)
        and operation.get("status") not in TERMINAL_OPERATION_STATUSES
        and (kind is None or operation.get("kind") == kind)
    ]


def require_operation_route(data: dict[str, Any], kind: str) -> None:
    if kind == "frontier_exchange":
        ensure_route_allows(data, "frontier")
    elif kind == "delegation":
        ensure_route_allows(data, "delegation")


def record_operation_intent(
    data: dict[str, Any], *, kind: str, idempotency_key: str, intent: dict[str, Any],
) -> tuple[dict[str, Any], bool]:
    """Create one idempotent durable side-effect intent in memory.

    The caller owns the state write so it can atomically add the companion
    task/frontier identity before returning control to an external tool.
    """
    if kind not in OPERATION_KINDS:
        raise SystemExit("invalid operation kind")
    if not isinstance(idempotency_key, str) or not idempotency_key.strip():
        raise SystemExit("--idempotency-key must be a non-empty string")
    normalized_intent = sanitize_evidence(intent)
    identity = operation_id(kind, idempotency_key)
    existing = find_operation_by_identity(data, kind, idempotency_key)
    if existing is not None:
        if existing.get("operation_id") != identity or existing.get("intent") != normalized_intent:
            raise SystemExit("OPERATION_IDEMPOTENCY_CONFLICT")
        return existing, False
    now = utcnow()
    operation = {
        "operation_id": identity,
        "kind": kind,
        "idempotency_key": idempotency_key,
        "status": "intent",
        "effect_stage": "none",
        "intent": normalized_intent,
        "effect": None,
        "receipt": None,
        "terminal_reason": None,
        "created_at": now,
        "updated_at": now,
        "confirmed_at": None,
    }
    data["pending_operations"].append(operation)
    return operation, True


def operation_is_effectively_confirmed(operation: dict[str, Any]) -> bool:
    return operation.get("status") == "confirmed" or (
        operation.get("kind") == "frontier_exchange"
        and operation.get("effective_status") == "confirmed"
    )


def operation_purpose(operation: dict[str, Any]) -> tuple[Any, ...]:
    """Return the stable purpose used to prevent unrelated supersession."""
    intent = operation.get("intent")
    if not isinstance(intent, dict):
        intent = {}
    parent_gate = bool(intent.get("parent_gate") is True or intent.get("purpose") == "parent_gate")
    purpose = intent.get("purpose") or ("parent_gate" if parent_gate else operation.get("kind"))
    return (
        operation.get("kind"), purpose, parent_gate,
        intent.get("completed_work_unit_id"), intent.get("work_unit_id"),
    )


FRONTIER_REQUEST_TYPE_KEYS = ("type", "purpose")
FRONTIER_WORK_UNIT_KEYS = ("work_unit_id", "completed_work_unit_id", "next_work_unit_id")
FRONTIER_REQUEST_PAYLOAD_KEYS = ("outbound_message", "payload", "request", "message", "request_payload")
# Transport identity fields are the only parts of a Frontier intent a retry may
# change: task/chat/artifact identity.  Every other intent key defines the
# immutable purpose and must be rejected on retry.
FRONTIER_RETRY_ALLOWED_OVERRIDE_KEYS = frozenset({"task_id", "chat_url", "artifact_root"})


def frontier_purpose_components(data: dict[str, Any], intent: dict[str, Any]) -> dict[str, Any]:
    """Canonical immutable purpose identity for a Frontier exchange.

    The canonical components are objective, request type, parent gate, work
    unit, request payload, and scope.  Transport identity fields (task, chat,
    artifact root, message identity) are deliberately excluded so a retry may
    only touch those.
    """
    parent_gate = intent.get("parent_gate") is True or intent.get("purpose") == "parent_gate"
    request_type = next(
        (intent[key] for key in FRONTIER_REQUEST_TYPE_KEYS if intent.get(key) is not None),
        None,
    )
    if request_type is None and parent_gate:
        request_type = "parent_gate"
    work_unit = next(
        (intent[key] for key in FRONTIER_WORK_UNIT_KEYS if intent.get(key) is not None),
        None,
    )
    request_payload = next(
        (intent[key] for key in FRONTIER_REQUEST_PAYLOAD_KEYS if intent.get(key) is not None),
        None,
    )
    scope = intent.get("scope") or data.get("scope")
    return {
        "objective": data.get("objective"),
        "request_type": request_type,
        "parent_gate": parent_gate,
        "work_unit": work_unit,
        "request_payload": request_payload,
        "scope": scope,
    }


def frontier_purpose_digest(data: dict[str, Any], intent: dict[str, Any]) -> str:
    """Immutable purpose digest over the canonical purpose components."""
    encoded = json.dumps(
        frontier_purpose_components(data, intent),
        ensure_ascii=False, sort_keys=True, separators=(",", ":"),
    ).encode()
    return hashlib.sha256(encoded).hexdigest()


def validate_purpose_digest_continuity(predecessor: dict[str, Any], successor: dict[str, Any]) -> None:
    """A successor must match the predecessor's immutable purpose digest.

    Legacy records without a digest are preserved conservatively: no digest is
    invented for them, so no continuity check applies.
    """
    if predecessor.get("purpose_digest") is not None and predecessor["purpose_digest"] != successor.get("purpose_digest"):
        raise SystemExit("OPERATION_SUCCESSOR_PURPOSE_DIGEST_MISMATCH")


def frontier_resolution_evidence_complete(operation: dict[str, Any]) -> bool:
    effect = operation.get("effect")
    receipt = operation.get("receipt")
    if pre_effect_absence_evidence_complete(
        effect if isinstance(effect, dict) else {},
        receipt if isinstance(receipt, dict) else {},
    ):
        return True
    resolution = operation.get("resolution_evidence")
    if not isinstance(resolution, dict):
        return False
    return pre_effect_absence_evidence_complete(
        resolution.get("effect"), resolution.get("receipt"),
    )


def recovery_blocker_code(data: dict[str, Any]) -> str | None:
    recovery = data.get("recovery")
    if isinstance(recovery, dict) and isinstance(recovery.get("code"), str):
        return recovery["code"]
    blocker = data.get("blocker")
    if not isinstance(blocker, str) or not blocker:
        return None
    return blocker.split(":", 1)[0].strip()


def is_recoverable_frontier_blocker(data: dict[str, Any]) -> bool:
    return recovery_blocker_code(data) in RECOVERABLE_FRONTIER_BLOCKER_CODES


def frontier_successor_candidates(data: dict[str, Any], predecessor: dict[str, Any]) -> list[dict[str, Any]]:
    explicit = predecessor.get("successor_operation_id")
    operations = [item for item in data.get("pending_operations", []) if isinstance(item, dict)]
    if isinstance(explicit, str):
        return [item for item in operations if item.get("operation_id") == explicit and operation_is_effectively_confirmed(item)]
    linked = [
        item for item in operations
        if item.get("kind") == "frontier_exchange"
        and operation_is_effectively_confirmed(item)
        and (
            item.get("predecessor_operation_id") == predecessor.get("operation_id")
            or predecessor.get("operation_id") in item.get("predecessor_operation_ids", [])
        )
    ]
    if linked:
        return linked
    candidates: list[dict[str, Any]] = []
    predecessor_purpose = operation_purpose(predecessor)
    generic_legacy_purpose = predecessor_purpose == (
        "frontier_exchange", "frontier_exchange", False, None, None,
    )
    for item in operations:
        if item.get("kind") != "frontier_exchange" or not operation_is_effectively_confirmed(item):
            continue
        if item.get("operation_id") == predecessor.get("operation_id"):
            continue
        if predecessor_purpose != operation_purpose(item):
            continue
        predecessor_digest = predecessor.get("purpose_digest")
        successor_digest = item.get("purpose_digest")
        if predecessor_digest is not None and predecessor_digest != successor_digest:
            continue
        # Legacy records without a digest may be auto-matched only when their
        # persisted purpose is specific. Generic Frontier intents require an
        # explicit successor ID from the typed recovery authority.
        if predecessor_digest is None and generic_legacy_purpose:
            continue
        if str(item.get("created_at") or "") < str(predecessor.get("created_at") or ""):
            continue
        candidates.append(item)
    return candidates


def confirmed_frontier_successor(data: dict[str, Any], predecessor: dict[str, Any]) -> dict[str, Any] | None:
    candidates = frontier_successor_candidates(data, predecessor)
    return candidates[0] if len(candidates) == 1 else None


def parse_frontier_resolution_evidence(value: str | None) -> dict[str, Any] | None:
    if value is None:
        return None
    evidence = parse_object_json(value, "--evidence-json")
    effect = evidence.get("effect")
    receipt = evidence.get("receipt")
    if not pre_effect_absence_evidence_complete(effect, receipt):
        raise SystemExit("FRONTIER_RESOLUTION_REQUIRES_COMPLETE_STRUCTURED_EVIDENCE")
    authority = evidence.get("authority")
    source = evidence.get("source")
    if not isinstance(authority, str) or not authority.strip():
        raise SystemExit("FRONTIER_RESOLUTION_EVIDENCE_AUTHORITY_REQUIRED")
    if not isinstance(source, str) or not source.strip():
        raise SystemExit("FRONTIER_RESOLUTION_EVIDENCE_SOURCE_REQUIRED")
    normalized = {
        "effect": sanitize_evidence(effect),
        "receipt": sanitize_evidence(receipt),
        "authority": authority.strip(),
        "source": source.strip(),
    }
    return normalized


def apply_frontier_resolution_evidence(
    operation: dict[str, Any], evidence: dict[str, Any] | None, *, explicit: bool,
) -> None:
    if frontier_resolution_evidence_complete(operation):
        operation["effect_stage"] = "none"
        operation["pre_effect_absence_proven"] = True
        return
    if not explicit:
        raise SystemExit("PRE_EFFECT_ABSENCE_PROOF_REQUIRED")
    if evidence is None:
        raise SystemExit("FRONTIER_RESOLUTION_EVIDENCE_REQUIRED")
    encoded = json.dumps(evidence, ensure_ascii=False, sort_keys=True, separators=(",", ":")).encode()
    operation["resolution_evidence"] = {**evidence, "recorded_at": utcnow()}
    operation["resolution_evidence_digest"] = hashlib.sha256(encoded).hexdigest()
    operation["effect_stage"] = "none"
    operation["pre_effect_absence_proven"] = True


def finalize_frontier_supersession(
    data: dict[str, Any], predecessor: dict[str, Any], successor: dict[str, Any], *,
    reason: str, explicit_pre_effect_proof: bool = False,
    resolution_evidence: dict[str, Any] | None = None,
) -> bool:
    if predecessor.get("status") == "superseded":
        if predecessor.get("successor_operation_id") == successor.get("operation_id"):
            return False
        raise SystemExit("OPERATION_RESOLUTION_CONFLICT")
    if predecessor.get("kind") != "frontier_exchange" or successor.get("kind") != "frontier_exchange":
        raise SystemExit("FRONTIER_SUPERSESSION_WRONG_KIND")
    if predecessor.get("status") != "failed":
        raise SystemExit("FRONTIER_SUPERSESSION_REQUIRES_FAILED_PREDECESSOR")
    if not operation_is_effectively_confirmed(successor):
        raise SystemExit("OPERATION_SUCCESSOR_MUST_BE_CONFIRMED")
    if operation_purpose(predecessor) != operation_purpose(successor):
        raise SystemExit("OPERATION_SUCCESSOR_PURPOSE_MISMATCH")
    validate_purpose_digest_continuity(predecessor, successor)
    apply_frontier_resolution_evidence(
        predecessor, resolution_evidence, explicit=explicit_pre_effect_proof,
    )
    now = utcnow()
    predecessor["status"] = "superseded"
    predecessor["terminal_reason"] = reason
    predecessor["terminal_disposition"] = "superseded"
    predecessor["successor_operation_id"] = successor["operation_id"]
    predecessor["confirmed_at"] = now
    predecessor["updated_at"] = now
    predecessor_ids = successor.setdefault("predecessor_operation_ids", [])
    if predecessor["operation_id"] not in predecessor_ids:
        predecessor_ids.append(predecessor["operation_id"])
    if successor.get("predecessor_operation_id") is None:
        successor["predecessor_operation_id"] = predecessor["operation_id"]
    successor["attempt_group_id"] = successor.get("attempt_group_id") or predecessor.get("attempt_group_id")
    predecessor["attempt_group_id"] = predecessor.get("attempt_group_id") or successor.get("attempt_group_id")
    successor["updated_at"] = now
    return True


def mark_pre_effect_absence_proven(operation: dict[str, Any], *, explicit: bool) -> None:
    """Promote an operator's explicit absence proof without guessing from a timeout.

    The authority assertion is validated against the persisted operation
    evidence; it never manufactures evidence by itself.  Only Frontier
    exchanges may use this resolution path.
    """
    if operation.get("pre_effect_absence_proven") is True:
        return
    if not explicit:
        raise SystemExit("PRE_EFFECT_ABSENCE_PROOF_REQUIRED")
    if operation.get("kind") != "frontier_exchange":
        raise SystemExit("PRE_EFFECT_ABSENCE_PROOF_FRONTIER_ONLY")
    if operation.get("status") not in {"intent", "failed"}:
        raise SystemExit("PRE_EFFECT_ABSENCE_PROOF_REQUIRES_UNRESOLVED_FRONTIER_FAILURE")
    if operation.get("effect_stage") not in {None, "none"}:
        raise SystemExit("PRE_EFFECT_ABSENCE_PROOF_CONFLICTS_WITH_RECORDED_EFFECT")
    effect = operation.get("effect")
    receipt = operation.get("receipt")
    if not frontier_resolution_evidence_complete(operation):
        raise SystemExit("PRE_EFFECT_ABSENCE_PROOF_REQUIRES_COMPLETE_STRUCTURED_EVIDENCE")
    for source in (effect, receipt):
        if isinstance(source, dict) and source.get("transport_status") == "success":
            raise SystemExit("PRE_EFFECT_ABSENCE_PROOF_CONFLICTS_WITH_SUCCESS")
    operation["effect_stage"] = "none"
    operation["pre_effect_absence_proven"] = True


def require_safe_operation_resolution(
    operation: dict[str, Any], *, explicit_pre_effect_proof: bool,
) -> None:
    if operation.get("status") == "intent":
        mark_pre_effect_absence_proven(operation, explicit=False)
        return
    if operation.get("status") != "failed":
        raise SystemExit("OPERATION_RESOLUTION_REQUIRES_FAILED_OPERATION")
    mark_pre_effect_absence_proven(operation, explicit=explicit_pre_effect_proof)
    if operation.get("effect_stage") != "none":
        raise SystemExit("OPERATION_RESOLUTION_REQUIRES_EFFECT_STAGE_NONE")


def validate_successor_operation(
    operation: dict[str, Any], successor: dict[str, Any], *, explicit_pre_effect_proof: bool,
) -> None:
    if operation["operation_id"] == successor["operation_id"]:
        raise SystemExit("OPERATION_SUCCESSOR_MUST_DIFFER")
    if operation.get("kind") != successor.get("kind"):
        raise SystemExit("OPERATION_SUCCESSOR_KIND_MISMATCH")
    if not operation_is_effectively_confirmed(successor):
        raise SystemExit("OPERATION_SUCCESSOR_MUST_BE_CONFIRMED")
    if operation_purpose(operation) != operation_purpose(successor):
        raise SystemExit("OPERATION_SUCCESSOR_PURPOSE_MISMATCH")
    validate_purpose_digest_continuity(operation, successor)
    require_safe_operation_resolution(
        operation, explicit_pre_effect_proof=explicit_pre_effect_proof,
    )


def cmd_operation_resolution(args: argparse.Namespace, data: dict[str, Any]) -> int:
    """Resolve a safe no-effect Frontier operation without rewriting history."""
    require_nonterminal_run(data, f"operation {args.operation_action}")
    if args.operation_id is None:
        raise SystemExit(f"operation {args.operation_action} requires --operation-id")
    operation = find_operation(data, args.operation_id)
    reason = require_nonempty_string(args.reason, "operation resolution reason")
    explicit_proof = bool(getattr(args, "pre_effect_absence_proven", False))
    expected_status = "superseded" if args.operation_action == "supersede" else "abandoned"
    if operation.get("status") == expected_status:
        requested_successor = args.successor_operation_id
        if operation.get("successor_operation_id") == requested_successor:
            print(json.dumps(data, indent=2, ensure_ascii=False, sort_keys=True))
            return 0
        raise SystemExit("OPERATION_RESOLUTION_CONFLICT")

    successor = None
    if args.operation_action == "supersede":
        if args.successor_operation_id is None:
            raise SystemExit("operation supersede requires --successor-operation-id")
        successor = find_operation(data, args.successor_operation_id)
        finalize_frontier_supersession(
            data, operation, successor, reason=reason,
            explicit_pre_effect_proof=explicit_proof,
        )
    else:
        require_safe_operation_resolution(operation, explicit_pre_effect_proof=explicit_proof)
        if operation.get("kind") != "frontier_exchange":
            raise SystemExit("PRE_EFFECT_ABSENCE_PROOF_FRONTIER_ONLY")
        now = utcnow()
        operation["status"] = "abandoned"
        operation["terminal_reason"] = reason
        operation["terminal_disposition"] = "abandoned"
        operation["confirmed_at"] = now
        operation["updated_at"] = now
        if args.successor_operation_id is not None:
            successor = find_operation(data, args.successor_operation_id)
            if not operation_is_effectively_confirmed(successor):
                raise SystemExit("OPERATION_SUCCESSOR_MUST_BE_CONFIRMED")
            if operation_purpose(operation) != operation_purpose(successor):
                raise SystemExit("OPERATION_SUCCESSOR_PURPOSE_MISMATCH")
            validate_purpose_digest_continuity(operation, successor)
            operation["successor_operation_id"] = successor["operation_id"]
            predecessor_ids = successor.setdefault("predecessor_operation_ids", [])
            if operation["operation_id"] not in predecessor_ids:
                predecessor_ids.append(operation["operation_id"])
            if successor.get("predecessor_operation_id") is None:
                successor["predecessor_operation_id"] = operation["operation_id"]
            successor["updated_at"] = now

    saved = write_state(data, args.expect_revision)
    append_event(args.run_id, f"operation.{args.operation_action}", reason, {
        "operation_id": operation["operation_id"],
        "successor_operation_id": operation.get("successor_operation_id"),
        "revision": saved["revision"],
    })
    print(json.dumps(saved, indent=2, ensure_ascii=False, sort_keys=True))
    return 0


def resolve_recovery_resume_phase(data: dict[str, Any], explicit_phase: str | None) -> str:
    recovery = data.get("recovery")
    persisted = recovery.get("resume_phase") if isinstance(recovery, dict) else None
    if explicit_phase is not None and persisted is not None and explicit_phase != persisted:
        raise SystemExit("RECOVERY_RESUME_PHASE_CONFLICT")
    candidate = explicit_phase or persisted
    if candidate is None:
        raise SystemExit("RECOVERY_RESUME_PHASE_REQUIRED_FOR_LEGACY_BLOCKER")
    if candidate not in PHASES or PHASE_STATUS[candidate] != "active":
        raise SystemExit("RECOVERY_RESUME_PHASE_MUST_BE_ACTIVE")
    return candidate


def cmd_recovery(args: argparse.Namespace) -> int:
    data = read_state(args.run_id)
    require_v2(data, "recovery")
    ensure_v2_defaults(data)
    require_nonterminal_run(data, "recovery")
    if args.recovery_action != "resolve-frontier":
        raise SystemExit("unsupported recovery action")
    if not isinstance(args.operation_id, str):
        raise SystemExit("recovery resolve-frontier requires --operation-id")
    predecessor = find_operation(data, args.operation_id)
    if predecessor.get("kind") != "frontier_exchange":
        raise SystemExit("FRONTIER_RECOVERY_WRONG_KIND")
    persisted_recovery = data.get("recovery") if isinstance(data.get("recovery"), dict) else {}
    if persisted_recovery.get("status") in {"blocked", "resolved"}:
        if (
            args.disposition == "supersede"
            and predecessor.get("status") == "superseded"
            and predecessor.get("successor_operation_id") == (
                args.successor_operation_id or persisted_recovery.get("successor_operation_id")
            )
        ):
            print(json.dumps(data, indent=2, ensure_ascii=False, sort_keys=True))
            return 0
        if args.disposition == "abandon" and predecessor.get("status") == "abandoned":
            print(json.dumps(data, indent=2, ensure_ascii=False, sort_keys=True))
            return 0
    if data["revision"] != args.expect_revision:
        raise SystemExit(
            f"revision conflict for {args.run_id}: expected {args.expect_revision}, observed {data['revision']}"
        )
    if data.get("status") == "blocked" and not is_recoverable_frontier_blocker(data):
        raise SystemExit("RECOVERY_CANNOT_CLEAR_UNRELATED_BLOCKER")
    evidence = parse_frontier_resolution_evidence(args.evidence_json)
    successor = None
    if args.successor_operation_id is not None:
        successor = find_operation(data, args.successor_operation_id)
    elif args.disposition == "supersede":
        successor = confirmed_frontier_successor(data, predecessor)
        if successor is None:
            candidates = frontier_successor_candidates(data, predecessor)
            if len(candidates) > 1:
                raise SystemExit("FRONTIER_RECOVERY_SUCCESSOR_AMBIGUOUS")
            raise SystemExit("FRONTIER_RECOVERY_CONFIRMED_SUCCESSOR_REQUIRED")

    reason = args.reason or "PRE_EFFECT_FAILURE"
    if args.disposition == "supersede":
        assert successor is not None
        finalize_frontier_supersession(
            data, predecessor, successor, reason=reason,
            explicit_pre_effect_proof=bool(args.pre_effect_absence_proven),
            resolution_evidence=evidence,
        )
    else:
        if predecessor.get("status") == "abandoned":
            if predecessor.get("terminal_reason") != reason:
                raise SystemExit("OPERATION_RESOLUTION_CONFLICT")
        else:
            if predecessor.get("status") != "failed":
                raise SystemExit("FRONTIER_ABANDON_REQUIRES_FAILED_OPERATION")
            apply_frontier_resolution_evidence(
                predecessor, evidence, explicit=bool(args.pre_effect_absence_proven),
            )
            now = utcnow()
            predecessor["status"] = "abandoned"
            predecessor["terminal_reason"] = reason
            predecessor["terminal_disposition"] = "abandoned"
            predecessor["confirmed_at"] = now
            predecessor["updated_at"] = now

    previous_phase = data.get("phase")
    recovery = data.get("recovery") if isinstance(data.get("recovery"), dict) else {}
    recovery_targets = list(recovery.get("operation_ids", []))
    if data.get("status") == "blocked" and not recovery_targets:
        recovery_targets = [
            item["operation_id"] for item in data.get("pending_operations", [])
            if isinstance(item, dict)
            and item.get("kind") == "frontier_exchange"
            and item.get("status") == "failed"
            and operation_effective_status(item) != "confirmed"
        ]
    operation_ids = list(dict.fromkeys([
        *recovery_targets,
        predecessor["operation_id"],
        *([successor["operation_id"]] if successor is not None else []),
    ]))
    unresolved_target_ids = []
    for operation_id_value in recovery_targets:
        candidate = find_operation(data, operation_id_value)
        if (
            candidate.get("kind") == "frontier_exchange"
            and candidate.get("status") == "failed"
            and operation_effective_status(candidate) != "confirmed"
        ):
            unresolved_target_ids.append(operation_id_value)

    resumed_phase = None
    still_blocked = data.get("status") == "blocked" and bool(unresolved_target_ids)
    if data.get("status") == "blocked" and not still_blocked:
        resumed_phase = resolve_recovery_resume_phase(data, args.resume_phase)
        data["phase"] = resumed_phase
        data["status"] = "active"
        data["blocker"] = None
    data["recovery"] = {
        "code": recovery_blocker_code(data) or recovery.get("code") or "BLOCKED_FRONTIER_PRE_EFFECT_FAILURE",
        "status": "blocked" if still_blocked else "resolved",
        "operation_ids": operation_ids,
        "blocked_at_revision": recovery.get("blocked_at_revision"),
        "resume_phase": resumed_phase or recovery.get("resume_phase"),
        "evidence_digest": predecessor.get("resolution_evidence_digest") or recovery.get("evidence_digest"),
        "recorded_at": recovery.get("recorded_at") or utcnow(),
        "resolved_at": None if still_blocked else utcnow(),
        "resolved_operation_id": predecessor["operation_id"],
        "successor_operation_id": successor.get("operation_id") if successor else None,
        "remaining_operation_ids": unresolved_target_ids,
        "reason": reason,
    }
    saved = write_state(data, args.expect_revision)
    append_event(args.run_id, "recovery.frontier_resolved", reason, {
        "operation_id": predecessor["operation_id"],
        "successor_operation_id": successor.get("operation_id") if successor else None,
        "disposition": args.disposition,
        "from_phase": previous_phase,
        "resume_phase": resumed_phase,
        "remaining_operation_ids": unresolved_target_ids,
        "revision": saved["revision"],
    })
    print(json.dumps(saved, indent=2, ensure_ascii=False, sort_keys=True))
    return 0


def cmd_operation(args: argparse.Namespace) -> int:
    data = read_state(args.run_id)
    require_v2(data, "operation")
    ensure_v2_defaults(data)
    validate_state(data)
    action = args.operation_action
    if action in {"supersede", "abandon"}:
        return cmd_operation_resolution(args, data)
    if action == "intent":
        require_active_run(data, "operation intent")
        if args.kind is None:
            raise SystemExit("operation intent requires --kind")
        if args.idempotency_key is None:
            raise SystemExit("operation intent requires --idempotency-key")
        if args.kind == "delegation":
            raise SystemExit("delegation intent must use delegation-preflight")
        if args.kind == "frontier_exchange":
            raise SystemExit("Frontier exchange intent must use frontier start")
        if args.kind == "local_commit":
            if args.authorization_id is None:
                raise SystemExit("local_commit intent requires --authorization-id")
            authorization = find_authorization(data, args.authorization_id)
            expected_key = f"local-commit:{args.authorization_id}:{authorization.get('authority')}:{authorization.get('request_id')}"
            if args.idempotency_key != expected_key:
                raise SystemExit("LOCAL_COMMIT_OPERATION_IDENTITY_MISMATCH")
            if data.get("commit_policy") not in {"authorized", "governed"}:
                raise SystemExit("local_commit intent requires an open governed commit grant")
            if data.get("commit_policy") == "governed":
                if authorization.get("grant_kind") != "governed":
                    raise SystemExit("GOVERNED_LOCAL_COMMIT_GRANT_REQUIRED")
                standing = data.get("commit_policy_authorization")
                if not isinstance(standing, dict) or standing.get("status") != "active":
                    raise SystemExit("local_commit intent requires an active standing commit policy authorization")
                validate_governed_authorization_source(data, authorization)
            if authorization.get("status") != "open":
                raise SystemExit("local_commit intent requires an open governed commit grant")
            if authorization_is_expired(authorization):
                raise SystemExit("AUTHORIZATION_EXPIRED")
        require_operation_route(data, args.kind)
        intent = parse_object_json(args.intent_json, "--intent-json")
        if args.kind == "tracking_issue":
            intent = validate_tracking_issue_intent(data, intent)
        elif args.kind == "pull_request":
            intent = validate_pull_request_intent(data, intent)
        if args.kind == "local_commit":
            candidate_operation = {
                "kind": "local_commit", "intent": intent, "idempotency_key": args.idempotency_key,
                "operation_id": operation_id(args.kind, args.idempotency_key),
            }
            if not authorization_operation_matches(authorization, candidate_operation):
                raise SystemExit("AUTHORIZATION_OPERATION_IDENTITY_MISMATCH")
        operation, created = record_operation_intent(
            data, kind=args.kind, idempotency_key=args.idempotency_key, intent=intent,
        )
        if not created:
            print(json.dumps(data, indent=2, ensure_ascii=False, sort_keys=True))
            return 0
        saved = write_state(data, args.expect_revision)
        append_event(args.run_id, "operation.intent_recorded", None, {
            "operation_id": operation["operation_id"], "kind": operation["kind"],
            "idempotency_key": operation["idempotency_key"], "revision": saved["revision"],
        })
        print(json.dumps(saved, indent=2, ensure_ascii=False, sort_keys=True))
        return 0

    require_nonterminal_run(data, f"operation {action}")
    if args.operation_id is None:
        raise SystemExit(f"operation {action} requires --operation-id")
    operation = find_operation(data, args.operation_id)
    if operation.get("kind") == "tracking_issue":
        validate_tracking_issue_intent(data, operation["intent"])
    elif operation.get("kind") == "pull_request":
        validate_pull_request_intent(data, operation["intent"])
    if action == "observe":
        if args.effect_json is None:
            raise SystemExit("operation observe requires --effect-json")
        effect = parse_object_json(args.effect_json, "--effect-json")
        if operation.get("kind") in {"tracking_issue", "pull_request"}:
            validate_delivery_payload(operation, effect, "effect")
        if operation["status"] in TERMINAL_OPERATION_STATUSES:
            if operation.get("effect") == effect:
                print(json.dumps(data, indent=2, ensure_ascii=False, sort_keys=True))
                return 0
            raise SystemExit("OPERATION_TERMINAL_EFFECT_CONFLICT")
        if operation.get("effect") is not None and operation["effect"] != effect:
            raise SystemExit("OPERATION_EFFECT_IDEMPOTENCY_CONFLICT")
        # Re-observing a discovery result after a receipt was stored is also
        # a no-op.  Do not regress ``receipt-recorded`` back to
        # ``effect-observed`` on a retry.
        if operation.get("effect") == effect:
            print(json.dumps(data, indent=2, ensure_ascii=False, sort_keys=True))
            return 0
        operation["effect"] = effect
        operation["status"] = "effect-observed"
        operation["effect_stage"] = "response_observed"
        operation["updated_at"] = utcnow()
        saved = write_state(data, args.expect_revision)
        append_event(args.run_id, "operation.effect_observed", None, {
            "operation_id": operation["operation_id"], "kind": operation["kind"], "revision": saved["revision"],
        })
        print(json.dumps(saved, indent=2, ensure_ascii=False, sort_keys=True))
        return 0

    if action == "receipt":
        if args.receipt_json is None:
            raise SystemExit("operation receipt requires --receipt-json")
        receipt = parse_object_json(args.receipt_json, "--receipt-json")
        if operation.get("kind") in {"tracking_issue", "pull_request"}:
            validate_delivery_payload(operation, receipt, "receipt")
        if operation.get("kind") == "pull_request":
            validate_pull_request_effect_receipt_identity(operation, receipt)
        if operation["status"] in TERMINAL_OPERATION_STATUSES:
            if operation.get("receipt") == receipt:
                print(json.dumps(data, indent=2, ensure_ascii=False, sort_keys=True))
                return 0
            raise SystemExit("OPERATION_TERMINAL_RECEIPT_CONFLICT")
        if operation.get("effect") is None:
            raise SystemExit("operation receipt requires an observed effect")
        if operation.get("receipt") is not None and operation["receipt"] != receipt:
            raise SystemExit("OPERATION_RECEIPT_IDEMPOTENCY_CONFLICT")
        if operation.get("receipt") == receipt and operation["status"] == "receipt-recorded":
            print(json.dumps(data, indent=2, ensure_ascii=False, sort_keys=True))
            return 0
        operation["receipt"] = receipt
        operation["status"] = "receipt-recorded"
        operation["effect_stage"] = "response_observed"
        operation["updated_at"] = utcnow()
        saved = write_state(data, args.expect_revision)
        append_event(args.run_id, "operation.receipt_recorded", None, {
            "operation_id": operation["operation_id"], "kind": operation["kind"], "revision": saved["revision"],
        })
        print(json.dumps(saved, indent=2, ensure_ascii=False, sort_keys=True))
        return 0

    # Terminal confirmation is deliberately separate from receipt recording:
    # discovery can establish a remote effect while a later gate still fails.
    terminal_status = args.status
    reason = args.reason
    if terminal_status not in TERMINAL_OPERATION_STATUSES:
        raise SystemExit("operation confirm requires --status confirmed, failed, or abandoned")
    if terminal_status == "superseded":
        raise SystemExit("operation superseded status requires the typed supersede transition")
    if not isinstance(reason, str) or not reason.strip():
        raise SystemExit("operation confirm requires --reason")
    if operation.get("kind") in {"tracking_issue", "pull_request"}:
        validate_delivery_confirmation(operation, terminal_status)
    frontier_outcome = None
    if operation.get("kind") == "frontier_exchange":
        frontier_outcome = frontier_typed_lifecycle_outcome(operation)
        if frontier_outcome is None:
            raise SystemExit("FRONTIER_TYPED_CONFIRMATION_REQUIRED")
    typed_parent_response = parent_gate_response_type(operation) if is_parent_gate_operation(operation) else None
    if is_parent_gate_operation(operation) and terminal_status == "confirmed" and typed_parent_response is None:
        raise SystemExit("PARENT_GATE_RESPONSE_TYPE_REQUIRED")
    if frontier_outcome is not None:
        frontier_status, frontier_decision, frontier_errors = frontier_outcome
        if frontier_status == "success" and not frontier_errors:
            if terminal_status != "confirmed":
                raise SystemExit("typed Frontier success requires --status confirmed")
            operation["transport_status"] = frontier_status
            operation["frontier_decision"] = frontier_decision
        else:
            terminal_status = "failed"
            operation["transport_status"] = frontier_status
            operation["frontier_decision"] = None
            reason = reason + ": Frontier transport " + frontier_status
            if frontier_errors:
                reason += ": " + "; ".join(sorted(set(frontier_errors)))
    if terminal_status == "abandoned":
        require_safe_operation_resolution(
            operation, explicit_pre_effect_proof=bool(getattr(args, "pre_effect_absence_proven", False)),
        )
    if operation["status"] in TERMINAL_OPERATION_STATUSES:
        if operation["status"] == terminal_status and operation.get("terminal_reason") == reason:
            print(json.dumps(data, indent=2, ensure_ascii=False, sort_keys=True))
            return 0
        raise SystemExit("OPERATION_TERMINAL_IDEMPOTENCY_CONFLICT")
    if terminal_status == "confirmed" and (operation.get("effect") is None or operation.get("receipt") is None):
        raise SystemExit("confirmed operation requires an observed effect and recorded receipt")
    operation["status"] = terminal_status
    if typed_parent_response is not None:
        operation["response_type"] = typed_parent_response
    operation["terminal_reason"] = reason
    operation["confirmed_at"] = utcnow()
    operation["updated_at"] = operation["confirmed_at"]
    if terminal_status == "confirmed" and typed_parent_response is not None:
        apply_parent_gate_response(
            data, operation, response_type=typed_parent_response,
            effect=operation["effect"], receipt=operation["receipt"],
        )
    saved = write_state(data, args.expect_revision)
    append_event(args.run_id, "operation.confirmed", reason, {
        "operation_id": operation["operation_id"], "kind": operation["kind"],
        "status": terminal_status, "revision": saved["revision"],
    })
    print(json.dumps(saved, indent=2, ensure_ascii=False, sort_keys=True))
    return 0


def find_authorization(data: dict[str, Any], authorization_id_value: str) -> dict[str, Any]:
    if not isinstance(authorization_id_value, str) or not AUTHORIZATION_ID_RE.fullmatch(authorization_id_value):
        raise SystemExit("--authorization-id must be a valid authorization ID")
    for authorization in data.get("authorizations", []):
        if isinstance(authorization, dict) and authorization.get("authorization_id") == authorization_id_value:
            return authorization
    raise SystemExit(f"authorization not found: {authorization_id_value}")


GOVERNED_SOURCE_ALIAS_KEYS = {
    "type", "status", "transport", "decision", "response", "response_message_id", "response_id",
    "plan", "proposed_plan", "next_work_unit", "next_work_unit_id", "completed_work_unit_id",
    "parent_gate", "parent_gate_intent", "parent_gate_operation", "parent_gate_continuation",
    "continuation", "continuation_of", "begin_wu", "BEGIN_WU",
}


def matching_work_unit_id(effect: dict[str, Any], receipt: dict[str, Any]) -> str | None:
    values = [source.get("work_unit_id") for source in (effect, receipt)]
    if all(isinstance(value, str) and value for value in values) and values[0] == values[1]:
        return values[0]
    return None


def reject_governed_source_markers(data: dict[str, Any], operation: dict[str, Any], effect: dict[str, Any], receipt: dict[str, Any]) -> None:
    if operation.get("kind") != "frontier_exchange" or is_parent_gate_operation(operation):
        raise SystemExit("GOVERNED_AUTHORIZATION_SOURCE_NOT_ACCEPTED")
    operation_id_value = operation.get("operation_id")
    for gate in [data.get("parent_gate"), *data.get("parent_gate_history", [])]:
        if isinstance(gate, dict) and gate.get("operation_id") == operation_id_value:
            raise SystemExit("GOVERNED_AUTHORIZATION_SOURCE_NOT_ACCEPTED")
    next_work_unit = data.get("next_work_unit")
    if isinstance(next_work_unit, dict):
        provenance = next_work_unit.get("provenance")
        if isinstance(provenance, dict) and provenance.get("operation_id") == operation_id_value:
            raise SystemExit("GOVERNED_AUTHORIZATION_SOURCE_NOT_ACCEPTED")
    sources = [operation.get("intent"), effect, receipt]
    operation_markers = {
        "proposed_plan", "plan", "next_work_unit", "next_work_unit_id", "completed_work_unit_id",
        "parent_gate", "parent_gate_intent", "parent_gate_operation", "parent_gate_continuation",
        "continuation", "continuation_of", "begin_wu", "BEGIN_WU",
    }
    if any(key in operation for key in operation_markers):
        raise SystemExit("GOVERNED_AUTHORIZATION_SOURCE_NOT_ACCEPTED")
    for source in sources:
        if not isinstance(source, dict):
            continue
        if any(key in source for key in GOVERNED_SOURCE_ALIAS_KEYS):
            raise SystemExit("GOVERNED_AUTHORIZATION_SOURCE_NOT_ACCEPTED")


def require_governed_source_field(source: dict[str, Any], field: str, expected: Any, label: str) -> Any:
    if field not in source:
        raise SystemExit(f"GOVERNED_AUTHORIZATION_SOURCE_EVIDENCE_INVALID: {label} is missing")
    value = source[field]
    if field == "response_type":
        try:
            value = normalize_frontier_response_type(value)
        except SystemExit as exc:
            raise SystemExit(f"GOVERNED_AUTHORIZATION_SOURCE_EVIDENCE_INVALID: {label} is malformed") from exc
    elif field == "frontier_decision":
        try:
            value = normalize_frontier_decision(value)
        except SystemExit as exc:
            raise SystemExit(f"GOVERNED_AUTHORIZATION_SOURCE_EVIDENCE_INVALID: {label} is malformed") from exc
    elif field == "transport_status":
        if value != "success":
            raise SystemExit(f"GOVERNED_AUTHORIZATION_SOURCE_NOT_ACCEPTED: {label} is not canonical success")
    elif field in {"operation_id", "request_id", "message_id", "work_unit_id"}:
        if not isinstance(value, str) or not value:
            raise SystemExit(f"GOVERNED_AUTHORIZATION_SOURCE_EVIDENCE_INVALID: {label} is invalid")
    if value != expected:
        raise SystemExit(f"GOVERNED_AUTHORIZATION_SOURCE_EVIDENCE_INVALID: {label} conflicts")
    return value


def source_operation_for_accepted_work_unit(
    data: dict[str, Any], *, operation_id_value: str | None, request_id: str | None,
    require_commit_scope: bool = False,
) -> dict[str, Any]:
    candidates: list[dict[str, Any]] = []
    for operation in data.get("pending_operations", []):
        if not isinstance(operation, dict):
            continue
        if operation_id_value is not None and operation.get("operation_id") == operation_id_value:
            candidates = [operation]
            break
        if operation_id_value is None and request_id is not None:
            identity = frontier_operation_identity(operation)
            if identity.get("request_id") == request_id:
                candidates.append(operation)
    if not candidates:
        raise SystemExit("accepted work-unit source operation was not found")
    operation = candidates[0]
    if operation.get("kind") != "frontier_exchange" or operation.get("status") != "confirmed":
        if operation.get("effective_status") != "confirmed":
            raise SystemExit("accepted work-unit source operation is not confirmed")
    effective_outcome = operation.get("effective_outcome")
    recovered = isinstance(effective_outcome, dict)
    if recovered:
        effect = effective_outcome.get("effect")
        receipt = effective_outcome.get("receipt")
    else:
        effect = operation.get("effect")
        receipt = operation.get("receipt")
    if not isinstance(effect, dict) or not isinstance(receipt, dict):
        raise SystemExit("accepted work-unit source operation lacks effect and receipt")
    reject_governed_source_markers(data, operation, effect, receipt)
    operation_fields = {
        "operation_id": operation.get("operation_id"),
        "request_id": operation.get("effective_request_id" if recovered else "request_id"),
        "message_id": operation.get("effective_message_id" if recovered else "message_id"),
        "response_type": operation.get("effective_response_type" if recovered else "response_type"),
        "frontier_decision": operation.get("effective_frontier_decision" if recovered else "frontier_decision"),
        "transport_status": operation.get("effective_transport_status" if recovered else "transport_status"),
        "work_unit_id": operation.get("effective_work_unit_id" if recovered else "work_unit_id"),
    }
    source_request = require_governed_source_field(operation_fields, "request_id", operation_fields["request_id"], "operation request_id")
    message_id = require_governed_source_field(operation_fields, "message_id", operation_fields["message_id"], "operation message_id")
    require_governed_source_field(operation_fields, "operation_id", operation.get("operation_id"), "operation_id")
    response_type = require_governed_source_field(operation_fields, "response_type", "sub_objective_complete", "operation response_type")
    decision = require_governed_source_field(operation_fields, "frontier_decision", "ACCEPT", "operation frontier_decision")
    transport = require_governed_source_field(operation_fields, "transport_status", "success", "operation transport_status")
    work_unit_id = require_work_unit_id(require_governed_source_field(
        operation_fields, "work_unit_id", operation_fields["work_unit_id"], "operation work_unit_id",
    ))
    if recovered:
        for field in ("request_id", "message_id", "frontier_decision", "transport_status"):
            require_governed_source_field(effective_outcome, field, operation_fields[field], f"effective outcome {field}")
    intent = operation.get("intent")
    if not isinstance(intent, dict):
        raise SystemExit("GOVERNED_AUTHORIZATION_SOURCE_EVIDENCE_INVALID: operation intent is missing")
    require_governed_source_field(intent, "request_id", source_request, "intent request_id")
    require_governed_source_field(intent, "message_id", message_id, "intent message_id")
    for label, source in (("effect", effect), ("receipt", receipt)):
        require_governed_source_field(source, "operation_id", operation["operation_id"], f"{label} operation_id")
        require_governed_source_field(source, "request_id", source_request, f"{label} request_id")
        require_governed_source_field(source, "message_id", message_id, f"{label} message_id")
        require_governed_source_field(source, "response_type", response_type, f"{label} response_type")
        require_governed_source_field(source, "frontier_decision", decision, f"{label} frontier_decision")
        require_governed_source_field(source, "transport_status", transport, f"{label} transport_status")
        require_governed_source_field(source, "work_unit_id", work_unit_id, f"{label} work_unit_id")
    work_unit = data.get("work_units", {}).get(work_unit_id)
    if not isinstance(work_unit, dict) or work_unit.get("status") in {"blocked", "cancelled", "legacy-ambiguous"}:
        raise SystemExit("accepted work-unit is not persisted and usable")

    matching_entries = [
        entry for entry in data.get("delegation_ledger", [])
        if isinstance(entry, dict) and entry.get("work_unit_id") == work_unit_id
    ]
    entry = matching_entries[-1] if matching_entries else {}
    target_root = None
    target_branch = None
    for source in (effect, receipt, intent if isinstance(intent, dict) else {}, work_unit, entry):
        if not isinstance(source, dict):
            continue
        target_root = target_root or source.get("repository_root") or source.get("workspace_repository_root")
        target_branch = target_branch or source.get("branch") or source.get("workspace_branch") or source.get("target_branch")
    if target_root is None:
        target_root = entry.get("workspace") or data.get("repository_root")
    if target_branch is None:
        target_branch = data.get("branch")
    target_root = normalize_repository_path(str(target_root), "accepted work-unit repository root")
    if not isinstance(target_branch, str) or not target_branch:
        raise SystemExit("accepted work-unit branch is required")
    source_scope: dict[str, Any] | None = None
    if require_commit_scope:
        source_scope = {}
        for key in ("repository_root", "branch", "expected_head", "candidate_diff_sha", "allowed_paths", "commit_message"):
            values = [source[key] for source in (effect, receipt) if key in source]
            if len(values) != 2 or values[0] != values[1]:
                raise SystemExit(f"accepted work-unit source {key} identity is missing or conflicting")
            source_scope[key] = values[0]
        source_scope["repository_root"] = normalize_repository_path(
            source_scope["repository_root"], "accepted work-unit source repository root",
        )
        source_scope["expected_head"] = require_candidate_sha(
            source_scope["expected_head"], "accepted work-unit source expected head",
        )
        source_scope["candidate_diff_sha"] = require_scope_digest(
            source_scope["candidate_diff_sha"], "accepted work-unit source candidate diff SHA",
        )
        source_scope["allowed_paths"] = normalize_allowed_paths(source_scope["allowed_paths"])
        if source_scope["repository_root"] != target_root or source_scope["branch"] != target_branch:
            raise SystemExit("accepted work-unit source target identity conflicts with persisted WU")
        if not isinstance(source_scope["commit_message"], str) or not source_scope["commit_message"]:
            raise SystemExit("accepted work-unit source commit message is invalid")
    return {
        "operation_id": operation["operation_id"], "request_id": source_request,
        "message_id": message_id, "work_unit_id": work_unit_id,
        "response_type": response_type, "frontier_decision": "ACCEPT",
        "repository_root": target_root, "branch": target_branch,
        "source_scope": source_scope,
    }


def validate_governed_authorization_source(
    data: dict[str, Any], authorization: dict[str, Any],
) -> dict[str, Any]:
    standing = data.get("commit_policy_authorization")
    standing_source = standing.get("source") if isinstance(standing, dict) else None
    if (
        not isinstance(standing_source, dict)
        or authorization.get("source_operation_id") != standing_source.get("operation_id")
        or authorization.get("source_request_id") != standing_source.get("request_id")
    ):
        raise SystemExit("GOVERNED_AUTHORIZATION_SOURCE_IDENTITY_MISMATCH")
    accepted = source_operation_for_accepted_work_unit(
        data,
        operation_id_value=authorization.get("source_operation_id"),
        request_id=authorization.get("source_request_id"),
        require_commit_scope=True,
    )
    if accepted["response_type"] != "sub_objective_complete":
        raise SystemExit("GOVERNED_AUTHORIZATION_SOURCE_NOT_ACCEPTED")
    expected_scope = {
        "repository_root": authorization.get("repository_root"),
        "branch": authorization.get("branch"),
        "expected_head": authorization.get("expected_head"),
        "candidate_diff_sha": authorization.get("candidate_diff_sha"),
        "allowed_paths": authorization.get("allowed_paths"),
        "commit_message": authorization.get("commit_message"),
    }
    if accepted["request_id"] != authorization.get("source_request_id"):
        raise SystemExit("GOVERNED_AUTHORIZATION_SOURCE_REQUEST_MISMATCH")
    if accepted["work_unit_id"] != authorization.get("work_unit_id"):
        raise SystemExit("GOVERNED_AUTHORIZATION_SOURCE_WU_MISMATCH")
    if accepted["repository_root"] != authorization.get("repository_root") or accepted["branch"] != authorization.get("branch"):
        raise SystemExit("GOVERNED_AUTHORIZATION_SOURCE_TARGET_MISMATCH")
    if accepted.get("source_scope") != expected_scope:
        raise SystemExit("GOVERNED_AUTHORIZATION_SOURCE_SCOPE_MISMATCH")
    return accepted


def standing_authorization_id(authority: str, source_request_id: str, scope: dict[str, Any]) -> str:
    encoded = json.dumps({"authority": authority, "source_request_id": source_request_id, "scope": scope}, sort_keys=True, separators=(",", ":"))
    return "policy-auth-" + hashlib.sha256(encoded.encode()).hexdigest()[:24]


def disable_commit_policy_authorization(data: dict[str, Any], reason: str) -> None:
    standing = data.get("commit_policy_authorization")
    if not isinstance(standing, dict) or standing.get("status") != "active":
        return
    standing["status"] = "revoked"
    standing.setdefault("audit_history", []).append({
        "event": "disabled", "reason": reason, "recorded_at": utcnow(),
    })


def revoke_legacy_local_commit_authorizations(data: dict[str, Any]) -> list[str]:
    """Close pre-governed grants before enabling the governed policy."""
    revoked: list[str] = []
    now = utcnow()
    for authorization in data.get("authorizations", []):
        if not isinstance(authorization, dict):
            continue
        if (
            authorization.get("kind") == "local_commit"
            and authorization.get("status") == "open"
            and authorization.get("grant_kind") != "governed"
        ):
            authorization["status"] = "revoked"
            authorization["consumed_at"] = now
            revoked.append(str(authorization.get("authorization_id")))
    return revoked


def cmd_commit_policy(args: argparse.Namespace) -> int:
    data = read_state(args.run_id)
    require_v2(data, "commit-policy")
    ensure_v2_defaults(data)
    validate_state(data)
    if args.commit_policy_action != "authorize":
        raise SystemExit("unsupported commit-policy action")
    require_active_run(data, "commit-policy authorize")
    if not is_continuous_parent(data):
        raise SystemExit("standing commit authorization requires a continuous parent objective")
    if data.get("push_policy") != "deny":
        raise SystemExit("standing commit authorization requires push_policy=deny")
    if args.authority != STANDING_AUTHORITY:
        raise SystemExit("standing commit authorization requires human authority=user")
    source_request_id = args.source_request_id or args.request_id
    if not isinstance(source_request_id, str) or not source_request_id:
        raise SystemExit("--source-request-id is required")
    work_unit_id = require_work_unit_id(args.work_unit_id)
    accepted = source_operation_for_accepted_work_unit(
        data, operation_id_value=args.source_operation_id, request_id=source_request_id,
    )
    if accepted["response_type"] != "sub_objective_complete":
        raise SystemExit("standing commit authorization requires SUB_OBJECTIVE_COMPLETE/ACCEPT evidence")
    if accepted["request_id"] != source_request_id or accepted["work_unit_id"] != work_unit_id:
        raise SystemExit("standing commit authorization source identity mismatch")
    if data.get("branch") is None or not isinstance(data.get("branch"), str) or not data["branch"]:
        raise SystemExit("standing commit authorization requires a persisted parent branch")
    scope = {
        "parent_run_id": data["run_id"],
        "parent_objective": data["parent_objective"],
        "repository_root": data["repository_root"],
        "branch": data["branch"],
    }
    auth_id = standing_authorization_id(STANDING_AUTHORITY, source_request_id, scope)
    expected = {
        "authorization_id": auth_id,
        "authority": STANDING_AUTHORITY,
        "source_request_id": source_request_id,
        "scope": scope,
        "source": {key: accepted[key] for key in (
            "operation_id", "request_id", "message_id", "work_unit_id", "response_type", "frontier_decision",
        )},
        "accepted_work_unit": {
            "work_unit_id": accepted["work_unit_id"],
            "repository_root": accepted["repository_root"],
            "branch": accepted["branch"],
        },
    }
    existing = data.get("commit_policy_authorization")
    if existing is not None:
        if not isinstance(existing, dict):
            raise SystemExit("COMMIT_POLICY_AUTHORIZATION_CONFLICT")
        compare_keys = ("authorization_id", "authority", "source_request_id", "scope", "source", "accepted_work_unit")
        if any(existing.get(key) != expected[key] for key in compare_keys):
            raise SystemExit("COMMIT_POLICY_AUTHORIZATION_CONFLICT")
        if existing.get("status") != "active" or data.get("commit_policy") != "governed":
            raise SystemExit("COMMIT_POLICY_AUTHORIZATION_CONFLICT")
        print(json.dumps(data, indent=2, ensure_ascii=False, sort_keys=True))
        return 0
    revoked_legacy = revoke_legacy_local_commit_authorizations(data)
    now = utcnow()
    standing = {
        **expected,
        "status": "active",
        "authorized_at": now,
        "audit_history": [{
            "event": "authorized", "authority": STANDING_AUTHORITY,
            "source_request_id": source_request_id, "recorded_at": now,
        }],
    }
    standing["audit_history"].extend({
        "event": "legacy_grant_revoked", "authorization_id": authorization_id_value,
        "recorded_at": now,
    } for authorization_id_value in revoked_legacy)
    data["commit_policy_authorization"] = standing
    data["commit_policy"] = "governed"
    saved = write_state(data, args.expect_revision)
    append_event(args.run_id, "commit_policy.authorized", "standing governed commit authorization created", {
        "authorization_id": auth_id, "authority": STANDING_AUTHORITY,
        "source_request_id": source_request_id, "work_unit_id": work_unit_id,
        "revoked_legacy_authorization_ids": revoked_legacy,
        "revision": saved["revision"],
    })
    print(json.dumps(saved, indent=2, ensure_ascii=False, sort_keys=True))
    return 0


def authorization_is_expired(authorization: dict[str, Any]) -> bool:
    expires_at = parse_authorization_expiry(authorization.get("expires_at"))
    return expires_at is not None and expires_at <= dt.datetime.now(dt.timezone.utc)


def authorization_operation_matches(authorization: dict[str, Any], operation: dict[str, Any]) -> bool:
    intent = operation.get("intent")
    if operation.get("kind") != "local_commit" or not isinstance(intent, dict):
        return False
    expected = {
        "authorization_id": authorization["authorization_id"],
        "authority": authorization["authority"],
        "request_id": authorization["request_id"],
        "repository_root": authorization["repository_root"],
        "branch": authorization["branch"],
        "expected_head": authorization["expected_head"],
        "allowed_paths": authorization["allowed_paths"],
        "scope_digest": authorization["scope_digest"],
        "commit_message": authorization["commit_message"],
        "commit_message_digest": authorization["commit_message_digest"],
    }
    if authorization.get("grant_kind") == "governed":
        expected.update({
            "grant_kind": "governed", "parent_run_id": authorization["parent_run_id"],
            "work_unit_id": authorization["work_unit_id"],
            "candidate_diff_sha": authorization["candidate_diff_sha"],
            "source_operation_id": authorization["source_operation_id"],
            "source_request_id": authorization["source_request_id"],
            "source_scope": authorization["source_scope"],
            "accepted_work_unit": authorization["accepted_work_unit"],
        })
    expected_key = f"local-commit:{authorization['authorization_id']}:{authorization['authority']}:{authorization['request_id']}"
    if operation.get("idempotency_key") != expected_key or operation.get("operation_id") != operation_id("local_commit", expected_key):
        return False
    baseline = intent.get("pre_effect")
    baseline_keys = {"branch", "head_symbolic", "expected_head", "config_digest", "tags_digest", "remotes_digest", "refs"}
    if not isinstance(baseline, dict) or set(baseline) != baseline_keys:
        return False
    if baseline.get("branch") != authorization["branch"]:
        return False
    if baseline.get("head_symbolic") != f"refs/heads/{authorization['branch']}" or baseline.get("expected_head") != authorization["expected_head"]:
        return False
    if not all(isinstance(baseline.get(key), str) and SHA256_RE.fullmatch(baseline[key]) for key in ("config_digest", "tags_digest", "remotes_digest")):
        return False
    refs = baseline.get("refs")
    if not isinstance(refs, dict) or not all(
        isinstance(name, str) and isinstance(value, list) and len(value) == 2
        and isinstance(value[0], str) and GIT_SHA_RE.fullmatch(value[0])
        and isinstance(value[1], str)
        for name, value in refs.items()
    ):
        return False
    return all(intent.get(key) == value for key, value in expected.items())


def local_commit_git_output(repository_root: str, *args: str) -> str:
    try:
        result = subprocess.run(
            ["git", "-C", repository_root, *args], capture_output=True, text=True,
            stdin=subprocess.DEVNULL, timeout=30,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise SystemExit("AUTHORIZATION_COMMIT_NOT_FOUND") from exc
    if result.returncode != 0:
        raise SystemExit("AUTHORIZATION_COMMIT_NOT_FOUND")
    return result.stdout


def validate_local_commit_receipt(authorization: dict[str, Any], operation: dict[str, Any], commit_sha: str) -> None:
    receipt = operation.get("receipt")
    effect = operation.get("effect")
    if not isinstance(receipt, dict) or not isinstance(effect, dict):
        raise SystemExit("AUTHORIZATION_COMMIT_RECEIPT_MISMATCH")
    if receipt.get("status") not in {"SUCCESS", "CONFIRMED"}:
        raise SystemExit("AUTHORIZATION_COMMIT_RECEIPT_MISMATCH")
    for source in (receipt, effect):
        if source.get("authorization_id") != authorization["authorization_id"]:
            raise SystemExit("AUTHORIZATION_COMMIT_RECEIPT_MISMATCH")
        if source.get("authority") != authorization["authority"] or source.get("request_id") != authorization["request_id"]:
            raise SystemExit("AUTHORIZATION_COMMIT_RECEIPT_MISMATCH")
        if source.get("commit_sha") != commit_sha:
            raise SystemExit("AUTHORIZATION_COMMIT_RECEIPT_MISMATCH")
        if authorization.get("grant_kind") == "governed" and (
            source.get("parent_run_id") != authorization.get("parent_run_id")
            or source.get("work_unit_id") != authorization.get("work_unit_id")
            or source.get("candidate_diff_sha") != authorization.get("candidate_diff_sha")
            or source.get("source_scope") != authorization.get("source_scope")
        ):
            raise SystemExit("AUTHORIZATION_COMMIT_RECEIPT_MISMATCH")
    if receipt.get("branch") != authorization["branch"] or receipt.get("paths") != authorization["allowed_paths"]:
        raise SystemExit("AUTHORIZATION_COMMIT_RECEIPT_MISMATCH")
    if receipt.get("message") != authorization["commit_message"]:
        raise SystemExit("AUTHORIZATION_COMMIT_RECEIPT_MISMATCH")
    if (
        effect.get("parent_sha") != authorization["expected_head"]
        or effect.get("branch") != authorization["branch"]
        or effect.get("paths") != authorization["allowed_paths"]
    ):
        raise SystemExit("AUTHORIZATION_COMMIT_RECEIPT_MISMATCH")
    if not GIT_SHA_RE.fullmatch(commit_sha):
        raise SystemExit("AUTHORIZATION_COMMIT_NOT_FOUND")
    branch_head = local_commit_git_output(authorization["repository_root"], "rev-parse", f"refs/heads/{authorization['branch']}").strip()
    if branch_head != commit_sha:
        raise SystemExit("AUTHORIZATION_COMMIT_RECEIPT_MISMATCH")
    parents = local_commit_git_output(authorization["repository_root"], "show", "-s", "--format=%P", commit_sha).strip().split()
    if parents != [authorization["expected_head"]]:
        raise SystemExit("AUTHORIZATION_COMMIT_RECEIPT_MISMATCH")
    message = local_commit_git_output(authorization["repository_root"], "show", "-s", "--format=%B", commit_sha).rstrip("\n")
    if message != authorization["commit_message"]:
        raise SystemExit("AUTHORIZATION_COMMIT_RECEIPT_MISMATCH")
    tree_sha = local_commit_git_output(authorization["repository_root"], "show", "-s", "--format=%T", commit_sha).strip()
    for source in (receipt, effect):
        if source.get("tree_sha") != tree_sha:
            raise SystemExit("AUTHORIZATION_COMMIT_RECEIPT_MISMATCH")
    paths = sorted(set(local_commit_git_output(
        authorization["repository_root"], "diff-tree", "--no-commit-id", "--name-only", "-r", "-z", commit_sha,
    ).split("\0")) - {""})
    if paths != authorization["allowed_paths"]:
        raise SystemExit("AUTHORIZATION_COMMIT_RECEIPT_MISMATCH")


def cmd_authorization(args: argparse.Namespace) -> int:
    data = read_state(args.run_id)
    require_v2(data, "authorization")
    ensure_v2_defaults(data)
    validate_state(data)
    if args.authorization_action == "create":
        require_active_run(data, "authorization create")
        governed = data.get("commit_policy") == "governed"
        if data.get("commit_policy") not in {"authorized", "governed"}:
            raise SystemExit("local_commit authorization requires a typed governed commit policy")
        standing = data.get("commit_policy_authorization")
        if governed and (not isinstance(standing, dict) or standing.get("status") != "active"):
            raise SystemExit("local_commit authorization requires an active standing commit policy authorization")
        repository_root = normalize_repository_path(args.repository_root)
        if not governed and repository_root != normalize_repository_path(data["repository_root"]):
            raise SystemExit("AUTHORIZATION_REPOSITORY_IDENTITY_MISMATCH")
        if not isinstance(args.branch, str) or not args.branch:
            raise SystemExit("--branch is required")
        if not governed and data.get("branch") is not None and data["branch"] != args.branch:
            raise SystemExit("AUTHORIZATION_BRANCH_IDENTITY_MISMATCH")
        if args.authority not in AUTHORIZATION_AUTHORITIES:
            raise SystemExit("--authority is required")
        if governed and args.authority != STANDING_AUTHORITY:
            raise SystemExit("governed local_commit authorization requires authority=user")
        if not isinstance(args.request_id, str) or not args.request_id:
            raise SystemExit("--request-id is required")
        if args.max_uses != 1:
            raise SystemExit("local_commit authorization requires --max-uses 1")
        expected_head = require_candidate_sha(args.expected_head, "--expected-head")
        paths = normalize_allowed_paths(args.allowed_path or [])
        message = args.commit_message
        if not isinstance(message, str) or not message:
            raise SystemExit("--message is required")
        work_unit_id: str | None = None
        candidate_diff_sha: str | None = None
        source_operation_id: str | None = None
        source_request_id: str | None = None
        accepted_work_unit: dict[str, Any] | None = None
        parent_run_id: str | None = None
        if governed:
            parent_run_id = data["run_id"]
            work_unit_id = require_work_unit_id(args.work_unit_id)
            candidate_diff_sha = require_scope_digest(args.candidate_diff_sha, "--candidate-diff-sha")
            source_request_id = args.source_request_id or standing.get("source_request_id")
            source_operation_id = args.source_operation_id or (standing.get("source") or {}).get("operation_id")
            if not isinstance(source_request_id, str) or not source_request_id:
                raise SystemExit("--source-request-id is required for governed local_commit authorization")
            standing_source = standing.get("source") if isinstance(standing, dict) else None
            if (
                not isinstance(standing_source, dict)
                or source_request_id != standing_source.get("request_id")
                or source_operation_id != standing_source.get("operation_id")
            ):
                raise SystemExit("GOVERNED_AUTHORIZATION_SOURCE_IDENTITY_MISMATCH")
            accepted_work_unit = source_operation_for_accepted_work_unit(
                data, operation_id_value=source_operation_id, request_id=source_request_id,
                require_commit_scope=True,
            )
            if accepted_work_unit["response_type"] != "sub_objective_complete":
                raise SystemExit("GOVERNED_AUTHORIZATION_SOURCE_NOT_ACCEPTED")
            if accepted_work_unit["request_id"] != source_request_id or accepted_work_unit["work_unit_id"] != work_unit_id:
                raise SystemExit("governed local_commit authorization source identity mismatch")
            if accepted_work_unit["repository_root"] != repository_root or accepted_work_unit["branch"] != args.branch:
                raise SystemExit("governed local_commit authorization target identity mismatch")
            expected_source_scope = {
                "repository_root": repository_root, "branch": args.branch,
                "expected_head": expected_head, "candidate_diff_sha": candidate_diff_sha,
                "allowed_paths": paths, "commit_message": message,
            }
            validated_source_scope = accepted_work_unit.get("source_scope")
            if validated_source_scope != expected_source_scope:
                raise SystemExit("GOVERNED_AUTHORIZATION_SOURCE_SCOPE_MISMATCH")
        expires_at = args.expires_at
        parse_authorization_expiry(expires_at)
        scope_digest = authorization_scope_digest(
            repository_root, args.branch, expected_head, paths, message,
            parent_run_id=parent_run_id, work_unit_id=work_unit_id,
            candidate_diff_sha=candidate_diff_sha,
        )
        if args.scope_digest is not None and args.scope_digest != scope_digest:
            raise SystemExit("AUTHORIZATION_SCOPE_DIGEST_MISMATCH")
        auth_id = authorization_id(args.authority, args.request_id, scope_digest)
        expected = {
            "authorization_id": auth_id,
            "kind": "local_commit",
            "authority": args.authority,
            "request_id": args.request_id,
            "repository_root": repository_root,
            "branch": args.branch,
            "expected_head": expected_head,
            "allowed_paths": paths,
            "scope_digest": scope_digest,
            "commit_message": message,
            "commit_message_digest": hashlib.sha256(message.encode()).hexdigest(),
            "max_uses": args.max_uses,
            "expires_at": expires_at,
        }
        if governed:
            expected.update({
                "grant_kind": "governed", "parent_run_id": parent_run_id,
                "work_unit_id": work_unit_id, "candidate_diff_sha": candidate_diff_sha,
                "source_operation_id": source_operation_id, "source_request_id": source_request_id,
                "source_scope": copy.deepcopy(validated_source_scope),
                "accepted_work_unit": {key: accepted_work_unit[key] for key in (
                    "work_unit_id", "repository_root", "branch",
                )},
            })
        existing = next(
            (item for item in data["authorizations"]
             if isinstance(item, dict) and item.get("kind") == "local_commit" and item.get("request_id") == args.request_id),
            None,
        )
        if existing is not None:
            if any(existing.get(key) != value for key, value in expected.items() if key != "authorization_id"):
                raise SystemExit("AUTHORIZATION_IDEMPOTENCY_CONFLICT")
            if existing.get("authorization_id") != auth_id:
                raise SystemExit("AUTHORIZATION_IDEMPOTENCY_CONFLICT")
            print(json.dumps(data, indent=2, ensure_ascii=False, sort_keys=True))
            return 0
        authorization = {
            **expected,
            "consumed_uses": 0,
            "status": "open",
            "authorized_at": utcnow(),
            "consumed_at": None,
        }
        data["authorizations"].append(authorization)
        saved = write_state(data, args.expect_revision)
        append_event(args.run_id, "authorization.created", "bounded local_commit authorization created", {
            "authorization_id": auth_id, "kind": "local_commit", "authority": args.authority,
            "request_id": args.request_id, "scope_digest": scope_digest, "revision": saved["revision"],
        })
        print(json.dumps(saved, indent=2, ensure_ascii=False, sort_keys=True))
        return 0

    require_nonterminal_run(data, "authorization consume")
    authorization = find_authorization(data, args.authorization_id)
    if authorization.get("status") == "consumed" and authorization.get("consumed_uses", 0) >= authorization.get("max_uses", 0):
        operation = find_operation(data, args.operation_id)
        if (
            authorization_operation_matches(authorization, operation)
            and operation.get("status") == "confirmed"
            and isinstance(operation.get("receipt"), dict)
            and operation["receipt"].get("commit_sha") == args.commit_sha
        ):
            validate_local_commit_receipt(authorization, operation, args.commit_sha)
            print(json.dumps(data, indent=2, ensure_ascii=False, sort_keys=True))
            return 0
        raise SystemExit("AUTHORIZATION_REPLAY")
    if authorization.get("status") != "open":
        raise SystemExit("AUTHORIZATION_NOT_CONSUMABLE")
    if authorization_is_expired(authorization):
        authorization["status"] = "expired"
        authorization["consumed_at"] = utcnow()
        saved = write_state(data, args.expect_revision)
        append_event(args.run_id, "authorization.expired", "local_commit authorization expired", {
            "authorization_id": authorization["authorization_id"], "revision": saved["revision"],
        })
        print(json.dumps(saved, indent=2, ensure_ascii=False, sort_keys=True))
        return 1
    operation = find_operation(data, args.operation_id)
    if not authorization_operation_matches(authorization, operation):
        raise SystemExit("AUTHORIZATION_OPERATION_IDENTITY_MISMATCH")
    if operation.get("status") != "confirmed":
        raise SystemExit("authorization consume requires a confirmed local_commit operation")
    receipt = operation.get("receipt")
    if not isinstance(args.commit_sha, str) or not isinstance(receipt, dict) or receipt.get("commit_sha") != args.commit_sha:
        raise SystemExit("AUTHORIZATION_COMMIT_RECEIPT_MISMATCH")
    validate_local_commit_receipt(authorization, operation, args.commit_sha)
    if authorization["consumed_uses"] >= authorization["max_uses"]:
        raise SystemExit("AUTHORIZATION_REPLAY")
    authorization["consumed_uses"] += 1
    if authorization["consumed_uses"] == authorization["max_uses"]:
        authorization["status"] = "consumed"
    authorization["consumed_at"] = utcnow()
    saved = write_state(data, args.expect_revision)
    append_event(args.run_id, "authorization.consumed", "local_commit authorization consumed", {
        "authorization_id": authorization["authorization_id"], "operation_id": operation["operation_id"],
        "commit_sha": args.commit_sha, "revision": saved["revision"],
    })
    print(json.dumps(saved, indent=2, ensure_ascii=False, sort_keys=True))
    return 0


def frontier_retry_projection(data: dict[str, Any], operation: dict[str, Any]) -> dict[str, Any]:
    projected = copy.deepcopy(data)
    status = operation.get("status")
    projected["retry_result"] = {
        "successor_operation_id": operation.get("operation_id"),
        "successor_status": status,
        "transport_required": status == "intent" and operation.get("effect") is None and operation.get("receipt") is None,
    }
    return projected


def cmd_frontier_retry(args: argparse.Namespace) -> int:
    """Create a linked, idempotent retry for a proven pre-effect failure.

    The retry preserves the predecessor's immutable purpose.  Only transport
    identity fields (task/chat/artifact identity) may change; any other
    ``--intent-json`` override is rejected before a successor is recorded.
    """
    data = read_state(args.run_id)
    require_v2(data, "frontier retry")
    ensure_v2_defaults(data)
    require_active_run(data, "frontier retry")
    ensure_route_allows(data, "frontier")
    if not args.operation_id:
        raise SystemExit("Frontier retry requires --operation-id")
    predecessor = find_operation(data, args.operation_id)
    if predecessor.get("kind") != "frontier_exchange":
        raise SystemExit("FRONTIER_RETRY_WRONG_KIND")
    if predecessor.get("status") != "failed":
        raise SystemExit("FRONTIER_RETRY_REQUIRES_FAILED_OPERATION")
    identity = frontier_operation_identity(predecessor)
    if identity["request_id"] != args.request_id:
        raise SystemExit("FRONTIER_RETRY_REQUEST_ID_MISMATCH")
    require_safe_operation_resolution(
        predecessor, explicit_pre_effect_proof=bool(args.pre_effect_absence_proven),
    )
    intent = copy.deepcopy(predecessor.get("intent"))
    if not isinstance(intent, dict):
        raise SystemExit("FRONTIER_RETRY_INVALID_PREDECESSOR_INTENT")
    override = parse_object_json(args.intent_json, "--intent-json")
    disallowed = sorted(set(override) - FRONTIER_RETRY_ALLOWED_OVERRIDE_KEYS)
    if disallowed:
        raise SystemExit("FRONTIER_RETRY_IMMUTABLE_INTENT_FIELDS: " + ", ".join(disallowed))
    if override:
        intent.update(override)
    task_id = args.task_id or intent.get("task_id") or identity["task_id"]
    if not isinstance(task_id, str) or not task_id:
        raise SystemExit("Frontier retry requires --task-id when the predecessor has none")
    intent.update({
        "request_id": args.request_id,
        "task_id": task_id,
        "predecessor_operation_id": predecessor["operation_id"],
    })
    intent.pop("message_id", None)
    key = args.idempotency_key or f"frontier-retry:{predecessor['operation_id']}"
    operation, created = record_operation_intent(
        data, kind="frontier_exchange", idempotency_key=key, intent=intent,
    )
    if not created:
        print(json.dumps(frontier_retry_projection(data, operation), indent=2, ensure_ascii=False, sort_keys=True))
        return 0
    operation["predecessor_operation_id"] = predecessor["operation_id"]
    operation["predecessor_operation_ids"] = [predecessor["operation_id"]]
    operation["purpose_digest"] = frontier_purpose_digest(data, operation["intent"])
    operation["attempt_group_id"] = predecessor.get("attempt_group_id") or f"attempt-{operation['purpose_digest'][:24]}"
    predecessor["attempt_group_id"] = operation["attempt_group_id"]
    if predecessor.get("successor_operation_id") not in {None, operation["operation_id"]}:
        raise SystemExit("OPERATION_SUCCESSOR_ALREADY_LINKED")
    predecessor["successor_operation_id"] = operation["operation_id"]
    validate_purpose_digest_continuity(predecessor, operation)
    data["last_request_id"] = args.request_id
    data["frontier_task_id"] = task_id
    gate = data.get("parent_gate")
    if isinstance(gate, dict) and gate.get("operation_id") == predecessor["operation_id"]:
        gate["operation_id"] = operation["operation_id"]
        gate["request_id"] = args.request_id
        gate["message_id"] = None
    saved = write_state(data, args.expect_revision)
    append_event(args.run_id, "frontier.retry_intent_recorded", "safe pre-effect Frontier retry", {
        "operation_id": operation["operation_id"],
        "predecessor_operation_id": predecessor["operation_id"],
        "request_id": args.request_id,
        "revision": saved["revision"],
    })
    print(json.dumps(frontier_retry_projection(saved, operation), indent=2, ensure_ascii=False, sort_keys=True))
    return 0


def cmd_frontier(args: argparse.Namespace) -> int:
    """Persist a Frontier exchange intent before browser transport is invoked."""
    if args.frontier_action == "retry":
        return cmd_frontier_retry(args)
    if args.frontier_action == "result":
        return cmd_frontier_result(args)
    if args.frontier_action == "recover":
        return cmd_frontier_recover(args)
    data = read_state(args.run_id)
    require_v2(data, "frontier")
    ensure_v2_defaults(data)
    require_active_run(data, "frontier start")
    ensure_route_allows(data, "frontier")
    artifact_root = artifact_root_for_state(data)
    if not isinstance(args.request_id, str) or not args.request_id.strip():
        raise SystemExit("--request-id must be a non-empty string")
    if not isinstance(args.task_id, str) or not args.task_id.strip():
        raise SystemExit("--task-id must be a non-empty string")
    intent = parse_object_json(args.intent_json, "--intent-json")
    predecessor = None
    if args.predecessor_operation_id is not None:
        predecessor = find_operation(data, args.predecessor_operation_id)
        if predecessor.get("kind") != "frontier_exchange":
            raise SystemExit("FRONTIER_SUCCESSOR_WRONG_PREDECESSOR_KIND")
        require_safe_operation_resolution(
            predecessor, explicit_pre_effect_proof=bool(args.pre_effect_absence_proven),
        )
        intent["predecessor_operation_id"] = predecessor["operation_id"]
    requested_artifact_root = intent.get("artifact_root")
    if requested_artifact_root is not None:
        if normalize_artifact_root(str(requested_artifact_root), data["repository_root"]) != artifact_root:
            raise SystemExit("FRONTIER_ARTIFACT_ROOT_IDENTITY_MISMATCH")
    intent["artifact_root"] = artifact_root
    intent.update({"request_id": args.request_id, "task_id": args.task_id})
    intent.setdefault("scope", data["scope"])
    if args.message_id is not None:
        intent["message_id"] = args.message_id
    if args.scope is not None:
        intent["scope"] = args.scope
    if args.chat_url is not None:
        intent["chat_url"] = args.chat_url
    identity_chat_url = args.chat_url if args.chat_url is not None else intent.get("chat_url")
    existing_frontier = existing_frontier_identity(
        data,
        request_id=args.request_id,
        task_id=args.task_id,
        message_id=args.message_id,
        scope=intent.get("scope"),
        chat_url=identity_chat_url,
        intent=intent,
    )
    if existing_frontier is not None:
        print(json.dumps(data, indent=2, ensure_ascii=False, sort_keys=True))
        return 0
    if data.get("artifact_root") is None:
        data["artifact_root"] = artifact_root
    parent_gate = data.get("parent_gate")
    starting_parent_gate = parent_gate_needs_request(data)
    if starting_parent_gate:
        intent["parent_gate"] = True
        intent["purpose"] = "parent_gate"
        intent["completed_work_unit_id"] = parent_gate.get("completed_work_unit_id")
    key = args.idempotency_key or f"frontier:{args.request_id}"
    if is_continuous_parent(data) and isinstance(parent_gate, dict) and parent_gate.get("status") == "requested":
        expected_operation_id = operation_id("frontier_exchange", key)
        if parent_gate.get("operation_id") != expected_operation_id:
            raise SystemExit("PARENT_GATE_ALREADY_REQUESTED")
    operation, created = record_operation_intent(
        data, kind="frontier_exchange", idempotency_key=key, intent=intent,
    )
    if not created:
        print(json.dumps(data, indent=2, ensure_ascii=False, sort_keys=True))
        return 0
    operation["purpose_digest"] = frontier_purpose_digest(data, operation["intent"])
    operation["attempt_group_id"] = (
        predecessor.get("attempt_group_id") if predecessor is not None else None
    ) or f"attempt-{operation['purpose_digest'][:24]}"
    if predecessor is not None:
        operation["predecessor_operation_id"] = predecessor["operation_id"]
        operation["predecessor_operation_ids"] = [predecessor["operation_id"]]
        predecessor["attempt_group_id"] = operation["attempt_group_id"]
        if predecessor.get("successor_operation_id") not in {None, operation["operation_id"]}:
            raise SystemExit("OPERATION_SUCCESSOR_ALREADY_LINKED")
        predecessor["successor_operation_id"] = operation["operation_id"]
        validate_purpose_digest_continuity(predecessor, operation)
    data["last_request_id"] = args.request_id
    data["frontier_task_id"] = args.task_id
    if args.chat_url is not None:
        data["frontier_chat_url"] = args.chat_url
    if starting_parent_gate:
        if isinstance(parent_gate, dict) and parent_gate.get("status") == "confirmed":
            data.setdefault("parent_gate_history", []).append(copy.deepcopy(parent_gate))
        data["parent_gate"] = {
            **parent_gate,
            "status": "requested", "operation_id": operation["operation_id"],
            "request_id": args.request_id, "message_id": args.message_id,
        }
    saved = write_state(data, args.expect_revision)
    append_event(args.run_id, "frontier.intent_recorded", None, {
        "operation_id": operation["operation_id"], "request_id": args.request_id,
        "task_id": args.task_id, "revision": saved["revision"],
    })
    print(json.dumps(saved, indent=2, ensure_ascii=False, sort_keys=True))
    return 0


def frontier_response_objects(args: argparse.Namespace, *, recovery: bool) -> tuple[dict[str, Any], dict[str, Any]]:
    if recovery and (args.effect_json is None or args.receipt_json is None):
        raise SystemExit("Frontier recovery requires both --effect-json and --receipt-json")
    effect = sanitize_frontier_payload(parse_object_json(args.effect_json, "--effect-json")) if args.effect_json is not None else {}
    receipt = sanitize_frontier_payload(parse_object_json(args.receipt_json, "--receipt-json")) if args.receipt_json is not None else {}
    return effect, receipt


def frontier_identity_errors(
    source: dict[str, Any], *, request_id: str, message_id: str | None,
    task_id: str | None, scope: str | None, transport_status: str, decision: str | None,
    label: str,
) -> list[str]:
    errors: list[str] = []
    source_request = source.get("request_id")
    if source_request is not None and source_request != request_id:
        errors.append(f"{label} request_id mismatch")
    source_message = frontier_message_id(source)
    if source_message in {"<invalid>", "<conflict>"}:
        errors.append(f"{label} message identity is malformed")
    elif source_message is not None and source_message != message_id:
        errors.append(f"{label} message_id mismatch")
    if task_id is not None and source.get("task_id") is not None and source.get("task_id") != task_id:
        errors.append(f"{label} task_id scope mismatch")
    if scope is not None and source.get("scope") is not None and source.get("scope") != scope:
        errors.append(f"{label} scope mismatch")
    if "transport_status" in source:
        try:
            if normalize_frontier_transport_status(source["transport_status"]) != transport_status:
                errors.append(f"{label} transport_status mismatch")
        except SystemExit:
            errors.append(f"{label} transport_status is malformed")
    if "frontier_decision" in source:
        try:
            source_decision = normalize_frontier_decision(source["frontier_decision"], allow_none=True)
        except SystemExit:
            errors.append(f"{label} frontier_decision is malformed")
        else:
            if source_decision != decision:
                errors.append(f"{label} frontier_decision mismatch")
    return errors


def build_frontier_response(
    data: dict[str, Any], operation: dict[str, Any], args: argparse.Namespace, *, recovery: bool,
) -> tuple[str, str | None, str, str | None, str, bool, dict[str, Any], dict[str, Any], list[str]]:
    requested_status = normalize_frontier_transport_status(args.transport_status)
    requested_decision = normalize_frontier_decision(args.frontier_decision, allow_none=True)
    effect_raw, receipt_raw = frontier_response_objects(args, recovery=recovery)
    response_type = response_type_from_sources(args.response_type, effect_raw, receipt_raw)
    if getattr(args, "plan_json", None) is not None:
        plan = parse_object_json(args.plan_json, "--plan-json")
        for source in (effect_raw, receipt_raw):
            if source.get("proposed_plan") is not None and source["proposed_plan"] != plan:
                raise SystemExit("Frontier proposed_plan conflicts with --plan-json")
            source["proposed_plan"] = plan
        if response_type is None:
            response_type = "plan"
    if getattr(args, "clarification_json", None) is not None:
        clarification = parse_object_json(args.clarification_json, "--clarification-json")
        for source in (effect_raw, receipt_raw):
            if source.get("clarification") is not None and source["clarification"] != clarification:
                raise SystemExit("Frontier clarification conflicts with --clarification-json")
            source["clarification"] = clarification
    request_id = args.request_id
    message_id = args.message_id or frontier_message_id(effect_raw) or frontier_message_id(receipt_raw)
    task_id = args.task_id
    scope = args.scope
    expected = frontier_operation_identity(operation)
    errors: list[str] = []

    if expected["request_id"] is not None and request_id != expected["request_id"]:
        errors.append("request_id does not match the Frontier operation")
    if expected["message_id"] is not None and message_id != expected["message_id"]:
        errors.append("message_id does not match the Frontier operation")
    if expected["task_id"] is not None and task_id is not None and task_id != expected["task_id"]:
        errors.append("task_id scope does not match the Frontier operation")
    if expected["scope"] is not None and scope is not None and scope != expected["scope"]:
        errors.append("scope does not match the Frontier operation")
    if task_id is None:
        task_id = expected["task_id"]
    if scope is None:
        scope = expected["scope"]

    if requested_status == "success" and requested_decision is None:
        errors.append("successful Frontier transport requires frontier_decision")
    if requested_status == "success" and not message_id:
        errors.append("successful Frontier transport requires message_id")
    if not isinstance(request_id, str) or not request_id:
        errors.append("request_id is required")
    for source, label in ((effect_raw, "effect"), (receipt_raw, "receipt")):
        if args.effect_json is not None or label == "receipt":
            errors.extend(frontier_identity_errors(
                source, request_id=request_id, message_id=message_id, task_id=task_id,
                scope=scope, transport_status=requested_status, decision=requested_decision, label=label,
            ))
    plan_supplied = getattr(args, "plan_json", None) is not None
    if requested_status == "success" and ((args.effect_json is None and not plan_supplied) or (args.receipt_json is None and not plan_supplied)):
        errors.append("successful Frontier transport requires effect and receipt")
    if response_type is not None and response_type_from_sources(effect_raw, receipt_raw) not in {None, response_type}:
        errors.append("effect and receipt response_type mismatch")
    if requested_status == "success" and effect_raw != {} and receipt_raw != {}:
        effect_message = frontier_message_id(effect_raw)
        receipt_message = frontier_message_id(receipt_raw)
        if effect_message != receipt_message:
            errors.append("effect and receipt response identity mismatch")
        if effect_raw.get("request_id") is not None and receipt_raw.get("request_id") is not None \
                and effect_raw.get("request_id") != receipt_raw.get("request_id"):
            errors.append("effect and receipt request_id mismatch")

    effect_stage = requested_effect_stage(
        args, status=requested_status, message_id=message_id,
        effect=effect_raw, receipt=receipt_raw,
    )
    absence_proven = False
    if effect_stage == "none":
        absence_proven = pre_effect_absence_proven(args, effect_raw, receipt_raw)
        if requested_status == "success":
            errors.append("effect_stage none is incompatible with successful Frontier transport")
        elif requested_status == "timeout":
            errors.append("timeout cannot classify an exchange as pre-effect absence")
        elif not absence_proven:
            errors.append("effect_stage none requires proof that no browser tab or outbound request existed")
        elif message_id is not None:
            errors.append("pre-effect Frontier failure cannot have message_id")
        if errors:
            # Incomplete or contradictory evidence never persists a no-effect
            # stage or a retryable proof; keep the failure conservative.
            absence_proven = False
            effect_stage = "transport_started"
    elif effect_stage == "response_observed" and requested_status != "success":
        # A response identity is useful recovery evidence, but a transport
        # failure that observed a response must be represented as ambiguous
        # rather than silently promoted to a no-effect retry.
        if message_id is None:
            errors.append("response_observed requires message_id")

    status = requested_status
    decision = requested_decision if not errors else None
    if errors and requested_status == "success":
        if any("request_id" in error or "scope" in error or "task_id" in error for error in errors):
            status = "request_mismatch"
        elif any("message" in error or "response identity" in error for error in errors):
            status = "response_identity_mismatch"
        else:
            status = "malformed"

    if errors:
        effect = {
            "transport_status": status, "frontier_decision": None,
            "request_id": request_id, "message_id": message_id,
            "effect_stage": effect_stage,
            "task_id": task_id, "scope": scope, "validation_errors": sorted(set(errors)),
            "response": effect_raw,
        }
        if absence_proven:
            effect["pre_effect_absence_proven"] = True
        if response_type is not None:
            effect["response_type"] = response_type
        receipt = {
            "transport_status": status, "frontier_decision": None,
            "request_id": request_id, "message_id": message_id,
            "effect_stage": effect_stage,
            "task_id": task_id, "scope": scope, "validation_errors": sorted(set(errors)),
            "response": receipt_raw,
        }
        if absence_proven:
            receipt["pre_effect_absence_proven"] = True
        if response_type is not None:
            receipt["response_type"] = response_type
    else:
        def complete(source: dict[str, Any]) -> dict[str, Any]:
            result = dict(source)
            result.update({
                "transport_status": status, "frontier_decision": decision,
                "request_id": request_id, "message_id": message_id,
                "effect_stage": effect_stage,
            })
            if absence_proven:
                result["pre_effect_absence_proven"] = True
            if response_type is not None:
                result["response_type"] = response_type
            if task_id is not None:
                result["task_id"] = task_id
            if scope is not None:
                result["scope"] = scope
            return result

        effect = complete(effect_raw)
        receipt = complete(receipt_raw)
    return status, decision, request_id, message_id, effect_stage, absence_proven, effect, receipt, errors


def frontier_recovery_projection(entry: dict[str, Any]) -> dict[str, Any]:
    return {key: value for key, value in entry.items() if key != "recorded_at"}


def frontier_recovery_entry(
    operation: dict[str, Any], *, status: str, decision: str, request_id: str, message_id: str,
    task_id: str | None, scope: str | None, effect: dict[str, Any], receipt: dict[str, Any],
) -> dict[str, Any]:
    evidence = {
        "transport_status": status,
        "frontier_decision": decision,
        "request_id": request_id,
        "message_id": message_id,
        "effect_stage": "response_observed",
        "task_id": task_id,
        "scope": scope,
        "effective_status": "confirmed",
        "effect": effect,
        "receipt": receipt,
    }
    encoded = json.dumps({"operation_id": operation["operation_id"], **evidence}, ensure_ascii=False, sort_keys=True, separators=(",", ":"))
    return {
        "recovery_id": "recovery-" + hashlib.sha256(encoded.encode()).hexdigest()[:24],
        **evidence,
        "recorded_at": utcnow(),
    }


def frontier_typed_lifecycle_outcome(operation: dict[str, Any]) -> tuple[str, str | None, list[str]] | None:
    """Interpret typed fields on the generic lifecycle without breaking old v2 records."""
    effect = operation.get("effect")
    receipt = operation.get("receipt")
    sources = [source for source in (effect, receipt) if isinstance(source, dict)]
    if not any("transport_status" in source or "frontier_decision" in source for source in sources):
        return None
    errors: list[str] = []
    status: str | None = None
    decision: str | None = None
    expected = frontier_operation_identity(operation)
    for source, label in ((effect, "effect"), (receipt, "receipt")):
        if not isinstance(source, dict):
            errors.append(f"{label} is missing")
            continue
        try:
            source_status = normalize_frontier_transport_status(source.get("transport_status"))
        except SystemExit:
            errors.append(f"{label} transport_status is malformed")
            continue
        if status is None:
            status = source_status
        elif status != source_status:
            errors.append("effect and receipt transport_status mismatch")
        source_message = frontier_message_id(source)
        if source.get("request_id") != expected["request_id"]:
            errors.append(f"{label} request_id mismatch")
        if source_message in {None, "<invalid>", "<conflict>"}:
            errors.append(f"{label} message identity is missing or malformed")
        elif expected["message_id"] is not None and source_message != expected["message_id"]:
            errors.append(f"{label} message_id mismatch")
        try:
            source_decision = normalize_frontier_decision(source.get("frontier_decision"), allow_none=True)
        except SystemExit:
            errors.append(f"{label} frontier_decision is malformed")
            source_decision = None
        if decision is None:
            decision = source_decision
        elif decision != source_decision:
            errors.append("effect and receipt frontier_decision mismatch")
    if status == "success" and decision is None:
        errors.append("successful Frontier transport requires frontier_decision")
    if status is None:
        status = "malformed"
    if errors and any("request_id" in error for error in errors):
        status = "request_mismatch"
    elif errors and any("message" in error for error in errors):
        status = "response_identity_mismatch"
    elif errors:
        status = "malformed"
    return status, decision if status == "success" and not errors else None, errors


def is_continuous_parent(data: dict[str, Any]) -> bool:
    return data.get("scope") == "continuous" and bool(data.get("parent_objective"))


def parent_gate_needs_request(data: dict[str, Any]) -> bool:
    if not is_continuous_parent(data):
        return False
    gate = data.get("parent_gate")
    if not isinstance(gate, dict):
        return False
    if gate.get("status") in {"required", "blocked"}:
        return True
    return (
        gate.get("status") == "confirmed"
        and gate.get("response_type") != PARENT_GATE_TERMINAL_RESPONSE
        and not isinstance(data.get("next_work_unit"), dict)
    )


def is_parent_gate_operation(operation: dict[str, Any]) -> bool:
    intent = operation.get("intent")
    return (
        operation.get("kind") == "parent_gate"
        or (isinstance(intent, dict) and (intent.get("parent_gate") is True or intent.get("purpose") == "parent_gate"))
    )


def parent_gate_response_type(operation: dict[str, Any]) -> str | None:
    return normalize_frontier_response_type(
        operation.get("response_type")
        or response_type_from_sources(operation.get("effect"), operation.get("receipt")),
        allow_none=True,
    )


def next_work_unit_id_from_plan(
    plan: dict[str, Any], operation: dict[str, Any], explicit_id: str | None = None,
) -> str:
    candidate = explicit_id
    if candidate is None:
        for key in ("work_unit_id", "next_work_unit_id"):
            if isinstance(plan.get(key), str):
                candidate = plan[key]
                break
    if candidate is None:
        intent = operation.get("intent")
        if isinstance(intent, dict) and isinstance(intent.get("next_work_unit_id"), str):
            candidate = intent["next_work_unit_id"]
    return require_work_unit_id(candidate)


def apply_parent_gate_response(
    data: dict[str, Any], operation: dict[str, Any], *, response_type: str,
    effect: dict[str, Any], receipt: dict[str, Any], next_work_unit_id: str | None = None,
) -> None:
    """Apply one confirmed typed parent gate and its optional plan handoff."""
    if not is_continuous_parent(data):
        return
    response_type = normalize_frontier_response_type(response_type)  # type: ignore[assignment]
    if not is_parent_gate_operation(operation):
        return
    request_id = effect.get("request_id") or receipt.get("request_id")
    message_id = frontier_message_id(effect) or frontier_message_id(receipt)
    if not isinstance(request_id, str) or not request_id or not isinstance(message_id, str) or not message_id:
        raise SystemExit("PARENT_GATE_IDENTITY_REQUIRED")
    if operation.get("status") not in {"confirmed", "failed"} and operation.get("effective_status") != "confirmed":
        raise SystemExit("PARENT_GATE_REQUIRES_CONFIRMED_FRONTIER_EVIDENCE")
    gate = data.get("parent_gate")
    completed_work_unit_id = gate.get("completed_work_unit_id") if isinstance(gate, dict) else None
    intent = operation.get("intent")
    if completed_work_unit_id is None and isinstance(intent, dict):
        completed_work_unit_id = intent.get("completed_work_unit_id")
    if completed_work_unit_id is not None:
        completed_work_unit_id = require_work_unit_id(completed_work_unit_id)

    plan = proposed_plan_from_sources(effect, receipt)
    if response_type == "plan":
        if plan is None:
            raise SystemExit("PARENT_GATE_PLAN_REQUIRED")
        work_unit_id = next_work_unit_id_from_plan(plan, operation, next_work_unit_id)
        existing = data.get("next_work_unit")
        provenance = {
            "operation_id": operation["operation_id"],
            "request_id": request_id,
            "message_id": message_id,
            "frontier_decision": operation.get("frontier_decision") or effect.get("frontier_decision"),
            "effect": copy.deepcopy(effect),
            "receipt": copy.deepcopy(receipt),
        }
        candidate = {
            "status": "approved",
            "work_unit_id": work_unit_id,
            "intent": copy.deepcopy(plan),
            "provenance": provenance,
            "approved_at": utcnow(),
        }
        if isinstance(existing, dict):
            if (
                existing.get("work_unit_id") == work_unit_id
                and existing.get("intent") == plan
                and existing.get("provenance", {}).get("operation_id") == operation.get("operation_id")
            ):
                return
            if existing.get("status") in {"approved", "active"}:
                raise SystemExit("NEXT_WORK_UNIT_HANDOFF_CONFLICT")
        previous_gate = data.get("parent_gate")
        if isinstance(previous_gate, dict) and previous_gate.get("status") not in {None, "required"} \
                and previous_gate.get("operation_id") != operation.get("operation_id"):
            data.setdefault("parent_gate_history", []).append(copy.deepcopy(previous_gate))
        data["parent_gate"] = {
            "status": "confirmed", "completed_work_unit_id": completed_work_unit_id,
            "operation_id": operation["operation_id"], "request_id": request_id,
            "message_id": message_id, "response_type": response_type,
            "frontier_decision": operation.get("frontier_decision") or effect.get("frontier_decision"),
            "effect": copy.deepcopy(effect), "receipt": copy.deepcopy(receipt),
            "next_work_unit_id": work_unit_id, "recorded_at": utcnow(),
        }
        data["next_work_unit"] = candidate
        data["phase"] = "reviewing-plan"
        data["status"] = "active"
        data["blocker"] = None
        return

    if response_type == "blocking_clarification":
        clarification_payload = receipt.get("clarification") or effect.get("clarification")
        if clarification_payload is None:
            clarification_payload = {
                key: receipt[key] for key in ("question", "options", "recommended_default") if key in receipt
            }
        if not isinstance(clarification_payload, dict):
            raise SystemExit("BLOCKING_CLARIFICATION_EVIDENCE_REQUIRED")
        action = {
            "action": "RESUME_BLOCKING_CLARIFICATION",
            "operation_ids": [operation["operation_id"]],
            "phase": data.get("phase"),
        }
        data["clarification"] = {
            "status": "blocked", "response_type": response_type,
            "operation_id": operation["operation_id"], "request_id": request_id,
            "message_id": message_id, "question": copy.deepcopy(clarification_payload),
            "resume_phase": "parent-gate" if is_parent_gate_operation(operation) else data.get("phase"),
            "action": action, "recorded_at": utcnow(),
        }
        if is_parent_gate_operation(operation):
            data["parent_gate"] = {
                "status": "blocked", "completed_work_unit_id": completed_work_unit_id,
                "operation_id": operation["operation_id"], "request_id": request_id,
                "message_id": message_id, "response_type": response_type,
                "effect": copy.deepcopy(effect), "receipt": copy.deepcopy(receipt),
                "recorded_at": utcnow(),
            }
        data["phase"] = "blocked"
        data["status"] = "blocked"
        data["blocker"] = CLARIFICATION_BLOCKER
        return

    previous_gate = data.get("parent_gate")
    if isinstance(previous_gate, dict) and previous_gate.get("status") not in {None, "required"} \
            and previous_gate.get("operation_id") != operation.get("operation_id"):
        data.setdefault("parent_gate_history", []).append(copy.deepcopy(previous_gate))
    data["parent_gate"] = {
        "status": "confirmed", "completed_work_unit_id": completed_work_unit_id,
        "operation_id": operation["operation_id"], "request_id": request_id,
        "message_id": message_id, "response_type": response_type,
        "frontier_decision": operation.get("frontier_decision") or effect.get("frontier_decision"),
        "effect": copy.deepcopy(effect), "receipt": copy.deepcopy(receipt), "recorded_at": utcnow(),
    }


def apply_blocking_clarification(
    data: dict[str, Any], operation: dict[str, Any], effect: dict[str, Any], receipt: dict[str, Any],
) -> None:
    payload = receipt.get("clarification") or effect.get("clarification")
    if payload is None:
        payload = {key: receipt[key] for key in ("question", "options", "recommended_default") if key in receipt}
    if not isinstance(payload, dict):
        raise SystemExit("BLOCKING_CLARIFICATION_EVIDENCE_REQUIRED")
    request_id = effect.get("request_id") or receipt.get("request_id")
    message_id = frontier_message_id(effect) or frontier_message_id(receipt)
    if not isinstance(request_id, str) or not request_id or not isinstance(message_id, str) or not message_id:
        raise SystemExit("BLOCKING_CLARIFICATION_IDENTITY_REQUIRED")
    data["clarification"] = {
        "status": "blocked", "response_type": "blocking_clarification",
        "operation_id": operation["operation_id"], "request_id": request_id,
        "message_id": message_id, "question": copy.deepcopy(payload),
        "resume_phase": data.get("phase"),
        "action": {
            "action": "RESUME_BLOCKING_CLARIFICATION",
            "operation_ids": [operation["operation_id"]], "phase": data.get("phase"),
        },
        "recorded_at": utcnow(),
    }
    data["phase"] = "blocked"
    data["status"] = "blocked"
    data["blocker"] = CLARIFICATION_BLOCKER


def cmd_frontier_result(args: argparse.Namespace) -> int:
    data = read_state(args.run_id)
    require_v2(data, "frontier result")
    ensure_v2_defaults(data)
    require_nonterminal_run(data, "frontier result")
    if not args.operation_id:
        raise SystemExit("Frontier result requires --operation-id")
    operation = find_operation(data, args.operation_id)
    if operation.get("kind") != "frontier_exchange" and not is_parent_gate_operation(operation):
        raise SystemExit("FRONTIER_OPERATION_KIND_MISMATCH")
    status, decision, request_id, message_id, effect_stage, absence_proven, effect, receipt, errors = build_frontier_response(
        data, operation, args, recovery=False,
    )
    effect["operation_id"] = operation["operation_id"]
    receipt["operation_id"] = operation["operation_id"]
    terminal_status = "confirmed" if status == "success" and not errors else "failed"
    reason = None if terminal_status == "confirmed" else "Frontier transport " + status
    if errors:
        reason += ": " + "; ".join(sorted(set(errors)))
    response_type = response_type_from_sources(args.response_type, effect, receipt)
    if is_parent_gate_operation(operation) and terminal_status == "confirmed" and response_type is None:
        raise SystemExit("PARENT_GATE_RESPONSE_TYPE_REQUIRED")
    if operation.get("status") in TERMINAL_OPERATION_STATUSES:
        if (
            operation.get("status") == terminal_status
            and operation.get("effect") == effect
            and operation.get("receipt") == receipt
            and operation.get("transport_status") == status
            and operation.get("frontier_decision") == decision
        ):
            print(json.dumps(data, indent=2, ensure_ascii=False, sort_keys=True))
            return 0
        raise SystemExit("FRONTIER_RESULT_OPERATION_CONFLICT")
    if operation.get("effect") is not None and operation["effect"] != effect:
        raise SystemExit("FRONTIER_RESULT_EFFECT_CONFLICT")
    if operation.get("receipt") is not None and operation["receipt"] != receipt:
        raise SystemExit("FRONTIER_RESULT_RECEIPT_CONFLICT")
    now = utcnow()
    operation["effect"] = effect
    operation["receipt"] = receipt
    operation["request_id"] = request_id
    operation["message_id"] = message_id
    operation["transport_status"] = status
    operation["frontier_decision"] = decision
    operation["effect_stage"] = effect_stage
    operation["pre_effect_absence_proven"] = absence_proven
    work_unit_id = matching_work_unit_id(effect, receipt)
    if work_unit_id is not None:
        operation["work_unit_id"] = work_unit_id
    if response_type is not None:
        operation["response_type"] = response_type
        proposed_plan = proposed_plan_from_sources(effect, receipt)
        if proposed_plan is not None:
            operation["proposed_plan"] = proposed_plan
    operation["status"] = terminal_status
    operation["terminal_reason"] = reason
    operation["terminal_disposition"] = (
        "completed_effect" if terminal_status == "confirmed"
        else ("failed_attempt" if effect_stage == "none" and absence_proven else "ambiguous_effect")
    )
    operation["confirmed_at"] = now
    operation["updated_at"] = now
    if terminal_status == "confirmed" and response_type is not None:
        if is_parent_gate_operation(operation):
            apply_parent_gate_response(
                data, operation, response_type=response_type, effect=effect, receipt=receipt,
                next_work_unit_id=args.next_work_unit_id,
            )
        elif response_type == "blocking_clarification":
            apply_blocking_clarification(data, operation, effect, receipt)
    auto_superseded = None
    if terminal_status == "confirmed" and isinstance(operation.get("predecessor_operation_id"), str):
        predecessor = find_operation(data, operation["predecessor_operation_id"])
        if is_pre_effect_frontier_failure(predecessor):
            if finalize_frontier_supersession(
                data, predecessor, operation, reason="PRE_EFFECT_RETRY_SUCCEEDED",
            ):
                auto_superseded = predecessor["operation_id"]
    saved = write_state(data, args.expect_revision)
    append_event(args.run_id, "frontier.result_recorded", reason, {
        "operation_id": operation["operation_id"], "transport_status": status,
        "frontier_decision": decision, "request_id": request_id,
        "message_id": message_id, "status": terminal_status,
        "auto_superseded_operation_id": auto_superseded,
        "revision": saved["revision"],
    })
    print(json.dumps(saved, indent=2, ensure_ascii=False, sort_keys=True))
    return 0


def cmd_frontier_recover(args: argparse.Namespace) -> int:
    data = read_state(args.run_id)
    require_v2(data, "frontier recover")
    ensure_v2_defaults(data)
    require_nonterminal_run(data, "frontier recover")
    if not args.operation_id:
        raise SystemExit("Frontier recovery requires --operation-id")
    operation = find_operation(data, args.operation_id)
    if operation.get("kind") != "frontier_exchange":
        raise SystemExit("FRONTIER_RECOVERY_WRONG_KIND")
    if operation.get("status") != "failed":
        raise SystemExit("FRONTIER_RECOVERY_REQUIRES_LEGACY_FAILED_OPERATION")
    identity = frontier_operation_identity(operation)
    if not identity["request_id"]:
        raise SystemExit("FRONTIER_RECOVERY_MISSING_ORIGINAL_REQUEST_ID")
    for source_name in ("effect", "receipt"):
        source = operation.get(source_name)
        if not isinstance(source, dict):
            continue
        if source.get("request_id") not in {None, identity["request_id"]}:
            raise SystemExit("FRONTIER_RECOVERY_ORIGINAL_REQUEST_ID_CONFLICT")
        source_message = frontier_message_id(source)
        if source_message not in {None, identity["message_id"]}:
            raise SystemExit("FRONTIER_RECOVERY_ORIGINAL_MESSAGE_ID_CONFLICT")
    status, decision, request_id, message_id, effect_stage, absence_proven, effect, receipt, errors = build_frontier_response(
        data, operation, args, recovery=True,
    )
    effect["operation_id"] = operation["operation_id"]
    receipt["operation_id"] = operation["operation_id"]
    if status != "success" or decision is None or errors or message_id is None:
        raise SystemExit("FRONTIER_RECOVERY_EVIDENCE_INVALID: " + "; ".join(sorted(set(errors or ["transport is not successful"]))))
    task_id = args.task_id or identity["task_id"]
    scope = args.scope or identity["scope"]
    response_type = response_type_from_sources(args.response_type, effect, receipt)
    if is_parent_gate_operation(operation) and response_type is None:
        raise SystemExit("PARENT_GATE_RESPONSE_TYPE_REQUIRED")
    entry = frontier_recovery_entry(
        operation, status=status, decision=decision, request_id=request_id, message_id=message_id,
        task_id=task_id, scope=scope, effect=effect, receipt=receipt,
    )
    if response_type is not None:
        entry["response_type"] = response_type
    history = operation.setdefault("recovery_history", [])
    if history:
        existing = history[-1]
        if frontier_recovery_projection(existing) == frontier_recovery_projection(entry):
            print(json.dumps(data, indent=2, ensure_ascii=False, sort_keys=True))
            return 0
        raise SystemExit("FRONTIER_RECOVERY_CONFLICT")
    operation["recovery_history"] = [entry]
    operation["effective_status"] = "confirmed"
    operation["effective_transport_status"] = status
    operation["effective_frontier_decision"] = decision
    operation["effective_effect_stage"] = effect_stage
    operation["effective_request_id"] = request_id
    operation["effective_message_id"] = message_id
    work_unit_id = matching_work_unit_id(effect, receipt)
    if work_unit_id is not None:
        operation["effective_work_unit_id"] = work_unit_id
    operation["effective_outcome"] = {
        "transport_status": status, "frontier_decision": decision,
        "request_id": request_id, "message_id": message_id,
        "effect_stage": effect_stage,
        "effect": effect, "receipt": receipt,
    }
    operation["terminal_disposition"] = "completed_effect"
    if response_type is not None:
        operation["effective_response_type"] = response_type
        proposed_plan = proposed_plan_from_sources(effect, receipt)
        if proposed_plan is not None:
            operation["proposed_plan"] = proposed_plan
        if is_parent_gate_operation(operation):
            apply_parent_gate_response(
                data, operation, response_type=response_type, effect=effect, receipt=receipt,
                next_work_unit_id=args.next_work_unit_id,
            )
        elif response_type == "blocking_clarification":
            apply_blocking_clarification(data, operation, effect, receipt)
    auto_superseded = None
    if isinstance(operation.get("predecessor_operation_id"), str):
        predecessor = find_operation(data, operation["predecessor_operation_id"])
        if is_pre_effect_frontier_failure(predecessor):
            if finalize_frontier_supersession(
                data, predecessor, operation, reason="PRE_EFFECT_RETRY_RECOVERED",
            ):
                auto_superseded = predecessor["operation_id"]
    saved = write_state(data, args.expect_revision)
    append_event(args.run_id, "frontier.operation_recovered", "legacy failed Frontier operation recovered", {
        "operation_id": operation["operation_id"], "recovery_id": entry["recovery_id"],
        "transport_status": status, "frontier_decision": decision,
        "request_id": request_id, "message_id": message_id,
        "auto_superseded_operation_id": auto_superseded,
        "revision": saved["revision"],
    })
    print(json.dumps(saved, indent=2, ensure_ascii=False, sort_keys=True))
    return 0


def accessible_workspace(value: str | None) -> str:
    if not isinstance(value, str) or not value.strip():
        raise SystemExit("--workspace is required")
    try:
        workspace = Path(value).expanduser().resolve(strict=True)
    except OSError as exc:
        raise SystemExit(f"workspace is not accessible: {value!r}: {exc}") from exc
    if not workspace.is_dir() or not os.access(workspace, os.R_OK | os.X_OK):
        raise SystemExit(f"workspace is not an accessible directory: {workspace}")
    return str(workspace)


def workspace_git_identity(workspace: str) -> tuple[str | None, str | None]:
    try:
        root_result = subprocess.run(
            ["git", "-C", workspace, "rev-parse", "--show-toplevel"],
            capture_output=True, text=True, stdin=subprocess.DEVNULL, timeout=10,
        )
        branch_result = subprocess.run(
            ["git", "-C", workspace, "branch", "--show-current"],
            capture_output=True, text=True, stdin=subprocess.DEVNULL, timeout=10,
        )
    except (OSError, subprocess.TimeoutExpired):
        return None, None
    if root_result.returncode != 0 or branch_result.returncode != 0:
        return None, None
    root = root_result.stdout.strip()
    branch = branch_result.stdout.strip()
    return (normalize_repository_path(root) if root else None), (branch or None)


def require_continuous_work_unit_provenance(data: dict[str, Any], work_unit_id: str) -> None:
    if not is_continuous_parent(data):
        return
    next_work_unit = data.get("next_work_unit")
    completed_units = [
        existing_id for existing_id, work_unit in data.get("work_units", {}).items()
        if isinstance(work_unit, dict) and work_unit.get("status") == "complete"
    ]
    if isinstance(next_work_unit, dict) and next_work_unit.get("status") in {"approved", "active"}:
        if next_work_unit.get("work_unit_id") != work_unit_id:
            raise SystemExit("BLOCKED_NEXT_WORK_UNIT_PROVENANCE_REQUIRED")
        provenance = next_work_unit.get("provenance")
        if not isinstance(provenance, dict) or not all(provenance.get(key) for key in ("operation_id", "request_id", "message_id")):
            raise SystemExit("BLOCKED_NEXT_WORK_UNIT_PROVENANCE_REQUIRED")
    elif completed_units:
        raise SystemExit("BLOCKED_NEXT_WORK_UNIT_PROVENANCE_REQUIRED")
    live_units = [
        live_id for live_id, work_unit in data.get("work_units", {}).items()
        if isinstance(work_unit, dict) and work_unit.get("status") in {"active", "remediating"}
    ]
    if live_units and work_unit_id not in live_units:
        raise SystemExit("BLOCKED_CONCURRENT_ACTIVE_WORK_UNIT")


def delegation_attempt_group_id(work_unit_id: str, role: str, workspace: str) -> str:
    encoded = "\0".join(("delegation", work_unit_id, role, workspace)).encode()
    return "attempt-" + hashlib.sha256(encoded).hexdigest()[:24]


def latest_delegation_attempt_in_group(
    data: dict[str, Any], attempt_group_id: str, *, exclude_operation_id: str | None = None,
) -> dict[str, Any] | None:
    for candidate in reversed(data.get("pending_operations", [])):
        if (
            isinstance(candidate, dict)
            and candidate.get("kind") == "delegation"
            and candidate.get("attempt_group_id") == attempt_group_id
            and candidate.get("operation_id") != exclude_operation_id
        ):
            return candidate
    return None


def cmd_delegation_preflight(args: argparse.Namespace) -> int:
    """Record WU/task/workspace identity before launching a Task side effect."""
    data = read_state(args.run_id)
    require_v2(data, "delegation-preflight")
    ensure_v2_defaults(data)
    require_active_run(data, "delegation-preflight")
    ensure_route_allows(data, "delegation")
    if args.role not in {"scout", "writer", "verifier"}:
        raise SystemExit("invalid delegation role")
    if not isinstance(args.task_id, str) or not args.task_id.strip():
        raise SystemExit("--task-id must be a non-empty string")
    work_unit_id = require_work_unit_id(args.work_unit_id)
    workspace = accessible_workspace(args.workspace)
    workspace_repository_root, workspace_branch = workspace_git_identity(workspace)
    attempt_group_id = delegation_attempt_group_id(work_unit_id, args.role, workspace)
    intent = {
        "task_id": args.task_id,
        "work_unit_id": work_unit_id,
        "workspace": workspace,
        "agent": args.agent,
        "role": args.role,
        "reason": args.reason,
    }
    if workspace_repository_root is not None:
        intent["workspace_repository_root"] = workspace_repository_root
    if workspace_branch is not None:
        intent["workspace_branch"] = workspace_branch
    existing = find_operation_by_identity(data, "delegation", f"task:{args.task_id}")
    require_continuous_work_unit_provenance(data, work_unit_id)
    # A stale/legacy started row cannot be silently claimed by a new preflight.
    # The only retry allowed is the exact same operation that previously wrote
    # this task identity atomically with its ledger row.
    for entry in data.get("delegation_ledger", []):
        if not isinstance(entry, dict) or entry.get("status") != "started":
            continue
        if entry.get("task_id") == args.task_id and (
            existing is None
            or entry.get("operation_id") != existing.get("operation_id")
            or existing.get("intent") != intent
        ):
            raise SystemExit("BLOCKED_DELEGATION_TASK_ALREADY_ACTIVE")
    if args.role == "writer":
        for operation in nonterminal_operations(data, "delegation"):
            operation_intent = operation.get("intent")
            if (
                isinstance(operation_intent, dict)
                and operation_intent.get("role") == "writer"
                and operation_intent.get("work_unit_id") == work_unit_id
                and (existing is None or operation.get("operation_id") != existing.get("operation_id"))
            ):
                raise SystemExit("BLOCKED_CONCURRENT_WRITER_WORK_UNIT")
        for entry in data.get("delegation_ledger", []):
            if (
                isinstance(entry, dict)
                and entry.get("status") == "started"
                and entry.get("role") == "writer"
                and entry.get("work_unit_id") == work_unit_id
                and (existing is None or entry.get("operation_id") != existing.get("operation_id"))
            ):
                raise SystemExit("BLOCKED_CONCURRENT_WRITER_WORK_UNIT")
    operation, created = record_operation_intent(
        data, kind="delegation", idempotency_key=f"task:{args.task_id}", intent=intent,
    )
    if not created:
        print(json.dumps(data, indent=2, ensure_ascii=False, sort_keys=True))
        return 0
    operation["attempt_group_id"] = attempt_group_id
    predecessor = latest_delegation_attempt_in_group(
        data, attempt_group_id, exclude_operation_id=operation["operation_id"],
    )
    if predecessor is not None and predecessor.get("status") == "failed":
        operation["predecessor_operation_id"] = predecessor["operation_id"]
        operation["predecessor_operation_ids"] = [predecessor["operation_id"]]
        predecessor["successor_operation_id"] = operation["operation_id"]
        predecessor["updated_at"] = utcnow()
    work_unit = get_or_create_work_unit(data, work_unit_id)
    entry = {
        "agent": args.agent, "role": args.role, "reason": args.reason,
        "task_id": args.task_id, "work_unit_id": work_unit_id, "workspace": workspace,
        "attempt": data["attempts"][args.role + "s"] + 1,
        "started_at": utcnow(), "completed_at": None, "status": "started", "outcome": "STARTED",
        "operation_id": operation["operation_id"],
        "attempt_group_id": attempt_group_id,
    }
    if workspace_repository_root is not None:
        entry["workspace_repository_root"] = workspace_repository_root
    if workspace_branch is not None:
        entry["workspace_branch"] = workspace_branch
    data["delegation_ledger"].append(entry)
    data["attempts"][args.role + "s"] = entry["attempt"]
    data["active_work_unit_id"] = work_unit["work_unit_id"]
    data["worker_task_id"] = args.task_id
    if is_continuous_parent(data) and isinstance(data.get("next_work_unit"), dict) \
            and data["next_work_unit"].get("work_unit_id") == work_unit_id:
        data["next_work_unit"]["status"] = "active"
        data["phase"] = "implementing"
    saved = write_state(data, args.expect_revision)
    append_event(args.run_id, "delegation.preflight_recorded", None, {
        "operation_id": operation["operation_id"], "task_id": args.task_id,
        "work_unit_id": work_unit_id, "workspace": workspace, "revision": saved["revision"],
    })
    print(json.dumps(saved, indent=2, ensure_ascii=False, sort_keys=True))
    return 0


def find_delegation_entry(data: dict[str, Any], task_id: str) -> dict[str, Any] | None:
    """Return the durable delegation row for one task, if present."""
    for entry in reversed(data.get("delegation_ledger", [])):
        if isinstance(entry, dict) and entry.get("task_id") == task_id:
            return entry
    return None


def delegation_result_identity(
    args: argparse.Namespace, workspace: str, work_unit_id: str,
) -> dict[str, str]:
    if not isinstance(args.task_id, str) or not args.task_id.strip():
        raise SystemExit("terminal delegation results require a non-empty --task-id")
    return {
        "task_id": args.task_id,
        "work_unit_id": work_unit_id,
        "workspace": workspace,
        "agent": args.agent,
        "role": args.role,
    }


def validate_delegation_result_identity(
    operation: dict[str, Any], entry: dict[str, Any] | None, identity: dict[str, str],
) -> None:
    intent = operation.get("intent")
    if not isinstance(intent, dict):
        raise SystemExit("DELEGATION_RESULT_IDENTITY_CONFLICT")
    for key, value in identity.items():
        if intent.get(key) != value:
            raise SystemExit("DELEGATION_RESULT_IDENTITY_CONFLICT")
    if entry is None or entry.get("operation_id") != operation.get("operation_id"):
        raise SystemExit("DELEGATION_RESULT_IDENTITY_CONFLICT")
    for key, value in identity.items():
        if entry.get(key) != value:
            raise SystemExit("DELEGATION_RESULT_IDENTITY_CONFLICT")


def parse_delegation_evidence(value: str | None) -> Any:
    if value is None:
        return None
    try:
        return sanitize_evidence(json.loads(value))
    except json.JSONDecodeError as exc:
        raise SystemExit(f"invalid --evidence-json: {exc}") from exc


def cmd_correction_preflight(args: argparse.Namespace) -> int:
    """Persist one correction charge and its Task launch identity atomically."""
    data = read_state(args.run_id)
    require_v2(data, "correction start")
    ensure_v2_defaults(data)
    require_active_run(data, "correction start")
    ensure_route_allows(data, "delegation")
    work_unit_id = require_work_unit_id(args.work_unit_id)
    require_continuous_work_unit_provenance(data, work_unit_id)
    workspace = accessible_workspace(args.workspace)
    if not isinstance(args.task_id, str) or not args.task_id.strip():
        raise SystemExit("--task-id must be a non-empty string")
    if not isinstance(args.source_request_id, str) or not args.source_request_id:
        raise SystemExit("--source-request-id is required for corrections")
    scope_digest = require_scope_digest(args.scope_digest)
    source_candidate_sha = require_candidate_sha(args.source_candidate_sha)
    defect_revision = latest_work_unit_defect_revision(data, work_unit_id)
    if args.defect_revision is not None and require_defect_revision(args.defect_revision) != defect_revision:
        raise SystemExit("CORRECTION_DEFECT_REVISION_CONFLICT")
    base_intent = {
        "task_id": args.task_id,
        "work_unit_id": work_unit_id,
        "workspace": workspace,
        "agent": args.agent,
        "role": "writer",
        "reason": args.reason,
    }

    # An exact retry of a correction preflight is read-only.  Check this before
    # looking at budgets so a replay cannot spend or block the correction again.
    existing = find_operation_by_identity(data, "delegation", f"task:{args.task_id}")
    if existing is not None:
        intent = existing.get("intent")
        existing_correction = intent.get("correction") if isinstance(intent, dict) else None
        persisted_grant_id = (
            existing_correction.get("grant_id")
            if isinstance(existing_correction, dict) else None
        )
        expected = {
            **base_intent,
            "correction": {
                "work_unit_id": work_unit_id,
                "source_request_id": args.source_request_id,
                "verification_request_id": args.source_request_id,
                "scope_digest": scope_digest,
                "source_candidate_sha": source_candidate_sha,
                "defect_revision": defect_revision,
                "grant_id": persisted_grant_id,
            },
        }
        if intent != expected:
            raise SystemExit("OPERATION_IDEMPOTENCY_CONFLICT")
        print(json.dumps(data, indent=2, ensure_ascii=False, sort_keys=True))
        return 0

    for entry in data.get("delegation_ledger", []):
        if isinstance(entry, dict) and entry.get("task_id") == args.task_id:
            raise SystemExit("BLOCKED_DELEGATION_TASK_ALREADY_ACTIVE")

    work_unit = get_or_create_work_unit(data, work_unit_id)
    remediation = data["remediation"]
    total = remediation["total_corrections_used"]
    max_total = remediation["max_total_corrections"]
    if max_total is not None and total >= max_total:
        block_correction(
            data, scope="run", work_unit_id=None, code="BLOCKED_TOTAL_CORRECTION_BUDGET",
            used=total, limit=max_total, reason="run-global correction cost ceiling exhausted",
        )
        saved = write_state(data, args.expect_revision)
        append_event(args.run_id, "correction.blocked", "run-global correction budget exhausted", data["remediation"]["blocked"])
        print(json.dumps(saved, indent=2, ensure_ascii=False, sort_keys=True))
        return 1

    grant: dict[str, Any] | None = None
    if work_unit["corrections_used"] >= work_unit["base_correction_limit"]:
        grant = matching_correction_grant(
            data, work_unit_id, args.source_request_id, scope_digest, source_candidate_sha, defect_revision,
        )
        if grant is None:
            closed_grant = correction_grant_for_identity(
                data, work_unit_id, args.source_request_id, scope_digest, source_candidate_sha, defect_revision,
            )
            if closed_grant is not None and closed_grant.get("status") != "open":
                raise SystemExit("CORRECTION_GRANT_ALREADY_CONSUMED")
            block_correction(
                data, scope="work_unit", work_unit_id=work_unit_id, code="BLOCKED_CORRECTION_BUDGET",
                used=work_unit["corrections_used"], limit=work_unit["base_correction_limit"],
                reason="work-unit correction budget exhausted for the supplied scope and candidate",
                source_request_id=args.source_request_id, scope_digest=scope_digest,
                source_candidate_sha=source_candidate_sha, defect_revision=defect_revision,
            )
            saved = write_state(data, args.expect_revision)
            append_event(args.run_id, "correction.blocked", "work-unit correction budget exhausted", data["remediation"]["blocked"])
            print(json.dumps(saved, indent=2, ensure_ascii=False, sort_keys=True))
            return 1

    correction = {
        "work_unit_id": work_unit_id,
        "work_unit_attempt": work_unit["corrections_used"] + 1,
        "source_request_id": args.source_request_id,
        "verification_request_id": args.source_request_id,
        "scope_digest": scope_digest,
        "source_candidate_sha": source_candidate_sha,
        "defect_revision": defect_revision,
        "grant_id": grant["grant_id"] if grant is not None else None,
    }
    intent = {**base_intent, "correction": {
        "work_unit_id": work_unit_id,
        "source_request_id": args.source_request_id,
        "verification_request_id": args.source_request_id,
        "scope_digest": scope_digest,
        "source_candidate_sha": source_candidate_sha,
        "defect_revision": defect_revision,
        "grant_id": grant["grant_id"] if grant is not None else None,
    }}
    operation, created = record_operation_intent(
        data, kind="delegation", idempotency_key=f"task:{args.task_id}", intent=intent,
    )
    if not created:
        print(json.dumps(data, indent=2, ensure_ascii=False, sort_keys=True))
        return 0
    for pending in nonterminal_operations(data, "delegation"):
        pending_intent = pending.get("intent")
        if (
            pending.get("operation_id") != operation.get("operation_id")
            and isinstance(pending_intent, dict)
            and pending_intent.get("role") == "writer"
            and pending_intent.get("work_unit_id") == work_unit_id
        ):
            raise SystemExit("BLOCKED_CONCURRENT_WRITER_WORK_UNIT")
    for entry in data.get("delegation_ledger", []):
        if (
            isinstance(entry, dict)
            and entry.get("status") == "started"
            and entry.get("role") == "writer"
            and entry.get("work_unit_id") == work_unit_id
        ):
            raise SystemExit("BLOCKED_CONCURRENT_WRITER_WORK_UNIT")

    attempt = data["attempts"]["writers"] + 1
    entry = {
        "agent": args.agent, "role": "writer", "reason": args.reason,
        "task_id": args.task_id, "work_unit_id": work_unit_id, "workspace": workspace,
        "attempt": attempt, "started_at": args.started_at or utcnow(),
        "completed_at": None, "status": "started", "outcome": "STARTED",
        "operation_id": operation["operation_id"], "correction": correction,
    }
    data["delegation_ledger"].append(entry)
    data["attempts"]["writers"] = attempt
    work_unit["corrections_used"] += 1
    work_unit["status"] = "remediating"
    data["active_work_unit_id"] = work_unit_id
    data["worker_task_id"] = args.task_id
    data["remediation"]["total_corrections_used"] += 1
    data["attempts"]["corrections"] += 1
    if grant is not None:
        grant["consumed_attempts"] += 1
        if grant["consumed_attempts"] == grant["granted_attempts"]:
            grant["status"] = "consumed"
            grant["closed_at"] = utcnow()
    saved = write_state(data, args.expect_revision)
    append_event(args.run_id, "correction.preflight_recorded", None, {
        "operation_id": operation["operation_id"], "task_id": args.task_id,
        "work_unit_id": work_unit_id, "workspace": workspace,
        "attempt": attempt, "revision": saved["revision"],
    })
    print(json.dumps(saved, indent=2, ensure_ascii=False, sort_keys=True))
    return 0


def cmd_work_unit(args: argparse.Namespace) -> int:
    """Close one verified work unit so terminal completion can prove no WU is open."""
    data = read_state(args.run_id)
    require_v2(data, "work-unit complete")
    require_active_run(data, "work-unit complete")
    work_unit_id = require_work_unit_id(args.work_unit_id)
    work_unit = data["work_units"].get(work_unit_id)
    if not isinstance(work_unit, dict):
        raise SystemExit(f"work unit not found: {work_unit_id}")
    if work_unit.get("status") == "complete":
        print(json.dumps(data, indent=2, ensure_ascii=False, sort_keys=True))
        return 0
    if work_unit.get("status") in {"blocked", "cancelled", "legacy-ambiguous"}:
        raise SystemExit(f"work unit {work_unit_id} cannot be completed from status {work_unit.get('status')!r}")
    if any(
        isinstance(operation.get("intent"), dict)
        and operation["intent"].get("work_unit_id") == work_unit_id
        for operation in nonterminal_operations(data)
    ):
        raise SystemExit("work unit has a pending operation")
    if any(
        grant.get("work_unit_id") == work_unit_id
        and grant.get("status") == "open"
        and grant.get("consumed_attempts", 0) < grant.get("granted_attempts", 0)
        for grant in data["remediation"]["grants"]
        if isinstance(grant, dict)
    ):
        raise SystemExit("work unit has an unconsumed correction authorization")
    evidence = parse_object_json(args.evidence_json, "--evidence-json")
    latest_defects = next(
        (record for record in reversed(data["defect_history"])
         if isinstance(record, dict) and record.get("work_unit_id") == work_unit_id),
        None,
    )
    if latest_defects is not None and latest_defects.get("remaining"):
        raise SystemExit("work unit has remaining verified defects")
    work_unit["status"] = "complete"
    work_unit["completed_at"] = utcnow()
    work_unit["completion_evidence"] = evidence
    if data.get("active_work_unit_id") == work_unit_id:
        data["active_work_unit_id"] = None
    if is_continuous_parent(data):
        next_work_unit = data.get("next_work_unit")
        if isinstance(next_work_unit, dict) and next_work_unit.get("work_unit_id") != work_unit_id:
            raise SystemExit("continuous work unit completion does not match the approved next work unit")
        previous_gate = data.get("parent_gate")
        if isinstance(previous_gate, dict) and previous_gate.get("status") not in {None, "required"}:
            data.setdefault("parent_gate_history", []).append(copy.deepcopy(previous_gate))
        data["parent_gate"] = {
            "status": "required", "completed_work_unit_id": work_unit_id,
            "operation_id": None, "request_id": None, "message_id": None,
            "response_type": None, "effect": None, "receipt": None,
        }
        data["next_work_unit"] = None
        data["phase"] = "parent-gate"
        data["status"] = "active"
        data["blocker"] = None
    saved = write_state(data, args.expect_revision)
    append_event(args.run_id, "work_unit.completed", None, {
        "work_unit_id": work_unit_id, "revision": saved["revision"],
    })
    print(json.dumps(saved, indent=2, ensure_ascii=False, sort_keys=True))
    return 0



def require_work_unit_id(value: str | None) -> str:
    if not isinstance(value, str) or not WORK_UNIT_ID_RE.fullmatch(value) or value == "__legacy__":
        raise SystemExit("--work-unit-id must be a non-empty safe work-unit identifier")
    return value


def require_scope_digest(value: str | None, option: str = "--scope-digest") -> str:
    if not isinstance(value, str) or not SHA256_RE.fullmatch(value):
        raise SystemExit(f"{option} must be a lowercase SHA-256 hex digest")
    return value


def require_candidate_sha(value: str | None, option: str = "--source-candidate-sha") -> str:
    if not isinstance(value, str) or not GIT_SHA_RE.fullmatch(value):
        raise SystemExit(f"{option} must be a Git SHA (7-64 hexadecimal characters)")
    return value.lower()


def require_defect_revision(value: int | None, option: str = "--defect-revision") -> int:
    if not isinstance(value, int) or value < 0:
        raise SystemExit(f"{option} must be a non-negative integer")
    return value


def latest_work_unit_defect_revision(data: dict[str, Any], work_unit_id: str) -> int:
    for record in reversed(data.get("defect_history", [])):
        if not isinstance(record, dict) or record.get("work_unit_id") != work_unit_id:
            continue
        revision = record.get("revision")
        if not isinstance(revision, int) or revision < 0:
            raise SystemExit("invalid work-unit defect revision")
        return revision
    return 0


def get_or_create_work_unit(data: dict[str, Any], work_unit_id: str) -> dict[str, Any]:
    work_units: dict[str, dict[str, Any]] = data["work_units"]
    current = work_units.get(work_unit_id)
    if current is None:
        current = {
            "work_unit_id": work_unit_id,
            "status": "active",
            "base_correction_limit": data["budgets"]["max_corrections_per_work_unit"],
            "corrections_used": 0,
            "no_progress_cycles": 0,
        }
        work_units[work_unit_id] = current
    if current.get("status") in {"cancelled", "complete", "legacy-ambiguous"}:
        raise SystemExit(f"work unit {work_unit_id} cannot accept a correction in status {current.get('status')!r}")
    return current


def correction_grant_id(
    authority: str, request_id: str, work_unit_id: str, scope_digest: str,
    source_candidate_sha: str, verification_request_id: str, defect_revision: int,
) -> str:
    value = "\0".join((
        authority, request_id, work_unit_id, scope_digest, source_candidate_sha.lower(),
        verification_request_id, str(defect_revision),
    ))
    return "grant-" + hashlib.sha256(value.encode()).hexdigest()[:24]


def grant_is_expired(grant: dict[str, Any]) -> bool:
    value = grant.get("expires_at")
    if value is None:
        return False
    try:
        expires = dt.datetime.fromisoformat(str(value).replace("Z", "+00:00"))
    except ValueError:
        # Validation prevents newly created bad timestamps. Treat an old bad
        # value as unusable rather than accidentally spending it.
        return True
    if expires.tzinfo is None:
        return True
    return expires <= dt.datetime.now(dt.timezone.utc)


def correction_grant_for_identity(
    data: dict[str, Any], work_unit_id: str, verification_request_id: str,
    scope_digest: str, source_candidate_sha: str, defect_revision: int,
) -> dict[str, Any] | None:
    for grant in data["remediation"]["grants"]:
        if (
            grant.get("work_unit_id") == work_unit_id
            and grant.get("verification_request_id") == verification_request_id
            and grant.get("scope_digest") == scope_digest
            and str(grant.get("source_candidate_sha", "")).lower() == source_candidate_sha.lower()
            and grant.get("defect_revision") == defect_revision
        ):
            return grant
    return None


def matching_correction_grant(
    data: dict[str, Any], work_unit_id: str, verification_request_id: str,
    scope_digest: str, source_candidate_sha: str, defect_revision: int,
) -> dict[str, Any] | None:
    for grant in data["remediation"]["grants"]:
        if grant["status"] == "open" and grant_is_expired(grant):
            grant["status"] = "expired"
            grant["closed_at"] = utcnow()
        if (
            grant["status"] == "open"
            and grant["work_unit_id"] == work_unit_id
            and grant["verification_request_id"] == verification_request_id
            and grant["scope_digest"] == scope_digest
            and grant["source_candidate_sha"].lower() == source_candidate_sha.lower()
            and grant["defect_revision"] == defect_revision
            and grant["consumed_attempts"] < grant["granted_attempts"]
        ):
            return grant
    return None


def block_correction(
    data: dict[str, Any], *, scope: str, work_unit_id: str | None, code: str,
    used: int, limit: int | None, reason: str, source_request_id: str | None = None,
    scope_digest: str | None = None, source_candidate_sha: str | None = None,
    defect_revision: int | None = None,
) -> None:
    data["phase"] = "blocked"
    data["status"] = "blocked"
    data["blocker"] = code
    context: dict[str, Any] = {
        "scope": scope,
        "work_unit_id": work_unit_id,
        "code": code,
        "used": used,
        "limit": limit,
        "reason": reason,
        "blocked_at": utcnow(),
    }
    if scope == "work_unit":
        context.update({
            "source_request_id": source_request_id,
            "verification_request_id": source_request_id,
            "scope_digest": scope_digest,
            "source_candidate_sha": source_candidate_sha,
            "defect_revision": defect_revision,
        })
    data["remediation"]["blocked"] = context
    if scope == "work_unit" and work_unit_id is not None:
        data["work_units"][work_unit_id]["status"] = "blocked"


def cmd_delegation_terminal(args: argparse.Namespace) -> int:
    """Resolve exactly one persisted preflight without charging a second attempt."""
    data = read_state(args.run_id)
    require_v2(data, "delegation")
    if args.role not in {"scout", "writer", "verifier"}:
        raise SystemExit("invalid delegation role")
    work_unit_id = require_work_unit_id(args.work_unit_id)
    workspace = accessible_workspace(args.workspace)
    identity = delegation_result_identity(args, workspace, work_unit_id)
    operation = find_operation_by_identity(data, "delegation", f"task:{args.task_id}")
    if operation is None:
        require_active_run(data, "delegation")
        raise SystemExit("DELEGATION_RESULT_REQUIRES_PREFLIGHT")
    entry = find_delegation_entry(data, args.task_id)
    validate_delegation_result_identity(operation, entry, identity)
    assert entry is not None

    outcome = args.outcome or {
        "success": "SUCCESS", "failed": "FAILED", "blocked": "BLOCKED", "cancelled": "CANCELLED",
    }[args.status]
    evidence = parse_delegation_evidence(args.evidence_json)
    effect = {"task_id": args.task_id, "status": args.status, "outcome": outcome}
    receipt = {
        "task_id": args.task_id, "status": args.status, "outcome": outcome, "evidence": evidence,
    }
    if operation.get("status") in TERMINAL_OPERATION_STATUSES:
        if operation.get("effect") == effect and operation.get("receipt") == receipt:
            print(json.dumps(data, indent=2, ensure_ascii=False, sort_keys=True))
            return 0
        raise SystemExit("DELEGATION_RESULT_OPERATION_CONFLICT")
    if operation.get("effect") is not None and operation["effect"] != effect:
        raise SystemExit("DELEGATION_RESULT_OPERATION_CONFLICT")
    if operation.get("receipt") is not None and operation["receipt"] != receipt:
        raise SystemExit("DELEGATION_RESULT_OPERATION_CONFLICT")
    if entry.get("status") != "started":
        raise SystemExit("DELEGATION_RESULT_OPERATION_CONFLICT")

    # Update the preflight row in place.  A second ledger row would make the
    # task look like it started twice and would make replay accounting unsafe.
    entry["status"] = args.status
    entry["outcome"] = outcome
    entry["completed_at"] = args.completed_at or utcnow()
    if evidence is not None:
        entry["evidence"] = evidence
    now = utcnow()
    operation["effect"] = effect
    operation["receipt"] = receipt
    operation["effect_stage"] = "response_observed"
    operation["status"] = "confirmed" if args.status == "success" else "failed"
    operation["terminal_reason"] = None if args.status == "success" else f"delegation task ended {args.status}"
    operation["terminal_disposition"] = "completed_effect" if args.status == "success" else "failed_attempt"
    operation["confirmed_at"] = now
    operation["updated_at"] = now
    if data.get("status") == "active" and outcome in {"AGENT_MODEL_UNRESOLVED", "AGENT_NOT_INSTALLED"}:
        data["phase"] = "blocked"
        data["status"] = "blocked"
        data["blocker"] = outcome
    if data.get("worker_task_id") == args.task_id:
        data["worker_task_id"] = None
    saved = write_state(data, args.expect_revision)
    append_event(args.run_id, "delegation.recorded", None, entry)
    print(json.dumps(saved, indent=2, ensure_ascii=False, sort_keys=True))
    return 0


def cmd_delegation(args: argparse.Namespace) -> int:
    if args.status == "started":
        if args.correction:
            return cmd_correction_preflight(args)
        return cmd_delegation_preflight(args)
    if args.correction and args.role != "writer":
        raise SystemExit("corrections can only target the writer")
    return cmd_delegation_terminal(args)


def cmd_correction_authorize(args: argparse.Namespace) -> int:
    """Grant a bounded, auditable extra correction for one exhausted work unit."""
    data = read_state(args.run_id)
    require_v2(data, "correction authorize")
    if data["revision"] != args.expect_revision:
        raise SystemExit(
            f"revision conflict for {args.run_id}: expected {args.expect_revision}, observed {data['revision']}"
        )
    work_unit_id = require_work_unit_id(args.work_unit_id)
    scope_digest = require_scope_digest(args.scope_digest)
    source_candidate_sha = require_candidate_sha(args.source_candidate_sha)
    if args.authority not in CORRECTION_AUTHORITIES:
        raise SystemExit("invalid correction authority")
    if not isinstance(args.request_id, str) or not args.request_id:
        raise SystemExit("--request-id is required")
    if not isinstance(args.max_additional_attempts, int) or args.max_additional_attempts < 1:
        raise SystemExit("--max-additional-attempts must be a positive integer")
    if args.expires_at is not None:
        try:
            parsed_expiry = dt.datetime.fromisoformat(args.expires_at.replace("Z", "+00:00"))
        except ValueError as exc:
            raise SystemExit("--expires-at must be an ISO-8601 timestamp with timezone") from exc
        if parsed_expiry.tzinfo is None:
            raise SystemExit("--expires-at must include a timezone")

    blocked = data["remediation"].get("blocked")
    existing = next((
        grant for grant in data["remediation"]["grants"]
        if grant.get("authority") == args.authority
        and grant.get("request_id") == args.request_id
        and grant.get("work_unit_id") == work_unit_id
        and grant.get("scope_digest") == scope_digest
        and str(grant.get("source_candidate_sha", "")).lower() == source_candidate_sha
    ), None)
    if existing is not None:
        verification_request_id = existing.get("verification_request_id")
        defect_revision = existing.get("defect_revision")
        if not isinstance(verification_request_id, str) or not isinstance(defect_revision, int):
            raise SystemExit("CORRECTION_AUTHORIZATION_IDENTITY_CONFLICT")
        if args.verification_request_id is not None and args.verification_request_id != verification_request_id:
            raise SystemExit("CORRECTION_AUTHORIZATION_IDENTITY_CONFLICT")
        if args.defect_revision is not None and require_defect_revision(args.defect_revision) != defect_revision:
            raise SystemExit("CORRECTION_AUTHORIZATION_IDENTITY_CONFLICT")
        grant_id = correction_grant_id(
            args.authority, args.request_id, work_unit_id, scope_digest, source_candidate_sha,
            verification_request_id, defect_revision,
        )
        expected = {
            "authority": args.authority,
            "request_id": args.request_id,
            "work_unit_id": work_unit_id,
            "scope_digest": scope_digest,
            "source_candidate_sha": source_candidate_sha,
            "verification_request_id": verification_request_id,
            "defect_revision": defect_revision,
            "granted_attempts": args.max_additional_attempts,
            "expires_at": args.expires_at,
        }
        if existing.get("grant_id") != grant_id:
            raise SystemExit("CORRECTION_AUTHORIZATION_IDEMPOTENCY_CONFLICT")
        if any(existing.get(key) != value for key, value in expected.items()):
            raise SystemExit("CORRECTION_AUTHORIZATION_IDEMPOTENCY_CONFLICT")
        blocker_matches = (
            data["phase"] == "blocked" and data["status"] == "blocked"
            and data.get("blocker") == "BLOCKED_CORRECTION_BUDGET"
            and isinstance(blocked, dict) and blocked.get("scope") == "work_unit"
            and blocked.get("work_unit_id") == work_unit_id
            and blocked.get("source_request_id") == verification_request_id
            and blocked.get("verification_request_id") == verification_request_id
            and blocked.get("scope_digest") == scope_digest
            and str(blocked.get("source_candidate_sha", "")).lower() == source_candidate_sha
            and blocked.get("defect_revision") == defect_revision
        )
        if not blocker_matches:
            if data.get("status") == "active" and data.get("blocker") is None:
                print(json.dumps(data, indent=2, ensure_ascii=False, sort_keys=True))
                return 0
            raise SystemExit("CORRECTION_AUTHORIZATION_IDENTITY_CONFLICT")
        if (
            existing["status"] == "open" and existing["consumed_attempts"] < existing["granted_attempts"]
        ):
            # Replaying an open grant is safe only when the blocker is the exact
            # identity that produced the grant.  The blocker identity check above
            # deliberately runs before this branch, so a newer verification
            # cycle cannot be replaced by an old authorization.
            data["remediation"]["blocked"] = None
            data["active_work_unit_id"] = work_unit_id
            data["work_units"][work_unit_id]["status"] = "remediating"
            data["phase"] = "implementing"
            data["status"] = "active"
            data["blocker"] = None
            saved = write_state(data, args.expect_revision)
            append_event(args.run_id, "correction.authorization_replayed", "reopened matching unconsumed grant", {
                "grant_id": grant_id,
                "grant_scope_digest": scope_digest,
                "grant_candidate_sha": source_candidate_sha,
                "grant_verification_request_id": verification_request_id,
                "grant_defect_revision": defect_revision,
                "revision": saved["revision"],
            })
            print(json.dumps(saved, indent=2, ensure_ascii=False, sort_keys=True))
            return 0
        print(json.dumps(data, indent=2, ensure_ascii=False, sort_keys=True))
        return 0

    if (
        data["phase"] != "blocked" or data["status"] != "blocked"
        or data.get("blocker") != "BLOCKED_CORRECTION_BUDGET"
        or not isinstance(blocked, dict) or blocked.get("scope") != "work_unit"
        or blocked.get("work_unit_id") != work_unit_id
        or blocked.get("scope_digest") != scope_digest
        or str(blocked.get("source_candidate_sha", "")).lower() != source_candidate_sha
        or blocked.get("source_request_id") != blocked.get("verification_request_id")
        or not isinstance(blocked.get("verification_request_id"), str)
        or not isinstance(blocked.get("defect_revision"), int)
    ):
        raise SystemExit("correction authorization requires the matching work-unit correction-budget blocker")
    verification_request_id = blocked["verification_request_id"]
    defect_revision = blocked["defect_revision"]
    if args.verification_request_id is not None and args.verification_request_id != verification_request_id:
        raise SystemExit("CORRECTION_AUTHORIZATION_IDENTITY_CONFLICT")
    if args.defect_revision is not None and require_defect_revision(args.defect_revision) != defect_revision:
        raise SystemExit("CORRECTION_AUTHORIZATION_IDENTITY_CONFLICT")
    grant_id = correction_grant_id(
        args.authority, args.request_id, work_unit_id, scope_digest, source_candidate_sha,
        verification_request_id, defect_revision,
    )
    for grant in data["remediation"]["grants"]:
        if (
            grant.get("authority") == args.authority
            and grant.get("request_id") == args.request_id
        ):
            raise SystemExit("CORRECTION_AUTHORIZATION_IDENTITY_CONFLICT")
    work_unit = data["work_units"].get(work_unit_id)
    if not isinstance(work_unit, dict):
        raise SystemExit("correction authorization references an unknown work unit")
    grant = {
        "grant_id": grant_id,
        "authority": args.authority,
        "request_id": args.request_id,
        "work_unit_id": work_unit_id,
        "scope_digest": scope_digest,
        "source_candidate_sha": source_candidate_sha,
        "verification_request_id": verification_request_id,
        "defect_revision": defect_revision,
        "granted_attempts": args.max_additional_attempts,
        "consumed_attempts": 0,
        "status": "open",
        "authorized_at": utcnow(),
        "expires_at": args.expires_at,
        "closed_at": None,
    }
    data["remediation"]["grants"].append(grant)
    data["remediation"]["blocked"] = None
    data["active_work_unit_id"] = work_unit_id
    work_unit["status"] = "remediating"
    data["phase"] = "implementing"
    data["status"] = "active"
    data["blocker"] = None
    saved = write_state(data, args.expect_revision)
    append_event(args.run_id, "correction.authorized", "bounded work-unit correction grant authorized", {
        "grant_id": grant_id,
        "authority": args.authority,
        "request_id": args.request_id,
        "work_unit_id": work_unit_id,
        "scope_digest": scope_digest,
        "source_candidate_sha": source_candidate_sha,
        "verification_request_id": verification_request_id,
        "defect_revision": defect_revision,
        "granted_attempts": args.max_additional_attempts,
        "revision": saved["revision"],
    })
    print(json.dumps(saved, indent=2, ensure_ascii=False, sort_keys=True))
    return 0


def cmd_correction_start(args: argparse.Namespace) -> int:
    """Start one typed writer correction without exposing generic delegation flags.

    The legacy `delegation --correction` spelling remains compatible during the
    rollout, but both spellings execute the same protected accounting path.
    """
    args.correction = True
    args.role = "writer"
    args.status = "started"
    args.outcome = None
    args.completed_at = None
    args.evidence_json = None
    return cmd_delegation(args)

def parse_string_list(value: str | None, option: str) -> list[str] | None:
    if value is None:
        return None
    parsed = json.loads(value)
    if not isinstance(parsed, list) or not all(isinstance(item, str) for item in parsed):
        raise SystemExit(f"{option} must be an array of strings")
    return parsed


def cmd_defects(args: argparse.Namespace) -> int:
    """Record verifier evidence against one work unit rather than a run-global list."""
    data = read_state(args.run_id)
    require_v2(data, "defects")
    require_active_run(data, "defects")
    work_unit_id = require_work_unit_id(args.work_unit_id)
    if not isinstance(args.verification_request_id, str) or not args.verification_request_id:
        raise SystemExit("--verification-request-id is required")
    scope_digest = require_scope_digest(args.scope_digest)
    candidate_sha = require_candidate_sha(args.candidate_sha, "--candidate-sha")
    work_unit = get_or_create_work_unit(data, work_unit_id)
    initial = parse_string_list(args.defects_json, "--defects-json")
    corrected = parse_string_list(args.corrected_json, "--corrected-json") or []
    remaining = parse_string_list(args.remaining_json, "--remaining-json")
    new = parse_string_list(args.new_json, "--new-json") or []
    if len(set(corrected)) != len(corrected) or len(set(new)) != len(new):
        raise SystemExit("defect IDs must be unique")
    previous = next(
        (record for record in reversed(data["defect_history"])
         if isinstance(record, dict) and record.get("work_unit_id") == work_unit_id),
        None,
    )

    if previous is None and initial is None:
        raise SystemExit("--defects-json is required for the initial work-unit defect record")
    if initial is None:
        initial = list(previous["remaining"])
    if remaining is None:
        remaining = list(initial)
    if len(set(initial)) != len(initial) or len(set(remaining)) != len(remaining):
        raise SystemExit("defect IDs must be unique")
    if previous is not None and args.remaining_json is None and args.corrected_json is None and args.new_json is None:
        raise SystemExit("an update requires corrected, remaining, or new defects")

    if previous is None:
        progress = "initial"
        work_unit["no_progress_cycles"] = 0
    else:
        prior_remaining = set(previous["remaining"])
        resolved = prior_remaining - set(remaining)
        if new:
            progress = "regressed"
            work_unit["no_progress_cycles"] += 1
        elif resolved:
            progress = "reduced"
            work_unit["no_progress_cycles"] = 0
        else:
            progress = "unchanged"
            work_unit["no_progress_cycles"] += 1
    data["no_progress_cycles"] = work_unit["no_progress_cycles"]
    record = {
        "revision": data["verification_revision"] + 1,
        "work_unit_id": work_unit_id,
        "verification_request_id": args.verification_request_id,
        "candidate_sha": candidate_sha,
        "scope_digest": scope_digest,
        "initial": initial,
        "corrected": corrected,
        "remaining": remaining,
        "new": new,
        "progress": progress,
        "no_progress_cycles": work_unit["no_progress_cycles"],
    }
    data["defect_history"].append(record)
    data["verification_revision"] = record["revision"]
    data["active_work_unit_id"] = work_unit_id
    if work_unit["no_progress_cycles"] >= 2:
        data["phase"] = "blocked"
        data["status"] = "blocked"
        data["blocker"] = "BLOCKED_NO_PROGRESS"
        work_unit["status"] = "blocked"
    saved = write_state(data, args.expect_revision)
    append_event(args.run_id, "defects.recorded", None, record)
    print(json.dumps(saved, indent=2, ensure_ascii=False, sort_keys=True))
    return 1 if data["blocker"] == "BLOCKED_NO_PROGRESS" else 0

def cmd_event(args: argparse.Namespace) -> int:
    data_state = read_state(args.run_id)
    require_v2(data_state, "event")
    data: Any = None
    if args.data_json:
        data = json.loads(args.data_json)
    event = append_event(args.run_id, args.type, args.message, data)
    print(json.dumps(event, indent=2, ensure_ascii=False, sort_keys=True))
    return 0


def parse_batch_results(value: str) -> list[dict[str, Any]]:
    try:
        results = json.loads(value)
    except json.JSONDecodeError as exc:
        raise SystemExit(f"invalid --results-json: {exc}") from exc
    if not isinstance(results, list):
        raise SystemExit("--results-json must be an array")
    parsed: list[dict[str, Any]] = []
    seen: set[str] = set()
    for result in results:
        if not isinstance(result, dict):
            raise SystemExit("each delegation result must be an object")
        task_id = result.get("task_id")
        status = result.get("status")
        if not isinstance(task_id, str) or not task_id:
            raise SystemExit("each delegation result requires task_id")
        if task_id in seen:
            raise SystemExit(f"duplicate delegation result for task_id: {task_id}")
        if status not in TERMINAL_TASK_STATUSES:
            raise SystemExit(f"delegation result {task_id} is not terminal")
        seen.add(task_id)
        parsed.append({"task_id": task_id, "status": status, "payload": sanitize_evidence(result.get("payload"))})
    return parsed


def contradictory_claims(results: list[dict[str, Any]]) -> list[str]:
    """Detect conflicting structured claims while allowing independent findings."""
    claims: dict[str, str] = {}
    conflicts: set[str] = set()
    for result in results:
        payload = result.get("payload")
        if not isinstance(payload, dict) or not isinstance(payload.get("claims"), list):
            continue
        for claim in payload["claims"]:
            if not isinstance(claim, dict) or not isinstance(claim.get("subject"), str) or "value" not in claim:
                continue
            subject = claim["subject"]
            value = json.dumps(claim["value"], ensure_ascii=False, sort_keys=True)
            if subject in claims and claims[subject] != value:
                conflicts.add(subject)
            claims[subject] = value
    return sorted(conflicts)


def cmd_delegation_batch(args: argparse.Namespace) -> int:
    data = read_state(args.run_id)
    require_v2(data, "delegation-batch")
    batches: list[dict[str, Any]] = data["delegation_batches"]
    batch = next((item for item in batches if item.get("batch_id") == args.batch_id), None)
    if args.batch_action == "start":
        require_active_run(data, "delegation-batch start")
        ensure_route_allows(data, "delegation")
        if batch is not None:
            raise SystemExit(f"delegation batch already exists: {args.batch_id}")
        task_ids = parse_string_list(args.task_ids_json, "--task-ids-json")
        if not task_ids:
            raise SystemExit("--task-ids-json must contain at least one task ID")
        if len(set(task_ids)) != len(task_ids):
            raise SystemExit("--task-ids-json must be unique")
        batch = {
            "batch_id": args.batch_id, "task_ids": task_ids, "expected_results": len(task_ids),
            "status": "waiting-for-delegations", "started_at": utcnow(), "recovery_attempted": False,
            "results": [], "missing_task_ids": [], "contradictions": [],
        }
        batches.append(batch)
        data["phase"] = "waiting-for-delegations"
        data["status"] = "active"
        saved = write_state(data, args.expect_revision)
        append_event(args.run_id, "delegation_batch.started", None, batch)
        print(json.dumps(saved, indent=2, ensure_ascii=False, sort_keys=True))
        return 0

    if batch is None:
        raise SystemExit(f"delegation batch not found: {args.batch_id}")
    if args.batch_action == "collect":
        require_batch_collect_allowed(data, batch)
        if args.results_json is None:
            raise SystemExit("--results-json is required for delegation-batch collect")
        results = parse_batch_results(args.results_json)
        expected = set(batch["task_ids"])
        unexpected = sorted(item["task_id"] for item in results if item["task_id"] not in expected)
        if unexpected:
            raise SystemExit("unexpected delegation result task IDs: " + ", ".join(unexpected))
        result_ids = {item["task_id"] for item in results}
        missing = sorted(expected - result_ids)
        batch["results"] = results
        batch["missing_task_ids"] = missing
        if missing:
            if args.recover_missing and not batch["recovery_attempted"]:
                batch["recovery_attempted"] = True
                batch["status"] = "recovering-missing-delegation-result"
                data["phase"] = "collecting-delegation-results"
                data["status"] = "active"
                saved = write_state(data, args.expect_revision)
                append_event(args.run_id, "delegation_batch.recovery_requested", None, {"batch_id": args.batch_id, "missing_task_ids": missing})
                print(json.dumps(saved, indent=2, ensure_ascii=False, sort_keys=True))
                return 1
            data["phase"] = "blocked"
            data["status"] = "blocked"
            data["blocker"] = "BLOCKED_MISSING_DELEGATION_RESULT"
            batch["status"] = "blocked"
            saved = write_state(data, args.expect_revision)
            append_event(args.run_id, "delegation_batch.blocked", None, {"batch_id": args.batch_id, "missing_task_ids": missing})
            print(json.dumps(saved, indent=2, ensure_ascii=False, sort_keys=True))
            return 1
        batch["contradictions"] = contradictory_claims(results)
        if batch["contradictions"]:
            data["phase"] = "blocked"
            data["status"] = "blocked"
            data["blocker"] = "BLOCKED_CONTRADICTORY_DELEGATION_RESULTS"
            batch["status"] = "blocked"
            saved = write_state(data, args.expect_revision)
            append_event(args.run_id, "delegation_batch.blocked", None, {"batch_id": args.batch_id, "contradictions": batch["contradictions"]})
            print(json.dumps(saved, indent=2, ensure_ascii=False, sort_keys=True))
            return 1
        batch["status"] = "consolidating-evidence"
        batch["completed_at"] = utcnow()
        data["phase"] = "consolidating-evidence"
        data["status"] = "active"
        saved = write_state(data, args.expect_revision)
        append_event(args.run_id, "delegation_batch.completed", None, {"batch_id": args.batch_id, "result_count": len(results)})
        print(json.dumps(saved, indent=2, ensure_ascii=False, sort_keys=True))
        return 0

    require_active_run(data, "delegation-batch proceed")
    if batch["status"] != "consolidating-evidence":
        raise SystemExit("delegation batch must be consolidated before proceeding")
    if args.next_phase not in PHASE_STATUS or PHASE_STATUS[args.next_phase] != "active":
        raise SystemExit("--next-phase must be an active phase")
    batch["status"] = "proceeded"
    batch["proceeded_at"] = utcnow()
    batch["next_phase"] = args.next_phase
    data["phase"] = args.next_phase
    data["status"] = "active"
    saved = write_state(data, args.expect_revision)
    append_event(args.run_id, "delegation_batch.proceeded", None, {"batch_id": args.batch_id, "next_phase": args.next_phase})
    print(json.dumps(saved, indent=2, ensure_ascii=False, sort_keys=True))
    return 0


def write_v1_backup(run_id: str, revision: int, raw: bytes) -> Path:
    """Persist the exact pre-migration bytes once, without replacing a prior backup."""
    backup = run_dir(run_id) / f"state.v1.r{revision}.json"
    try:
        fd = os.open(backup, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    except FileExistsError:
        if backup.read_bytes() != raw:
            raise SystemExit(f"existing migration backup differs: {backup}")
        return backup
    try:
        offset = 0
        while offset < len(raw):
            offset += os.write(fd, raw[offset:])
        os.fsync(fd)
    finally:
        os.close(fd)
    return backup


def upgrade_v1_to_v2(data: dict[str, Any], backup_name: str) -> tuple[dict[str, Any], list[str]]:
    """Convert only unequivocal v1 data; never invent historic WU ownership."""
    changes = normalize_legacy_state(data)
    validate_state(data)
    old_budget = data["budgets"]
    old_corrections = data["attempts"]["corrections"]
    legacy_needed = bool(old_corrections or data["defect_history"] or data["no_progress_cycles"])
    work_units: dict[str, dict[str, Any]] = {}
    if legacy_needed:
        work_units["__legacy__"] = {
            "status": "legacy-ambiguous",
            "base_correction_limit": old_budget["max_worker_corrections"],
            "corrections_used": old_corrections,
            "no_progress_cycles": data["no_progress_cycles"],
            "legacy_defect_history": data["defect_history"],
            "migration_note": "v1 correction counts were run-global and cannot be assigned to a work unit",
        }
    blocked: dict[str, Any] | None = None
    if data.get("blocker") == "BLOCKED_CORRECTION_BUDGET":
        blocked = {
            "scope": "legacy-ambiguous",
            "work_unit_id": None,
            "code": "BLOCKED_CORRECTION_BUDGET",
            "used": old_corrections,
            "limit": old_budget["max_worker_corrections"],
            "reason": "v1 global correction blocker cannot be assigned to a work unit",
            "blocked_at": data.get("updated_at") or utcnow(),
        }
    data["schema"] = SCHEMA_V2
    data["schema_version"] = 2
    data["budgets"] = {
        "max_wait_seconds": old_budget["max_wait_seconds"],
        "max_plan_iterations": old_budget["max_plan_iterations"],
        "max_corrections_per_work_unit": old_budget["max_worker_corrections"],
        "max_total_corrections": None,
        "max_failover_chats": old_budget["max_failover_chats"],
    }
    data["active_work_unit_id"] = None
    data["work_units"] = work_units
    data["remediation"] = {
        "total_corrections_used": old_corrections,
        "max_total_corrections": None,
        "grants": [],
        "blocked": blocked,
    }
    data["migration"] = {
        "from_schema": SCHEMA_V1,
        "from_schema_version": 1,
        "backup": backup_name,
        "legacy_correction_accounting": "preserved under work_units.__legacy__ without WU attribution",
        "migrated_at": utcnow(),
    }
    changes.append("migrated v1 correction accounting to explicit legacy work-unit record")
    return data, changes


def cmd_migrate(args: argparse.Namespace) -> int:
    run_id = args.run_id
    path = run_dir(run_id) / "state.json"
    raw = path.read_bytes() if path.is_file() else None
    if raw is None:
        raise SystemExit(f"run not found: {run_id}")
    try:
        data = json.loads(raw)
    except Exception as exc:
        raise SystemExit(f"invalid state for {run_id}: {exc}") from exc
    if (data.get("schema"), data.get("schema_version")) not in SUPPORTED_SCHEMAS:
        raise SystemExit("unsupported state schema/version")
    observed_revision = data.get("revision")
    if args.expect_revision != observed_revision:
        raise SystemExit(
            f"revision conflict for {run_id}: expected {args.expect_revision}, observed {observed_revision}"
        )
    if state_is_v2(data):
        validate_state(data)
        print(json.dumps({"migrated": False, "state": data}, indent=2, ensure_ascii=False, sort_keys=True))
        return 0
    backup = write_v1_backup(run_id, int(observed_revision), raw)
    upgraded, changes = upgrade_v1_to_v2(data, backup.name)
    saved = write_state(upgraded, args.expect_revision)
    append_event(run_id, "state.migrated", "v1 state migrated to v2", {
        "from_schema": SCHEMA_V1,
        "to_schema": SCHEMA_V2,
        "backup": backup.name,
        "changes": changes,
        "revision": saved["revision"],
    })
    print(json.dumps({"migrated": True, "changes": changes, "backup": str(backup), "state": saved}, indent=2, ensure_ascii=False, sort_keys=True))
    return 0


REQUIRED_RECEIPT_KINDS = {"tracking_issue", "pull_request", "ci", "local_verification", "parent_gate", "local_commit"}
RECEIPT_ALIASES = {
    "tracking_issue": ("tracking_issue", "github_tracking_issue", "github_issue"),
    "pull_request": ("pull_request", "github_pr", "github_pull_request"),
    "ci": ("ci", "github_ci", "continuous_integration"),
    "local_verification": ("local_verification", "verification"),
    "parent_gate": ("parent_gate", "parent_objective_gate"),
}
RECEIPT_SUCCESS = {
    "tracking_issue": {"ISSUE_APPROVED", "ISSUE_REUSED"},
    "pull_request": {"PR_CREATED"},
    "ci": {"SUCCESS", "PASSED", "CI_PASSED", "CONFIRMED", "COMPLETED"},
    "local_verification": {"SUCCESS", "PASSED", "VERIFIED", "CONFIRMED", "COMPLETED"},
    "parent_gate": {"PARENT_OBJECTIVE_COMPLETE"},
    "local_commit": {"SUCCESS", "CONFIRMED"},
}


def receipt_status(value: Any) -> str | None:
    """Extract a conservative outcome from a receipt without inventing one."""
    if isinstance(value, str) and value.strip():
        return value.strip().upper()
    if not isinstance(value, dict):
        return None
    for key in ("status", "conclusion", "outcome", "state"):
        candidate = value.get(key)
        if isinstance(candidate, str) and candidate.strip():
            return candidate.strip().upper()
    return None


def operation_is_required(operation: dict[str, Any]) -> bool:
    """An explicitly optional delivery record never turns into a hidden gate."""
    intent = operation.get("intent")
    return not (isinstance(intent, dict) and intent.get("required") is False)


def operation_effective_status(operation: dict[str, Any]) -> str | None:
    """Return the technical outcome while retaining the original terminal status."""
    if operation.get("kind") == "frontier_exchange" and operation.get("effective_status") is not None:
        return str(operation["effective_status"])
    return operation.get("status")


def is_pre_effect_frontier_failure(operation: dict[str, Any]) -> bool:
    identity = frontier_operation_identity(operation)
    return (
        operation.get("kind") == "frontier_exchange"
        and operation.get("status") == "failed"
        and operation.get("effect_stage") == "none"
        and operation.get("pre_effect_absence_proven") is True
        and frontier_resolution_evidence_complete(operation)
        and identity["message_id"] is None
    )


def open_work_units(data: dict[str, Any]) -> list[str]:
    work_units = data.get("work_units", {})
    if not isinstance(work_units, dict):
        return ["<invalid-work-units>"]
    return sorted(
        str(work_unit_id) for work_unit_id, work_unit in work_units.items()
        if not isinstance(work_unit, dict) or work_unit.get("status") != "complete"
    )


def incomplete_batch_ids(data: dict[str, Any]) -> list[str]:
    batches = data.get("delegation_batches", [])
    if not isinstance(batches, list):
        return ["<invalid-delegation-batches>"]
    return sorted(
        str(batch.get("batch_id") or "<unnamed>") for batch in batches
        if not isinstance(batch, dict) or batch.get("status") != "proceeded"
    )


def pending_correction_ids(data: dict[str, Any]) -> list[str]:
    remediation = data.get("remediation")
    if not isinstance(remediation, dict):
        return ["<invalid-remediation>"]
    grants = remediation.get("grants", [])
    pending: list[str] = []
    if isinstance(grants, list):
        for grant in grants:
            if not isinstance(grant, dict):
                pending.append("<invalid-grant>")
                continue
            if grant.get("status") == "open" and grant.get("consumed_attempts", 0) < grant.get("granted_attempts", 0):
                pending.append(str(grant.get("grant_id") or "<unnamed-grant>"))
    else:
        pending.append("<invalid-grants>")
    return sorted(pending)


def delegation_attempt_is_historical_terminal(data: dict[str, Any], operation: dict[str, Any]) -> bool:
    if operation.get("kind") != "delegation" or operation.get("status") != "failed":
        return False
    intent = operation.get("intent")
    if not isinstance(intent, dict):
        return False
    task_id = intent.get("task_id")
    if not isinstance(task_id, str) or not task_id:
        return False
    if task_id in active_task_ids(data):
        return False
    entry = find_delegation_entry(data, task_id)
    if not isinstance(entry, dict) or entry.get("status") == "started":
        return False
    for batch in data.get("delegation_batches", []):
        if (
            isinstance(batch, dict)
            and task_id in (batch.get("task_ids") or [])
            and batch.get("status") != "proceeded"
        ):
            return False
    return operation.get("terminal_disposition") in {None, "failed_attempt"}


def receipt_completion_blockers(data: dict[str, Any]) -> list[str]:
    """Validate only delivery checks that this run explicitly persisted.

    No default issue/PR/CI requirement is inferred for a small local run.  Once
    a typed operation or named legacy receipt exists, however, an ambiguous,
    partial, failed, or cancelled result is a real completion blocker rather
    than a reason to claim success.
    """
    blockers: list[str] = []
    operations = data.get("pending_operations", [])
    if isinstance(operations, list):
        for operation in operations:
            if not isinstance(operation, dict) or not operation_is_required(operation):
                continue
            kind = operation.get("kind")
            status = operation.get("status")
            effective_status = operation_effective_status(operation)
            operation_id_value = str(operation.get("operation_id") or "<unnamed-operation>")
            if status in {"abandoned", "superseded"}:
                # These are typed historical resolutions.  Their evidence is
                # retained, but they are no longer required effects.
                continue
            if delegation_attempt_is_historical_terminal(data, operation):
                # The delegation ledger and work-unit state retain the failed
                # attempt. It is historical evidence, not an unfulfilled effect.
                continue
            if effective_status != "confirmed":
                # A pending record is reported separately, but a terminal
                # failed/abandoned effect must remain visible in the terminal
                # gate as well.
                if status in TERMINAL_OPERATION_STATUSES:
                    blockers.append(f"required operation {operation_id_value} ({kind}) ended {status}")
                continue
            if kind not in REQUIRED_RECEIPT_KINDS:
                continue
            if kind == "parent_gate" and parent_gate_response_type(operation) in FRONTIER_RESPONSE_TYPES:
                continue
            outcome = receipt_status(operation.get("receipt"))
            if outcome not in RECEIPT_SUCCESS[kind]:
                blockers.append(
                    f"required {kind} operation {operation_id_value} has incomplete receipt "
                    f"({outcome or 'unknown'})"
                )

    receipts = data.get("receipts", {})
    if not isinstance(receipts, dict):
        return blockers + ["delivery receipts are invalid"]
    for kind, aliases in RECEIPT_ALIASES.items():
        for alias in aliases:
            if alias not in receipts:
                continue
            outcome = receipt_status(receipts[alias])
            if outcome not in RECEIPT_SUCCESS[kind]:
                blockers.append(f"required {kind} receipt {alias} is incomplete ({outcome or 'unknown'})")
            break
    return blockers


def parent_gate_evaluated(data: dict[str, Any]) -> bool:
    """A continuous parent objective needs an explicit parent-complete response."""
    if not data.get("parent_objective"):
        return True
    gate = data.get("parent_gate")
    if isinstance(gate, dict) and (
        gate.get("status") == "confirmed"
        and gate.get("response_type") == PARENT_GATE_TERMINAL_RESPONSE
        and isinstance(gate.get("operation_id"), str)
        and isinstance(gate.get("request_id"), str)
        and isinstance(gate.get("message_id"), str)
    ):
        return True
    for operation in data.get("pending_operations", []):
        if (
            isinstance(operation, dict)
            and is_parent_gate_operation(operation)
            and operation.get("status") == "confirmed"
            and parent_gate_response_type(operation) == PARENT_GATE_TERMINAL_RESPONSE
        ):
            return True
    receipts = data.get("receipts", {})
    if isinstance(receipts, dict):
        return any(
            receipt_status(receipts.get(alias)) == "PARENT_OBJECTIVE_COMPLETE"
            or (isinstance(receipts.get(alias), dict) and receipts[alias].get("response_type") == PARENT_GATE_TERMINAL_RESPONSE)
            for alias in RECEIPT_ALIASES["parent_gate"] if alias in receipts
        )
    return False


def completion_blockers(data: dict[str, Any]) -> list[str]:
    """Return every persisted condition that makes terminal completion unsafe.

    This is intentionally pure so both `reconcile` and `complete` share the
    same gate.  It does not infer that absent integrations were required; it
    only refuses to finish work that the run itself says is still open or
    whose explicitly recorded delivery result is not successful.
    """
    blockers: list[str] = []
    work_units = open_work_units(data)
    if work_units:
        blockers.append("open work units: " + ", ".join(work_units))
    batches = incomplete_batch_ids(data)
    if batches:
        blockers.append("incomplete delegation batches: " + ", ".join(batches))
    tasks = active_task_ids(data)
    if tasks:
        blockers.append("active delegation tasks: " + ", ".join(tasks))
    corrections = pending_correction_ids(data)
    if corrections:
        blockers.append("pending corrections: " + ", ".join(corrections))
    pending = nonterminal_operations(data)
    if pending:
        blockers.append("pending operations: " + ", ".join(str(item["operation_id"]) for item in pending))

    # An external Frontier identity without its matching ledger record cannot
    # prove which exchange finished, including a partial write on a newer run.
    frontier_operations = [
        operation for operation in data.get("pending_operations", [])
        if isinstance(operation, dict) and operation.get("kind") == "frontier_exchange"
    ]
    if (data.get("frontier_task_id") or data.get("last_request_id")) and not frontier_operations:
        blockers.append("frontier exchange lacks a typed operation record")
    if data.get("phase") == "waiting-for-frontier":
        blockers.append("frontier exchange is not reconciled")

    remediation = data.get("remediation")
    if isinstance(remediation, dict) and remediation.get("blocked") is not None:
        blockers.append("correction remediation is blocked")
    if not parent_gate_evaluated(data):
        blockers.append("parent objective has not passed a parent gate")
    if data.get("push_status") in {"pending", "failed"}:
        blockers.append(f"push status is {data.get('push_status')}")
    blockers.extend(receipt_completion_blockers(data))
    # Keep messages deterministic even if a legacy receipt and its operation
    # report the same problem.
    return list(dict.fromkeys(blockers))


def operation_reconcile_action(operation: dict[str, Any]) -> tuple[str, str]:
    """Map one durable in-flight operation to its single safe next action."""
    kind = operation.get("kind")
    status = operation.get("status")
    operation_id_value = str(operation.get("operation_id") or "<unnamed-operation>")
    if kind == "delegation":
        return "COLLECT_DELEGATIONS", f"delegation operation {operation_id_value} is {status}"
    if kind == "frontier_exchange":
        action = "WAIT_FRONTIER" if status in {"effect-observed", "receipt-recorded"} else "RECOVER_FRONTIER_EXCHANGE"
        return action, f"Frontier exchange {operation_id_value} is {status}"
    if kind == "tracking_issue":
        return "RECONCILE_TRACKING_ISSUE", f"tracking issue operation {operation_id_value} is {status}"
    if kind in {"pull_request", "git_delivery"}:
        return "RECONCILE_PULL_REQUEST", f"delivery operation {operation_id_value} is {status}"
    if kind == "local_commit":
        return "RECONCILE_LOCAL_COMMIT", f"local commit operation {operation_id_value} is {status}"
    if kind in {"ci", "local_verification"}:
        return "RUN_LOCAL_VERIFICATION", f"verification operation {operation_id_value} is {status}"
    if kind == "parent_gate":
        return "RUN_PARENT_GATE", f"parent gate operation {operation_id_value} is {status}"
    return "BLOCKED_STATE_INCOMPLETE", f"operation {operation_id_value} has an unsupported kind"


def derive_reconcile_action(data: dict[str, Any]) -> tuple[str, str, list[str]]:
    """Derive, but never execute, exactly one next recovery action."""
    if data.get("status") in TERMINAL_RUN_STATUSES:
        return "NO_ACTION", "run is terminal", []

    execution = data.get("execution")
    if data.get("status") == "active" and isinstance(execution, dict) \
            and execution.get("requested_policy") == "unresolved":
        return "REQUEST_EXECUTION_POLICY", "execution policy must be resolved before external effects", []

    failed_frontier = [
        operation for operation in data.get("pending_operations", [])
        if isinstance(operation, dict)
        and operation.get("kind") == "frontier_exchange"
        and operation.get("status") == "failed"
        and operation_effective_status(operation) != "confirmed"
    ]

    if data.get("status") == "blocked":
        blocker = data.get("blocker")
        if blocker == PAUSE_BLOCKER:
            pause = data.get("pause") or {}
            action = pause.get("action") if isinstance(pause, dict) else None
            return "RESUME_PAUSED_RUN", "run is explicitly paused", [json.dumps(action, sort_keys=True)]
        if blocker == CLARIFICATION_BLOCKER:
            clarification = data.get("clarification") or {}
            operation_id_value = clarification.get("operation_id") if isinstance(clarification, dict) else None
            return "RESUME_BLOCKING_CLARIFICATION", "a typed Frontier clarification requires an answer", [
                str(operation_id_value or "<unnamed-operation>")
            ]
        if blocker == "BLOCKED_MISSING_DELEGATION_RESULT":
            return "RECOVER_MISSING_RESULT", "a delegation result is missing", []
        if blocker in {"BLOCKED_CORRECTION_BUDGET", "BLOCKED_TOTAL_CORRECTION_BUDGET", "BLOCKED_NO_PROGRESS"}:
            return "REQUEST_CORRECTION", f"correction recovery is required ({blocker})", []
        if blocker == "HUMAN_DECISION_REQUIRED":
            return "HUMAN_DECISION_REQUIRED", "a persisted human decision is required", []
        if is_recoverable_frontier_blocker(data):
            for predecessor in failed_frontier:
                successor = confirmed_frontier_successor(data, predecessor)
                if successor is not None:
                    return (
                        "FINALIZE_FRONTIER_SUPERSESSION",
                        f"confirmed successor {successor['operation_id']} can close failed Frontier attempt {predecessor['operation_id']}",
                        [predecessor["operation_id"], successor["operation_id"]],
                    )
            if failed_frontier:
                predecessor = failed_frontier[0]
                if is_pre_effect_frontier_failure(predecessor) or recovery_blocker_code(data) in {
                    "BLOCKED_FRONTIER_RECOVERY_MISSING_ORIGINAL_IDENTITY",
                    "BLOCKED_FRONTIER_PRE_EFFECT_FAILURE",
                }:
                    return (
                        "RESOLVE_PRE_EFFECT_FRONTIER_FAILURE",
                        f"blocked Frontier attempt {predecessor['operation_id']} requires typed no-effect resolution",
                        [predecessor["operation_id"]],
                    )
                return (
                    "RECOVER_FRONTIER_EXCHANGE",
                    f"blocked Frontier exchange {predecessor['operation_id']} may have produced an effect",
                    [predecessor["operation_id"]],
                )
        return "BLOCKED_STATE_INCOMPLETE", f"run is blocked ({blocker or 'unspecified blocker'})", []

    pending = nonterminal_operations(data)
    if pending:
        action, reason = operation_reconcile_action(pending[0])
        return action, reason, [str(operation["operation_id"]) for operation in pending]

    for predecessor in failed_frontier:
        successor = confirmed_frontier_successor(data, predecessor)
        if successor is not None:
            return (
                "FINALIZE_FRONTIER_SUPERSESSION",
                f"confirmed successor {successor['operation_id']} can close failed Frontier attempt {predecessor['operation_id']}",
                [predecessor["operation_id"], successor["operation_id"]],
            )

    if failed_frontier:
        operation = failed_frontier[0]
        if is_pre_effect_frontier_failure(operation):
            return (
                "RETRY_FRONTIER_EXCHANGE",
                f"Frontier exchange {operation.get('operation_id', '<unnamed-operation>')} failed before any effect",
                [str(operation.get("operation_id") or "<unnamed-operation>")],
            )
        return (
            "RECOVER_FRONTIER_EXCHANGE",
            f"Frontier exchange {operation.get('operation_id', '<unnamed-operation>')} is failed",
            [str(operation.get("operation_id") or "<unnamed-operation>")],
        )

    frontier_operations = [
        operation for operation in data.get("pending_operations", [])
        if isinstance(operation, dict) and operation.get("kind") == "frontier_exchange"
    ]
    if (data.get("frontier_task_id") or data.get("last_request_id")) and not frontier_operations:
        return "RECOVER_FRONTIER_EXCHANGE", "external Frontier identity lacks a typed operation record", []

    tasks = active_task_ids(data)
    if tasks:
        return "COLLECT_DELEGATIONS", "persisted delegation tasks are still active", tasks
    batches = incomplete_batch_ids(data)
    if batches:
        return "COLLECT_DELEGATIONS", "a delegation batch is incomplete", batches

    if parent_gate_needs_request(data):
        return "REQUEST_PARENT_GATE", "completed work unit requires exactly one parent gate", []
    next_work_unit = data.get("next_work_unit")
    if is_continuous_parent(data) and isinstance(next_work_unit, dict) and next_work_unit.get("status") == "approved":
        return "BEGIN_NEXT_WORK_UNIT", "a confirmed Frontier proposed_plan approved the next work unit", [
            str(next_work_unit["work_unit_id"])
        ]

    phase = data.get("phase")
    if phase == "waiting-for-frontier":
        if data.get("frontier_task_id") or data.get("last_request_id"):
            return "RECOVER_FRONTIER_EXCHANGE", "legacy Frontier identity requires discovery", []
        return "BLOCKED_STATE_INCOMPLETE", "waiting-for-frontier has no typed operation or external identity", []
    if phase == "verifying":
        return "RUN_LOCAL_VERIFICATION", "run is at the verification phase", []
    if phase == "parent-gate":
        if parent_gate_needs_request(data):
            return "REQUEST_PARENT_GATE", "completed work unit requires exactly one parent gate", []
        if is_continuous_parent(data) and parent_gate_evaluated(data):
            blockers = completion_blockers(data)
            if blockers:
                return "BLOCKED_STATE_INCOMPLETE", blockers[0], []
            return "COMPLETE_RUN", "explicit PARENT_OBJECTIVE_COMPLETE passed all terminal gates", []
        return "RUN_PARENT_GATE", "run is at the parent gate", []
    if phase in {"reporting", "committing", "pushing", "proceeding-to-next-gate"}:
        blockers = completion_blockers(data)
        if blockers:
            return "BLOCKED_STATE_INCOMPLETE", blockers[0], []
        return "COMPLETE_RUN", "all persisted terminal gates are satisfied", []
    return "CONTINUE_PHASE", f"continue persisted phase {phase}", []


def cmd_reconcile(args: argparse.Namespace) -> int:
    """Print one recovery action without writing state, events, or receipts."""
    data = read_state(args.run_id)
    require_v2(data, "reconcile")
    validate_state(data)
    action, reason, identifiers = derive_reconcile_action(data)
    result = {
        "run_id": data["run_id"],
        "revision": data["revision"],
        "action": action,
        "reason": reason,
        "operation_ids": identifiers,
        "completion_blockers": completion_blockers(data) if action in {"COMPLETE_RUN", "BLOCKED_STATE_INCOMPLETE"} else [],
    }
    print(json.dumps(result, indent=2, ensure_ascii=False, sort_keys=True))
    return 0


def atomic_text(path: Path, content: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=path.name + ".", suffix=".tmp", dir=path.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write(content)
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(temporary, 0o600)
        os.replace(temporary, path)
    finally:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass


def cmd_delivery(args: argparse.Namespace) -> int:
    """Generate delivery text from confirmed local identities without GitHub effects."""
    data = read_state(args.run_id)
    require_v2(data, "delivery")
    validate_state(data)
    if args.delivery_action != "pr-body":
        raise SystemExit("unsupported delivery action")
    tracking_operation = find_operation(data, args.tracking_operation_id)
    repo, issue_number, issue_url, identity = delivery_operation_issue_identity(tracking_operation)
    try:
        template = Path(args.template_file).expanduser().resolve().read_text(encoding="utf-8")
    except OSError as exc:
        raise SystemExit(f"pull request template cannot be read: {args.template_file}") from exc
    existing_markers = TRACKING_BODY_LINK_RE.findall(template)
    if any(marker != issue_url for marker in existing_markers):
        raise SystemExit("PULL_REQUEST_BODY_TRACKING_ISSUE_MISMATCH")
    if existing_markers:
        body = template
    else:
        suffix = (
            "\n\n## Tracking issue\n"
            f"[Tracking issue #{issue_number}]({issue_url})\n"
            f"<!-- myrmex:tracking-issue-url={issue_url} -->\n"
        )
        body = template.rstrip() + suffix
    output = Path(args.output_file).expanduser().resolve()
    atomic_text(output, body)
    result = {
        "schema": "myrmex.delivery-artifact/v1",
        "kind": "pull_request_body",
        "body_file": str(output),
        "body_digest": hashlib.sha256(body.encode()).hexdigest(),
        "tracking_issue_operation_id": tracking_operation["operation_id"],
        "tracking_issue_identity_marker": identity,
        "tracking_issue_number": issue_number,
        "tracking_issue_url": issue_url,
        "repo": repo,
    }
    print(json.dumps(result, indent=2, ensure_ascii=False, sort_keys=True))
    return 0


def cmd_complete(args: argparse.Namespace) -> int:
    """Atomically persist terminal state, then record completion before unlocking."""
    data = read_state(args.run_id)
    require_v2(data, "complete")
    require_active_run(data, "complete")
    blockers = completion_blockers(data)
    if blockers:
        raise SystemExit("BLOCKED_COMPLETION_INCOMPLETE: " + "; ".join(blockers))
    lock_path: Path | None = None
    previous_lock: dict[str, Any] | None = None
    if args.unlock_owner:
        lock_path = run_dir(args.run_id) / "lock.json"
        if not lock_path.exists():
            raise SystemExit("run is not locked by the requested completion owner")
        previous_lock = json.loads(lock_path.read_text(encoding="utf-8"))
        if previous_lock.get("owner") != args.unlock_owner:
            raise SystemExit(f"run lock is owned by {previous_lock.get('owner')!r}")
    data["phase"] = "dormant"
    data["status"] = "dormant"
    data["blocker"] = None
    disable_commit_policy_authorization(data, "parent objective completed")
    data["completion"] = {"completed_at": utcnow(), "message": args.message}
    saved = write_state(data, args.expect_revision)
    append_event(args.run_id, "objective.complete", args.message, {"revision": saved["revision"]})
    unlocked: dict[str, Any] | None = None
    if lock_path is not None and previous_lock is not None:
        lock_path.unlink()
        unlocked = {"previous": previous_lock}
        append_event(args.run_id, "run.unlocked", "completion lock release", unlocked)
    print(json.dumps({"state": saved, "unlocked": unlocked}, indent=2, ensure_ascii=False, sort_keys=True))
    return 0


def cmd_artifact_path(args: argparse.Namespace) -> int:
    data = read_state(args.run_id)
    require_v2(data, "artifact-path")
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,127}", args.name):
        raise SystemExit("invalid artifact name")
    root = Path(normalize_artifact_root(artifact_root_for_state(data), data["repository_root"], create=True))
    path = (root / args.name).resolve()
    try:
        path.relative_to(root)
    except ValueError as exc:
        raise SystemExit("artifact path escapes the external artifact root") from exc
    path.parent.mkdir(parents=True, exist_ok=True)
    print(path)
    return 0


def cmd_lock(args: argparse.Namespace) -> int:
    data = read_state(args.run_id)
    require_v2(data, "lock")
    path = run_dir(args.run_id) / "lock.json"
    lock = {"owner": args.owner, "acquired_at": utcnow(), "pid": os.getpid()}

    if args.force:
        previous = None
        if path.exists():
            previous = json.loads(path.read_text(encoding="utf-8"))
        atomic_write(path, lock)
        append_event(args.run_id, "run.locked", "lock force-acquired", {"lock": lock, "previous": previous})
        print(json.dumps(lock, indent=2))
        return 0

    try:
        fd = os.open(path, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
    except FileExistsError:
        current = json.loads(path.read_text(encoding="utf-8"))
        if current.get("owner") == args.owner:
            print(json.dumps(current, indent=2))
            return 0
        raise SystemExit(f"run locked by {current.get('owner')!r} since {current.get('acquired_at')}")

    try:
        payload = (json.dumps(lock, indent=2, ensure_ascii=False, sort_keys=True) + "\n").encode()
        os.write(fd, payload)
        os.fsync(fd)
    finally:
        os.close(fd)
    append_event(args.run_id, "run.locked", None, lock)
    print(json.dumps(lock, indent=2))
    return 0


def cmd_unlock(args: argparse.Namespace) -> int:
    data = read_state(args.run_id)
    require_v2(data, "unlock")
    path = run_dir(args.run_id) / "lock.json"
    if not path.exists():
        print(json.dumps({"unlocked": False, "reason": "not locked"}, indent=2))
        return 0
    current = json.loads(path.read_text(encoding="utf-8"))
    if current.get("owner") != args.owner and not args.force:
        raise SystemExit(f"lock owned by {current.get('owner')!r}; use matching owner")
    path.unlink()
    append_event(args.run_id, "run.unlocked", None, {"previous": current})
    print(json.dumps({"unlocked": True, "previous": current}, indent=2))
    return 0


def cmd_pause(args: argparse.Namespace) -> int:
    data = read_state(args.run_id)
    require_v2(data, "pause")
    require_active_run(data, "pause")
    action, reason, identifiers = derive_reconcile_action(data)
    data["pause"] = {
        "status": "paused", "reason": args.reason, "resume_phase": data["phase"],
        "action": {"action": action, "reason": reason, "identifiers": identifiers},
        "paused_at": utcnow(),
    }
    data["phase"] = "blocked"
    data["status"] = "blocked"
    data["blocker"] = PAUSE_BLOCKER
    saved = write_state(data, args.expect_revision)
    append_event(args.run_id, "run.paused", args.reason, {
        "action": action, "identifiers": identifiers, "revision": saved["revision"],
    })
    print(json.dumps(saved, indent=2, ensure_ascii=False, sort_keys=True))
    return 0


def cmd_resume(args: argparse.Namespace) -> int:
    data = read_state(args.run_id)
    require_v2(data, "resume")
    require_nonterminal_run(data, "resume")
    if data.get("status") != "blocked" or data.get("blocker") not in {PAUSE_BLOCKER, CLARIFICATION_BLOCKER}:
        raise SystemExit("resume requires an explicit pause or blocking clarification")
    pause = data.get("pause") if data.get("blocker") == PAUSE_BLOCKER else data.get("clarification")
    if not isinstance(pause, dict) or not isinstance(pause.get("resume_phase"), str):
        raise SystemExit("resumable state is missing its typed resume evidence")
    resume_phase = pause["resume_phase"]
    if resume_phase not in PHASES or PHASE_STATUS[resume_phase] != "active":
        raise SystemExit("resumable state has an invalid active phase")
    pause["status"] = "resumed"
    pause["resumed_at"] = utcnow()
    data["phase"] = resume_phase
    data["status"] = "active"
    data["blocker"] = None
    saved = write_state(data, args.expect_revision)
    append_event(args.run_id, "run.resumed", args.reason, {
        "from_blocker": args.reason, "phase": resume_phase, "revision": saved["revision"],
    })
    print(json.dumps(saved, indent=2, ensure_ascii=False, sort_keys=True))
    return 0


def cmd_cancel(args: argparse.Namespace) -> int:
    data = read_state(args.run_id)
    require_v2(data, "cancel")
    require_nonterminal_run(data, "cancel")
    cancellation_type = args.cancellation_type or (
        PARENT_CANCELLATION_TYPE if is_continuous_parent(data) else RUN_CANCELLATION_TYPE
    )
    if cancellation_type not in {PARENT_CANCELLATION_TYPE, RUN_CANCELLATION_TYPE}:
        raise SystemExit("invalid cancellation type")
    evidence = parse_object_json(args.evidence_json, "--evidence-json") if args.evidence_json else {}
    data["cancellation"] = {
        "type": cancellation_type, "reason": args.reason,
        "request_id": args.request_id, "message_id": args.message_id,
        "evidence": evidence, "cancelled_at": utcnow(),
    }
    data["phase"] = "cancelled"
    data["status"] = "cancelled"
    data["blocker"] = args.reason
    disable_commit_policy_authorization(data, "parent run cancelled")
    saved = write_state(data, args.expect_revision)
    append_event(args.run_id, "run.cancelled", args.reason, {
        "type": cancellation_type, "request_id": args.request_id, "message_id": args.message_id,
    })
    print(json.dumps(saved, indent=2, ensure_ascii=False, sort_keys=True))
    return 0


def cmd_latest(args: argparse.Namespace) -> int:
    print(latest_run())
    return 0


def cmd_hash(args: argparse.Namespace) -> int:
    digest = hashlib.sha256(Path(args.file).expanduser().read_bytes()).hexdigest()
    print(digest)
    return 0


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="myrmex-state", description=__doc__)
    sub = p.add_subparsers(dest="command", required=True)

    doctor = sub.add_parser("doctor")
    doctor.set_defaults(func=cmd_doctor)

    init = sub.add_parser("init")
    init.add_argument("--run-id")
    init.add_argument("--objective")
    init.add_argument("--objective-file")
    init.add_argument("--repository-root", required=True)
    init.add_argument("--mode", choices=["interactive", "autonomous"], required=True)
    init.add_argument("--scope", choices=["narrow", "continuous"], required=True)
    init.add_argument("--parent-objective")
    init.add_argument("--artifact-root", help="absolute external per-run Frontier artifact root")
    init.add_argument("--branch")
    init.add_argument("--base-sha")
    init.add_argument("--protected-dirty-path", action="append")
    init.add_argument("--commit-policy", choices=sorted(POLICIES), default="ask")
    init.add_argument("--push-policy", choices=sorted(POLICIES), default="deny")
    init.add_argument(
        "--execution-policy", choices=sorted(EXECUTION_POLICIES), default="unresolved",
        help="persist an explicit route; omit only when OpenCode must ask the user once",
    )
    init.add_argument("--execution-authority")
    init.add_argument("--execution-request-id")
    init.add_argument("--execution-source-digest")
    init.add_argument("--chat-url")
    init.add_argument("--max-wait-seconds", type=int, default=900)
    init.add_argument("--max-plan-iterations", type=int, default=6)
    init.add_argument("--max-corrections-per-work-unit", type=int, default=2)
    init.add_argument(
        "--max-worker-corrections", type=int, dest="legacy_max_worker_corrections",
        help="deprecated alias for --max-corrections-per-work-unit",
    )
    init.add_argument("--max-total-corrections", type=int)
    init.add_argument("--max-failover-chats", type=int, default=1)
    init.set_defaults(func=cmd_init)

    show = sub.add_parser("show")
    show.add_argument("run_id", nargs="?")
    show.set_defaults(func=cmd_show)

    listing = sub.add_parser("list")
    listing.add_argument("--status", choices=sorted(STATUSES))
    listing.add_argument("--limit", type=int, default=20)
    listing.set_defaults(func=cmd_list)

    patch = sub.add_parser("patch")
    patch.add_argument("run_id")
    patch.add_argument("--set", action="append")
    patch.add_argument("--json-patch")
    # `patch` remains a temporary metadata/receipt compatibility escape hatch
    # while typed delivery operations are rolled out.  Domain mutators require
    # revisions; callers that can provide one still get optimistic checks.
    patch.add_argument("--expect-revision", type=int)
    patch.set_defaults(func=cmd_patch)

    commit_policy = sub.add_parser("commit-policy", help="authorize a governed parent local-commit mode")
    commit_policy_sub = commit_policy.add_subparsers(dest="commit_policy_action", required=True)
    commit_policy_authorize = commit_policy_sub.add_parser("authorize", help="authorize standing governed local commits")
    commit_policy_authorize.add_argument("run_id")
    commit_policy_authorize.add_argument("--authority", required=True)
    commit_policy_authorize.add_argument("--source-request-id")
    commit_policy_authorize.add_argument("--request-id", dest="request_id")
    commit_policy_authorize.add_argument("--source-operation-id", "--frontier-operation-id", dest="source_operation_id")
    commit_policy_authorize.add_argument("--work-unit-id", required=True)
    commit_policy_authorize.add_argument("--evidence-json")
    commit_policy_authorize.add_argument("--expect-revision", type=int, required=True)
    commit_policy_authorize.set_defaults(func=cmd_commit_policy)

    transition = sub.add_parser("transition", help="apply one validated active-run phase transition")
    transition.add_argument("run_id")
    transition.add_argument("--to-phase", choices=sorted(PHASES), required=True)
    transition.add_argument("--reason", required=True)
    transition.add_argument("--blocker")
    transition.add_argument("--recovery-code")
    transition.add_argument("--recovery-operation-id", action="append")
    transition.add_argument("--recovery-resume-phase")
    transition.add_argument("--recovery-evidence-digest")
    transition.add_argument("--expect-revision", type=int, required=True)
    transition.set_defaults(func=cmd_transition)

    route = sub.add_parser(
        "route",
        help="persist or enforce an execution route (`route set RUN_ID`; legacy `route RUN_ID set` also works)",
    )
    route.add_argument("first")
    route.add_argument("second")
    route.add_argument("--policy", choices=sorted(EXECUTION_POLICIES))
    route.add_argument("--authority")
    route.add_argument("--request-id")
    route.add_argument("--source-digest")
    route.add_argument("--override-locked", action="store_true")
    route.add_argument("--action", choices=["delegation", "frontier"])
    route.add_argument("--expect-revision", type=int, required=True)
    route.set_defaults(func=cmd_route)

    operation = sub.add_parser("operation", help="persist one external-effect lifecycle without generic patches")
    operation.add_argument("run_id")
    operation.add_argument(
        "operation_action",
        choices=["intent", "observe", "receipt", "confirm", "supersede", "abandon"],
    )
    operation.add_argument("--kind", choices=sorted(OPERATION_KINDS))
    operation.add_argument("--idempotency-key")
    operation.add_argument("--authorization-id")
    operation.add_argument("--intent-json")
    operation.add_argument("--operation-id")
    operation.add_argument("--effect-json")
    operation.add_argument("--receipt-json")
    operation.add_argument("--status", choices=sorted(TERMINAL_OPERATION_STATUSES))
    operation.add_argument("--reason")
    operation.add_argument("--successor-operation-id")
    operation.add_argument(
        "--pre-effect-absence-proven", action="store_true",
        help="assert that no browser tab, outbound request, or external effect existed",
    )
    operation.add_argument("--expect-revision", type=int, required=True)
    operation.set_defaults(func=cmd_operation)

    recovery = sub.add_parser("recovery", help="resolve a typed recoverable blocker without generic patches")
    recovery.add_argument("run_id")
    recovery.add_argument("recovery_action", choices=["resolve-frontier"])
    recovery.add_argument("--operation-id", required=True)
    recovery.add_argument("--successor-operation-id")
    recovery.add_argument("--disposition", choices=["supersede", "abandon"], default="supersede")
    recovery.add_argument("--pre-effect-absence-proven", action="store_true")
    recovery.add_argument("--evidence-json")
    recovery.add_argument("--resume-phase")
    recovery.add_argument("--reason")
    recovery.add_argument("--expect-revision", type=int, required=True)
    recovery.set_defaults(func=cmd_recovery)

    authorization = sub.add_parser("authorization", help="create or consume bounded local operation authorization")
    authorization.add_argument("run_id")
    authorization.add_argument("authorization_action", choices=["create", "consume"])
    authorization.add_argument("--authority", choices=sorted(AUTHORIZATION_AUTHORITIES))
    authorization.add_argument("--request-id")
    authorization.add_argument("--repository-root")
    authorization.add_argument("--branch")
    authorization.add_argument("--expected-head")
    authorization.add_argument("--allowed-path", action="append")
    authorization.add_argument("--scope-digest")
    authorization.add_argument("--message", "--commit-message", dest="commit_message")
    authorization.add_argument("--max-uses", type=int, default=1)
    authorization.add_argument("--expires-at")
    authorization.add_argument("--work-unit-id")
    authorization.add_argument("--candidate-diff-sha")
    authorization.add_argument("--source-operation-id", "--frontier-operation-id", dest="source_operation_id")
    authorization.add_argument("--source-request-id")
    authorization.add_argument("--authorization-id")
    authorization.add_argument("--operation-id")
    authorization.add_argument("--commit-sha")
    authorization.add_argument("--expect-revision", type=int, required=True)
    authorization.set_defaults(func=cmd_authorization)

    frontier = sub.add_parser("frontier", help="record and recover typed Frontier exchange outcomes")
    frontier.add_argument("run_id")
    frontier.add_argument("frontier_action", choices=["start", "result", "recover", "retry"])
    frontier.add_argument("--request-id", required=True)
    frontier.add_argument("--task-id")
