    complete.add_argument("run_id")
    complete.add_argument("--message", required=True)
    complete.add_argument("--unlock-owner")
    complete.add_argument("--expect-revision", type=int, required=True)
    complete.set_defaults(func=cmd_complete)

    latest = sub.add_parser("latest")
    latest.set_defaults(func=cmd_latest)

    hashing = sub.add_parser("hash")
    hashing.add_argument("--file", required=True)
    hashing.set_defaults(func=cmd_hash)
    return p


def main() -> int:
    args = build_parser().parse_args()
    return int(args.func(args))


if __name__ == "__main__":
    raise SystemExit(main())
