    defects.add_argument("--expect-revision", type=int, required=True)
    defects.set_defaults(func=cmd_defects)

    artifact = sub.add_parser("artifact-path")
    artifact.add_argument("run_id")
    artifact.add_argument("name")
    artifact.set_defaults(func=cmd_artifact_path)

    lock = sub.add_parser("lock")
    lock.add_argument("run_id")
    lock.add_argument("--owner", required=True)
    lock.add_argument("--force", action="store_true")
    lock.set_defaults(func=cmd_lock)

    unlock = sub.add_parser("unlock")
    unlock.add_argument("run_id")
    unlock.add_argument("--owner", required=True)
    unlock.add_argument("--force", action="store_true")
    unlock.set_defaults(func=cmd_unlock)

    pause = sub.add_parser("pause", help="pause a run with typed, resumable evidence")
    pause.add_argument("run_id")
    pause.add_argument("--reason", required=True)
    pause.add_argument("--expect-revision", type=int, required=True)
    pause.set_defaults(func=cmd_pause)

    resume = sub.add_parser("resume", help="resume an explicit pause or blocking clarification")
    resume.add_argument("run_id")
    resume.add_argument("--reason", default="typed resume")
    resume.add_argument("--expect-revision", type=int, required=True)
    resume.set_defaults(func=cmd_resume)

    cancel = sub.add_parser("cancel")
    cancel.add_argument("run_id")
    cancel.add_argument("--reason", required=True)
    cancel.add_argument("--cancellation-type", choices=[PARENT_CANCELLATION_TYPE, RUN_CANCELLATION_TYPE])
    cancel.add_argument("--request-id")
    cancel.add_argument("--message-id")
    cancel.add_argument("--evidence-json")
    cancel.add_argument("--expect-revision", type=int, required=True)
    cancel.set_defaults(func=cmd_cancel)

    migrate = sub.add_parser("migrate")
    migrate.add_argument("run_id")
    migrate.add_argument("--expect-revision", type=int, required=True)
    migrate.set_defaults(func=cmd_migrate)

    complete = sub.add_parser("complete")
    complete.add_argument("run_id")
    complete.add_argument("--message", required=True)
    complete.add_argument("--unlock-owner")
    complete.add_argument("--expect-revision", type=int, required=True)
    complete.set_defaults(func=cmd_complete)

    latest = sub.add_parser("latest")
    latest.set_defaults(func=cmd_latest)

    hashing = sub.add_parser("hash")
    hashing.add_argument("--file", required=True)
    hashing.set_defaults(func=cmd_hash)
    return p


def main() -> int:
    args = build_parser().parse_args()
    return int(args.func(args))


if __name__ == "__main__":
    raise SystemExit(main())
