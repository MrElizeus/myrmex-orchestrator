    preflight = sub.add_parser("delegation-preflight", help="persist WU/task/workspace before launching a Task")
    preflight.add_argument("run_id")
    preflight.add_argument("--agent", required=True)
    preflight.add_argument("--role", choices=["scout", "writer", "verifier"], required=True)
    preflight.add_argument("--reason", required=True)
