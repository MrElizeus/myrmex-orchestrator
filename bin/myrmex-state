    preflight.add_argument("--work-unit-id", required=True)
    preflight.add_argument("--workspace", required=True)
    preflight.add_argument("--expect-revision", type=int, required=True)
    preflight.set_defaults(func=cmd_delegation_preflight)

    work_unit = sub.add_parser("work-unit", help="close a fully verified work unit")
    work_unit.add_argument("run_id")
