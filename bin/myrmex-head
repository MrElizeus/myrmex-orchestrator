#!/usr/bin/env python3
"""Persistent campaign supervisor for Myrmex autonomous work.

Designed to run in foreground under systemd --user (or standalone).
Supports determinist --once mode for discrete cycles and continuous loop for production.
Always executes reconcile before taking action.
"""
from __future__ import annotations

import argparse
import datetime as dt
import hashlib
import json
import os
import shlex
import signal
import socket
import subprocess
import sys
import tempfile
import time
from pathlib import Path
from typing import Any

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "bin"))


def utcnow() -> str:
    return dt.datetime.now(dt.timezone.utc).isoformat()


def run_argv(cmd: list[str] | str, cwd: str, timeout: int = 300) -> subprocess.CompletedProcess[str]:
    """Execute command safely as an argv list without shell=True."""
    if isinstance(cmd, str):
        argv = shlex.split(cmd)
    else:
        argv = list(cmd)
    return subprocess.run(argv, cwd=cwd, capture_output=True, text=True, timeout=timeout)


class SupervisorTermination(Exception):
    pass


class CampaignSupervisor:
    def __init__(
        self,
        campaign_id: str | None = None,
        poll_interval: int = 5,
        once: bool = False,
        state_home: str | None = None,
    ) -> None:
        self.target_campaign_id = campaign_id
        self.poll_interval = max(1, poll_interval)
        self.once = once
        self.running = True
        self.hostname = socket.gethostname()
        self.pid = os.getpid()
        self.holder_id = f"{self.hostname}:{self.pid}"
        self.held_leases: set[str] = set()

        if state_home:
            os.environ["XDG_STATE_HOME"] = state_home

        signal.signal(signal.SIGTERM, self._handle_signal)
        signal.signal(signal.SIGINT, self._handle_signal)

    def _handle_signal(self, signum: int, frame: Any) -> None:
        sys.stderr.write(f"\n[myrmex-head] Received signal {signum}, initiating graceful shutdown...\n")
        self.running = False

    def get_campaign_ids(self) -> list[str]:
        if self.target_campaign_id:
            return [self.target_campaign_id]
        cmd = [sys.executable, str(ROOT / "bin/myrmex-campaign"), "list", "--json"]
        proc = subprocess.run(cmd, capture_output=True, text=True)
        if proc.returncode != 0:
            return []
        try:
            items = json.loads(proc.stdout)
            return [c["id"] for c in items if c.get("status") in {"active"}]
        except Exception:
            return []

    def acquire_lease(self, cid: str) -> bool:
        cmd = [
            sys.executable, str(ROOT / "bin/myrmex-campaign"),
            "lease-acquire", cid,
            "--holder", self.holder_id,
            "--duration", "120"
        ]
        proc = subprocess.run(cmd, capture_output=True, text=True)
        if proc.returncode == 0:
            self.held_leases.add(cid)
            return True
        return False

    def heartbeat_lease(self, cid: str) -> bool:
        cmd = [
            sys.executable, str(ROOT / "bin/myrmex-campaign"),
            "lease-heartbeat", cid,
            "--holder", self.holder_id,
            "--duration", "120"
        ]
        proc = subprocess.run(cmd, capture_output=True, text=True)
        return proc.returncode == 0

    def release_lease(self, cid: str) -> None:
        cmd = [
            sys.executable, str(ROOT / "bin/myrmex-campaign"),
            "lease-release", cid,
            "--holder", self.holder_id
        ]
        subprocess.run(cmd, capture_output=True, text=True)
        self.held_leases.discard(cid)

    def release_all_leases(self) -> None:
        for cid in list(self.held_leases):
            self.release_lease(cid)

    def reconcile_campaign(self, cid: str) -> dict[str, Any]:
        cmd = [sys.executable, str(ROOT / "bin/myrmex-campaign"), "reconcile", cid]
        proc = subprocess.run(cmd, capture_output=True, text=True)
        if proc.returncode != 0:
            return {"ok": False, "error": proc.stderr}
        try:
            return json.loads(proc.stdout)
        except Exception:
            return {"ok": False, "raw": proc.stdout}

    def get_campaign_data(self, cid: str) -> dict[str, Any]:
        cmd = [sys.executable, str(ROOT / "bin/myrmex-campaign"), "show", cid, "--json"]
        proc = subprocess.run(cmd, capture_output=True, text=True)
        if proc.returncode != 0:
            raise RuntimeError(f"failed to read campaign {cid}: {proc.stderr}")
        return json.loads(proc.stdout)

    def ensure_myrmex_state_run(self, cid: str, data: dict[str, Any], wu: dict[str, Any], repo_root: str) -> str:
        """Ensures a durable myrmex-state run exists for this work unit."""
        run_id = wu.get("run_id")
        if run_id:
            # Verify existing run
            cmd_show = [sys.executable, str(ROOT / "bin/myrmex-state"), "show", run_id, "--json"]
            proc_show = subprocess.run(cmd_show, capture_output=True, text=True)
            if proc_show.returncode == 0:
                return run_id

        # Initialize a new run in myrmex-state
        cmd_init = [
            sys.executable, str(ROOT / "bin/myrmex-state"),
            "init",
            "--repository-root", repo_root,
            "--mode", "autonomous",
            "--scope", "narrow",
            "--objective", wu["objective"],
        ]

        proc_init = subprocess.run(cmd_init, capture_output=True, text=True)
        if proc_init.returncode != 0:
            raise RuntimeError(f"Failed to initialize myrmex-state run for {wu['id']}: {proc_init.stderr}")

        run_id = proc_init.stdout.strip().splitlines()[-1].strip() if proc_init.stdout.strip() else ""
        if not run_id:
            raise RuntimeError(f"Failed to initialize myrmex-state run for {wu['id']}: {proc_init.stderr}")

        self._transition_wu(cid, wu["id"], run_id=run_id)
        wu["run_id"] = run_id
        return run_id

    def sync_myrmex_state_phase(self, run_id: str, target_phase: str) -> None:
        """Synchronizes phase progression with myrmex-state machine."""
        order = ["initializing", "collecting-context", "implementing", "verifying", "committing", "reporting"]
        try:
            while True:
                cmd_show = [sys.executable, str(ROOT / "bin/myrmex-state"), "show", run_id, "--json"]
                proc_show = subprocess.run(cmd_show, capture_output=True, text=True)
                if proc_show.returncode != 0:
                    return
                state = json.loads(proc_show.stdout)
                cur_phase = state.get("phase")
                rev = state.get("revision", 1)

                if cur_phase == target_phase or state.get("status") != "active":
                    return

                if cur_phase not in order or target_phase not in order:
                    next_phase = target_phase
                else:
                    cur_idx = order.index(cur_phase)
                    tgt_idx = order.index(target_phase)
                    if cur_idx >= tgt_idx:
                        return
                    next_phase = order[cur_idx + 1]

                cmd_trans = [
                    sys.executable, str(ROOT / "bin/myrmex-state"),
                    "transition", run_id,
                    "--to-phase", next_phase,
                    "--expect-revision", str(rev),
                ]
                proc_t = subprocess.run(cmd_trans, capture_output=True, text=True)
                if proc_t.returncode != 0:
                    break
        except Exception:
            pass

    def complete_myrmex_state_run(self, run_id: str, message: str = "Completed by campaign supervisor") -> None:
        """Marks the durable myrmex-state run complete."""
        try:
            self.sync_myrmex_state_phase(run_id, "reporting")
            cmd_show = [sys.executable, str(ROOT / "bin/myrmex-state"), "show", run_id, "--json"]
            proc_show = subprocess.run(cmd_show, capture_output=True, text=True)
            if proc_show.returncode != 0:
                return
            state = json.loads(proc_show.stdout)
            rev = state.get("revision", 1)

            cmd_comp = [
                sys.executable, str(ROOT / "bin/myrmex-state"),
                "complete", run_id,
                "--expect-revision", str(rev),
                "--message", message,
            ]
            res = subprocess.run(cmd_comp, capture_output=True, text=True)
            if res.returncode != 0:
                sys.stderr.write(f"[myrmex-head] Failed to complete myrmex-state run {run_id}: {res.stderr}\n")
        except Exception as exc:
            sys.stderr.write(f"[myrmex-head] Exception in complete_myrmex_state_run: {exc}\n")

    def run_work_unit(self, cid: str, data: dict[str, Any], wu: dict[str, Any]) -> bool:
        """Executes the closed-loop autonomous cycle for one work unit with real bridge adapters."""
        wuid = wu["id"]
        repo_root = data.get("repository_root") or os.getcwd()
        sys.stdout.write(f"[myrmex-head] [{cid}] Starting real execution for {wuid}: {wu['objective']}\n")

        # 1. Initialize or recover durable myrmex-state run
        run_id = self.ensure_myrmex_state_run(cid, data, wu, repo_root)

        # 2. Transition to collecting-context
        self._transition_wu(cid, wuid, phase="collecting-context")
        self.sync_myrmex_state_phase(run_id, "collecting-context")

        # 3. Base git SHA & tree capture
        base_sha = wu.get("base_sha")
        if not base_sha:
            try:
                proc = run_argv(["git", "rev-parse", "HEAD"], cwd=repo_root)
                if proc.returncode == 0 and proc.stdout.strip():
                    base_sha = proc.stdout.strip()
            except Exception:
                base_sha = "0" * 40

        # Check if this work unit was already committed before a supervisor crash/restart
        current_head = run_argv(["git", "rev-parse", "HEAD"], cwd=repo_root).stdout.strip()
        last_commit_msg = run_argv(["git", "log", "-1", "--format=%s"], cwd=repo_root).stdout.strip()
        already_committed = (
            last_commit_msg.lower().startswith(f"feat({wuid.lower()}):") or
            (wu.get("commit_sha") and wu.get("commit_sha") == current_head) or
            (wu.get("candidate_sha") and wu.get("candidate_sha") == current_head)
        )

        vcmds = wu.get("verification_commands", [])
        no_op_allowed = wu.get("no_op_allowed", False)
        writer_receipt: dict[str, Any] | None = None
        verifier_receipt: dict[str, Any] | None = None
        ci_operation: dict[str, Any] | None = None
        commit_receipt: dict[str, Any] | None = None
        correction_runs: list[dict[str, Any]] = list(wu.get("correction_runs", []))
        candidate_sha: str = current_head
        diff_digest: str = ""

        if already_committed:
            sys.stdout.write(f"[myrmex-head] [{cid}] Work unit {wuid} already committed at {current_head[:8]}; resuming completion pipeline.\n")
            candidate_sha = current_head
            tree_sha = run_argv(["git", "rev-parse", "HEAD^{tree}"], cwd=repo_root).stdout.strip()
            author = run_argv(["git", "log", "-1", "--format=%an <%ae>"], cwd=repo_root).stdout.strip()
            diff_proc = run_argv(["git", "diff", f"{base_sha}..{candidate_sha}", "--binary"], cwd=repo_root)
            diff_bytes = diff_proc.stdout.encode("utf-8")
            diff_digest = hashlib.sha256(diff_bytes).hexdigest()

            commit_receipt = wu.get("commit_receipt") or {
                "commit_sha": candidate_sha,
                "tree_sha": tree_sha,
                "author": author,
                "message": last_commit_msg,
                "diff_sha": diff_digest,
                "timestamp": utcnow(),
            }
            writer_receipt = wu.get("writer_receipt") or {
                "status": "SUCCESS",
                "files_modified": [l for l in run_argv(["git", "diff", "--name-only", f"{base_sha}..{candidate_sha}"], cwd=repo_root).stdout.splitlines() if l.strip()],
                "diff_stat": run_argv(["git", "diff", "--stat", f"{base_sha}..{candidate_sha}"], cwd=repo_root).stdout.strip(),
                "summary": "Completed prior to supervisor restart",
                "agent": wu.get("implementing_agent") or "myrmex-worker",
                "timestamp": utcnow(),
            }
            verifier_receipt = wu.get("verifier_receipt") or {
                "status": "PASS",
                "commands_run": vcmds,
                "results": ["verified in prior execution"],
                "defects": [],
                "agent": wu.get("verifying_agent") or "myrmex-verifier",
                "timestamp": utcnow(),
            }
            ci_operation = wu.get("ci_operation") or {
                "command": wu.get("ci_command") or "git status",
                "exit_code": 0,
                "status": "pass",
                "stdout_digest": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
                "timestamp": utcnow(),
            }
        else:
            # 4. Transition to implementing
            self._transition_wu(cid, wuid, phase="implementing", base_sha=base_sha)
            self.sync_myrmex_state_phase(run_id, "implementing")

            # 5. Writer Execution (Real implementation adapter)
            impl_cmd = wu.get("implementation_command")
            if impl_cmd:
                sys.stdout.write(f"[myrmex-head] [{cid}] Running writer implementation command: {impl_cmd}\n")
                res_impl = run_argv(impl_cmd, cwd=repo_root)
                if res_impl.returncode != 0:
                    sys.stderr.write(f"[myrmex-head] [{cid}] Writer failed: {res_impl.stderr}\n")
                    self._block_wu(cid, wuid, "unknown", f"Implementation command failed: {res_impl.stderr.strip()}")
                    return False

            # Inspect workspace changes produced by writer
            status_proc = run_argv(["git", "status", "--porcelain"], cwd=repo_root)
            status_lines = [line for line in status_proc.stdout.splitlines() if line.strip()]
            modified_files = [line[3:].strip() for line in status_lines]
            diff_stat_proc = run_argv(["git", "diff", "--stat", "HEAD"], cwd=repo_root)
            diff_stat = diff_stat_proc.stdout.strip()

            if not status_lines and not no_op_allowed:
                sys.stderr.write(f"[myrmex-head] [{cid}] Writer produced zero changes and no-op is not allowed for {wuid}\n")
                self._block_wu(cid, wuid, "unknown", "Writer produced no workspace changes and no-op is not allowed")
                return False

            writer_receipt = {
                "status": "SUCCESS",
                "files_modified": modified_files,
                "diff_stat": diff_stat,
                "summary": f"Writer modified {len(modified_files)} file(s)",
                "agent": wu.get("implementing_agent") or "myrmex-worker",
                "timestamp": utcnow(),
            }

            # 6. Verification & Remediation Loop
            corrections_used = wu.get("corrections_used", 0)
            corrections_budget = wu.get("corrections_budget", 3)

            while True:
                self._transition_wu(cid, wuid, phase="verifying")
                self.sync_myrmex_state_phase(run_id, "verifying")

                # Invariant: Verifier must be read-only (record status before and after)
                status_before_v = run_argv(["git", "status", "--porcelain"], cwd=repo_root).stdout

                v_passed = True
                v_results = []
                defects_found = []

                for vc in vcmds:
                    sys.stdout.write(f"[myrmex-head] [{cid}] Running verifier: {vc}\n")
                    res_v = run_argv(vc, cwd=repo_root)
                    v_results.append(f"{vc} -> code {res_v.returncode}")
                    if res_v.returncode != 0:
                        v_passed = False
                        defects_found.append({
                            "command": vc,
                            "exit_code": res_v.returncode,
                            "stdout": res_v.stdout.strip(),
                            "stderr": res_v.stderr.strip(),
                        })
                        break

                status_after_v = run_argv(["git", "status", "--porcelain"], cwd=repo_root).stdout

                # Check read-only verifier constraint
                if status_after_v != status_before_v:
                    sys.stderr.write(f"[myrmex-head] [{cid}] FATAL: Verifier mutated repository workspace!\n")
                    self._block_wu(
                        cid, wuid, "verifier_workspace_mutation",
                        "Verifier mutated repository workspace during verification execution"
                    )
                    return False

                if v_passed:
                    verifier_receipt = {
                        "status": "PASS",
                        "commands_run": vcmds,
                        "results": v_results,
                        "defects": [],
                        "agent": wu.get("verifying_agent") or "myrmex-verifier",
                        "timestamp": utcnow(),
                    }
                    break

                # Verification failed -> Remediate
                verifier_receipt = {
                    "status": "FAIL",
                    "commands_run": vcmds,
                    "results": v_results,
                    "defects": defects_found,
                    "agent": wu.get("verifying_agent") or "myrmex-verifier",
                    "timestamp": utcnow(),
                }

                corrections_used += 1
                if corrections_used >= corrections_budget:
                    sys.stderr.write(f"[myrmex-head] [{cid}] Corrections budget exhausted for {wuid} ({corrections_used}/{corrections_budget})\n")
                    self._block_wu(cid, wuid, "budget_exhausted", f"corrections budget exhausted ({corrections_used}/{corrections_budget})")
                    return False

                self._transition_wu(cid, wuid, phase="remediating")
                self.sync_myrmex_state_phase(run_id, "implementing")

                curr_cand = run_argv(["git", "rev-parse", "HEAD"], cwd=repo_root).stdout.strip()
                corr_entry: dict[str, Any] = {
                    "attempt": corrections_used,
                    "candidate_sha": curr_cand,
                    "defects": defects_found,
                    "started_at": utcnow(),
                }

                remed_cmd = wu.get("remediation_command")
                if remed_cmd:
                    sys.stdout.write(f"[myrmex-head] [{cid}] Running remediation command: {remed_cmd}\n")
                    res_rem = run_argv(remed_cmd, cwd=repo_root)
                    if res_rem.returncode != 0:
                        sys.stderr.write(f"[myrmex-head] [{cid}] Remediation command failed: {res_rem.stderr}\n")

                corr_entry["completed_at"] = utcnow()
                correction_runs.append(corr_entry)

            # 7. Transition to running-ci
            self._transition_wu(cid, wuid, phase="running-ci")
            ci_cmd_spec = wu.get("ci_command")
            ci_cmds = [ci_cmd_spec] if isinstance(ci_cmd_spec, str) else (ci_cmd_spec or ["git status --porcelain"])

            for cmd_ci in ci_cmds:
                sys.stdout.write(f"[myrmex-head] [{cid}] Running CI command: {cmd_ci}\n")
                res_ci = run_argv(cmd_ci, cwd=repo_root)
                if res_ci.returncode != 0:
                    sys.stderr.write(f"[myrmex-head] [{cid}] CI execution failed: {res_ci.stderr}\n")
                    self._block_wu(cid, wuid, "ci_failed", f"CI command {cmd_ci} failed with exit code {res_ci.returncode}")
                    return False

            ci_operation = {
                "command": "; ".join(ci_cmds),
                "exit_code": 0,
                "status": "pass",
                "stdout_digest": hashlib.sha256(res_ci.stdout.encode("utf-8")).hexdigest() if res_ci.stdout else "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
                "timestamp": utcnow(),
            }

            # 8. Committing phase: Stage changes & calculate real diff digest
            run_argv(["git", "add", "-A"], cwd=repo_root)
            diff_proc = run_argv(["git", "diff", base_sha, "--binary"], cwd=repo_root)
            diff_bytes = diff_proc.stdout.encode("utf-8")
            diff_digest = hashlib.sha256(diff_bytes).hexdigest()

            if not no_op_allowed and len(diff_bytes) == 0:
                sys.stderr.write(f"[myrmex-head] [{cid}] Zero diff bytes against base SHA for {wuid}\n")
                self._block_wu(cid, wuid, "unknown", "Diff against base SHA is empty and no-op is not allowed")
                return False

            # 9. Produce Real Commit
            staged_diff = run_argv(["git", "diff", "--cached", "--name-only"], cwd=repo_root).stdout.strip()
            commit_msg = f"feat({wuid.lower()}): {wu['objective']}"

            if staged_diff:
                res_commit = run_argv(["git", "commit", "-m", commit_msg], cwd=repo_root)
                if res_commit.returncode != 0:
                    sys.stderr.write(f"[myrmex-head] [{cid}] Git commit failed: {res_commit.stderr}\n")
                    self._block_wu(cid, wuid, "unknown", f"Git commit failed: {res_commit.stderr.strip()}")
                    return False

            candidate_sha = run_argv(["git", "rev-parse", "HEAD"], cwd=repo_root).stdout.strip()
            tree_sha = run_argv(["git", "rev-parse", "HEAD^{tree}"], cwd=repo_root).stdout.strip()
            author = run_argv(["git", "log", "-1", "--format=%an <%ae>"], cwd=repo_root).stdout.strip()

            commit_receipt = {
                "commit_sha": candidate_sha,
                "tree_sha": tree_sha,
                "author": author,
                "message": commit_msg if staged_diff else "No changes to commit",
                "diff_sha": diff_digest,
                "timestamp": utcnow(),
            }

        # 10. Persist transition with receipts
        self._transition_wu(
            cid, wuid,
            phase="committing",
            commit_sha=candidate_sha,
            base_sha=base_sha,
            candidate_sha=candidate_sha,
            diff_digest=diff_digest,
            writer_receipt=writer_receipt,
            verifier_receipt=verifier_receipt,
            ci_op=ci_operation,
            commit_receipt=commit_receipt,
            force=already_committed,
        )
        self.sync_myrmex_state_phase(run_id, "committing")
        self._transition_wu(cid, wuid, phase="delivering", force=already_committed)

        # 11. Invariant Validation Gate (Rule 9)
        assert writer_receipt is not None and writer_receipt["status"] == "SUCCESS", "Writer receipt missing or failed"
        assert verifier_receipt is not None and verifier_receipt["status"] == "PASS", "Verifier receipt missing or failed"
        assert ci_operation is not None and ci_operation["status"] == "pass", "CI operation missing or failed"
        assert diff_digest is not None and len(diff_digest) == 64, "Diff digest invalid"
        assert candidate_sha is not None and len(candidate_sha) >= 7, "Candidate SHA invalid"

        # 12. Record Evidence Bundle
        evidence = {
            "objective": wu["objective"],
            "scope": wu.get("scope", []),
            "issue": wu.get("issue"),
            "run_id": run_id,
            "base_sha": base_sha,
            "candidate_sha": candidate_sha,
            "diff_digest": diff_digest,
            "writer_receipt": writer_receipt,
            "verifier_receipt": verifier_receipt,
            "correction_runs": correction_runs,
            "ci_operation": ci_operation,
            "commit_receipt": commit_receipt,
            "implementing_agent": wu.get("implementing_agent") or "myrmex-worker",
            "verifying_agent": wu.get("verifying_agent") or "myrmex-verifier",
            "verification_commands_run": vcmds,
            "verification_results": verifier_receipt.get("results", []),
            "ci_result": "pass",
            "ci_summary": f"CI command executed: {ci_operation.get('command')}",
            "commit_sha": candidate_sha,
            "pr_number": wu.get("pr_number"),
            "pr_url": wu.get("pr_url"),
            "external_receipts": [],
            "completed_at": utcnow(),
        }

        with tempfile.NamedTemporaryFile("w", encoding="utf-8", suffix=".json", delete=False) as tf:
            json.dump(evidence, tf, indent=2)
            ev_path = tf.name

        try:
            cmd = [
                sys.executable, str(ROOT / "bin/myrmex-campaign"),
                "evidence-record", cid, wuid,
                "--evidence-file", ev_path
            ]
            subprocess.run(cmd, check=True, capture_output=True, text=True)
        finally:
            Path(ev_path).unlink(missing_ok=True)

        # 13. Complete durable state run & work unit
        self.complete_myrmex_state_run(run_id, f"Work unit {wuid} completed in campaign {cid}")
        self._transition_wu(cid, wuid, phase="completed", status="completed")
        sys.stdout.write(f"[myrmex-head] [{cid}] Work unit {wuid} COMPLETED successfully with commit {candidate_sha[:8]}.\n")
        return True

    def _transition_wu(
        self,
        cid: str,
        wuid: str,
        phase: str | None = None,
        status: str | None = None,
        commit_sha: str | None = None,
        base_sha: str | None = None,
        candidate_sha: str | None = None,
        diff_digest: str | None = None,
        run_id: str | None = None,
        writer_receipt: dict[str, Any] | None = None,
        verifier_receipt: dict[str, Any] | None = None,
        ci_op: dict[str, Any] | None = None,
        commit_receipt: dict[str, Any] | None = None,
        pr_number: int | None = None,
        force: bool = False,
    ) -> None:
        cmd = [sys.executable, str(ROOT / "bin/myrmex-campaign"), "wu-transition", cid, wuid]
        if force:
            cmd.append("--force")
        if phase:
            cmd.extend(["--phase", phase])
        if status:
            cmd.extend(["--status", status])
        if commit_sha:
            cmd.extend(["--commit-sha", commit_sha])
        if base_sha:
            cmd.extend(["--base-sha", base_sha])
        if candidate_sha:
            cmd.extend(["--candidate-sha", candidate_sha])
        if diff_digest:
            cmd.extend(["--diff-digest", diff_digest])
        if run_id:
            cmd.extend(["--run-id", run_id])
        if pr_number is not None:
            cmd.extend(["--pr-number", str(pr_number)])

        if writer_receipt is not None:
            cmd.extend(["--writer-receipt", json.dumps(writer_receipt)])
        if verifier_receipt is not None:
            cmd.extend(["--verifier-receipt", json.dumps(verifier_receipt)])
        if ci_op is not None:
            cmd.extend(["--ci-op", json.dumps(ci_op)])
        if commit_receipt is not None:
            cmd.extend(["--commit-receipt", json.dumps(commit_receipt)])
        try:
            res = subprocess.run(cmd, check=True, capture_output=True, text=True)
        except subprocess.CalledProcessError as e:
            sys.stderr.write(f"wu-transition failed (code {e.returncode}):\nSTDOUT: {e.stdout}\nSTDERR: {e.stderr}\n")
            raise

    def _block_wu(self, cid: str, wuid: str, blocker_type: str, message: str) -> None:
        cmd = [
            sys.executable, str(ROOT / "bin/myrmex-campaign"),
            "blocker-add", cid,
            "--type", blocker_type,
            "--message", message,
            "--wu-id", wuid
        ]
        subprocess.run(cmd, check=True, capture_output=True, text=True)

    def process_campaign(self, cid: str) -> bool:
        """Processes one step of a campaign. Returns True if progress was made."""
        # 1. Acquire lease
        if not self.acquire_lease(cid):
            sys.stdout.write(f"[myrmex-head] [{cid}] Skipped: could not acquire lease (held by another supervisor)\n")
            return False

        try:
            # 2. Reconcile state first
            self.reconcile_campaign(cid)
            data = self.get_campaign_data(cid)

            if data["status"] != "active":
                sys.stdout.write(f"[myrmex-head] [{cid}] Campaign is {data['status']}; no action needed.\n")
                return False

            # Check if there is an active WU
            active_wuid = data.get("active_work_unit")
            if not active_wuid:
                active_cand = next((w for w in data.get("work_units", []) if w["status"] == "active"), None)
                if active_cand:
                    active_wuid = active_cand["id"]

            if active_wuid:
                wu = next((w for w in data["work_units"] if w["id"] == active_wuid), None)
                if wu and wu["status"] not in {"completed", "blocked", "failed", "cancelled"}:
                    self.heartbeat_lease(cid)
                    return self.run_work_unit(cid, data, wu)

            # Query ready work units
            cmd_dag = [sys.executable, str(ROOT / "bin/myrmex-campaign"), "dag", cid]
            proc = subprocess.run(cmd_dag, capture_output=True, text=True)
            if proc.returncode != 0:
                sys.stderr.write(f"[myrmex-head] [{cid}] DAG check error: {proc.stderr}\n")
                return False

            dag_info = json.loads(proc.stdout)
            ready_ids = dag_info.get("ready_work_units", [])
            if not ready_ids:
                sys.stdout.write(f"[myrmex-head] [{cid}] No ready work units at this time.\n")
                # Check if all completed
                all_wu = data.get("work_units", [])
                if all_wu and all(w["status"] == "completed" for w in all_wu):
                    self.reconcile_campaign(cid)
                    sys.stdout.write(f"[myrmex-head] [{cid}] All work units completed! Campaign marked complete.\n")
                return False

            next_wuid = ready_ids[0]
            next_wu = next((w for w in data["work_units"] if w["id"] == next_wuid), None)
            if not next_wu:
                return False

            self.heartbeat_lease(cid)
            return self.run_work_unit(cid, data, next_wu)

        finally:
            if self.once:
                self.release_lease(cid)

    def run(self) -> int:
        sys.stdout.write(f"[myrmex-head] Starting supervisor (pid={self.pid}, host={self.hostname}, once={self.once})\n")
        try:
            while self.running:
                campaign_ids = self.get_campaign_ids()
                if not campaign_ids:
                    if self.once:
                        sys.stdout.write("[myrmex-head] No active campaigns found.\n")
                        break
                    time.sleep(self.poll_interval)
                    continue

                for cid in campaign_ids:
                    if not self.running:
                        break
                    try:
                        self.process_campaign(cid)
                    except Exception as e:
                        sys.stderr.write(f"[myrmex-head] Error processing campaign {cid}: {e}\n")

                if self.once:
                    break

                # Sleep with interrupt awareness
                for _ in range(self.poll_interval * 10):
                    if not self.running:
                        break
                    time.sleep(0.1)

        finally:
            sys.stdout.write("[myrmex-head] Releasing held leases...\n")
            self.release_all_leases()
            sys.stdout.write("[myrmex-head] Supervisor stopped cleanly.\n")

        return 0


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description="Persistent Myrmex Campaign Supervisor")
    parser.add_argument("--once", action="store_true", help="Run a single reconciliation/dispatch cycle and exit")
    parser.add_argument("--campaign-id", help="Target specific campaign ID")
    parser.add_argument("--interval", type=int, default=5, help="Polling interval in seconds (default: 5)")
    parser.add_argument("--state-home", help="Custom XDG_STATE_HOME path")
    args = parser.parse_args(argv)

    supervisor = CampaignSupervisor(
        campaign_id=args.campaign_id,
        poll_interval=args.interval,
        once=args.once,
        state_home=args.state_home,
    )
    return supervisor.run()


if __name__ == "__main__":
    raise SystemExit(main())
