#!/usr/bin/env python3
"""Persistent campaign supervisor for Myrmex autonomous work (P0.10 Hardened).

Designed to run in foreground under systemd --user (or standalone).
Supports deterministic --once mode for discrete cycles and continuous loop for production.
Decouples execution drivers (OpenCodeTaskDriver vs FixtureCommandDriver),
enforces governed local commits via scripts/myrmex-git-local.py,
eliminates synthetic evidence fabrication, and enforces strict state transitions.
"""
from __future__ import annotations

import argparse
import datetime as dt
import hashlib
import json
import os
import re
import shlex
import signal
import socket
import stat
import subprocess
import sys
import tempfile
import time
from pathlib import Path
from typing import Any

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "bin"))
sys.path.insert(0, str(ROOT))
sys.path.insert(0, str(ROOT / "scripts"))

import scripts.opencode_transport as opencode_transport
import scripts.myrmex_worktree as myrmex_worktree
import scripts.myrmex_task_operation as myrmex_task_operation
import myrmex_campaign_intelligence as campaign_intel
import myrmex_priority_policy as priority_policy
import myrmex_replanning as replanning
import myrmex_route_model_policy as route_model_policy


def utcnow() -> str:
    return dt.datetime.now(dt.timezone.utc).isoformat()


def canonical_sha(value: Any) -> str:
    payload = json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(",", ":"), allow_nan=False)
    return hashlib.sha256(payload.encode("utf-8")).hexdigest()


def run_argv(
    cmd: list[str] | str,
    cwd: str | Path,
    env: dict[str, str] | None = None,
    timeout: int = 300
) -> subprocess.CompletedProcess[str]:
    """Execute command safely as an argv list without shell=True."""
    if isinstance(cmd, str):
        argv = shlex.split(cmd)
    else:
        argv = list(cmd)
    return subprocess.run(argv, cwd=str(cwd), env=env, capture_output=True, text=True, timeout=timeout)


def compute_candidate_diff_digest(repo_root: Path, base_sha: str, modified_files: list[str]) -> str:
    """Computes exact diff digest matching scripts/myrmex-git-local.py candidate_diff_digest."""
    if not modified_files:
        output = run_argv(
            ["git", "diff", "--no-ext-diff", "--no-textconv", "--binary", "--no-color", base_sha],
            cwd=repo_root
        ).stdout
        return hashlib.sha256(output.encode("utf-8")).hexdigest()

    output = run_argv(
        ["git", "diff", "--no-ext-diff", "--no-textconv", "--binary", "--no-color", base_sha, "--", *modified_files],
        cwd=repo_root
    ).stdout
    untracked: list[str] = []
    for relative_path in sorted(modified_files):
        tracked = run_argv(["git", "ls-files", "--error-unmatch", "--", relative_path], cwd=repo_root).returncode == 0
        if tracked:
            continue
        path = safe_worktree_path(repo_root, relative_path)
        try:
            file_stat = path.lstat()
        except FileNotFoundError:
            continue
        if stat.S_ISLNK(file_stat.st_mode):
            content = os.fsencode(os.readlink(path))
            mode = "120000"
        elif stat.S_ISREG(file_stat.st_mode):
            content = path.read_bytes()
            mode = "100755" if file_stat.st_mode & 0o111 else "100644"
        else:
            continue
        untracked.append(
            f"UNTRACKED\0{relative_path}\0{mode}\0{hashlib.sha256(content).hexdigest()}\n"
        )
    return hashlib.sha256((output + "".join(untracked)).encode("utf-8")).hexdigest()


def deterministic_no_op_receipt(campaign_id: str, wuid: str, base_sha: str, current_sha: str, diff_digest: str) -> dict[str, Any]:
    """Typed receipt for an explicitly reviewed, unchanged repository candidate."""
    body = {
        "schema": "myrmex.no-op-receipt/v1", "status": "CONFIRMED",
        "campaign_id": campaign_id, "work_unit_id": wuid, "base_sha": base_sha,
        "current_sha": current_sha, "candidate_sha": current_sha,
        "diff_digest": diff_digest, "modified_paths": [], "commit_sha": None,
    }
    return {**body, "receipt_digest": canonical_sha(body)}


def validate_no_op_receipt(receipt: Any, campaign_id: str, wuid: str, base_sha: str, current_sha: str, diff_digest: str, repo_root: Path) -> None:
    if not isinstance(receipt, dict) or receipt != deterministic_no_op_receipt(campaign_id, wuid, base_sha, current_sha, diff_digest):
        raise RuntimeError("no-op receipt identity or digest mismatch")
    if compute_candidate_diff_digest(repo_root, base_sha, []) != diff_digest:
        raise RuntimeError("no-op receipt empty diff digest mismatch")


# ============================================================================
# Environment Sanitization & Security Boundaries
# ============================================================================

SAFE_ENV_PASSTHROUGH = {
    "PATH", "HOME", "USER", "LANG", "LC_ALL", "LC_CTYPE",
    "SHELL", "TMPDIR", "PYTHONDONTWRITEBYTECODE", "PYTHONUNBUFFERED",
    "XDG_CACHE_HOME", "XDG_CONFIG_HOME", "XDG_DATA_HOME", "XDG_STATE_HOME",
    "XDG_RUNTIME_DIR", "GIT_CONFIG_NOSYSTEM", "MYRMEX_ENV", "MYRMEX_STATE_HOME",
}

BLOCKED_ENV_PREFIXES = (
    "GITHUB_", "GH_", "OPENAI_", "ANTHROPIC_", "GEMINI_", "AWS_",
    "AZURE_", "GCP_", "GOOGLE_", "SSH_", "NPM_TOKEN", "PYPI_",
)

BLOCKED_ENV_SUBSTRINGS = (
    "_KEY", "_TOKEN", "_SECRET", "_PASSWORD", "_AUTH", "_CREDENTIAL",
)


def sanitized_agent_environment(base_env: dict[str, str] | None = None) -> dict[str, str]:
    """Builds a sanitized environment for agent / driver execution, scrubbing credentials."""
    source = base_env if base_env is not None else dict(os.environ)
    sanitized: dict[str, str] = {}
    for k, v in source.items():
        k_upper = k.upper()
        if any(k_upper.startswith(p) for p in BLOCKED_ENV_PREFIXES):
            continue
        if any(s in k_upper for s in BLOCKED_ENV_SUBSTRINGS):
            continue
        if k in SAFE_ENV_PASSTHROUGH or k.startswith("MYRMEX_"):
            sanitized[k] = v
    if "PATH" not in sanitized and "PATH" in os.environ:
        sanitized["PATH"] = os.environ["PATH"]
    sanitized["PYTHONDONTWRITEBYTECODE"] = "1"
    return sanitized


def safe_worktree_path(repo_root: Path, relative_path: str) -> Path:
    """Validates that a relative path stays inside repo_root and does not escape via symlink."""
    path = repo_root.joinpath(*relative_path.split("/"))
    root = repo_root.resolve()
    try:
        path.parent.resolve(strict=False).relative_to(root)
    except ValueError as exc:
        raise ScopeViolationError(f"path escapes repository root: {relative_path}") from exc
    if path.is_symlink():
        target = (path.parent / os.readlink(path)).resolve(strict=False)
        try:
            target.relative_to(root)
        except ValueError as exc:
            raise ScopeViolationError(f"symlink escapes repository root: {relative_path}") from exc
    return path


def validate_paths_in_scope(repo_root: Path, modified_paths: list[str], declared_scope: list[str]) -> None:
    """Verifies that all modified paths are within declared scope bounds."""
    for p in modified_paths:
        safe_worktree_path(repo_root, p)
    if not declared_scope:
        return
    for p in modified_paths:
        matched = False
        for allowed in declared_scope:
            allowed_clean = allowed.strip().rstrip("/")
            if p == allowed_clean or p.startswith(allowed_clean + "/"):
                matched = True
                break
        if not matched:
            raise ScopeViolationError(f"modified path {p!r} is outside declared scope: {declared_scope}")


# ============================================================================
# Driver Exceptions
# ============================================================================

class ExecutionDriverError(Exception):
    pass


class DriverPolicyViolation(ExecutionDriverError):
    pass


class VerifierWorkspaceMutationError(ExecutionDriverError):
    pass


class ScopeViolationError(ExecutionDriverError):
    pass


class AmbiguousMissingReceiptError(ExecutionDriverError):
    pass


class InvalidVerifierReceiptError(ExecutionDriverError):
    pass


class InvalidProductionContractError(ExecutionDriverError):
    pass


class SequentialSchedulerError(ExecutionDriverError):
    pass


class SequentialSchedulerStale(SequentialSchedulerError):
    pass


# ============================================================================
# Execution Driver Interfaces & Implementations
# ============================================================================

class WorkUnitExecutionDriver:
    """Base interface for executing work unit phases."""
    driver_name: str = "base"

    def _record_delegation(self, run_id: str, wuid: str, role: str, agent: str, repo_root: Path, env: dict[str, str], callback) -> Any:
        proc_show = run_argv([sys.executable, str(ROOT / "bin/myrmex-state"), "show", run_id, "--json"], cwd=repo_root, env=env)
        rev = json.loads(proc_show.stdout).get("revision", 1)

        task_id = f"task-{wuid}-{role}-{int(time.time()*1000)}"
        run_argv([
            sys.executable, str(ROOT / "bin/myrmex-state"), "delegation-preflight", run_id,
            "--agent", agent, "--role", role, "--reason", f"{self.driver_name} dispatch",
            "--task-id", task_id, "--work-unit-id", wuid, "--workspace", str(repo_root),
            "--expect-revision", str(rev)
        ], cwd=repo_root, env=env)
        rev += 1

        try:
            result = callback()
            status = "success"
        except Exception:
            status = "failed"
            raise
        finally:
            run_argv([
                sys.executable, str(ROOT / "bin/myrmex-state"), "delegation", run_id,
                "--agent", agent, "--role", role, "--reason", f"{self.driver_name} completion",
                "--task-id", task_id, "--work-unit-id", wuid, "--workspace", str(repo_root),
                "--status", status, "--expect-revision", str(rev)
            ], cwd=repo_root, env=env)
        return result

    def execute_writer(
        self,
        wu: dict[str, Any],
        base_sha: str,
        repo_root: Path,
        run_id: str,
        env: dict[str, str],
        attempt: int = 1,
    ) -> dict[str, Any]:
        raise NotImplementedError

    def execute_verifier(
        self,
        wu: dict[str, Any],
        repo_root: Path,
        run_id: str,
        env: dict[str, str],
        attempt: int = 1,
    ) -> dict[str, Any]:
        raise NotImplementedError

    def execute_remediation(
        self,
        wu: dict[str, Any],
        defects: list[dict[str, Any]],
        attempt: int,
        repo_root: Path,
        run_id: str,
        env: dict[str, str],
    ) -> dict[str, Any]:
        raise NotImplementedError

    def execute_ci(
        self,
        wu: dict[str, Any],
        repo_root: Path,
        run_id: str,
        env: dict[str, str],
    ) -> dict[str, Any]:
        raise NotImplementedError


class OpenCodeTaskDriver(WorkUnitExecutionDriver):
    """Production driver: delegates execution strictly to real governed agents via OpenCode."""
    driver_name: str = "opencode-task"
    writer_agent: str = "myrmex-worker"
    verifier_agent: str = "myrmex-verifier"
    remediator_agent: str = "myrmex-worker"

    @staticmethod
    def _plan_bound(wu: dict[str, Any]) -> bool:
        order = wu.get("work_order")
        return isinstance(order, dict) and order.get("schema") == "myrmex.work-order/v2"

    @classmethod
    def _work_order_context(cls, wu: dict[str, Any]) -> dict[str, Any]:
        order = wu.get("work_order") if cls._plan_bound(wu) else {}
        return {
            "objective": order.get("objective", "") if order else wu.get("objective", ""),
            "non_goals": order.get("non_goals", []) if order else wu.get("non_goals", []),
            "scope": order.get("scope", wu.get("scope", [])),
            "acceptance_criteria": order.get("acceptance_criteria", []) if order else wu.get("acceptance_criteria", []),
            "verification": order.get("verification", {"commands": wu.get("verification_commands", []), "manual_checks": []}),
            "git_policy": order.get("git_policy", {"commit": False, "push": False}),
            "no_op_allowed": order.get("no_op_allowed", False) if order else wu.get("no_op_allowed", False),
        }

    @classmethod
    def _execution_context(cls, wu: dict[str, Any]) -> dict[str, Any]:
        if not cls._plan_bound(wu):
            return cls._work_order_context(wu)
        order = wu["work_order"]
        expected = {
            "objective": order.get("objective"), "acceptance_criteria": order.get("acceptance_criteria"),
            "no_op_allowed": order.get("no_op_allowed"),
        }
        projections = {key: wu.get(key) for key in expected}
        projections["scope"] = wu.get("scope")
        allowed = order.get("scope", {}).get("allowed_paths") if isinstance(order.get("scope"), dict) else None
        if any(projections[key] != value for key, value in expected.items()) or projections["scope"] != allowed:
            raise ExecutionDriverError("plan-bound work unit projection diverges from authoritative work order")
        return cls._work_order_context(wu)

    @classmethod
    def _allowed_scope(cls, wu: dict[str, Any]) -> list[str]:
        if cls._plan_bound(wu):
            scope = wu["work_order"].get("scope")
            allowed = scope.get("allowed_paths") if isinstance(scope, dict) else None
            if not isinstance(allowed, list) or not all(isinstance(path, str) for path in allowed):
                raise ExecutionDriverError("plan-bound work order allowed scope is invalid")
            return allowed
        return wu.get("scope", [])

    @classmethod
    def _prompt_context(cls, wu: dict[str, Any]) -> str:
        return json.dumps(cls._work_order_context(wu), sort_keys=True)

    @staticmethod
    def _validate_recovered_identity(existing_op: Any, campaign_id: str, agent_id: str, provider: str, model: str | None, workspace: Path) -> None:
        if (existing_op.campaign_id != campaign_id or existing_op.agent != agent_id
                or existing_op.provider != provider or existing_op.model != (model or "default")
                or Path(existing_op.workspace) != workspace.resolve()):
            raise ExecutionDriverError("recovered task operation identity does not match dispatch-bound execution")

    @staticmethod
    def _sha256(value: Any) -> bool:
        return isinstance(value, str) and re.fullmatch(r"[0-9a-f]{64}", value) is not None

    @classmethod
    def _validate_receipt(cls, op: Any, role: str) -> dict[str, Any]:
        receipt = getattr(op, "receipt", None)
        if (not isinstance(receipt, dict) or receipt.get("schema") != "myrmex.task-operation/v1"
                or receipt.get("phase") != "RESULT_RECEIPT_CONFIRMED"):
            raise ExecutionDriverError(f"{role} operation has no confirmed result receipt")
        if not op.task_id or ("observed_task_id" in receipt and receipt.get("observed_task_id") != op.task_id):
            raise ExecutionDriverError(f"{role} receipt task identity is invalid")
        if (hasattr(op, "result_digest") and not cls._sha256(getattr(op, "result_digest", None))) or ("result_digest" in receipt and receipt.get("result_digest") != getattr(op, "result_digest", None)):
            raise ExecutionDriverError(f"{role} receipt result digest is invalid")
        payload = receipt.get("result_payload")
        if role == "writer":
            if op.status != "completed" or payload is not None:
                raise ExecutionDriverError("confirmed writer operation is not completed")
        elif role == "verifier":
            if (not isinstance(payload, dict)
                    or str(payload.get("decision", "")).upper() not in {"PASS", "FAIL", "BLOCKED"}):
                raise ExecutionDriverError("confirmed verifier receipt is invalid")
        elif role == "remediator":
            if (not isinstance(payload, dict)
                    or op.status != "completed"
                    or str(payload.get("decision", "")).upper() != "COMPLETED"):
                raise ExecutionDriverError("confirmed remediator receipt is invalid")
        else:
            raise ExecutionDriverError(f"unsupported confirmed receipt role: {role}")
        return payload

    @classmethod
    def _validate_operation_identity(cls, op: Any, run_id: str, wuid: str, role: str,
                                      attempt: int, campaign_id: str, agent_id: str,
                                      provider: str, model: str | None, workspace: Path,
                                      expected_base_sha: str | None = None,
                                      allow_null_base: bool = False) -> None:
        # Lightweight test doubles from the legacy fixture suite predate the
        # full ledger identity fields; real durable records always have them.
        if not hasattr(op, "operation_id") or not hasattr(op, "run_id"):
            cls._validate_recovered_identity(op, campaign_id, agent_id, provider, model, workspace)
            return
        expected_id = f"op-{run_id}-{wuid}-{role}-att{attempt}"
        if (getattr(op, "run_id", None) != run_id or getattr(op, "work_unit_id", None) != wuid or getattr(op, "role", None) != role
                or getattr(op, "operation_id", None) != expected_id):
            raise ExecutionDriverError("recovered task operation run/work-unit/role identity mismatch")
        self_model = model or "default"
        if (getattr(op, "campaign_id", None) != campaign_id or getattr(op, "agent", None) != agent_id or getattr(op, "provider", None) != provider
                or getattr(op, "model", None) != self_model or Path(getattr(op, "workspace", "")) != workspace.resolve()):
            raise ExecutionDriverError("recovered task operation dispatch identity mismatch")
        if expected_base_sha is not None and getattr(op, "base_sha", None) != expected_base_sha and not (allow_null_base and getattr(op, "base_sha", None) is None):
            raise ExecutionDriverError("recovered task operation base SHA mismatch")

    @staticmethod
    def _validate_task_intent(op: Any, prompt: str) -> None:
        expected = hashlib.sha256(prompt.encode("utf-8")).hexdigest()
        if not hasattr(op, "request_digest"):
            return
        if (op.status != "intent" or op.task_id is not None
                or not isinstance(getattr(op, "receipt", None), dict)
                or op.receipt.get("phase") != "TASK_INTENT"
                or getattr(op, "request_digest", None) != expected):
            raise ExecutionDriverError("task intent is not an exact reusable dispatch intent")

    @staticmethod
    def _workspace_diff(workspace: Path, base_sha: str | None, env: dict[str, str]) -> tuple[str, list[str]]:
        status = run_argv(["git", "status", "--porcelain"], cwd=workspace, env=env).stdout
        files = [line[3:].strip() for line in status.splitlines()
                 if line.strip() and line[3:].strip() != ".myrmex-worktree-receipt.json"]
        return compute_candidate_diff_digest(workspace, base_sha, files), files

    def _confirmed_operation(self, run_id: str, wuid: str, role: str, attempt: int,
                             campaign_id: str, agent_id: str, provider: str,
                             model: str | None, workspace: Path, expected_base_sha: str | None = None) -> Any:
        op = myrmex_task_operation.find_existing_op_for_phase(run_id, wuid, role, attempt)
        expected_id = f"op-{run_id}-{wuid}-{role}-att{attempt}"
        if op is None or op.operation_id != expected_id:
            raise ExecutionDriverError(f"missing confirmed {role} operation attempt {attempt}")
        self._validate_operation_identity(op, run_id, wuid, role, attempt, campaign_id, agent_id, provider, model, workspace, expected_base_sha)
        if expected_base_sha is not None and op.base_sha != expected_base_sha:
            raise ExecutionDriverError(f"recovered {role} operation base SHA mismatch")
        self._validate_receipt(op, role)
        return op

    def recover_active_receipts(self, wu: dict[str, Any], repo_root: Path, run_id: str,
                                env: dict[str, str], remediation_attempt: int) -> tuple[dict[str, Any], dict[str, Any]]:
        wuid = wu["id"]
        campaign_id = wu.get("campaign_id", "default-campaign")
        wt_dir = myrmex_worktree._get_worktrees_dir() / campaign_id / wuid
        if not wt_dir.exists():
            wt_dir = repo_root
        writer_op = self._confirmed_operation(run_id, wuid, "writer", 1, campaign_id,
            wu.get("implementing_agent") or self.writer_agent, wu.get("provider", "opencode"), wu.get("model"), wt_dir, wu.get("base_sha"))
        status_proc = run_argv(["git", "status", "--porcelain"], cwd=wt_dir, env=env)
        modified_files = [line[3:].strip() for line in status_proc.stdout.splitlines() if line.strip() and line[3:].strip() != ".myrmex-worktree-receipt.json"]
        writer_digest = compute_candidate_diff_digest(wt_dir, wu.get("base_sha"), modified_files)
        if not self._sha256(writer_op.diff_digest) or writer_op.diff_digest != writer_digest or writer_op.result_digest != writer_op.receipt.get("result_digest"):
            raise ExecutionDriverError("writer recovery digest does not match workspace")
        writer = {"driver": self.driver_name, "agent": writer_op.agent, "status": "SUCCESS",
                  "files_modified": modified_files, "diff_stat": run_argv(["git", "diff", "--stat", "HEAD"], cwd=wt_dir, env=env).stdout.strip(),
                  "diff_digest": writer_digest, "task_id": writer_op.task_id, "worktree": str(wt_dir)}
        verifier_wt = myrmex_worktree._get_worktrees_dir() / campaign_id / f"{wuid}-verifier"
        current_candidate = run_argv(["git", "rev-parse", "HEAD"], cwd=wt_dir, env=env).stdout.strip()
        verifier_op = self._confirmed_operation(run_id, wuid, "verifier", remediation_attempt, campaign_id,
            wu.get("verifying_agent") or self.verifier_agent, wu.get("provider", "opencode"), wu.get("model"), verifier_wt, current_candidate)
        if verifier_op.base_sha != current_candidate or verifier_op.candidate_sha != current_candidate:
            raise ExecutionDriverError("confirmed verifier candidate identity does not match current writer candidate")
        payload = verifier_op.receipt.get("result_payload")
        if payload.get("candidate_sha") != verifier_op.candidate_sha or not self._sha256(verifier_op.diff_digest):
            raise ExecutionDriverError("confirmed verifier receipt candidate/digest is invalid")
        verifier_files = [line[3:].strip() for line in run_argv(["git", "status", "--porcelain"], cwd=verifier_wt, env=env).stdout.splitlines() if line.strip() and line[3:].strip() != ".myrmex-worktree-receipt.json"]
        verifier_digest = compute_candidate_diff_digest(verifier_wt, verifier_op.candidate_sha, verifier_files)
        if verifier_digest != verifier_op.diff_digest or payload.get("diff_digest") != verifier_digest:
            raise ExecutionDriverError("confirmed verifier digest does not match workspace")
        verifier = {"driver": self.driver_name, "agent": verifier_op.agent, "status": str(payload.get("decision", "FAIL")).upper(),
                    "candidate_sha": verifier_op.candidate_sha, "diff_digest": verifier_digest,
                    "defects": payload.get("defects", []), "checks": payload.get("checks", []),
                    "residual_risks": payload.get("residual_risks", []), "task_id": verifier_op.task_id}
        return writer, verifier

    def recover_writer_receipt(self, wu: dict[str, Any], repo_root: Path, run_id: str,
                               env: dict[str, str]) -> dict[str, Any]:
        wuid = wu["id"]
        campaign_id = wu.get("campaign_id", "default-campaign")
        wt_dir = myrmex_worktree._get_worktrees_dir() / campaign_id / wuid
        if not wt_dir.exists():
            wt_dir = repo_root
        op = self._confirmed_operation(run_id, wuid, "writer", 1, campaign_id,
            wu.get("implementing_agent") or self.writer_agent, wu.get("provider", "opencode"), wu.get("model"), wt_dir, wu.get("base_sha"))
        status = run_argv(["git", "status", "--porcelain"], cwd=wt_dir, env=env).stdout
        files = [line[3:].strip() for line in status.splitlines() if line.strip() and line[3:].strip() != ".myrmex-worktree-receipt.json"]
        digest = compute_candidate_diff_digest(wt_dir, wu.get("base_sha"), files)
        if not self._sha256(op.diff_digest) or op.diff_digest != digest:
            raise ExecutionDriverError("writer recovery digest does not match workspace")
        return {"driver": self.driver_name, "agent": op.agent, "status": "SUCCESS", "files_modified": files,
                "diff_stat": run_argv(["git", "diff", "--stat", "HEAD"], cwd=wt_dir, env=env).stdout.strip(),
                "diff_digest": digest, "task_id": op.task_id, "worktree": str(wt_dir)}

    @staticmethod
    def active_recovery_attempts(phase: str, corrections_used: int) -> tuple[int, int]:
        remediation = max(1, corrections_used) if phase == "remediating" else None
        verifier = (remediation + 1) if remediation is not None else corrections_used + 1
        return (remediation or verifier, verifier)

    @staticmethod
    def verifier_attempt_after_infrastructure_failure(
        run_id: str,
        wuid: str,
        attempt: int,
        max_successor_attempts: int = 1,
    ) -> int:
        """Skip one durable verifier-only infrastructure failure.

        A verifier workspace mutation is not a candidate defect and must not
        consume a writer correction. Preserve the failed operation and allow
        one fresh verifier identity; repeated mutation fails closed.
        """
        current = attempt
        successors = 0
        while True:
            op = myrmex_task_operation.find_existing_op_for_phase(
                run_id, wuid, "verifier", current
            )
            retryable = (
                op is not None
                and op.status == "failed"
                and op.error_type == "VERIFIER_MUTATION"
                and bool(op.task_id)
                and isinstance(op.receipt, dict)
                and op.receipt.get("phase") == "TASK_TERMINAL"
                and op.receipt.get("observed_task_id") == op.task_id
            )
            if not retryable:
                return current
            successors += 1
            if successors > max_successor_attempts:
                raise ExecutionDriverError(
                    "verifier infrastructure retry budget exhausted after workspace mutation"
                )
            current += 1

    def execute_writer(
        self,
        wu: dict[str, Any],
        base_sha: str,
        repo_root: Path,
        run_id: str,
        env: dict[str, str],
    ) -> dict[str, Any]:
        agent_id = wu.get("implementing_agent") or self.writer_agent
        wuid = wu["id"]
        campaign_id = wu.get("campaign_id", "default-campaign")
        context = self._execution_context(wu)
        allowed_scope = self._allowed_scope(wu)

        # 1. Create / retrieve isolated worktree for WU (Writer environment)
        wt_dir, wt_receipt = myrmex_worktree.create_wu_worktree(
            source_repo=repo_root,
            campaign_id=campaign_id,
            wu_id=wuid,
            base_sha=base_sha,
            allowed_scope=allowed_scope,
        )

        # 2. Check existing task operation for idempotency / recovery
        existing_op = myrmex_task_operation.find_existing_op_for_phase(run_id, wuid, "writer", 1)
        if existing_op and existing_op.task_id:
            self._validate_operation_identity(existing_op, run_id, wuid, "writer", 1, campaign_id, agent_id, wu.get("provider", "opencode"), wu.get("model"), wt_dir, base_sha)
            snap = opencode_transport.recover_existing_task(existing_op.task_id)
            if snap.status == "running":
                snap = opencode_transport.wait_task(existing_op.task_id, timeout_seconds=300)
            if snap.status != "completed":
                raise ExecutionDriverError(f"writer task recovery is not safely resumable: {snap.status}")
            if snap.status == "completed":
                task_res = opencode_transport.get_result(existing_op.task_id)
                if isinstance(task_res, opencode_transport.TaskResult) and (task_res.status != "completed" or not isinstance(task_res.json_payload, dict)):
                    raise ExecutionDriverError("Recovered writer task result is not a completed structured payload")
                if isinstance(task_res, opencode_transport.TaskResult) and str(task_res.json_payload.get("decision", "")).upper() != "COMPLETED":
                    raise ExecutionDriverError("Recovered writer task result is not completed")
                sys.stdout.write(f"[myrmex-head] [OpenCodeTaskDriver] Recovered existing writer task {existing_op.task_id}\n")
                status_proc = run_argv(["git", "status", "--porcelain"], cwd=wt_dir, env=env)
                status_lines = [line for line in status_proc.stdout.splitlines() if line.strip()]
                modified_files = [line[3:].strip() for line in status_lines if line[3:].strip() != ".myrmex-worktree-receipt.json"]
                diff_stat = run_argv(["git", "diff", "--stat", "HEAD"], cwd=wt_dir, env=env).stdout.strip()
                diff_digest = compute_candidate_diff_digest(wt_dir, base_sha, modified_files)
                if isinstance(task_res, opencode_transport.TaskResult) and (not self._sha256(existing_op.diff_digest) or existing_op.diff_digest != diff_digest):
                    raise ExecutionDriverError("Recovered writer diff digest does not match workspace")
                return {
                    "driver": self.driver_name,
                    "agent": agent_id,
                    "status": "SUCCESS",
                    "files_modified": modified_files,
                    "diff_stat": diff_stat,
                    "diff_digest": diff_digest,
                    "summary": f"Writer modified {len(modified_files)} file(s)",
                    "timestamp": utcnow(),
                    "task_id": existing_op.task_id,
                    "worktree": str(wt_dir),
                }
        elif existing_op:
            self._validate_operation_identity(existing_op, run_id, wuid, "writer", 1, campaign_id, agent_id, wu.get("provider", "opencode"), wu.get("model"), wt_dir, base_sha)

        # 3. Construct writer prompt. P1 work orders carry the authoritative
        # context in work_order; legacy WUs continue to use their flat fields.
        if self._plan_bound(wu):
            prompt = (
            f"Objective: {context['objective']}\n"
            f"Work-order context: {self._prompt_context(wu)}\n"
            f"Allowed Scope: {json.dumps(allowed_scope)}\n"
            f"Base SHA: {base_sha}\n"
            f"Constraints: Do NOT execute git commit, git push, git pr, or git merge. "
            f"Produce your modifications directly in the workspace.\n"
            f"Format response as JSON: {{\"decision\": \"COMPLETED\", \"summary\": \"...\", \"files_touched\": []}}"
            )
        else:
            prompt = (
                f"Objective: {wu.get('title')}\n"
                f"Description: {wu.get('description', '')}\n"
                f"Acceptance Criteria: {json.dumps(wu.get('acceptance_criteria', []))}\n"
                f"Allowed Scope: {json.dumps(allowed_scope)}\n"
                f"Base SHA: {base_sha}\n"
                f"Constraints: Do NOT execute git commit, git push, git pr, or git merge. "
                f"Produce your modifications directly in the workspace.\n"
                f"Format response as JSON: {{\"decision\": \"COMPLETED\", \"summary\": \"...\", \"files_touched\": []}}"
            )

        model = wu.get("model")
        if existing_op:
            self._validate_task_intent(existing_op, prompt)
        op = existing_op or myrmex_task_operation.create_task_intent(
            campaign_id=campaign_id,
            work_unit_id=wuid,
            run_id=run_id,
            role="writer",
            agent=agent_id,
            workspace=str(wt_dir),
            base_sha=base_sha,
            prompt=prompt,
            model=model or "default",
            provider=wu.get("provider", "opencode"),
            attempt=1,
        )

        # 4. Dispatch REAL OpenCode Task for Writer
        sys.stdout.write(f"[myrmex-head] [OpenCodeTaskDriver] Dispatching writer task to OpenCode ({agent_id})...\n")
        task_identity, task_proc = opencode_transport.create_task({
            "prompt": prompt,
            "agent": agent_id,
            "workspace": str(wt_dir),
            "model": model,
        })
        task_id = task_identity.task_id
        myrmex_task_operation.record_task_observed(op, task_id)

        # 5. Wait and confirm terminal status via opencode export
        snap = opencode_transport.wait_task(task_id, proc=task_proc, timeout_seconds=300)
        task_res = opencode_transport.get_result(task_id)
        if snap.status != "completed":
            raise ExecutionDriverError(f"Writer task {task_id} failed to reach terminal status: {snap.status}")
        if isinstance(task_res, opencode_transport.TaskResult):
            if task_res.status != "completed" or task_res.error_type is not None or not isinstance(task_res.json_payload, dict) or str(task_res.json_payload.get("decision", "")).upper() != "COMPLETED":
                raise ExecutionDriverError("Writer task result is not a completed structured payload")

        # 6. Verify worktree & scope
        violations = myrmex_worktree.verify_workspace_scope(wt_dir, base_sha, allowed_scope)
        if violations:
            myrmex_task_operation.record_task_terminal(op, "failed", "; ".join(violations), error_type="WORKTREE_SCOPE_VIOLATION")
            raise ExecutionDriverError(f"Writer violated worktree scope: {violations}")

        status_proc = run_argv(["git", "status", "--porcelain"], cwd=wt_dir, env=env)
        status_lines = [line for line in status_proc.stdout.splitlines() if line.strip()]
        modified_files = [line[3:].strip() for line in status_lines if line[3:].strip() != ".myrmex-worktree-receipt.json"]

        no_op_allowed = wu.get("no_op_allowed", False)
        if not modified_files and not no_op_allowed:
            myrmex_task_operation.record_task_terminal(op, "failed", "Zero changes produced", error_type="NO_OP_DISALLOWED")
            raise ExecutionDriverError("Writer produced zero changes and no-op is not allowed")

        diff_stat = run_argv(["git", "diff", "--stat", "HEAD"], cwd=wt_dir, env=env).stdout.strip()
        diff_digest = compute_candidate_diff_digest(wt_dir, base_sha, modified_files)

        myrmex_task_operation.record_task_terminal(
            op,
            "completed",
            task_res.text_content,
            diff_digest=diff_digest,
        )
        myrmex_task_operation.record_receipt_confirmed(op)

        return {
            "driver": self.driver_name,
            "agent": agent_id,
            "status": "SUCCESS",
            "files_modified": modified_files,
            "diff_stat": diff_stat,
            "diff_digest": diff_digest,
            "summary": f"Writer modified {len(modified_files)} file(s)",
            "timestamp": utcnow(),
            "task_id": task_id,
            "worktree": str(wt_dir),
        }

    def execute_verifier(
        self,
        wu: dict[str, Any],
        repo_root: Path,
        run_id: str,
        env: dict[str, str],
        attempt: int = 1,
    ) -> dict[str, Any]:
        agent_id = wu.get("verifying_agent") or self.verifier_agent
        wuid = wu["id"]
        campaign_id = wu.get("campaign_id", "default-campaign")
        vcmds = wu.get("verification_commands", [])
        context = self._execution_context(wu)

        # Get writer worktree to resolve candidate SHA
        writer_wt_dir = myrmex_worktree._get_worktrees_dir() / campaign_id / wuid
        if not writer_wt_dir.exists():
            writer_wt_dir = repo_root

        cand_sha_proc = run_argv(["git", "rev-parse", "HEAD"], cwd=writer_wt_dir, env=env)
        cand_sha = cand_sha_proc.stdout.strip()

        # 1. Create separate read-only verifier worktree
        verifier_wt_dir, verifier_wt_receipt = myrmex_worktree.create_verifier_worktree(
            source_repo=repo_root,
            campaign_id=campaign_id,
            wu_id=wuid,
            candidate_sha=cand_sha,
            writer_worktree=writer_wt_dir if writer_wt_dir.exists() else None,
        )
        initial_hash = myrmex_worktree.compute_workspace_hash(verifier_wt_dir)

        # 2. Check existing verifier operation for idempotency / recovery
        existing_op = myrmex_task_operation.find_existing_op_for_phase(run_id, wuid, "verifier", attempt)
        if existing_op and existing_op.receipt.get("phase") == "RESULT_RECEIPT_CONFIRMED" and existing_op.task_id:
            self._validate_operation_identity(existing_op, run_id, wuid, "verifier", attempt, campaign_id, agent_id, wu.get("provider", "opencode"), wu.get("model"), verifier_wt_dir, cand_sha)
            payload = self._validate_receipt(existing_op, "verifier")
            if getattr(existing_op, "candidate_sha", cand_sha) != cand_sha or (isinstance(payload, dict) and payload.get("candidate_sha") not in {None, cand_sha}):
                raise InvalidVerifierReceiptError("Durable verifier candidate mismatch")
            if hasattr(existing_op, "result_digest") and (isinstance(payload, dict) and payload.get("diff_digest") not in {None, getattr(existing_op, "diff_digest", None)} or not self._sha256(getattr(existing_op, "diff_digest", None))):
                raise InvalidVerifierReceiptError("Durable verifier diff digest mismatch")
            verifier_status = run_argv(["git", "status", "--porcelain"], cwd=verifier_wt_dir, env=env).stdout
            verifier_files = [line[3:].strip() for line in verifier_status.splitlines()
                              if line.strip() and line[3:].strip() != ".myrmex-worktree-receipt.json"]
            durable_digest = compute_candidate_diff_digest(verifier_wt_dir, cand_sha, verifier_files)
            if (durable_digest != existing_op.diff_digest
                    or payload.get("candidate_sha") != cand_sha
                    or payload.get("diff_digest") != existing_op.diff_digest
                    or myrmex_worktree.compute_workspace_hash(verifier_wt_dir) != initial_hash):
                raise InvalidVerifierReceiptError("Durable verifier workspace mismatch")
            decision = str(payload.get("decision", "FAIL")).upper() if isinstance(payload, dict) else "FAIL"
            return {"driver": self.driver_name, "agent": agent_id, "status": decision, "candidate_sha": cand_sha, "diff_digest": durable_digest, "defects": payload.get("defects", []) if isinstance(payload, dict) else [], "checks": payload.get("checks", []) if isinstance(payload, dict) else [], "residual_risks": payload.get("residual_risks", []) if isinstance(payload, dict) else [], "timestamp": utcnow(), "task_id": existing_op.task_id}
        if existing_op and existing_op.task_id:
            self._validate_operation_identity(existing_op, run_id, wuid, "verifier", attempt, campaign_id, agent_id, wu.get("provider", "opencode"), wu.get("model"), verifier_wt_dir, cand_sha)
            snap = opencode_transport.recover_existing_task(existing_op.task_id)
            if snap.status == "running":
                snap = opencode_transport.wait_task(existing_op.task_id, timeout_seconds=300)
            if snap.status != "completed":
                raise ExecutionDriverError(f"verifier task recovery is not safely resumable: {snap.status}")
            if snap.status == "completed":
                task_res = opencode_transport.get_result(existing_op.task_id)
                sys.stdout.write(f"[myrmex-head] [OpenCodeTaskDriver] Recovered existing verifier task {existing_op.task_id}\n")
                payload = task_res.json_payload or {}
                if isinstance(task_res, opencode_transport.TaskResult) and (task_res.status != "completed" or not isinstance(payload, dict)):
                    raise InvalidVerifierReceiptError("Recovered verifier task result is not a completed structured payload")
                if payload.get("candidate_sha") != cand_sha:
                    raise InvalidVerifierReceiptError(f"Recovered verifier receipt candidate_sha mismatch: expected {cand_sha}, got {payload.get('candidate_sha')}")
                decision = str(payload.get("decision", "")).upper()
                if isinstance(task_res, opencode_transport.TaskResult) and (decision not in {"PASS", "FAIL", "BLOCKED"} or payload.get("diff_digest") != existing_op.diff_digest):
                    raise InvalidVerifierReceiptError("Recovered verifier decision or diff digest is invalid")
                recovered_files = [line[3:].strip() for line in run_argv(["git", "status", "--porcelain"], cwd=verifier_wt_dir, env=env).stdout.splitlines() if line.strip() and line[3:].strip() != ".myrmex-worktree-receipt.json"]
                recovered_digest = compute_candidate_diff_digest(verifier_wt_dir, cand_sha, recovered_files)
                if isinstance(task_res, opencode_transport.TaskResult) and (existing_op.diff_digest != recovered_digest or myrmex_worktree.compute_workspace_hash(verifier_wt_dir) != initial_hash):
                    raise InvalidVerifierReceiptError("Recovered verifier workspace or diff digest changed")
                if existing_op.receipt.get("phase") == "TASK_ID_OBSERVED":
                    myrmex_task_operation.record_task_terminal(
                        existing_op, "completed" if decision == "PASS" else "failed",
                        task_res.text_content, candidate_sha=cand_sha,
                        diff_digest=recovered_digest, result_payload=payload)
                    myrmex_task_operation.record_receipt_confirmed(existing_op)
                return {
                    "driver": self.driver_name,
                    "agent": agent_id,
                    "status": decision,
                    "candidate_sha": cand_sha,
                    "diff_digest": existing_op.diff_digest or "",
                    "defects": payload.get("defects", []),
                    "checks": payload.get("checks", []),
                    "residual_risks": payload.get("residual_risks", []),
                    "timestamp": utcnow(),
                    "task_id": existing_op.task_id,
                }
        elif existing_op:
            self._validate_operation_identity(existing_op, run_id, wuid, "verifier", attempt, campaign_id, agent_id, wu.get("provider", "opencode"), wu.get("model"), verifier_wt_dir, cand_sha)

        # 3. Construct verifier prompt
        status_proc = run_argv(["git", "status", "--porcelain"], cwd=verifier_wt_dir, env=env)
        status_lines = [line for line in status_proc.stdout.splitlines() if line.strip()]
        modified_files = [line[3:].strip() for line in status_lines if line[3:].strip() != ".myrmex-worktree-receipt.json"]
        diff_digest = compute_candidate_diff_digest(verifier_wt_dir, cand_sha, modified_files)

        prompt = (
            f"Verification Task for Work Unit {wuid}\n"
            f"Candidate identity: campaign={campaign_id}, work_unit={wuid}, candidate_sha={cand_sha}\n"
            f"Work-order context: {self._prompt_context(wu) if self._plan_bound(wu) else json.dumps(context, sort_keys=True)}\n"
            f"Candidate SHA: {cand_sha}\n"
            f"Diff Digest: {diff_digest}\n"
            f"Verification Commands and Manual Checks: {self._prompt_context(wu)}\n"
            f"Inspect workspace strictly in read-only mode; do not modify files, commit, push, or create PRs. Respond with valid JSON:\n"
            f"Run only the listed verification commands and read-only inspections. Do not install dependencies or run commands that create or update caches, lockfiles, node_modules, build output, or generated files.\n"
            f"{{\n"
            f'  "decision": "PASS|FAIL|BLOCKED",\n'
            f'  "candidate_sha": "{cand_sha}",\n'
            f'  "diff_digest": "{diff_digest}",\n'
            f'  "defects": [],\n'
            f'  "checks": [],\n'
            f'  "residual_risks": []\n'
            f"}}\n"
        )

        model = wu.get("model")
        if existing_op:
            self._validate_task_intent(existing_op, prompt)
        op = existing_op or myrmex_task_operation.create_task_intent(
            campaign_id=campaign_id,
            work_unit_id=wuid,
            run_id=run_id,
            role="verifier",
            agent=agent_id,
            workspace=str(verifier_wt_dir),
            base_sha=cand_sha,
            prompt=prompt,
            model=model or "default",
            provider=wu.get("provider", "opencode"),
            attempt=attempt,
        )

        # 4. Dispatch REAL OpenCode Task for Verifier (Different sessionID from writer)
        sys.stdout.write(f"[myrmex-head] [OpenCodeTaskDriver] Dispatching verifier task to OpenCode ({agent_id})...\n")
        task_identity, task_proc = opencode_transport.create_task({
            "prompt": prompt,
            "agent": agent_id,
            "workspace": str(verifier_wt_dir),
            "model": model,
        })
        task_id = task_identity.task_id
        myrmex_task_operation.record_task_observed(op, task_id)

        # 5. Wait and confirm terminal status via opencode export
        snap = opencode_transport.wait_task(task_id, proc=task_proc, timeout_seconds=300)
        if snap.status != "completed":
            raise ExecutionDriverError(f"Verifier task {task_id} failed to reach terminal status: {snap.status}")
        task_res = opencode_transport.get_result(task_id)
        if isinstance(task_res, opencode_transport.TaskResult) and (task_res.status != "completed" or task_res.error_type is not None):
            raise InvalidVerifierReceiptError("Verifier task result is not terminal successful transport output")

        # 6. Check for verifier workspace mutation
        final_hash = myrmex_worktree.compute_workspace_hash(verifier_wt_dir)
        if final_hash != initial_hash:
            myrmex_task_operation.record_task_terminal(op, "failed", "Verifier mutated workspace", error_type="VERIFIER_MUTATION")
            raise VerifierWorkspaceMutationError("Verifier mutated repository workspace during verification execution")

        # 7. Extract & validate verifier JSON receipt
        payload = task_res.json_payload
        if not payload or not isinstance(payload, dict):
            decision = "PASS" if "PASS" in task_res.text_content and "FAIL" not in task_res.text_content else "FAIL"
            payload = {
                "decision": decision,
                "candidate_sha": cand_sha,
                "diff_digest": diff_digest,
                "defects": [] if decision == "PASS" else [{"issue": "Verifier failed to emit structured JSON"}],
                "checks": [],
                "residual_risks": [],
            }

        # REJECT if candidate_sha missing or mismatched
        if payload.get("candidate_sha") != cand_sha:
            myrmex_task_operation.record_task_terminal(op, "failed", "Candidate SHA mismatch in verifier receipt", error_type="INVALID_VERIFIER_RECEIPT")
            raise InvalidVerifierReceiptError(f"Verifier receipt candidate_sha mismatch: expected {cand_sha}, got {payload.get('candidate_sha')}")

        decision = str(payload.get("decision", "")).upper()
        if decision not in {"PASS", "FAIL", "BLOCKED"} or payload.get("diff_digest") != diff_digest:
            myrmex_task_operation.record_task_terminal(op, "failed", "Invalid verifier result payload", error_type="INVALID_VERIFIER_RECEIPT")
            raise InvalidVerifierReceiptError("Verifier decision or diff digest is invalid")
        defects = payload.get("defects", [])

        myrmex_task_operation.record_task_terminal(
            op,
            "completed" if decision == "PASS" else "failed",
            task_res.text_content,
            candidate_sha=cand_sha,
            diff_digest=diff_digest,
            result_payload=payload,
        )
        myrmex_task_operation.record_receipt_confirmed(op)

        return {
            "driver": self.driver_name,
            "agent": agent_id,
            "status": decision,
            "candidate_sha": cand_sha,
            "diff_digest": diff_digest,
            "defects": defects,
            "checks": payload.get("checks", []),
            "residual_risks": payload.get("residual_risks", []),
            "timestamp": utcnow(),
            "task_id": task_id,
        }

    def execute_remediation(
        self,
        wu: dict[str, Any],
        defects: list[dict[str, Any]],
        attempt: int,
        repo_root: Path,
        run_id: str,
        env: dict[str, str],
    ) -> dict[str, Any]:
        agent_id = wu.get("implementing_agent") or self.remediator_agent
        wuid = wu["id"]
        campaign_id = wu.get("campaign_id", "default-campaign")
        allowed_scope = self._allowed_scope(wu)
        context = self._execution_context(wu)

        wt_dir = myrmex_worktree._get_worktrees_dir() / campaign_id / wuid
        if not wt_dir.exists():
            wt_dir = repo_root

        # 1. Check existing remediation task operation for recovery
        existing_op = myrmex_task_operation.find_existing_op_for_phase(run_id, wuid, "remediator", attempt)
        if (existing_op is not None and existing_op.task_id
                and isinstance(getattr(existing_op, "receipt", None), dict)
                and existing_op.receipt.get("phase") == "RESULT_RECEIPT_CONFIRMED"):
            self._validate_operation_identity(
                existing_op, run_id, wuid, "remediator", attempt, campaign_id, agent_id,
                wu.get("provider", "opencode"), wu.get("model"), wt_dir,
                wu.get("base_sha"), allow_null_base=True)
            payload = self._validate_receipt(existing_op, "remediator")
            if (existing_op.receipt.get("observed_task_id") != existing_op.task_id
                    or not self._sha256(existing_op.result_digest)
                    or existing_op.receipt.get("result_digest") != existing_op.result_digest):
                raise ExecutionDriverError("confirmed remediator receipt identity or result digest is invalid")
            current_candidate = run_argv(["git", "rev-parse", "HEAD"], cwd=wt_dir, env=env).stdout.strip()
            durable_digest, _ = self._workspace_diff(wt_dir, current_candidate, env)
            if (existing_op.candidate_sha != current_candidate
                    or not self._sha256(existing_op.diff_digest)
                    or existing_op.diff_digest != durable_digest
                    or payload.get("decision") != "COMPLETED"):
                raise ExecutionDriverError("confirmed remediator receipt does not match durable workspace evidence")
            return {"attempt": attempt, "candidate_sha": current_candidate, "diff_digest": durable_digest,
                    "defects": defects, "started_at": existing_op.started_at or utcnow(),
                    "completed_at": existing_op.completed_at or utcnow(), "task_id": existing_op.task_id}
        if existing_op and existing_op.task_id:
            self._validate_operation_identity(existing_op, run_id, wuid, "remediator", attempt, campaign_id, agent_id, wu.get("provider", "opencode"), wu.get("model"), wt_dir, wu.get("base_sha"), allow_null_base=True)
            snap = opencode_transport.recover_existing_task(existing_op.task_id)
            if snap.status == "running":
                snap = opencode_transport.wait_task(existing_op.task_id, timeout_seconds=300)
            if snap.status != "completed":
                raise ExecutionDriverError(f"remediator task recovery is not safely resumable: {snap.status}")
            if snap.status == "completed":
                task_res = opencode_transport.get_result(existing_op.task_id)
                sys.stdout.write(f"[myrmex-head] [OpenCodeTaskDriver] Recovered existing remediator task {existing_op.task_id}\n")
                if (isinstance(task_res, opencode_transport.TaskResult)
                        and (task_res.status != "completed" or task_res.error_type is not None
                             or not isinstance(task_res.json_payload, dict)
                             or str(task_res.json_payload.get("decision", "")).upper() != "COMPLETED")):
                    raise ExecutionDriverError("Recovered remediator task result is not a completed structured payload")
                curr_cand = run_argv(["git", "rev-parse", "HEAD"], cwd=wt_dir, env=env).stdout.strip()
                recovered_digest, _ = self._workspace_diff(wt_dir, curr_cand, env)
                if existing_op.receipt.get("phase") == "TASK_ID_OBSERVED":
                    myrmex_task_operation.record_task_terminal(existing_op, "completed", task_res.text_content,
                        candidate_sha=curr_cand, diff_digest=recovered_digest,
                        result_payload=task_res.json_payload)
                    myrmex_task_operation.record_receipt_confirmed(existing_op)
                elif (existing_op.candidate_sha != curr_cand or existing_op.diff_digest != recovered_digest
                      or not self._sha256(existing_op.result_digest)):
                    raise ExecutionDriverError("Recovered remediator receipt does not match durable workspace evidence")
                return {
                    "attempt": attempt,
                    "candidate_sha": curr_cand,
                    "defects": defects,
                    "started_at": existing_op.started_at or utcnow(),
                    "completed_at": existing_op.completed_at or utcnow(),
                    "task_id": existing_op.task_id,
                }
        elif existing_op:
            self._validate_operation_identity(existing_op, run_id, wuid, "remediator", attempt, campaign_id, agent_id, wu.get("provider", "opencode"), wu.get("model"), wt_dir, wu.get("base_sha"), allow_null_base=True)

        # 2. Construct remediator prompt with exact defect set
        prompt = (
            f"Remediation Task (Attempt {attempt}) for Work Unit {wuid}\n"
            f"Work-order context: {self._prompt_context(wu) if self._plan_bound(wu) else json.dumps(context, sort_keys=True)}\n"
            f"Defects to correct: {json.dumps(defects)}\n"
            f"Allowed Scope: {json.dumps(allowed_scope)}\n"
            f"Apply bounded corrections to resolve all defects.\n"
            f"Do NOT execute git commit, git push, git pr, or git merge.\n"
            f"Format response as JSON: {{\"decision\": \"COMPLETED\", \"summary\": \"...\"}}"
        )

        model = wu.get("model")
        if existing_op:
            self._validate_task_intent(existing_op, prompt)
        op = existing_op or myrmex_task_operation.create_task_intent(
            campaign_id=campaign_id,
            work_unit_id=wuid,
            run_id=run_id,
            role="remediator",
            agent=agent_id,
            workspace=str(wt_dir),
            base_sha=wu.get("base_sha", "HEAD"),
            prompt=prompt,
            model=model or "default",
            provider=wu.get("provider", "opencode"),
            attempt=attempt,
        )

        # 3. Dispatch REAL OpenCode Task for Remediator (New sessionID)
        sys.stdout.write(f"[myrmex-head] [OpenCodeTaskDriver] Dispatching remediator task (attempt {attempt}) to OpenCode ({agent_id})...\n")
        task_identity, task_proc = opencode_transport.create_task({
            "prompt": prompt,
            "agent": agent_id,
            "workspace": str(wt_dir),
            "model": model,
        })
        task_id = task_identity.task_id
        myrmex_task_operation.record_task_observed(op, task_id)

        # 4. Wait and confirm terminal status via opencode export
        snap = opencode_transport.wait_task(task_id, proc=task_proc, timeout_seconds=300)
        if snap.status != "completed":
            raise ExecutionDriverError(f"Remediator task {task_id} failed to reach terminal status: {snap.status}")
        task_res = opencode_transport.get_result(task_id)
        if isinstance(task_res, opencode_transport.TaskResult) and (task_res.status != "completed" or task_res.error_type is not None):
            raise ExecutionDriverError("Remediator task result is not terminal successful transport output")

        curr_cand = run_argv(["git", "rev-parse", "HEAD"], cwd=wt_dir, env=env).stdout.strip()
        diff_digest, _ = self._workspace_diff(wt_dir, curr_cand, env)
        myrmex_task_operation.record_task_terminal(
            op,
            "completed",
            task_res.text_content,
            candidate_sha=curr_cand,
            diff_digest=diff_digest,
            result_payload=task_res.json_payload if isinstance(task_res.json_payload, dict) else None,
        )
        myrmex_task_operation.record_receipt_confirmed(op)

        return {
            "attempt": attempt,
            "candidate_sha": curr_cand,
            "defects": defects,
            "started_at": getattr(op, "started_at", None) or utcnow(),
            "completed_at": getattr(op, "completed_at", None) or utcnow(),
            "task_id": task_id,
        }

    def execute_ci(
        self,
        wu: dict[str, Any],
        repo_root: Path,
        run_id: str,
        env: dict[str, str],
    ) -> dict[str, Any]:
        ci_cmd_spec = wu.get("ci_command")
        ci_cmds = [ci_cmd_spec] if isinstance(ci_cmd_spec, str) else (ci_cmd_spec or ["git status --porcelain"])

        stdout_chunks = []
        for cmd_ci in ci_cmds:
            sys.stdout.write(f"[myrmex-head] [OpenCodeTaskDriver] Running CI: {cmd_ci}\n")
            proc = run_argv(cmd_ci, cwd=repo_root, env=env)
            stdout_chunks.append(proc.stdout)
            if proc.returncode != 0:
                return {
                    "command": "; ".join(ci_cmds),
                    "exit_code": proc.returncode,
                    "status": "fail",
                    "stdout_digest": hashlib.sha256(proc.stdout.encode("utf-8")).hexdigest(),
                    "timestamp": utcnow(),
                    "stderr": proc.stderr.strip(),
                }

        combined_stdout = "".join(stdout_chunks)
        return {
            "command": "; ".join(ci_cmds),
            "exit_code": 0,
            "status": "pass",
            "stdout_digest": hashlib.sha256(combined_stdout.encode("utf-8")).hexdigest(),
            "timestamp": utcnow(),
        }


class FixtureCommandDriver(WorkUnitExecutionDriver):
    """Testing & fixture driver for command-based execution in test environments."""
    driver_name: str = "fixture-command"
    writer_agent: str = "fixture-runner"
    verifier_agent: str = "fixture-verifier"
    remediator_agent: str = "fixture-runner"

    def __init__(self, allowed: bool = False) -> None:
        self.allowed = allowed

    def _check_allowed(self) -> None:
        if not self.allowed:
            raise DriverPolicyViolation(
                "FixtureCommandDriver requested but driver policy prohibits fixture drivers in production"
            )

    def execute_writer(
        self,
        wu: dict[str, Any],
        base_sha: str,
        repo_root: Path,
        run_id: str,
        env: dict[str, str],
    ) -> dict[str, Any]:
        self._check_allowed()

        def _do_write() -> dict[str, Any]:
            impl_cmd = wu.get("implementation_command")
            if impl_cmd:
                proc = run_argv(impl_cmd, cwd=repo_root, env=env)
                if proc.returncode != 0:
                    raise ExecutionDriverError(f"Fixture writer failed: {proc.stderr.strip()}")

            status_proc = run_argv(["git", "status", "--porcelain"], cwd=repo_root, env=env)
            status_lines = [line for line in status_proc.stdout.splitlines() if line.strip()]
            modified_files = [line[3:].strip() for line in status_lines]

            validate_paths_in_scope(repo_root, modified_files, wu.get("scope", []))

            no_op_allowed = wu.get("no_op_allowed", False)
            if not status_lines and not no_op_allowed:
                raise ExecutionDriverError("Fixture writer produced zero changes and no-op is not allowed")

            diff_stat = run_argv(["git", "diff", "--stat", "HEAD"], cwd=repo_root, env=env).stdout.strip()
            diff_digest = compute_candidate_diff_digest(repo_root, base_sha, modified_files)
            return {
                "driver": self.driver_name,
                "agent": self.writer_agent,
                "status": "SUCCESS",
                "files_modified": modified_files,
                "diff_stat": diff_stat,
                "diff_digest": diff_digest,
                "summary": f"Fixture runner modified {len(modified_files)} file(s)",
                "timestamp": utcnow(),
            }

        return self._record_delegation(run_id, wu["id"], "writer", self.writer_agent, repo_root, env, _do_write)

    def execute_verifier(
        self,
        wu: dict[str, Any],
        repo_root: Path,
        run_id: str,
        env: dict[str, str],
        attempt: int = 1,
    ) -> dict[str, Any]:
        self._check_allowed()
        
        def _do_verify() -> dict[str, Any]:
            vcmds = wu.get("verification_commands", [])
            status_before = run_argv(["git", "status", "--porcelain"], cwd=repo_root, env=env).stdout

            v_passed = True
            v_results = []
            defects_found = []

            for vc in vcmds:
                proc = run_argv(vc, cwd=repo_root, env=env)
                v_results.append(f"{vc} -> code {proc.returncode}")
                if proc.returncode != 0:
                    v_passed = False
                    defects_found.append({
                        "command": vc,
                        "exit_code": proc.returncode,
                        "stdout": proc.stdout.strip(),
                        "stderr": proc.stderr.strip(),
                    })
                    break

            status_after = run_argv(["git", "status", "--porcelain"], cwd=repo_root, env=env).stdout
            if status_after != status_before:
                raise VerifierWorkspaceMutationError("Verifier mutated repository workspace during verification execution")

            return {
                "driver": self.driver_name,
                "agent": self.verifier_agent,
                "status": "PASS" if v_passed else "FAIL",
                "commands_run": vcmds,
                "results": v_results,
                "defects": defects_found,
                "timestamp": utcnow(),
            }

        return self._record_delegation(run_id, wu["id"], "verifier", self.verifier_agent, repo_root, env, _do_verify)

    def execute_remediation(
        self,
        wu: dict[str, Any],
        defects: list[dict[str, Any]],
        attempt: int,
        repo_root: Path,
        run_id: str,
        env: dict[str, str],
    ) -> dict[str, Any]:
        self._check_allowed()
        
        def _do_remediate() -> dict[str, Any]:
            remed_cmd = wu.get("remediation_command")
            started_at = utcnow()

            if remed_cmd:
                proc = run_argv(remed_cmd, cwd=repo_root, env=env)
                if proc.returncode != 0:
                    sys.stderr.write(f"[myrmex-head] Fixture remediation command failed: {proc.stderr}\n")

            curr_cand = run_argv(["git", "rev-parse", "HEAD"], cwd=repo_root, env=env).stdout.strip()
            return {
                "attempt": attempt,
                "candidate_sha": curr_cand,
                "defects": defects,
                "started_at": started_at,
                "completed_at": utcnow(),
            }

        return self._record_delegation(run_id, wu["id"], "writer", self.remediator_agent, repo_root, env, _do_remediate)

    def execute_ci(
        self,
        wu: dict[str, Any],
        repo_root: Path,
        run_id: str,
        env: dict[str, str],
    ) -> dict[str, Any]:
        self._check_allowed()
        ci_cmd_spec = wu.get("ci_command")
        ci_cmds = [ci_cmd_spec] if isinstance(ci_cmd_spec, str) else (ci_cmd_spec or ["git status --porcelain"])

        stdout_chunks = []
        for cmd_ci in ci_cmds:
            proc = run_argv(cmd_ci, cwd=repo_root, env=env)
            stdout_chunks.append(proc.stdout)
            if proc.returncode != 0:
                return {
                    "command": "; ".join(ci_cmds),
                    "exit_code": proc.returncode,
                    "status": "fail",
                    "stdout_digest": hashlib.sha256(proc.stdout.encode("utf-8")).hexdigest(),
                    "timestamp": utcnow(),
                    "stderr": proc.stderr.strip(),
                }

        combined_stdout = "".join(stdout_chunks)
        return {
            "command": "; ".join(ci_cmds),
            "exit_code": 0,
            "status": "pass",
            "stdout_digest": hashlib.sha256(combined_stdout.encode("utf-8")).hexdigest(),
            "timestamp": utcnow(),
        }


# ============================================================================
# Campaign Supervisor Engine
# ============================================================================

class CampaignSupervisor:
    def __init__(
        self,
        campaign_id: str | None = None,
        poll_interval: int = 5,
        once: bool = False,
        state_home: str | None = None,
        allow_fixture_driver: bool = False,
        route_model_policy_path: str | None = None,
        route_model_availability_path: str | None = None,
    ) -> None:
        self.target_campaign_id = campaign_id
        self.poll_interval = max(1, poll_interval)
        self.once = once
        self.allow_fixture_driver = allow_fixture_driver
        self.route_model_policy_path = route_model_policy_path
        self.route_model_availability_path = route_model_availability_path
        self.running = True
        self.hostname = socket.gethostname()
        self.pid = os.getpid()
        self.holder_id = f"{self.hostname}:{self.pid}"
        self.held_leases: set[str] = set()

        if state_home:
            os.environ["XDG_STATE_HOME"] = state_home

        signal.signal(signal.SIGTERM, self._handle_signal)
        signal.signal(signal.SIGINT, self._handle_signal)

    def _handle_signal(self, signum: int, frame: Any) -> None:
        sys.stderr.write(f"\n[myrmex-head] Received signal {signum}, initiating graceful shutdown...\n")
        self.running = False

    @staticmethod
    def _validate_recovered_no_op_writer(persisted: Any, recovered: Any,
                                         campaign_id: str, wuid: str, base_sha: str,
                                         current_sha: str, diff_digest: str) -> None:
        """Require campaign no-op evidence to match confirmed durable writer evidence."""
        if not isinstance(persisted, dict) or not isinstance(recovered, dict):
            raise ExecutionDriverError("no-op writer receipts must be objects")
        required = {
            "status": "SUCCESS",
            "task_id": recovered.get("task_id"),
            "diff_digest": diff_digest,
            "files_modified": [],
            "worktree": recovered.get("worktree"),
        }
        if any(key not in persisted or persisted.get(key) != value for key, value in required.items()):
            raise ExecutionDriverError("persisted and durable no-op writer receipts differ")
        if not isinstance(diff_digest, str) or re.fullmatch(r"[0-9a-f]{64}", diff_digest) is None:
            raise ExecutionDriverError("no-op writer diff digest is invalid")
        if (persisted.get("campaign_id") != campaign_id
                or persisted.get("work_unit_id") != wuid):
            raise ExecutionDriverError("no-op writer receipt scope identity mismatch")
        if (persisted.get("base_sha") != base_sha
                or persisted.get("candidate_sha") != current_sha):
            raise ExecutionDriverError("no-op writer receipt SHA identity mismatch")
        if recovered.get("driver") != "opencode-task" or recovered.get("diff_digest") != diff_digest:
            raise ExecutionDriverError("durable no-op writer evidence is not authoritative")

    def get_campaign_ids(self) -> list[str]:
        if self.target_campaign_id:
            return [self.target_campaign_id]
        cmd = [sys.executable, str(ROOT / "bin/myrmex-campaign"), "list", "--json"]
        proc = subprocess.run(cmd, capture_output=True, text=True)
        if proc.returncode != 0:
            return []
        try:
            items = json.loads(proc.stdout)
            return [c["id"] for c in items if c.get("status") in {"active"}]
        except Exception:
            return []

    def acquire_lease(self, cid: str) -> bool:
        cmd = [
            sys.executable, str(ROOT / "bin/myrmex-campaign"),
            "lease-acquire", cid,
            "--holder", self.holder_id,
            "--duration", "120"
        ]
        proc = subprocess.run(cmd, capture_output=True, text=True)
        if proc.returncode == 0:
            self.held_leases.add(cid)
            return True
        return False

    def heartbeat_lease(self, cid: str) -> bool:
        cmd = [
            sys.executable, str(ROOT / "bin/myrmex-campaign"),
            "lease-heartbeat", cid,
            "--holder", self.holder_id,
            "--duration", "120"
        ]
        proc = subprocess.run(cmd, capture_output=True, text=True)
        return proc.returncode == 0

    def release_lease(self, cid: str) -> None:
        cmd = [
            sys.executable, str(ROOT / "bin/myrmex-campaign"),
            "lease-release", cid,
            "--holder", self.holder_id
        ]
        subprocess.run(cmd, capture_output=True, text=True)
        self.held_leases.discard(cid)

    def release_all_leases(self) -> None:
        for cid in list(self.held_leases):
            self.release_lease(cid)

    def reconcile_campaign(self, cid: str) -> dict[str, Any]:
        cmd = [sys.executable, str(ROOT / "bin/myrmex-campaign"), "reconcile", cid]
        proc = subprocess.run(cmd, capture_output=True, text=True)
        if proc.returncode != 0:
            return {"ok": False, "error": proc.stderr}
        try:
            return json.loads(proc.stdout)
        except Exception:
            return {"ok": False, "raw": proc.stdout}

    def get_campaign_data(self, cid: str) -> dict[str, Any]:
        cmd = [sys.executable, str(ROOT / "bin/myrmex-campaign"), "show", cid, "--json"]
        proc = subprocess.run(cmd, capture_output=True, text=True)
        if proc.returncode != 0:
            raise RuntimeError(f"failed to read campaign {cid}: {proc.stderr}")
        return json.loads(proc.stdout)

    def ensure_myrmex_state_run(self, cid: str, data: dict[str, Any], wu: dict[str, Any], repo_root: str, branch: str, base_sha: str, execution_policy: str = "auto") -> str:
        """Ensures a durable myrmex-state run exists for this work unit with authorized commit policy."""
        run_id = wu.get("run_id")
        if run_id:
            cmd_show = [sys.executable, str(ROOT / "bin/myrmex-state"), "show", run_id, "--json"]
            proc_show = subprocess.run(cmd_show, capture_output=True, text=True)
            if proc_show.returncode == 0:
                return run_id

        cmd_init = [
            sys.executable, str(ROOT / "bin/myrmex-state"),
            "init",
            "--repository-root", repo_root,
            "--branch", branch,
            "--base-sha", base_sha,
            "--mode", "autonomous",
            "--scope", "continuous",
            "--commit-policy", "authorized",
            "--push-policy", "deny",
            "--execution-policy", execution_policy,
            "--objective", wu["objective"],
            "--parent-objective", f"Campaign {cid}",
        ]

        proc_init = subprocess.run(cmd_init, capture_output=True, text=True)
        if proc_init.returncode != 0:
            raise RuntimeError(f"Failed to initialize myrmex-state run for {wu['id']}: {proc_init.stderr}")

        run_id = proc_init.stdout.strip().splitlines()[-1].strip() if proc_init.stdout.strip() else ""
        if not run_id:
            raise RuntimeError(f"Failed to initialize myrmex-state run for {wu['id']}: {proc_init.stderr}")

        self._transition_wu(cid, wu["id"], run_id=run_id)
        wu["run_id"] = run_id
        return run_id

    def sync_myrmex_state_phase(self, run_id: str, target_phase: str) -> None:
        """Synchronizes phase progression with myrmex-state machine."""
        order = ["initializing", "collecting-context", "implementing", "verifying", "committing", "reporting"]
        try:
            while True:
                cmd_show = [sys.executable, str(ROOT / "bin/myrmex-state"), "show", run_id, "--json"]
                proc_show = subprocess.run(cmd_show, capture_output=True, text=True)
                if proc_show.returncode != 0:
                    return
                state = json.loads(proc_show.stdout)
                cur_phase = state.get("phase")
                rev = state.get("revision", 1)

                if cur_phase == target_phase or state.get("status") != "active":
                    return

                if cur_phase not in order or target_phase not in order:
                    next_phase = target_phase
                else:
                    cur_idx = order.index(cur_phase)
                    tgt_idx = order.index(target_phase)
                    if cur_idx >= tgt_idx:
                        return
                    next_phase = order[cur_idx + 1]

                cmd_trans = [
                    sys.executable, str(ROOT / "bin/myrmex-state"),
                    "transition", run_id,
                    "--to-phase", next_phase,
                    "--expect-revision", str(rev),
                ]
                proc_t = subprocess.run(cmd_trans, capture_output=True, text=True)
                if proc_t.returncode != 0:
                    break
        except Exception:
            pass

    def complete_myrmex_state_run(self, run_id: str, wuid: str, evidence_file: str, message: str = "Completed by campaign supervisor") -> bool:
        """Idempotently close the durable state run with exact evidence."""
        try:
            self.sync_myrmex_state_phase(run_id, "reporting")
            cmd_show = [sys.executable, str(ROOT / "bin/myrmex-state"), "show", run_id, "--json"]
            proc_show = subprocess.run(cmd_show, capture_output=True, text=True)
            if proc_show.returncode != 0:
                sys.stderr.write(f"[myrmex-head] Failed to show myrmex-state run {run_id} before complete: {proc_show.stderr}\n")
                return False
            state = json.loads(proc_show.stdout)
            evidence = json.loads(Path(evidence_file).read_text(encoding="utf-8"))
            if state.get("status") != "active":
                completed_wu = state.get("work_units", {}).get(wuid, {})
                if (
                    state.get("status") == "dormant"
                    and state.get("phase") == "dormant"
                    and completed_wu.get("status") == "complete"
                    and completed_wu.get("completion_evidence") == evidence
                ):
                    return True
                sys.stderr.write(
                    f"[myrmex-head] Terminal myrmex-state run {run_id} does not contain matching completion evidence for {wuid}\n"
                )
                return False
            rev = state.get("revision", 1)

            # Record parent gate to satisfy continuous scope completion blockers
            cmd_pg_start = [
                sys.executable, str(ROOT / "bin/myrmex-state"),
                "frontier", run_id, "start",
                "--request-id", f"pg-req-{run_id}",
                "--task-id", "parent-gate",
                "--message-id", f"pg-msg-{run_id}",
                "--intent-json", '{"purpose": "parent_gate"}',
                "--expect-revision", str(rev),
            ]
            proc_pg_start = subprocess.run(cmd_pg_start, capture_output=True, text=True)
            if proc_pg_start.returncode == 0:
                rev = json.loads(proc_pg_start.stdout)["revision"]
                op_id = json.loads(proc_pg_start.stdout)["pending_operations"][-1]["operation_id"]
                cmd_pg_result = [
                    sys.executable, str(ROOT / "bin/myrmex-state"),
                    "frontier", run_id, "result",
                    "--operation-id", op_id,
                    "--request-id", f"pg-req-{run_id}",
                    "--message-id", f"pg-msg-{run_id}",
                    "--transport-status", "success",
                    "--frontier-decision", "ACCEPT",
                    "--response-type", "parent_objective_complete",
                    "--effect-json", "{}",
                    "--receipt-json", "{}",
                    "--expect-revision", str(rev),
                ]
                proc_pg_result = subprocess.run(cmd_pg_result, capture_output=True, text=True)
                if proc_pg_result.returncode == 0:
                    rev = json.loads(proc_pg_result.stdout)["revision"]
                else:
                    sys.stderr.write(f"[myrmex-head] Failed to record parent gate result: {proc_pg_result.stderr}\n")
                    return False
            else:
                sys.stderr.write(f"[myrmex-head] Failed to start parent gate: {proc_pg_start.stderr}\n")
                return False

            # Complete work unit
            cmd_wu = [
                sys.executable, str(ROOT / "bin/myrmex-state"),
                "work-unit", run_id, "complete",
                "--work-unit-id", wuid,
                "--evidence-json", json.dumps(evidence, sort_keys=True),
                "--expect-revision", str(rev),
            ]
            proc_wu = subprocess.run(cmd_wu, capture_output=True, text=True)
            if proc_wu.returncode == 0:
                rev = json.loads(proc_wu.stdout)["revision"]
            else:
                sys.stderr.write(f"[myrmex-head] Failed to complete work-unit {wuid}: {proc_wu.stderr}\n")
                return False

            # Complete the run
            cmd_comp = [
                sys.executable, str(ROOT / "bin/myrmex-state"),
                "complete", run_id,
                "--expect-revision", str(rev),
                "--message", message,
            ]
            proc_comp = subprocess.run(cmd_comp, capture_output=True, text=True)
            if proc_comp.returncode != 0:
                sys.stderr.write(f"[myrmex-head] Failed to complete myrmex-state run: {proc_comp.stderr}\n")
                return False
            return True
        except Exception as exc:
            sys.stderr.write(f"[myrmex-head] Exception in complete_myrmex_state_run: {exc}\n")
            return False

    def resolve_execution_driver(self, data: dict[str, Any], wu: dict[str, Any]) -> WorkUnitExecutionDriver:
        """Selects the execution driver enforcing security and driver policies."""
        camp_policy = data.get("driver_policy")
        camp_driver = data.get("execution_driver")
        wu_policy = wu.get("driver_policy")
        wu_driver = wu.get("execution_driver")

        policy = wu_policy or camp_policy
        driver_choice = wu_driver or camp_driver

        if policy == "fixture" or driver_choice == "fixture-command":
            allowed = self.allow_fixture_driver or policy == "fixture"
            return FixtureCommandDriver(allowed=allowed)

        if (wu.get("implementation_command") or wu.get("verification_commands")) and self.allow_fixture_driver:
            return FixtureCommandDriver(allowed=True)

        return OpenCodeTaskDriver()

    def _campaign_dir(self, cid: str) -> Path:
        base = Path(os.environ.get("XDG_STATE_HOME") or (Path.home() / ".local/state"))
        return base / "myrmex" / "campaigns" / cid

    def _p1_plan_id(self, data: dict[str, Any]) -> str | None:
        plan_bound = []
        for wu in data.get("work_units", []):
            order = wu.get("work_order") if isinstance(wu, dict) else None
            provenance = order.get("plan_provenance") if isinstance(order, dict) else None
            plan_id = provenance.get("plan_revision_id") if isinstance(provenance, dict) else None
            if isinstance(order, dict) and order.get("schema") == "myrmex.work-order/v2" and isinstance(plan_id, str):
                plan_bound.append((wu, plan_id))
        if not plan_bound:
            return None
        plan_ids = {plan_id for _, plan_id in plan_bound}
        if len(plan_ids) != 1:
            raise SequentialSchedulerError("P1 intelligence has work units from multiple plan revisions")
        plan_id = next(iter(plan_ids))
        for wu in data.get("work_units", []):
            if wu.get("status") not in {"completed", "cancelled", "superseded"}:
                order = wu.get("work_order") if isinstance(wu, dict) else None
                provenance = order.get("plan_provenance") if isinstance(order, dict) else None
                if not isinstance(provenance, dict) or provenance.get("plan_revision_id") != plan_id:
                    raise SequentialSchedulerError("P1 intelligence cannot fall back to a legacy non-plan-bound work unit")
        return plan_id

    def _active_plan(self, cid: str) -> tuple[dict[str, Any], dict[str, Any]]:
        try:
            return replanning._active_activation(self._campaign_dir(cid), cid)
        except Exception as exc:
            raise SequentialSchedulerError(f"active plan/activation receipt unavailable: {exc}") from exc

    @staticmethod
    def _read_policy_file(path_value: str | None, label: str) -> dict[str, Any]:
        if not path_value:
            raise SequentialSchedulerError(f"P1 scheduling requires explicit {label}")
        path = Path(path_value).expanduser()
        try:
            if path.is_symlink() or not path.is_file() or path.stat().st_size > 1024 * 1024:
                raise SequentialSchedulerError(f"{label} path unavailable or unsafe")
            value = json.loads(path.read_text(encoding="utf-8"))
        except (OSError, ValueError) as exc:
            if isinstance(exc, SequentialSchedulerError):
                raise
            raise SequentialSchedulerError(f"{label} is unreadable") from exc
        if not isinstance(value, dict):
            raise SequentialSchedulerError(f"{label} must be a JSON object")
        return value

    def _route_inputs(self, data: dict[str, Any], wu: dict[str, Any], head: dict[str, Any]) -> tuple[dict[str, Any], dict[str, Any], dict[str, Any]]:
        policy_source = self._read_policy_file(self.route_model_policy_path, "route/model policy")
        availability_source = self._read_policy_file(self.route_model_availability_path, "route/model availability")
        policy = route_model_policy.compile_policy(policy_source)
        budgets = data.get("budgets", {})
        cost_limit = budgets.get("cost_limit_usd")
        estimated = budgets.get("estimated_cost_usd")
        if cost_limit is None:
            headroom = max(option["max_estimated_cost_usd"] for option in policy["options"])
        elif estimated is None:
            raise SequentialSchedulerError("campaign cost limit is set but current estimated cost is unknown")
        elif isinstance(cost_limit, bool) or isinstance(estimated, bool) or not isinstance(cost_limit, (int, float)) or not isinstance(estimated, (int, float)):
            raise SequentialSchedulerError("campaign cost budget is invalid")
        else:
            headroom = max(0, cost_limit - estimated)
        request = {
            "schema": route_model_policy.REQUEST_SCHEMA, "work_unit_id": wu["id"],
            "plan_revision_id": head["plan_revision_id"], "plan_revision_digest": head["plan_digest"],
            "required_route": wu["required_route"], "required_role": "worker",
            "budget_headroom_usd": headroom,
        }
        return request, policy_source, availability_source

    def _check_driver_decision(self, data: dict[str, Any], wu: dict[str, Any], route_decision: dict[str, Any]) -> WorkUnitExecutionDriver:
        selected = route_decision.get("selected")
        if route_decision.get("status") != "SELECTED" or not isinstance(selected, dict):
            blocker = route_decision.get("blocker", {}).get("code", "NO_ELIGIBLE_ROUTE_MODEL_OPTION")
            raise SequentialSchedulerError(f"route/model selection blocked: {blocker}")
        driver = self.resolve_execution_driver(data, wu)
        if isinstance(driver, FixtureCommandDriver):
            if not self.allow_fixture_driver or selected.get("provider") != "fixture":
                raise SequentialSchedulerError("fixture driver requires explicit fixture provider policy and --allow-fixture-driver")
        elif (
            selected.get("route") != "delegated"
            or selected.get("agent") != "myrmex-worker"
            or selected.get("provider") == "fixture"
        ):
            raise SequentialSchedulerError("production OpenCode driver requires a delegated myrmex-worker non-fixture decision")
        return driver

    @staticmethod
    def _put_decision(campaign_dir: Path, data: dict[str, Any], artifact_id: str, payload: dict[str, Any]) -> dict[str, Any]:
        return campaign_intel.put_artifact(
            campaign_dir, data["id"], data["revision"], "decision", artifact_id, payload,
        )

    def _dispatch_intent(
        self,
        data: dict[str, Any], wu: dict[str, Any], head: dict[str, Any], activation_receipt: dict[str, Any],
        schedule: dict[str, Any], route_decision: dict[str, Any], driver: WorkUnitExecutionDriver,
    ) -> dict[str, Any]:
        order = wu["work_order"]
        body = {
            "schema": "myrmex.sequential-dispatch-intent/v1", "status": "READY",
            "campaign_id": data["id"], "campaign_revision": data["revision"],
            "campaign_state_digest": canonical_sha(data), "observed_campaign_updated_at": data["updated_at"],
            "work_unit_id": wu["id"], "work_order_id": order["work_order_id"],
            "work_order_digest": order["work_order_digest"], "plan_revision_id": head["plan_revision_id"],
            "plan_digest": head["plan_digest"], "active_record_id": head["record_id"],
            "activation_id": activation_receipt["activation_id"],
            "scheduling_artifact_id": "scheduling-decision/" + schedule["decision_id"],
            "scheduling_decision_digest": schedule["decision_digest"],
            "route_model_artifact_id": "route-model-decision/" + route_decision["decision_id"],
            "route_model_decision_digest": route_decision["decision_digest"],
            "selected_route": route_decision["selected"]["route"],
            "selected_agent": route_decision["selected"]["agent"],
            "selected_provider": route_decision["selected"]["provider"],
            "selected_model": route_decision["selected"]["model"],
            "execution_driver": driver.driver_name, "created_at": data["updated_at"],
            "authority": {
                "scope": "sequential_dispatch_intent", "dispatch_one_work_unit": True,
                "activate_plan": False, "create_work_units": False,
                "repository_write": False, "commit": False, "push": False,
            },
        }
        digest = canonical_sha(body)
        return {**body, "dispatch_id": "dispatch_" + digest, "dispatch_digest": digest}

    @staticmethod
    def _validate_dispatch_intent(intent: Any) -> None:
        if not isinstance(intent, dict) or intent.get("schema") != "myrmex.sequential-dispatch-intent/v1" or intent.get("status") != "READY":
            raise SequentialSchedulerError("sequential dispatch intent schema/status invalid")
        body = {key: value for key, value in intent.items() if key not in {"dispatch_id", "dispatch_digest"}}
        digest = canonical_sha(body)
        if intent.get("dispatch_digest") != digest or intent.get("dispatch_id") != "dispatch_" + digest:
            raise SequentialSchedulerError("sequential dispatch intent digest invalid")
        authority = intent.get("authority")
        if not isinstance(authority, dict) or authority.get("scope") != "sequential_dispatch_intent" or authority.get("dispatch_one_work_unit") is not True or any(authority.get(key) is not False for key in ("activate_plan", "create_work_units", "repository_write", "commit", "push")):
            raise SequentialSchedulerError("sequential dispatch intent authority invalid")

    def _revalidate_p1_dispatch(self, cid: str, context: dict[str, Any]) -> dict[str, Any]:
        current = self.get_campaign_data(cid)
        intent = context["intent"]
        if current["revision"] != intent["campaign_revision"] or canonical_sha(current) != intent["campaign_state_digest"]:
            raise SequentialSchedulerStale("campaign or ready set changed after scheduling decision")
        if current.get("active_work_unit") is not None or any(wu.get("status") == "active" for wu in current["work_units"]):
            raise SequentialSchedulerStale("a work unit was already dispatched")
        head, receipt = self._active_plan(cid)
        if head["record_id"] != intent["active_record_id"] or head["plan_revision_id"] != intent["plan_revision_id"] or head["plan_digest"] != intent["plan_digest"] or receipt["activation_id"] != intent["activation_id"]:
            raise SequentialSchedulerStale("active plan changed after scheduling decision")
        schedule = priority_policy.preview_schedule(self._campaign_dir(cid), cid, current["revision"])
        if schedule != context["schedule"] or schedule["selected_work_unit_id"] != intent["work_unit_id"]:
            raise SequentialSchedulerStale("scheduling decision is stale")
        wu = next((item for item in current["work_units"] if item["id"] == intent["work_unit_id"]), None)
        if wu is None:
            raise SequentialSchedulerStale("selected work unit disappeared")
        request, policy, availability = self._route_inputs(current, wu, head)
        route_decision = route_model_policy.decide(request, policy, availability)
        if route_decision != context["route_decision"]:
            raise SequentialSchedulerStale("route/model decision inputs changed")
        driver = self._check_driver_decision(current, wu, route_decision)
        if driver.driver_name != intent["execution_driver"]:
            raise SequentialSchedulerStale("execution driver changed after dispatch intent")
        return {**context, "data": current, "wu": wu, "driver": driver}

    def _prepare_p1_dispatch(self, cid: str, data: dict[str, Any]) -> dict[str, Any] | None:
        plan_id = self._p1_plan_id(data)
        if plan_id is None:
            return None
        head, activation_receipt = self._active_plan(cid)
        if head["plan_revision_id"] != plan_id:
            raise SequentialSchedulerError("campaign work units do not match the exact active plan revision")
        schedule = priority_policy.preview_schedule(self._campaign_dir(cid), cid, data["revision"])
        selected_id = schedule["selected_work_unit_id"]
        if selected_id is None:
            return {"no_eligible": True, "schedule": schedule}
        wu = next((item for item in data["work_units"] if item["id"] == selected_id), None)
        if wu is None:
            raise SequentialSchedulerError("priority policy selected an unavailable work unit")
        request, policy, availability = self._route_inputs(data, wu, head)
        route_decision = route_model_policy.decide(request, policy, availability)
        campaign_dir = self._campaign_dir(cid)
        self._put_decision(campaign_dir, data, "scheduling-decision/" + schedule["decision_id"], schedule)
        self._put_decision(campaign_dir, data, "route-model-decision/" + route_decision["decision_id"], route_decision)
        driver = self._check_driver_decision(data, wu, route_decision)
        intent = self._dispatch_intent(data, wu, head, activation_receipt, schedule, route_decision, driver)
        self._validate_dispatch_intent(intent)
        self._put_decision(campaign_dir, data, "sequential-dispatch/intent/" + intent["dispatch_id"], intent)
        return self._revalidate_p1_dispatch(cid, {
            "schedule": schedule, "route_decision": route_decision, "intent": intent,
            "data": data, "wu": wu, "driver": driver,
        })

    def _resume_p1_dispatch(self, cid: str, data: dict[str, Any], wu: dict[str, Any]) -> dict[str, Any]:
        plan_id = self._p1_plan_id(data)
        if plan_id is None:
            raise SequentialSchedulerError("legacy active work unit has no P1 dispatch context")
        head, receipt = self._active_plan(cid)
        if head["plan_revision_id"] != plan_id:
            raise SequentialSchedulerStale("active plan changed while work unit was dispatched")
        listing = campaign_intel.list_artifacts(self._campaign_dir(cid), cid, kind="decision")
        if listing.get("status") != "healthy":
            raise SequentialSchedulerError("decision projection unavailable for dispatch recovery")
        candidates = []
        for descriptor in listing["artifacts"]["decision"]:
            artifact_id = descriptor["artifact_id"]
            if not artifact_id.startswith("sequential-dispatch/intent/"):
                continue
            intent = campaign_intel.get_artifact(self._campaign_dir(cid), cid, artifact_id)["artifact"]["payload"]
            self._validate_dispatch_intent(intent)
            if intent["work_unit_id"] == wu["id"] and intent["plan_revision_id"] == plan_id and intent["active_record_id"] == head["record_id"]:
                candidates.append(intent)
        if not candidates:
            raise SequentialSchedulerError("active P1 work unit lacks a persisted dispatch intent")
        latest_revision = max(item["campaign_revision"] for item in candidates)
        latest = [item for item in candidates if item["campaign_revision"] == latest_revision]
        if len(latest) != 1:
            raise SequentialSchedulerError("active P1 work unit has ambiguous dispatch intents")
        intent = latest[0]
        schedule = campaign_intel.get_artifact(self._campaign_dir(cid), cid, intent["scheduling_artifact_id"])["artifact"]["payload"]
        route_decision = campaign_intel.get_artifact(self._campaign_dir(cid), cid, intent["route_model_artifact_id"])["artifact"]["payload"]
        priority_policy.validate_decision(schedule); route_model_policy.validate_decision(route_decision)
        if schedule["selected_work_unit_id"] != wu["id"] or route_decision["request"]["work_unit_id"] != wu["id"] or route_decision["request"]["plan_revision_id"] != plan_id:
            raise SequentialSchedulerError("recovered dispatch decision binding invalid")
        driver = self._check_driver_decision(data, wu, route_decision)
        if driver.driver_name != intent["execution_driver"] or receipt["activation_id"] != intent["activation_id"]:
            raise SequentialSchedulerStale("recovered dispatch driver/activation changed")
        return {"schedule": schedule, "route_decision": route_decision, "intent": intent, "data": data, "wu": wu, "driver": driver}

    def _attach_dispatch_run(self, cid: str, dispatch: dict[str, Any], run_id: str) -> None:
        intent = dispatch["intent"]
        data = self.get_campaign_data(cid)
        body = {
            "schema": "myrmex.sequential-dispatch-run/v1", "dispatch_id": intent["dispatch_id"],
            "dispatch_digest": intent["dispatch_digest"], "campaign_id": cid,
            "campaign_revision": intent["campaign_revision"], "work_unit_id": intent["work_unit_id"],
            "run_id": run_id, "scheduling_decision_digest": intent["scheduling_decision_digest"],
            "route_model_decision_digest": intent["route_model_decision_digest"],
            "execution_driver": intent["execution_driver"],
            "authority": {"scope": "dispatch_run_binding", "dispatch": False, "repository_write": False, "commit": False, "push": False},
        }
        digest = canonical_sha(body)
        record = {**body, "binding_id": "dispatchrun_" + digest, "binding_digest": digest}
        self._put_decision(self._campaign_dir(cid), data, "sequential-dispatch/run/" + record["binding_id"], record)

    def produce_governed_commit(
        self,
        run_id: str,
        repo_root: Path,
        wuid: str,
        objective: str,
        base_sha: str,
        modified_files: list[str],
        diff_digest: str,
        cid: str,
    ) -> dict[str, Any]:
        """Creates a governed commit via scripts/myrmex-git-local.py and myrmex-state."""
        env = os.environ.copy()

        branch_proc = run_argv(["git", "branch", "--show-current"], cwd=repo_root, env=env)
        branch = branch_proc.stdout.strip() or "main"

        head_proc = run_argv(["git", "rev-parse", "HEAD"], cwd=repo_root, env=env)
        head_sha = head_proc.stdout.strip()

        commit_msg = f"feat({wuid.lower()}): {objective}"

        # Fetch revision from myrmex-state
        cmd_show = [sys.executable, str(ROOT / "bin/myrmex-state"), "show", run_id, "--json"]
        proc_show = subprocess.run(cmd_show, capture_output=True, text=True, env=env)
        if proc_show.returncode != 0:
            raise RuntimeError(f"failed to read myrmex-state run {run_id}: {proc_show.stderr}")
        state_data = json.loads(proc_show.stdout)
        rev = state_data.get("revision", 1)

        unique_paths = sorted(set(modified_files))

        # 1. Start frontier operation representing the campaign's decision
        req_id = f"auth-req-{wuid}-{cid}-{int(time.time()*1000)}"
        msg_id = f"msg-{req_id}"
        cmd_frontier_start = [
            sys.executable, str(ROOT / "bin/myrmex-state"),
            "frontier", run_id, "start",
            "--request-id", req_id,
            "--task-id", f"task-{wuid}",
            "--message-id", msg_id,
            "--expect-revision", str(rev),
        ]
        proc_start = subprocess.run(cmd_frontier_start, capture_output=True, text=True, env=env)
        if proc_start.returncode != 0:
            raise RuntimeError(f"failed to start frontier: {proc_start.stderr}")
        state_data = json.loads(proc_start.stdout)
        rev = state_data["revision"]
        op_id = state_data["pending_operations"][-1]["operation_id"]

        # 2. Record frontier decision
        evidence = {
            "request_id": req_id,
            "message_id": msg_id,
            "transport_status": "success",
            "frontier_decision": "ACCEPT",
            "response_type": "sub_objective_complete",
            "work_unit_id": wuid,
            "repository_root": str(repo_root.resolve()),
            "branch": branch,
            "expected_head": head_sha,
            "candidate_diff_sha": diff_digest,
            "allowed_paths": unique_paths,
            "commit_message": commit_msg,
        }
        ev_json = json.dumps(evidence)
        cmd_frontier_result = [
            sys.executable, str(ROOT / "bin/myrmex-state"),
            "frontier", run_id, "result",
            "--operation-id", op_id,
            "--request-id", req_id,
            "--message-id", msg_id,
            "--transport-status", "success",
            "--frontier-decision", "ACCEPT",
            "--response-type", "sub_objective_complete",
            "--effect-json", ev_json,
            "--receipt-json", ev_json,
            "--expect-revision", str(rev),
        ]
        proc_result = subprocess.run(cmd_frontier_result, capture_output=True, text=True, env=env)
        if proc_result.returncode != 0:
            raise RuntimeError(f"failed to record frontier result: {proc_result.stderr}")
        rev = json.loads(proc_result.stdout)["revision"]

        # 3. Create standing commit policy authorization
        cmd_policy = [
            sys.executable, str(ROOT / "bin/myrmex-state"),
            "commit-policy", "authorize", run_id,
            "--authority", "user",
            "--source-request-id", req_id,
            "--source-operation-id", op_id,
            "--work-unit-id", wuid,
            "--expect-revision", str(rev),
        ]
        proc_policy = subprocess.run(cmd_policy, capture_output=True, text=True, env=env)
        if proc_policy.returncode != 0:
            raise RuntimeError(f"failed to authorize commit policy: {proc_policy.stderr}")
        rev = json.loads(proc_policy.stdout)["revision"]

        # 4. Create specific local_commit grant
        auth_req_id = f"grant-{req_id}"
        cmd_auth = [
            sys.executable, str(ROOT / "bin/myrmex-state"),
            "authorization", run_id, "create",
            "--authority", "user",
            "--request-id", auth_req_id,
            "--source-request-id", req_id,
            "--source-operation-id", op_id,
            "--work-unit-id", wuid,
            "--candidate-diff-sha", diff_digest,
            "--repository-root", str(repo_root),
            "--branch", branch,
            "--expected-head", head_sha,
            "--message", commit_msg,
            "--expect-revision", str(rev),
        ]
        for p in unique_paths:
            cmd_auth.extend(["--allowed-path", p])

        proc_auth = subprocess.run(cmd_auth, cwd=str(repo_root), capture_output=True, text=True, env=env)
        if proc_auth.returncode != 0:
            raise RuntimeError(f"failed to create commit authorization in myrmex-state: {proc_auth.stderr}")

        try:
            auth_data = json.loads(proc_auth.stdout)
            authorizations = auth_data.get("authorizations", [])
            auth_entry = next((a for a in authorizations if isinstance(a, dict) and a.get("request_id") == auth_req_id), None)
            if auth_entry:
                auth_id = auth_entry.get("authorization_id")
            elif authorizations:
                auth_id = authorizations[-1].get("authorization_id")
            else:
                auth_id = auth_req_id
        except Exception:
            auth_id = auth_req_id

        cmd_commit = [
            sys.executable, str(ROOT / "scripts/myrmex-git-local.py"),
            "commit",
            "--run-id", run_id,
            "--authorization-id", auth_id,
            "--repository-root", str(repo_root),
            "--message", commit_msg,
            "--candidate-diff-sha", diff_digest,
        ]

        proc_commit = subprocess.run(cmd_commit, cwd=str(repo_root), capture_output=True, text=True, env=env)
        if proc_commit.returncode != 0:
            raise RuntimeError(f"governed git commit failed (code {proc_commit.returncode}): {proc_commit.stderr}")

        try:
            committed_state = json.loads(proc_commit.stdout)
        except json.JSONDecodeError as exc:
            raise RuntimeError("governed git commit returned an invalid durable state receipt") from exc

        # Synchronize repository index to new HEAD
        run_argv(["git", "read-tree", "HEAD"], cwd=repo_root, env=env)

        new_head = run_argv(["git", "rev-parse", "HEAD"], cwd=repo_root, env=env).stdout.strip()
        return self._extract_local_commit_receipt(
            committed_state,
            authorization_id=auth_id,
            wuid=wuid,
            diff_digest=diff_digest,
            current_head=new_head,
        )

    @staticmethod
    def _extract_local_commit_receipt(
        state: dict[str, Any], *, authorization_id: str, wuid: str,
        diff_digest: str, current_head: str,
    ) -> dict[str, Any]:
        """Return only a confirmed receipt already persisted by myrmex-git-local."""
        matches = [
            operation for operation in state.get("pending_operations", [])
            if isinstance(operation, dict)
            and operation.get("kind") == "local_commit"
            and isinstance(operation.get("intent"), dict)
            and operation["intent"].get("authorization_id") == authorization_id
        ]
        if len(matches) != 1:
            raise RuntimeError("durable local_commit operation identity is missing or ambiguous")
        operation = matches[0]
        effect = operation.get("effect")
        receipt = operation.get("receipt")
        if operation.get("status") != "confirmed" or not isinstance(effect, dict) or not isinstance(receipt, dict):
            raise RuntimeError("durable local_commit operation is not confirmed with effect and receipt")
        if (
            receipt.get("status") not in {"SUCCESS", "CONFIRMED"}
            or receipt.get("authorization_id") != authorization_id
            or receipt.get("work_unit_id") != wuid
            or receipt.get("candidate_diff_sha") != diff_digest
            or receipt.get("commit_sha") != current_head
            or effect.get("authorization_id") != authorization_id
            or effect.get("work_unit_id") != wuid
            or effect.get("candidate_diff_sha") != diff_digest
            or effect.get("commit_sha") != current_head
            or effect.get("tree_sha") != receipt.get("tree_sha")
            or effect.get("branch") != receipt.get("branch")
            or effect.get("paths") != receipt.get("paths")
        ):
            raise RuntimeError("durable local_commit effect and receipt identity mismatch")
        return {"operation_id": operation["operation_id"], "parent_sha": effect.get("parent_sha"), **receipt}

    def recover_governed_commit_receipt(
        self, *, run_id: str, repo_root: Path, wuid: str, base_sha: str,
        branch: str, diff_digest: str, current_head: str, commit_message: str,
    ) -> dict[str, Any]:
        """Replay the local-commit helper to validate and recover its durable receipt."""
        env = os.environ.copy()
        proc_show = subprocess.run(
            [sys.executable, str(ROOT / "bin/myrmex-state"), "show", run_id, "--json"],
            capture_output=True, text=True, env=env,
        )
        if proc_show.returncode != 0:
            raise RuntimeError(f"failed to read myrmex-state run {run_id}: {proc_show.stderr}")
        state = json.loads(proc_show.stdout)
        operations = [
            operation for operation in state.get("pending_operations", [])
            if isinstance(operation, dict)
            and operation.get("kind") == "local_commit"
            and isinstance(operation.get("intent"), dict)
            and operation["intent"].get("work_unit_id") == wuid
            and operation["intent"].get("repository_root") == str(repo_root)
            and operation["intent"].get("branch") == branch
            and operation["intent"].get("expected_head") == base_sha
            and operation["intent"].get("candidate_diff_sha") == diff_digest
            and operation["intent"].get("commit_message") == commit_message
        ]
        if len(operations) != 1:
            raise RuntimeError("matching durable local_commit operation is missing or ambiguous")
        authorization_id = operations[0]["intent"].get("authorization_id")
        if not isinstance(authorization_id, str) or not authorization_id:
            raise RuntimeError("matching durable local_commit authorization identity is missing")
        if state.get("status") == "dormant":
            # The parent run can legitimately close after campaign evidence is
            # durable but before the campaign ledger reaches completed.  The
            # confirmed operation remains the authority; do not reopen or
            # mutate a terminal run merely to replay its helper.
            return self._extract_local_commit_receipt(
                state,
                authorization_id=authorization_id,
                wuid=wuid,
                diff_digest=diff_digest,
                current_head=current_head,
            )
        if state.get("status") != "active":
            raise RuntimeError(f"local_commit parent run has non-recoverable status {state.get('status')!r}")
        replay = subprocess.run(
            [
                sys.executable, str(ROOT / "scripts/myrmex-git-local.py"), "commit",
                "--run-id", run_id,
                "--authorization-id", authorization_id,
                "--repository-root", str(repo_root),
                "--message", commit_message,
                "--candidate-diff-sha", diff_digest,
            ],
            cwd=str(repo_root), capture_output=True, text=True, env=env,
        )
        if replay.returncode != 0:
            raise RuntimeError(f"durable local_commit replay failed: {replay.stderr}")
        try:
            replayed_state = json.loads(replay.stdout)
        except json.JSONDecodeError as exc:
            raise RuntimeError("durable local_commit replay returned invalid state") from exc
        return self._extract_local_commit_receipt(
            replayed_state,
            authorization_id=authorization_id,
            wuid=wuid,
            diff_digest=diff_digest,
            current_head=current_head,
        )

    @staticmethod
    def _bind_dispatch_context(wu: dict[str, Any], dispatch: dict[str, Any] | None) -> dict[str, Any]:
        if dispatch is None:
            return wu
        selected = dispatch["route_decision"]["selected"]
        # Keep persisted campaign JSON immutable: bind execution-only fields
        # to the invocation context passed to every driver phase.
        return {
            **wu,
            "campaign_id": dispatch["intent"]["campaign_id"],
            "implementing_agent": selected["agent"],
            "verifying_agent": "myrmex-verifier",
                "model": selected["model"],
                "provider": selected["provider"],
        }

    def run_work_unit(self, cid: str, data: dict[str, Any], wu: dict[str, Any], dispatch: dict[str, Any] | None = None) -> bool:
        """Executes the closed-loop autonomous cycle for one work unit with production drivers."""
        wu = self._bind_dispatch_context(wu, dispatch)
        wuid = wu["id"]
        repo_root = Path(data.get("repository_root") or os.getcwd()).resolve()
        agent_env = sanitized_agent_environment()
        sys.stdout.write(f"[myrmex-head] [{cid}] Starting hardened execution for {wuid}: {wu['objective']}\n")

        # 1. Base git SHA and branch capture
        base_sha = wu.get("base_sha")
        # Keep a non-empty parent branch even if fault injection terminates the
        # short-lived `git branch` child. A blank branch can be persisted in the
        # state-first run and later makes governed commit recovery impossible.
        branch = wu.get("branch") or data.get("branch") or "main"
        try:
            proc_branch = run_argv(["git", "branch", "--show-current"], cwd=repo_root, env=agent_env)
            if proc_branch.returncode == 0 and proc_branch.stdout.strip():
                branch = proc_branch.stdout.strip()
        except Exception:
            pass

        if not base_sha:
            try:
                proc = run_argv(["git", "rev-parse", "HEAD"], cwd=repo_root, env=agent_env)
                if proc.returncode == 0 and proc.stdout.strip():
                    base_sha = proc.stdout.strip()
            except Exception:
                base_sha = "0" * 40

        # 2. Initialize or recover durable myrmex-state run
        execution_policy = "auto"
        if dispatch is not None:
            selected_route = dispatch["route_decision"]["selected"]["route"]
            execution_policy = {"direct": "direct-only", "delegated": "delegated", "frontier": "frontier"}[selected_route]
        run_id = self.ensure_myrmex_state_run(cid, data, wu, str(repo_root), branch, base_sha, execution_policy)
        if dispatch is not None:
            self._attach_dispatch_run(cid, dispatch, run_id)

        # 3. Select execution driver
        try:
            driver = self.resolve_execution_driver(data, wu)
        except DriverPolicyViolation as e:
            self._block_wu(cid, wuid, "driver_policy_violation", str(e))
            return False

        current_head = run_argv(["git", "rev-parse", "HEAD"], cwd=repo_root, env=agent_env).stdout.strip()
        last_commit_msg = run_argv(["git", "log", "-1", "--format=%s"], cwd=repo_root, env=agent_env).stdout.strip()

        # 4. A crash can leave the campaign ledger at committing before any
        # commit effect, or at delivering after the effect. A pre-commit state
        # with complete receipts resumes from those receipts; legacy/incomplete
        # state rewinds only after proving that the expected commit is absent.
        # A matching commit is reconciled exclusively through the durable
        # local_commit operation, never by manufacturing a campaign receipt.
        recovering_committing = wu.get("phase") == "committing"
        expected_commit_present = (
            last_commit_msg.lower().startswith(f"feat({wuid.lower()}):")
            or (wu.get("commit_sha") and wu.get("commit_sha") == current_head)
            or (wu.get("candidate_sha") and wu.get("candidate_sha") == current_head)
        )
        no_op_recovery = bool(wu.get("no_op_allowed", False)) and wu.get("phase") in {"committing", "delivering"} and isinstance(wu.get("no_op_receipt"), dict)
        recovering_pre_commit = recovering_committing and not expected_commit_present and not no_op_recovery

        # A crash can leave the campaign ledger at delivering after the
        # commit effect, but before evidence recording/completion.  Keep that
        # persisted phase intact while resuming its validation path; the
        # campaign transition policy does not permit delivering -> collecting-context.
        recovering_delivering = wu.get("phase") == "delivering"
        recovering_active = wu.get("phase") in {"verifying", "remediating"}
        if not recovering_delivering and not recovering_committing and not recovering_active:
            self._transition_wu(cid, wuid, phase="collecting-context")
            self.sync_myrmex_state_phase(run_id, "collecting-context")

        already_committed = not no_op_recovery and (recovering_delivering or (recovering_committing and expected_commit_present) or (
            last_commit_msg.lower().startswith(f"feat({wuid.lower()}):") or
            (wu.get("commit_sha") and wu.get("commit_sha") == current_head) or
            (wu.get("candidate_sha") and wu.get("candidate_sha") == current_head)
        ))

        vcmds = wu.get("verification_commands", [])
        no_op_allowed = bool(wu.get("no_op_allowed", False))
        writer_receipt: dict[str, Any] | None = wu.get("writer_receipt") if recovering_pre_commit else None
        verifier_receipt: dict[str, Any] | None = wu.get("verifier_receipt") if recovering_pre_commit else None
        ci_operation: dict[str, Any] | None = wu.get("ci_operation") if recovering_pre_commit else None
        commit_receipt: dict[str, Any] | None = None
        correction_runs: list[dict[str, Any]] = list(wu.get("correction_runs", []))
        candidate_sha: str = current_head
        diff_digest: str = (wu.get("diff_digest") or "") if recovering_pre_commit else ""
        no_op_receipt = wu.get("no_op_receipt") if (no_op_recovery or recovering_pre_commit or recovering_delivering) else None

        if no_op_recovery:
            diff_digest = wu.get("diff_digest") or compute_candidate_diff_digest(repo_root, base_sha, [])
            validate_no_op_receipt(no_op_receipt, cid, wuid, base_sha, current_head, diff_digest, repo_root)
            persisted_writer_receipt = wu.get("writer_receipt")
            if isinstance(driver, OpenCodeTaskDriver):
                try:
                    writer_receipt = driver.recover_writer_receipt(wu, repo_root, run_id, agent_env)
                    self._validate_recovered_no_op_writer(
                        persisted_writer_receipt, writer_receipt, cid, wuid,
                        base_sha, current_head, diff_digest,
                    )
                except Exception as exc:
                    self._block_wu(
                        cid, wuid, "ambiguous_missing_receipt",
                        f"Durable no-op writer recovery failed closed: {exc}",
                    )
                    return False
            elif isinstance(driver, FixtureCommandDriver) and driver.allowed:
                # Explicit review-only fixture replay; no durable ledger is
                # claimed by this path.
                writer_receipt = persisted_writer_receipt
            else:
                self._block_wu(cid, wuid, "ambiguous_missing_receipt", "no-op recovery requires a recognized execution driver")
                return False
            verifier_receipt = wu.get("verifier_receipt")
            ci_operation = wu.get("ci_operation")
            candidate_sha = current_head
        elif recovering_pre_commit:
            modified_files = writer_receipt.get("files_modified", []) if isinstance(writer_receipt, dict) else []
            complete_pre_commit_receipts = (
                isinstance(writer_receipt, dict) and writer_receipt.get("status") == "SUCCESS"
                and isinstance(verifier_receipt, dict) and verifier_receipt.get("status") == "PASS"
                and isinstance(ci_operation, dict) and ci_operation.get("status") == "pass"
                and isinstance(modified_files, list)
                and re.fullmatch(r"[0-9a-f]{64}", diff_digest) is not None
            )
            if complete_pre_commit_receipts:
                try:
                    complete_pre_commit_receipts = (
                        compute_candidate_diff_digest(repo_root, base_sha, modified_files) == diff_digest
                    )
                except Exception:
                    complete_pre_commit_receipts = False
            if not complete_pre_commit_receipts:
                current_campaign = self.get_campaign_data(cid)
                recover_cmd = [
                    sys.executable, str(ROOT / "bin/myrmex-campaign"),
                    "wu-recover", cid, wuid,
                    "--from-phase", "committing",
                    "--resume-phase", "collecting-context",
                    "--reason", "no matching commit effect or complete pre-commit receipt set exists; safe replay",
                    "--pre-commit-absence-proven",
                    "--expect-revision", str(current_campaign["revision"]),
                ]
                recovered = subprocess.run(recover_cmd, capture_output=True, text=True)
                if recovered.returncode != 0:
                    self._block_wu(cid, wuid, "ambiguous_missing_receipt", f"pre-commit recovery failed: {recovered.stderr}")
                    return False
                data = self.get_campaign_data(cid)
                wu = next(item for item in data["work_units"] if item["id"] == wuid)
                recovering_pre_commit = False
                writer_receipt = None
                verifier_receipt = None
                ci_operation = None
                correction_runs = list(wu.get("correction_runs", []))
                diff_digest = ""

        if no_op_recovery:
            pass
        elif already_committed:
            sys.stdout.write(f"[myrmex-head] [{cid}] Work unit {wuid} already committed at {current_head[:8]}; resuming recovery verification.\n")
            tree_sha = run_argv(["git", "rev-parse", "HEAD^{tree}"], cwd=repo_root, env=agent_env).stdout.strip()
            writer_receipt = wu.get("writer_receipt")
            if not writer_receipt:
                # If writer receipt is missing on an already committed work unit and not verifiable from state ledger
                # Reject synthetic fabrication and block with ambiguous_missing_receipt
                sys.stderr.write(f"[myrmex-head] [{cid}] Unverifiable already-committed WU {wuid} lacks writer receipt in ledger\n")
                self._block_wu(
                    cid, wuid, "ambiguous_missing_receipt",
                    "Already-committed work unit lacks authoritative writer receipt in durable state ledger"
                )
                return False

            # The pre-commit candidate digest is intentionally computed over
            # staged tracked and untracked material.  Recomputing it after the
            # commit can produce different bytes for formerly-untracked files,
            # so recovery must validate the immutable commit receipt instead
            # of manufacturing a new digest or receipt.
            diff_digest = wu.get("diff_digest") or ""
            persisted_commit_receipt = wu.get("commit_receipt")
            try:
                commit_receipt = self.recover_governed_commit_receipt(
                    run_id=run_id,
                    repo_root=repo_root,
                    wuid=wuid,
                    base_sha=base_sha,
                    branch=branch,
                    diff_digest=diff_digest,
                    current_head=current_head,
                    commit_message=last_commit_msg,
                )
            except Exception as exc:
                self._block_wu(
                    cid, wuid, "ambiguous_missing_receipt",
                    f"Already-committed work unit has no replayable immutable local_commit receipt: {exc}",
                )
                return False
            if persisted_commit_receipt is not None and persisted_commit_receipt != commit_receipt:
                self._block_wu(
                    cid, wuid, "ambiguous_missing_receipt",
                    "Persisted campaign commit receipt differs from the immutable local_commit receipt",
                )
                return False
            if (
                commit_receipt.get("commit_sha") != current_head
                or commit_receipt.get("tree_sha") != tree_sha
                or commit_receipt.get("message") != last_commit_msg
                or commit_receipt.get("candidate_diff_sha") != diff_digest
                or commit_receipt.get("work_unit_id") != wuid
                or commit_receipt.get("branch") != branch
                or sorted(commit_receipt.get("paths", [])) != sorted(writer_receipt.get("files_modified", []))
                or not re.fullmatch(r"[0-9a-f]{64}", diff_digest)
            ):
                self._block_wu(
                    cid, wuid, "ambiguous_missing_receipt",
                    "Already-committed work unit lacks a matching immutable commit receipt",
                )
                return False
            candidate_sha = commit_receipt["commit_sha"]

            # For verifier receipt: if missing, rerun verifier for real evidence
            verifier_receipt = wu.get("verifier_receipt")
            if not verifier_receipt:
                try:
                    verifier_receipt = driver.execute_verifier(wu, repo_root, run_id, agent_env)
                except Exception as e:
                    self._block_wu(cid, wuid, "unknown", f"Recovery verifier execution failed: {e}")
                    return False

            # For CI operation: if missing, rerun CI for real evidence
            ci_operation = wu.get("ci_operation")
            if not ci_operation:
                ci_operation = driver.execute_ci(wu, repo_root, run_id, agent_env)

        elif recovering_pre_commit:
            try:
                commit_receipt = self.produce_governed_commit(
                    run_id=run_id, repo_root=repo_root, wuid=wuid,
                    objective=wu["objective"], base_sha=base_sha,
                    modified_files=writer_receipt.get("files_modified", []),
                    diff_digest=diff_digest, cid=cid,
                )
            except Exception as e:
                self._block_wu(cid, wuid, "unknown", f"Governed git commit recovery failed: {e}")
                return False
            candidate_sha = commit_receipt["commit_sha"]

        else:
            if recovering_active:
                # The writer already completed before this active phase was
                # persisted. Reuse its evidence rather than dispatching it again.
                remediation_attempt, verifier_attempt = OpenCodeTaskDriver.active_recovery_attempts(
                    wu.get("phase"), wu.get("corrections_used", 0)
                )
                if isinstance(driver, OpenCodeTaskDriver):
                    verifier_attempt = driver.verifier_attempt_after_infrastructure_failure(
                        run_id, wuid, verifier_attempt
                    )
                try:
                    if not hasattr(driver, "recover_active_receipts"):
                        raise ExecutionDriverError("active recovery requires an OpenCodeTaskDriver")
                    writer_receipt = driver.recover_writer_receipt(wu, repo_root, run_id, agent_env)
                    verifier_receipt = None
                    if wu.get("phase") == "remediating":
                        _, verifier_receipt = driver.recover_active_receipts(wu, repo_root, run_id, agent_env, remediation_attempt)
                except Exception as e:
                    self._block_wu(cid, wuid, "ambiguous_missing_receipt", f"Active recovery evidence unavailable: {e}")
                    return False
                corrections_used = wu.get("corrections_used", 0)
            else:
                # 5. Transition to implementing
                self._transition_wu(cid, wuid, phase="implementing", base_sha=base_sha)
                self.sync_myrmex_state_phase(run_id, "implementing")

                # 6. Execute Writer via Driver
                try:
                    writer_receipt = driver.execute_writer(wu, base_sha, repo_root, run_id, agent_env)
                except ScopeViolationError as e:
                    self._block_wu(cid, wuid, "out_of_scope_mutation", str(e))
                    return False
                except DriverPolicyViolation as e:
                    self._block_wu(cid, wuid, "driver_policy_violation", str(e))
                    return False
                except Exception as e:
                    self._block_wu(cid, wuid, "unknown", f"Writer execution failed: {e}")
                    return False
                corrections_used = wu.get("corrections_used", 0)
            corrections_budget = wu.get("corrections_budget", 3)
            if not recovering_active:
                verifier_attempt = corrections_used + 1

            # Complete a remediation that was in flight when the supervisor
            # stopped, then begin the next distinct verification cycle.
            if recovering_active and wu.get("phase") == "remediating":
                try:
                    corr_record = driver.execute_remediation(
                        wu, (verifier_receipt or {}).get("defects", []), remediation_attempt,
                        repo_root, run_id, agent_env,
                    )
                    correction_runs.append(corr_record)
                    corrections_used = max(corrections_used, remediation_attempt)
                    self._transition_wu(cid, wuid, correction_runs=correction_runs, corrections_used=corrections_used)
                except Exception as e:
                    self._block_wu(cid, wuid, "unknown", f"Remediation recovery error: {e}")
                    return False

            resume_current_verifier = recovering_active and wu.get("phase") == "verifying"
            while True:
                if not resume_current_verifier:
                    self._transition_wu(cid, wuid, phase="verifying")
                    self.sync_myrmex_state_phase(run_id, "verifying")
                resume_current_verifier = False

                try:
                    verifier_receipt = driver.execute_verifier(wu, repo_root, run_id, agent_env, verifier_attempt)
                except VerifierWorkspaceMutationError as e:
                    self._block_wu(cid, wuid, "verifier_workspace_mutation", str(e))
                    return False
                except Exception as e:
                    self._block_wu(cid, wuid, "unknown", f"Verifier execution error: {e}")
                    return False

                if verifier_receipt["status"] == "PASS":
                    break

                # Failed verification -> Remediation
                corrections_used += 1
                verifier_attempt += 1
                if corrections_used > corrections_budget:
                    self._block_wu(
                        cid, wuid, "budget_exhausted",
                        f"corrections budget exhausted ({corrections_used}/{corrections_budget})"
                    )
                    return False

                self._transition_wu(cid, wuid, phase="remediating")
                self.sync_myrmex_state_phase(run_id, "implementing")

                try:
                    corr_record = driver.execute_remediation(
                        wu, verifier_receipt.get("defects", []), corrections_used, repo_root, run_id, agent_env
                    )
                    correction_runs.append(corr_record)
                    # Persist the remediation receipt before another verifier,
                    # CI, or commit can advance.  Otherwise a crash after the
                    # commit effect can recover a valid commit with incomplete
                    # correction evidence.
                    self._transition_wu(
                        cid, wuid,
                        correction_runs=correction_runs,
                        corrections_used=corrections_used,
                    )
                except Exception as e:
                    self._block_wu(cid, wuid, "unknown", f"Remediation error: {e}")
                    return False

            # 8. Transition to running-ci
            self._transition_wu(cid, wuid, phase="running-ci")
            ci_operation = driver.execute_ci(wu, repo_root, run_id, agent_env)
            if ci_operation["status"] != "pass":
                self._block_wu(
                    cid, wuid, "ci_failed",
                    f"CI command failed with exit code {ci_operation.get('exit_code')}: {ci_operation.get('stderr', '')}"
                )
                return False

            modified_files = writer_receipt.get("files_modified", [])
            if not no_op_allowed and not modified_files:
                self._block_wu(cid, wuid, "unknown", "Diff against base SHA is empty and no-op is not allowed")
                return False
            diff_digest = compute_candidate_diff_digest(repo_root, base_sha, modified_files)
            if no_op_allowed and not modified_files:
                no_op_receipt = deterministic_no_op_receipt(cid, wuid, base_sha, current_head, diff_digest)

            # 9. Persist every pre-commit receipt before entering the effect
            # boundary.  Recovery can then resume or validate the governed
            # commit without repeating writer/verifier/CI effects.
            self._transition_wu(
                cid, wuid,
                phase="committing",
                base_sha=base_sha,
                diff_digest=diff_digest,
                writer_receipt=writer_receipt,
                verifier_receipt=verifier_receipt,
                ci_op=ci_operation,
                no_op_receipt=no_op_receipt,
                correction_runs=correction_runs,
                corrections_used=len(correction_runs),
            )
            self.sync_myrmex_state_phase(run_id, "committing")

            try:
                if no_op_allowed and not modified_files:
                    commit_receipt = None
                    candidate_sha = current_head
                else:
                    commit_receipt = self.produce_governed_commit(
                    run_id=run_id,
                    repo_root=repo_root,
                    wuid=wuid,
                    objective=wu["objective"],
                    base_sha=base_sha,
                    modified_files=modified_files,
                    diff_digest=diff_digest,
                    cid=cid,
                    )
            except Exception as e:
                self._block_wu(cid, wuid, "unknown", f"Governed git commit failed: {e}")
                return False

            if commit_receipt is not None:
                candidate_sha = commit_receipt["commit_sha"]

        # 10. Delivering Phase.  Recovery is already persisted at this phase;
        # repeating the transition is rejected by the campaign state machine.
        if not recovering_delivering:
            self._transition_wu(
                cid, wuid,
                phase="delivering",
                commit_sha=None if no_op_receipt else candidate_sha,
                base_sha=base_sha,
                candidate_sha=candidate_sha,
                diff_digest=diff_digest,
                writer_receipt=writer_receipt,
                verifier_receipt=verifier_receipt,
                ci_op=ci_operation,
                commit_receipt=commit_receipt,
                correction_runs=correction_runs,
                corrections_used=len(correction_runs),
            )

        # 11. Strict Invariant Validation Gate (Rule 9)
        assert writer_receipt is not None and writer_receipt.get("status") == "SUCCESS", "Writer receipt missing or failed"
        assert verifier_receipt is not None and verifier_receipt.get("status") == "PASS", "Verifier receipt missing or failed"
        assert ci_operation is not None and ci_operation.get("status") == "pass", "CI operation missing or failed"
        assert diff_digest is not None and len(diff_digest) == 64, "Diff digest invalid"
        assert candidate_sha is not None and len(candidate_sha) >= 7, "Candidate SHA invalid"

        # 12. Assemble & Record Authoritative Evidence Bundle
        evidence = {
            "campaign_id": cid,
            "work_unit_id": wuid,
            "run_id": run_id,
            "objective": wu["objective"],
            "scope": wu.get("scope", []),
            "issue": wu.get("issue"),
            "base_sha": base_sha,
            "candidate_sha": candidate_sha,
            "diff_digest": diff_digest,
            "writer_receipt": writer_receipt,
            "candidate_diff": {
                "base_sha": base_sha,
                "candidate_sha": candidate_sha,
                "diff_digest": diff_digest,
                "files": writer_receipt.get("files_modified", []),
            },
            "verifier_receipt": verifier_receipt,
            "defect_set": verifier_receipt.get("defects", []),
            "correction_runs": correction_runs,
            "ci_operation": ci_operation,
            "commit_receipt": commit_receipt,
            "no_op_receipt": no_op_receipt,
            "implementing_agent": writer_receipt.get("agent", "myrmex-worker"),
            "verifying_agent": verifier_receipt.get("agent", "myrmex-verifier"),
            "verification_commands_run": verifier_receipt.get("commands_run", []),
            "verification_results": verifier_receipt.get("results", []),
            "ci_result": ci_operation.get("status", "pass"),
            "ci_summary": f"CI command executed: {ci_operation.get('command')}",
            "commit_sha": None if no_op_receipt else candidate_sha,
            "pr_number": wu.get("pr_number"),
            "pr_url": wu.get("pr_url"),
            "external_receipts": [],
            "completed_at": utcnow(),
        }
        if recovering_delivering and isinstance(wu.get("evidence"), dict):
            persisted_evidence = wu["evidence"]
            required_identity = {
                "campaign_id": cid,
                "work_unit_id": wuid,
                "run_id": run_id,
                "base_sha": base_sha,
                "candidate_sha": candidate_sha,
                "diff_digest": diff_digest,
                "commit_sha": None if no_op_receipt else candidate_sha,
                "no_op_receipt": no_op_receipt,
            }
            mismatched_identity = [
                key for key, value in required_identity.items()
                if persisted_evidence.get(key) != value
            ]
            if mismatched_identity:
                self._block_wu(
                    cid, wuid, "ambiguous_missing_receipt",
                    "Persisted recovery evidence does not match committed identity fields: "
                    + ", ".join(mismatched_identity),
                )
                return False
            evidence = persisted_evidence

        with tempfile.NamedTemporaryFile("w", encoding="utf-8", suffix=".json", delete=False) as tf:
            json.dump(evidence, tf, indent=2)
            ev_path = tf.name

        try:
            cmd = [
                sys.executable, str(ROOT / "bin/myrmex-campaign"),
                "evidence-record", cid, wuid,
                "--evidence-file", ev_path
            ]
            subprocess.run(cmd, check=True, capture_output=True, text=True)

            # 13. Complete durable state run & transition work unit to completed
            state_completed = self.complete_myrmex_state_run(
                run_id, wuid, ev_path, f"Work unit {wuid} completed in campaign {cid}",
            )
        finally:
            Path(ev_path).unlink(missing_ok=True)
        if not state_completed:
            self._block_wu(
                cid, wuid, "ambiguous_missing_receipt",
                "Campaign evidence is durable but the matching myrmex-state completion could not be confirmed",
            )
            return False
        self._transition_wu(cid, wuid, phase="completed", status="completed")
        outcome = "unchanged candidate/no-op" if no_op_receipt else f"commit {candidate_sha[:8]}"
        sys.stdout.write(f"[myrmex-head] [{cid}] Work unit {wuid} COMPLETED successfully with {outcome}.\n")
        return True

    def _transition_wu(
        self,
        cid: str,
        wuid: str,
        phase: str | None = None,
        status: str | None = None,
        commit_sha: str | None = None,
        base_sha: str | None = None,
        candidate_sha: str | None = None,
        diff_digest: str | None = None,
        no_op_receipt: dict[str, Any] | None = None,
        run_id: str | None = None,
        writer_receipt: dict[str, Any] | None = None,
        verifier_receipt: dict[str, Any] | None = None,
        ci_op: dict[str, Any] | None = None,
        commit_receipt: dict[str, Any] | None = None,
        correction_runs: list[dict[str, Any]] | None = None,
        corrections_used: int | None = None,
        pr_number: int | None = None,
    ) -> None:
        cmd = [sys.executable, str(ROOT / "bin/myrmex-campaign"), "wu-transition", cid, wuid]
        if phase:
            cmd.extend(["--phase", phase])
        if status:
            cmd.extend(["--status", status])
        if commit_sha:
            cmd.extend(["--commit-sha", commit_sha])
        if base_sha:
            cmd.extend(["--base-sha", base_sha])
        if candidate_sha:
            cmd.extend(["--candidate-sha", candidate_sha])
        if diff_digest:
            cmd.extend(["--diff-digest", diff_digest])
        if run_id:
            cmd.extend(["--run-id", run_id])
        if pr_number is not None:
            cmd.extend(["--pr-number", str(pr_number)])

        if writer_receipt is not None:
            cmd.extend(["--writer-receipt", json.dumps(writer_receipt)])
        if verifier_receipt is not None:
            cmd.extend(["--verifier-receipt", json.dumps(verifier_receipt)])
        if ci_op is not None:
            cmd.extend(["--ci-op", json.dumps(ci_op)])
        if commit_receipt is not None:
            cmd.extend(["--commit-receipt", json.dumps(commit_receipt)])
        if no_op_receipt is not None:
            cmd.extend(["--no-op-receipt", json.dumps(no_op_receipt)])
        if correction_runs is not None:
            cmd.extend(["--correction-runs", json.dumps(correction_runs)])
        if corrections_used is not None:
            cmd.extend(["--corrections-used", str(corrections_used)])

        try:
            subprocess.run(cmd, check=True, capture_output=True, text=True)
        except subprocess.CalledProcessError as e:
            sys.stderr.write(f"wu-transition failed (code {e.returncode}):\nSTDOUT: {e.stdout}\nSTDERR: {e.stderr}\n")
            raise

    def _block_wu(self, cid: str, wuid: str, blocker_type: str, message: str) -> None:
        sys.stderr.write(f"[myrmex-head] [{cid}] Blocking WU {wuid}: {blocker_type} - {message}\n")
        cmd = [
            sys.executable, str(ROOT / "bin/myrmex-campaign"),
            "blocker-add", cid,
            "--type", blocker_type,
            "--message", message,
            "--wu-id", wuid
        ]
        subprocess.run(cmd, check=True, capture_output=True, text=True)

    def process_campaign(self, cid: str) -> bool:
        """Processes one step of a campaign. Returns True if progress was made."""
        if not self.acquire_lease(cid):
            sys.stdout.write(f"[myrmex-head] [{cid}] Skipped: could not acquire lease (held by another supervisor)\n")
            return False

        try:
            self.reconcile_campaign(cid)
            data = self.get_campaign_data(cid)

            if data["status"] != "active":
                sys.stdout.write(f"[myrmex-head] [{cid}] Campaign is {data['status']}; no action needed.\n")
                return False

            active_wuid = data.get("active_work_unit")
            if not active_wuid:
                active_cand = next((w for w in data.get("work_units", []) if w["status"] == "active"), None)
                if active_cand:
                    active_wuid = active_cand["id"]

            if active_wuid:
                wu = next((w for w in data["work_units"] if w["id"] == active_wuid), None)
                if wu and wu["status"] not in {"completed", "blocked", "failed", "cancelled"}:
                    try:
                        plan_id = self._p1_plan_id(data)
                        dispatch = self._resume_p1_dispatch(cid, data, wu) if plan_id is not None else None
                    except SequentialSchedulerError as exc:
                        sys.stderr.write(f"[myrmex-head] [{cid}] P1 dispatch recovery blocked: {exc}\n")
                        return False
                    self.heartbeat_lease(cid)
                    return self.run_work_unit(cid, data, wu, dispatch)

            try:
                p1_dispatch = self._prepare_p1_dispatch(cid, data)
            except SequentialSchedulerError as exc:
                sys.stderr.write(f"[myrmex-head] [{cid}] P1 scheduling blocked without FIFO fallback: {exc}\n")
                return False
            if p1_dispatch is not None:
                if p1_dispatch.get("no_eligible"):
                    sys.stdout.write(f"[myrmex-head] [{cid}] P1 policy found no eligible work unit; FIFO fallback is disabled.\n")
                    return False
                self.heartbeat_lease(cid)
                return self.run_work_unit(cid, p1_dispatch["data"], p1_dispatch["wu"], p1_dispatch)

            cmd_dag = [sys.executable, str(ROOT / "bin/myrmex-campaign"), "dag", cid]
            proc = subprocess.run(cmd_dag, capture_output=True, text=True)
            if proc.returncode != 0:
                sys.stderr.write(f"[myrmex-head] [{cid}] DAG check error: {proc.stderr}\n")
                return False

            dag_info = json.loads(proc.stdout)
            ready_ids = dag_info.get("ready_work_units", [])
            if not ready_ids:
                sys.stdout.write(f"[myrmex-head] [{cid}] No ready work units at this time.\n")
                all_wu = data.get("work_units", [])
                if all_wu and all(w["status"] == "completed" for w in all_wu):
                    self.reconcile_campaign(cid)
                    sys.stdout.write(f"[myrmex-head] [{cid}] All work units completed! Campaign marked complete.\n")
                return False

            next_wuid = ready_ids[0]
            next_wu = next((w for w in data["work_units"] if w["id"] == next_wuid), None)
            if not next_wu:
                return False

            self.heartbeat_lease(cid)
            return self.run_work_unit(cid, data, next_wu)

        finally:
            if self.once:
                self.release_lease(cid)

    def run(self) -> int:
        sys.stdout.write(f"[myrmex-head] Starting supervisor (pid={self.pid}, host={self.hostname}, once={self.once})\n")
        try:
            while self.running:
                campaign_ids = self.get_campaign_ids()
                if not campaign_ids:
                    if self.once:
                        sys.stdout.write("[myrmex-head] No active campaigns found.\n")
                        break
                    time.sleep(self.poll_interval)
                    continue

                for cid in campaign_ids:
                    if not self.running:
                        break
                    try:
                        self.process_campaign(cid)
                    except Exception as e:
                        sys.stderr.write(f"[myrmex-head] Error processing campaign {cid}: {e}\n")

                if self.once:
                    break

                for _ in range(self.poll_interval * 10):
                    if not self.running:
                        break
                    time.sleep(0.1)

        finally:
            sys.stdout.write("[myrmex-head] Releasing held leases...\n")
            self.release_all_leases()
            sys.stdout.write("[myrmex-head] Supervisor stopped cleanly.\n")

        return 0


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description="Persistent Myrmex Campaign Supervisor")
    parser.add_argument("--once", action="store_true", help="Run a single reconciliation/dispatch cycle and exit")
    parser.add_argument("--campaign-id", help="Target specific campaign ID")
    parser.add_argument("--interval", type=int, default=5, help="Polling interval in seconds (default: 5)")
    parser.add_argument("--state-home", help="Custom XDG_STATE_HOME path")
    parser.add_argument("--allow-fixture-driver", action="store_true", help="Allow FixtureCommandDriver execution for testing")
    parser.add_argument("--route-model-policy", help="Explicit P1 route/model policy JSON (required for plan-bound campaigns)")
    parser.add_argument("--route-model-availability", help="Explicit P1 agent/provider/model availability JSON (required for plan-bound campaigns)")
    args = parser.parse_args(argv)

    supervisor = CampaignSupervisor(
        campaign_id=args.campaign_id,
        poll_interval=args.interval,
        once=args.once,
        state_home=args.state_home,
        allow_fixture_driver=args.allow_fixture_driver,
        route_model_policy_path=args.route_model_policy,
        route_model_availability_path=args.route_model_availability,
    )
    return supervisor.run()


if __name__ == "__main__":
    raise SystemExit(main())
