{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:myrmex:schema:planning-request:v1",
  "title": "Myrmex Planning Request v1",
  "description": "A planning request from the orchestrator to a planner. A planning request never authorizes repository effects: the effect_policy block pins every authority flag to false and the mode to planning_only. Canonical digest rules: every SHA-256 digest (input_digests[].sha256, parent_revision.artifact_digest) is computed over the canonical serialized artifact using UTF-8, LF line endings, deterministic key ordering for structured fields, and no insignificant trailing whitespace.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "request_id",
    "run_id",
    "campaign_id",
    "objective_id",
    "base_sha",
    "parent_revision",
    "input_digests",
    "constraints",
    "required_output_schema",
    "effect_policy",
    "created_at"
  ],
  "properties": {
    "schema": {
      "const": "myrmex.planning-request/v1"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "Exact, unique planning request identity."
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "Exact run identity that issued the planning request."
    },
    "campaign_id": {
      "type": "string",
      "pattern": "^camp-[a-z0-9][a-z0-9-]{4,60}$"
    },
    "objective_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "base_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "description": "Repository base commit SHA the planning request is grounded in."
    },
    "parent_revision": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["artifact_id", "artifact_digest"],
      "properties": {
        "artifact_id": {
          "type": "string"
        },
        "artifact_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "description": "Plan revision this request should build on, or null."
    },
    "input_digests": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "identity", "sha256"],
        "properties": {
          "kind": {
            "type": "string"
          },
          "identity": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "description": "Non-empty, unique set of exact input digests the planning request binds to."
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_paths", "forbidden_paths", "required_invariants", "required_sections"],
      "properties": {
        "allowed_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "forbidden_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "required_invariants": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "required_sections": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "required_output_schema": {
      "const": "myrmex.planning-result/v1",
      "description": "The only accepted planning result contract for this request."
    },
    "effect_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "repository_write", "activate_plan", "commit", "push", "merge", "release", "deploy"],
      "properties": {
        "mode": {
          "const": "planning_only"
        },
        "repository_write": {
          "const": false
        },
        "activate_plan": {
          "const": false
        },
        "commit": {
          "const": false
        },
        "push": {
          "const": false
        },
        "merge": {
          "const": false
        },
        "release": {
          "const": false
        },
        "deploy": {
          "const": false
        }
      },
      "description": "Bounded authority: planning only. Every effect flag is pinned false."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
