{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:myrmex:schema:work-order:v1",
  "title": "Myrmex Work Order v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "objective",
    "repository_root",
    "base_sha",
    "scope",
    "acceptance_criteria",
    "verification",
    "git_policy"
  ],
  "properties": {
    "schema": {
      "const": "myrmex.work-order/v1"
    },
    "run_id": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "non_goals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "repository_root": {
      "type": "string",
      "minLength": 1
    },
    "branch": {
      "type": [
        "string",
        "null"
      ]
    },
    "base_sha": {
      "type": "string",
      "minLength": 4
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_paths",
        "forbidden_paths",
        "preexisting_dirty_paths"
      ],
      "properties": {
        "allowed_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "forbidden_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "preexisting_dirty_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository_findings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "known_risks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "relevant_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "skills_to_load": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "commands",
        "discover_when_missing"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "discover_when_missing": {
          "type": "boolean"
        },
        "manual_checks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "git_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "push"
      ],
      "properties": {
        "commit": {
          "const": false
        },
        "push": {
          "const": false
        }
      }
    },
    "diff_metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "files",
        "additions",
        "deletions",
        "changed_lines"
      ],
      "properties": {
        "files": {
          "type": "integer",
          "minimum": 0
        },
        "additions": {
          "type": "integer",
          "minimum": 0
        },
        "deletions": {
          "type": "integer",
          "minimum": 0
        },
        "changed_lines": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "size_exception": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "cohesion",
        "review_strategy"
      ],
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "cohesion": {
          "type": "string",
          "minLength": 1
        },
        "review_strategy": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
