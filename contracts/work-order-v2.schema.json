{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:myrmex:schema:work-order:v2",
  "title": "Myrmex Plan-Compiled Work Order v2",
  "description": "A deterministic execution work order compiled from one reviewed immutable plan WU. It carries exact plan, review, and normalized-backlog provenance but grants no commit or push authority. work_order_digest is the canonical SHA-256 digest excluding work_order_id and work_order_digest; work_order_id is 'wo_' plus that digest.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "work_order_id", "work_order_digest", "campaign_id", "work_unit_id",
    "plan_provenance", "backlog_provenance", "objective", "non_goals", "dependencies",
    "repository_root", "base_sha", "scope", "acceptance_criteria", "verification",
    "risk_class", "required_route", "human_gates", "expected_evidence", "terminal_gate",
    "git_policy", "no_op_allowed"
  ],
  "properties": {
    "schema": {"const": "myrmex.work-order/v2"},
    "work_order_id": {"type": "string", "pattern": "^wo_[0-9a-f]{64}$"},
    "work_order_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "campaign_id": {"type": "string", "pattern": "^camp-[a-z0-9][a-z0-9-]{4,60}$"},
    "work_unit_id": {"type": "string", "pattern": "^WU-[A-Z0-9][A-Z0-9-]{0,30}$"},
    "plan_provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["plan_revision_id", "reviewed_record_id", "plan_digest", "record_digest", "review_digest"],
      "properties": {
        "plan_revision_id": {"type": "string", "pattern": "^plan_[0-9a-f]{64}$"},
        "reviewed_record_id": {"type": "string", "pattern": "^planrec_[0-9a-f]{64}$"},
        "plan_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "record_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "review_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "backlog_provenance": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["snapshot_record_id", "backlog_item_id", "item_digest", "source_adapter", "source_entity_id"],
        "properties": {
          "snapshot_record_id": {"type": "string", "pattern": "^blsnaprec_[0-9a-f]{64}$"},
          "backlog_item_id": {"type": "string", "pattern": "^backlog_[0-9a-f]{64}$"},
          "item_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "source_adapter": {"enum": ["local-markdown-roadmap/v1", "github-issues-milestones/v1"]},
          "source_entity_id": {"type": "string", "pattern": "^(?:srcitem_|ghissue_)[0-9a-f]{64}$"}
        }
      }
    },
    "objective": {"type": "string", "minLength": 1},
    "non_goals": {"type": "array", "items": {"type": "string"}},
    "dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^WU-[A-Z0-9][A-Z0-9-]{0,30}$"}},
    "repository_root": {"type": "string", "minLength": 1},
    "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["allowed_paths", "forbidden_paths", "preexisting_dirty_paths"],
      "properties": {
        "allowed_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "forbidden_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "preexisting_dirty_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "verification": {
      "type": "object", "additionalProperties": false,
      "required": ["commands", "manual_checks", "discover_when_missing"],
      "properties": {
        "commands": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "manual_checks": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "discover_when_missing": {"type": "boolean"}
      }
    },
    "risk_class": {"enum": ["bounded", "unbounded"]},
    "required_route": {"enum": ["auto", "direct-only", "delegated", "frontier", "frontier-gated"]},
    "human_gates": {"type": "array", "items": {"type": "object"}},
    "expected_evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "terminal_gate": {"type": "string", "minLength": 1},
    "no_op_allowed": {"type": "boolean", "default": false},
    "git_policy": {
      "type": "object", "additionalProperties": false, "required": ["commit", "push"],
      "properties": {"commit": {"const": false}, "push": {"const": false}}
    }
  }
}
