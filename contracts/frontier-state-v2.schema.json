{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:myrmex:schema:frontier-state:v2",
  "title": "Myrmex Frontier State v2",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "schema_version",
    "run_id",
    "objective_id",
    "objective",
    "parent_objective",
    "scope",
    "mode",
    "phase",
    "status",
    "repository_root",
    "branch",
    "base_sha",
    "protected_dirty_paths",
    "commit_policy",
    "push_policy",
    "frontier_chat_url",
    "frontier_task_id",
    "last_request_id",
    "last_outbound_digest",
    "last_response_digest",
    "plan_revision",
    "worker_task_id",
    "verification_revision",
    "commit_sha",
    "push_status",
    "execution",
    "blocker",
    "budgets",
    "receipts",
    "pending_operations",
    "revision",
    "created_at",
    "updated_at",
    "delegation_ledger",
    "attempts",
    "defect_history",
    "no_progress_cycles",
    "active_work_unit_id",
    "work_units",
    "remediation",
    "authorizations"
  ],
  "properties": {
    "schema": {
      "const": "myrmex.frontier-state/v2"
    },
    "schema_version": {
      "const": 2
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
    },
    "objective_id": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "parent_objective": {
      "type": [
        "string",
        "null"
      ]
    },
    "scope": {
      "enum": [
        "narrow",
        "continuous"
      ]
    },
    "mode": {
      "enum": [
        "interactive",
        "autonomous"
      ]
    },
    "phase": {
      "enum": [
        "initializing",
        "collecting-context",
        "requesting-plan",
        "waiting-for-frontier",
        "reviewing-plan",
        "implementing",
        "verifying",
        "reporting",
        "parent-gate",
        "committing",
        "pushing",
        "blocked",
        "dormant",
        "failed",
        "cancelled",
        "superseded",
        "waiting-for-delegations",
        "collecting-delegation-results",
        "consolidating-evidence",
        "proceeding-to-next-gate"
      ]
    },
    "status": {
      "enum": [
        "active",
        "blocked",
        "dormant",
        "failed",
        "cancelled",
        "superseded"
      ]
    },
    "repository_root": {
      "type": "string",
      "minLength": 1
    },
    "artifact_root": {
      "type": "string",
      "minLength": 1,
      "pattern": "^/"
    },
    "branch": {
      "type": [
        "string",
        "null"
      ]
    },
    "base_sha": {
      "type": [
        "string",
        "null"
      ]
    },
    "protected_dirty_paths": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "commit_policy": {
      "enum": [
        "deny",
        "ask",
        "authorized"
      ]
    },
    "push_policy": {
      "enum": [
        "deny",
        "ask",
        "authorized"
      ]
    },
    "frontier_chat_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "frontier_task_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "last_request_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "last_outbound_digest": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "last_response_digest": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "plan_revision": {
      "type": "integer",
      "minimum": 0
    },
    "worker_task_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "verification_revision": {
      "type": "integer",
      "minimum": 0
    },
    "commit_sha": {
      "type": [
        "string",
        "null"
      ]
    },
    "push_status": {
      "enum": [
        "not_requested",
        "unauthorized",
        "pending",
        "pushed",
        "failed"
      ]
    },
    "execution": {
      "type": "object",
      "required": [
        "requested_policy",
        "effective_route",
        "authority",
        "request_id",
        "set_at",
        "locked"
      ],
      "properties": {
        "requested_policy": {
          "enum": [
            "auto",
            "direct-only",
            "delegated",
            "frontier"
          ]
        },
        "effective_route": {
          "enum": [
            "auto",
            "direct",
            "delegated",
            "frontier"
          ]
        },
        "authority": {
          "type": "string",
          "minLength": 1
        },
        "request_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "set_at": {
          "type": "string",
          "format": "date-time"
        },
        "locked": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "blocker": {
      "type": [
        "string",
        "null"
      ]
    },
    "budgets": {
      "type": "object",
      "required": [
        "max_wait_seconds",
        "max_plan_iterations",
        "max_corrections_per_work_unit",
        "max_total_corrections",
        "max_failover_chats"
      ],
      "properties": {
        "max_wait_seconds": {
          "type": "integer",
          "minimum": 30
        },
        "max_plan_iterations": {
          "type": "integer",
          "minimum": 1
        },
        "max_failover_chats": {
          "type": "integer",
          "minimum": 0
        },
        "max_corrections_per_work_unit": {
          "type": "integer",
          "minimum": 0
        },
        "max_total_corrections": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "receipts": {
      "type": "object"
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "memory_status": {
      "enum": [
        "available",
        "degraded",
        "unavailable"
      ]
    },
    "delegation_ledger": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "agent",
          "role",
          "reason",
          "attempt",
          "started_at",
          "status"
        ],
        "properties": {
          "agent": {
            "type": "string"
          },
          "role": {
            "enum": [
              "scout",
              "writer",
              "verifier"
            ]
          },
          "reason": {
            "type": "string"
          },
          "task_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "work_unit_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "attempt": {
            "type": "integer",
            "minimum": 1
          },
          "started_at": {
            "type": "string"
          },
          "completed_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "enum": [
              "started",
              "success",
              "failed",
              "blocked",
              "cancelled"
            ]
          },
          "outcome": {
            "enum": [
              "STARTED",
              "SUCCESS",
              "FAILED",
              "BLOCKED",
              "CANCELLED",
              "CREDENTIAL_NOT_VISIBLE_TO_ORCHESTRATOR",
              "PROVIDER_INVOCATION_FAILED",
              "AGENT_MODEL_UNRESOLVED",
              "AGENT_NOT_INSTALLED"
            ]
          },
          "evidence": {},
          "correction": {
            "type": "object",
            "required": [
              "work_unit_id",
              "work_unit_attempt",
              "source_request_id",
              "verification_request_id",
              "scope_digest",
              "source_candidate_sha",
              "defect_revision",
              "grant_id"
            ],
            "properties": {
              "work_unit_id": {
                "type": "string"
              },
              "work_unit_attempt": {
                "type": "integer",
                "minimum": 1
              },
              "source_request_id": {
                "type": "string"
              },
              "verification_request_id": {
                "type": "string"
              },
              "scope_digest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "source_candidate_sha": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{7,64}$"
              },
              "defect_revision": {
                "type": "integer",
                "minimum": 0
              },
              "grant_id": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          },
          "workspace": {
            "type": [
              "string",
              "null"
            ]
          },
          "operation_id": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^op-[0-9a-f]{24}$"
          }
        }
      }
    },
    "attempts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scouts",
        "writers",
        "verifiers",
        "corrections"
      ],
      "properties": {
        "scouts": {
          "type": "integer",
          "minimum": 0
        },
        "writers": {
          "type": "integer",
          "minimum": 0
        },
        "verifiers": {
          "type": "integer",
          "minimum": 0
        },
        "corrections": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "defect_history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "revision",
          "initial",
          "corrected",
          "remaining",
          "new",
          "progress",
          "no_progress_cycles"
        ],
        "properties": {
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "initial": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "corrected": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "remaining": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "new": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "progress": {
            "enum": [
              "initial",
              "reduced",
              "unchanged",
              "regressed"
            ]
          },
          "no_progress_cycles": {
            "type": "integer",
            "minimum": 0
          },
          "work_unit_id": {
            "type": "string"
          },
          "verification_request_id": {
            "type": "string"
          },
          "candidate_sha": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{7,64}$"
          },
          "scope_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "no_progress_cycles": {
      "type": "integer",
      "minimum": 0
    },
    "delegation_batches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "batch_id",
          "task_ids",
          "expected_results",
          "status",
          "started_at",
          "recovery_attempted",
          "results",
          "missing_task_ids",
          "contradictions"
        ],
        "properties": {
          "batch_id": {
            "type": "string",
            "minLength": 1
          },
          "task_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "expected_results": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "enum": [
              "waiting-for-delegations",
              "recovering-missing-delegation-result",
              "consolidating-evidence",
              "proceeded",
              "blocked"
            ]
          },
          "started_at": {
            "type": "string"
          },
          "completed_at": {
            "type": "string"
          },
          "proceeded_at": {
            "type": "string"
          },
          "next_phase": {
            "type": "string"
          },
          "recovery_attempted": {
            "type": "boolean"
          },
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "task_id",
                "status",
                "payload"
              ],
              "properties": {
                "task_id": {
                  "type": "string"
                },
                "status": {
                  "enum": [
                    "success",
                    "failed",
                    "blocked",
                    "cancelled"
                  ]
                },
                "payload": {}
              }
            }
          },
          "missing_task_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "contradictions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "completion": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "completed_at": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "parent_gate": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "status": {
          "enum": ["required", "requested", "confirmed", "blocked"]
        },
        "completed_work_unit_id": {
          "type": ["string", "null"]
        },
        "operation_id": {
          "type": ["string", "null"]
        },
        "request_id": {
          "type": ["string", "null"]
        },
        "message_id": {
          "type": ["string", "null"]
        },
        "response_type": {
          "enum": [
            "plan",
            "blocking_clarification",
            "objective_complete",
            "sub_objective_complete",
            "parent_objective_complete",
            "already_complete",
            "unknown",
            null
          ]
        },
        "frontier_decision": {
          "enum": ["ACCEPT", "REMEDIATE", "BLOCKED", null]
        },
        "effect": {
          "type": ["object", "null"]
        },
        "receipt": {
          "type": ["object", "null"]
        },
        "next_work_unit_id": {
          "type": ["string", "null"]
        },
        "recorded_at": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "parent_gate_history": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "next_work_unit": {
      "type": [
        "object",
        "null"
      ],
      "required": ["status", "work_unit_id", "intent", "provenance"],
      "properties": {
        "status": {
          "enum": ["approved", "active", "complete"]
        },
        "work_unit_id": {
          "type": "string",
          "minLength": 1
        },
        "intent": {
          "type": "object"
        },
        "provenance": {
          "type": "object",
          "required": ["operation_id", "request_id", "message_id"],
          "properties": {
            "operation_id": {"type": "string"},
            "request_id": {"type": "string"},
            "message_id": {"type": "string"},
            "frontier_decision": {"type": ["string", "null"]},
            "effect": {"type": "object"},
            "receipt": {"type": "object"}
          },
          "additionalProperties": true
        },
        "approved_at": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "clarification": {
      "type": ["object", "null"],
      "properties": {
        "status": {"enum": ["blocked", "resumed"]},
        "response_type": {"const": "blocking_clarification"},
        "operation_id": {"type": "string"},
        "request_id": {"type": "string"},
        "message_id": {"type": "string"},
        "question": {},
        "resume_phase": {"type": "string"},
        "action": {"type": "object"},
        "recorded_at": {"type": "string"}
      },
      "additionalProperties": true
    },
    "pause": {
      "type": ["object", "null"],
      "properties": {
        "status": {"enum": ["paused", "resumed"]},
        "reason": {"type": "string"},
        "resume_phase": {"type": "string"},
        "action": {"type": "object"},
        "paused_at": {"type": "string"},
        "resumed_at": {"type": "string"}
      },
      "additionalProperties": true
    },
    "cancellation": {
      "type": ["object", "null"],
      "properties": {
        "type": {"enum": ["PARENT_OBJECTIVE_CANCELLED", "RUN_CANCELLED"]},
        "reason": {"type": "string"},
        "request_id": {"type": ["string", "null"]},
        "message_id": {"type": ["string", "null"]},
        "evidence": {"type": "object"},
        "cancelled_at": {"type": "string"}
      },
      "additionalProperties": true
    },
    "active_work_unit_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "work_units": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "status",
          "base_correction_limit",
          "corrections_used",
          "no_progress_cycles"
        ],
        "properties": {
          "work_unit_id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "active",
              "remediating",
              "complete",
              "blocked",
              "cancelled",
              "legacy-ambiguous"
            ]
          },
          "base_correction_limit": {
            "type": "integer",
            "minimum": 0
          },
          "corrections_used": {
            "type": "integer",
            "minimum": 0
          },
          "no_progress_cycles": {
            "type": "integer",
            "minimum": 0
          },
          "legacy_defect_history": {
            "type": "array"
          },
          "migration_note": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "remediation": {
      "type": "object",
      "required": [
        "total_corrections_used",
        "max_total_corrections",
        "grants",
        "blocked"
      ],
      "properties": {
        "total_corrections_used": {
          "type": "integer",
          "minimum": 0
        },
        "max_total_corrections": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "grants": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "grant_id",
              "authority",
              "request_id",
              "work_unit_id",
              "verification_request_id",
              "defect_revision",
              "scope_digest",
              "source_candidate_sha",
              "granted_attempts",
              "consumed_attempts",
              "status",
              "authorized_at"
            ],
            "properties": {
              "grant_id": {
                "type": "string",
                "minLength": 1
              },
              "authority": {
                "enum": [
                  "frontier",
                  "verifier",
                  "user"
                ]
              },
              "request_id": {
                "type": "string",
                "minLength": 1
              },
              "work_unit_id": {
                "type": "string",
                "minLength": 1
              },
              "verification_request_id": {
                "type": "string",
                "minLength": 1
              },
              "defect_revision": {
                "type": "integer",
                "minimum": 0
              },
              "scope_digest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "source_candidate_sha": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{7,64}$"
              },
              "granted_attempts": {
                "type": "integer",
                "minimum": 1
              },
              "consumed_attempts": {
                "type": "integer",
                "minimum": 0
              },
              "status": {
                "enum": [
                  "open",
                  "consumed",
                  "expired",
                  "revoked"
                ]
              },
              "authorized_at": {
                "type": "string"
              },
              "expires_at": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "closed_at": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "blocked": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "scope": {
              "enum": [
                "work_unit",
                "run",
                "legacy-ambiguous"
              ]
            },
            "work_unit_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "code": {
              "type": "string"
            },
            "used": {
              "type": "integer",
              "minimum": 0
            },
            "limit": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "reason": {
              "type": "string"
            },
            "blocked_at": {
              "type": "string"
            },
            "source_request_id": {
              "type": "string"
            },
            "verification_request_id": {
              "type": "string"
            },
            "defect_revision": {
              "type": "integer",
              "minimum": 0
            },
            "scope_digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "source_candidate_sha": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{7,64}$"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "authorizations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "authorization_id",
          "kind",
          "authority",
          "request_id",
          "repository_root",
          "branch",
          "expected_head",
          "allowed_paths",
          "scope_digest",
          "commit_message",
          "commit_message_digest",
          "max_uses",
          "consumed_uses",
          "expires_at",
          "status",
          "authorized_at",
          "consumed_at"
        ],
        "properties": {
          "authorization_id": {"type": "string", "pattern": "^auth-[0-9a-f]{24}$"},
          "kind": {"const": "local_commit"},
