{
  "$schema": "myrmex.config/v1",
  "frontier": {
    "default_chat_url": null,
    "artifact_root": null,
    "artifact_root_policy": "external-per-run",
    "timeout_seconds": 900,
    "poll_seconds": [
      5,
      15,
      30,
      45,
      60
    ],
    "max_plan_iterations": 6,
    "max_corrections_per_work_unit": 2,
    "max_total_corrections": null,
    "max_failover_chats": 1,
    "context_soft_limit_chars": 90000,
    "evidence_soft_limit_chars": 90000
  },
  "git": {
    "default_commit_policy": "ask",
    "default_push_policy": "deny"
  },
  "delivery": {
    "tracking_issue": {
      "required": true,
      "reuse_matching_approved": true,
      "create_when_missing": true,
      "approval_marker": "status:approved",
      "ask_on_ambiguous_match": true
    }
  },
  "memory": {
    "engram_required": false
  },
  "procedural_learning": {
    "enabled": true,
    "default_scope": "project",
    "independent_verifier_required": true,
    "default_trial_max_work_units": 1,
    "core_control_requires_elevated_human": true,
    "collective_enabled": false
  },
  "agent_policy": {
    "allowed_provider_prefixes": [
      "openai/"
    ],
    "require_resolved_model_for_delegation": true,
    "block_shadowed_agents": true,
    "max_steps": {
      "myrmex-scout": 80,
      "myrmex-worker": 110,
      "myrmex-verifier": 90
    }
  }
}
